#!/usr/bin/env python3
"""
project-touch — single-command project status updater.

Usage:
    project-touch <id> [--status STATUS] [--health HEALTH] [--next "next step text"]
                       [--summary "summary"] [--blocker "blocker"] [--clear-blockers]

Examples:
    project-touch nest-gen2 --next "Decide custom OS strategy"
    project-touch winforge --status ready-to-ship --health yellow
    project-touch egyptian-fleet --blocker "no zero-touch provisioning"

This is the ZERO-EFFORT update path. One command. Sets last_touched to now.
"""
import argparse, json, sys
from pathlib import Path
from datetime import datetime
from zoneinfo import ZoneInfo

PROJECTS_FILE = Path("/home/lumen/projects.json")
PT = ZoneInfo("America/Los_Angeles")

VALID_STATUS = ["active", "active-unverified", "waiting", "stalled",
                "ready-to-ship", "complete", "parked", "not-started"]
VALID_HEALTH = ["green", "yellow", "red"]


def load():
    return json.loads(PROJECTS_FILE.read_text())


def save(data):
    data["updated_at"] = datetime.now(PT).isoformat()
    PROJECTS_FILE.write_text(json.dumps(data, indent=2))


def find(data, pid):
    for p in data["projects"]:
        if p["id"] == pid:
            return p
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("id", nargs="?", help="project id (e.g. nest-gen2)")
    ap.add_argument("--status", choices=VALID_STATUS)
    ap.add_argument("--health", choices=VALID_HEALTH)
    ap.add_argument("--next", dest="next_step", help="next concrete step (one line)")
    ap.add_argument("--summary", help="one-sentence what is this")
    ap.add_argument("--blocker", action="append", help="add a blocker (repeat for multiple)")
    ap.add_argument("--clear-blockers", action="store_true")
    ap.add_argument("--list", action="store_true", help="list all project ids and exit")
    args = ap.parse_args()

    data = load()

    if args.list:
        for p in data["projects"]:
            print(f"  {p['id']:30s}  [{p['health']:6s}]  {p['status']:18s}  {p['name']}")
        return

    proj = find(data, args.id)
    if proj is None:
        print(f"unknown project: {args.id}", file=sys.stderr)
        print("known projects:", file=sys.stderr)
        for p in data["projects"]:
            print(f"  {p['id']}", file=sys.stderr)
        sys.exit(1)

    proj["last_touched"] = datetime.now(PT).strftime("%Y-%m-%d")
    if args.status:    proj["status"]    = args.status
    if args.health:    proj["health"]    = args.health
    if args.next_step: proj["next_step"] = args.next_step
    if args.summary:   proj["summary"]   = args.summary
    if args.clear_blockers:
        proj["blockers"] = []
    if args.blocker:
        proj["blockers"] = list(set(proj.get("blockers", []) + args.blocker))

    save(data)
    print(f"updated: {proj['id']}")
    print(f"  status:       {proj['status']}")
    print(f"  health:       {proj['health']}")
    print(f"  last_touched: {proj['last_touched']}")
    print(f"  next_step:    {proj['next_step']}")
    if proj.get("blockers"):
        print(f"  blockers:     {proj['blockers']}")


if __name__ == "__main__":
    main()
