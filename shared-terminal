#!/bin/bash
# shared-terminal — one terminal session that Frank and an agent both see and
# drive. Backed by tmux on a dedicated server socket (tmux -L shared), so it
# never collides with anyone's personal tmux.
#
#   Frank:  shared-terminal open bench        (attach; creates if missing)
#   Agent:  shared-terminal snapshot bench    (what is on screen right now)
#           shared-terminal send bench "ls"   (type a line + Enter)
#           shared-terminal scrollback bench  (history)
#
# Both must run as the SAME Unix user (socket lives in /tmp/tmux-<uid>/shared).
# Every session is also transcript-logged (raw bytes) to $LOG_DIR/<name>.log.
#
# Replaces the remote-cli custom PTY daemon (wq#4395): that one worked but
# attach showed a blank screen until a key was pressed (no screen replay),
# was pinned to 24x80, had no resize/detach, and its VT100 subset could not
# render picocom/mtkclient/adb output faithfully. tmux does all of that.
set -euo pipefail

SOCK="${SHARED_TERMINAL_SOCKET:-shared}"                     # tmux -L <name>
LOG_DIR="${SHARED_TERMINAL_LOGS:-$HOME/.local/share/shared-terminal}"
DEFAULT_COLS="${SHARED_TERMINAL_COLS:-120}"
DEFAULT_ROWS="${SHARED_TERMINAL_ROWS:-40}"

TMUX="$(command -v tmux)" || { echo "shared-terminal: tmux is not installed (apt install tmux)" >&2; exit 1; }
T() { "$TMUX" -L "$SOCK" "$@"; }
die() { echo "shared-terminal: $*" >&2; exit 1; }
need_name() { [ -n "${1:-}" ] || die "usage: shared-terminal $2"; }
exists() { T has-session -t "=$1" 2>/dev/null; }
trim() { sed -e :a -e "/^[[:space:]]*\$/{\$d;N;ba" -e "}"; }   # drop trailing blank rows

apply_opts() {
  # Server/global options for the shared tmux server. Idempotent.
  T set -g history-limit 100000
  T set -g window-size latest          # follow the most recent client (Frank)
  T set -g mouse off
  T set -s escape-time 10              # serial consoles: do not swallow ESC
  T set -g status on
  T set -g status-interval 2
  T set -g status-left "#[bold][SHARED:#S] "
  T set -g status-left-length 30
  T set -g status-right "clients:#{session_attached}  %H:%M"
  T set -g set-titles on
  T set -g set-titles-string "SHARED:#S"
}

create() {  # create <name> [cmd...]  — detached session + transcript log
  local name="$1"; shift
  mkdir -p "$LOG_DIR"
  local log="$LOG_DIR/$name.log"
  T new-session -d -s "$name" -x "$DEFAULT_COLS" -y "$DEFAULT_ROWS" "$@"
  apply_opts
  T pipe-pane -o -t "=$name:" "cat >> '$log'"
  echo "shared-terminal: created '$name' (log: $log)" >&2
}

case "${1:-help}" in
  open)                      # open <name> [cmd...]   attach, create if missing
    need_name "${2:-}" "open <name> [cmd...]"; name="$2"; shift 2
    exists "$name" || create "$name" "$@"
    exec "$TMUX" -L "$SOCK" attach -t "=$name"
    ;;
  start)                     # start <name> [cmd...]  create detached only
    need_name "${2:-}" "start <name> [cmd...]"; name="$2"; shift 2
    exists "$name" && { echo "already running: $name" >&2; exit 0; }
    create "$name" "$@"
    echo "attach with: shared-terminal attach $name"
    ;;
  attach)
    need_name "${2:-}" "attach <name>"
    exists "$2" || die "no session '$2' (shared-terminal list)"
    exec "$TMUX" -L "$SOCK" attach -t "=$2"
    ;;
  snapshot)                  # snapshot <name> [--ansi]   current screen
    need_name "${2:-}" "snapshot <name> [--ansi]"
    exists "$2" || die "no session '$2'"
    if [ "${3:-}" = "--ansi" ]; then exec "$TMUX" -L "$SOCK" capture-pane -p -e -t "=$2:"; fi
    T capture-pane -p -t "=$2:" | trim
    ;;
  scrollback)                # scrollback <name> [lines|all]
    need_name "${2:-}" "scrollback <name> [lines|all]"
    exists "$2" || die "no session '$2'"
    lines="${3:-200}"
    if [ "$lines" = "all" ]; then T capture-pane -p -J -S - -t "=$2:" | trim; exit 0; fi
    T capture-pane -p -J -S "-$lines" -t "=$2:" | trim
    ;;
  send)                      # send <name> "text"            type text + Enter
                             # send <name> --no-enter "text"  type text only
                             # send <name> --key C-c [Up ...] tmux key names
    need_name "${2:-}" "send <name> [--no-enter] \"text\" | send <name> --key KEY..."
    name="$2"; shift 2
    exists "$name" || die "no session '$name'"
    case "${1:-}" in
      --key)   shift; [ $# -gt 0 ] || die "send --key needs a key name (C-c, Enter, Up, Escape, ...)"
               exec "$TMUX" -L "$SOCK" send-keys -t "=$name:" "$@" ;;
      --no-enter) shift; exec "$TMUX" -L "$SOCK" send-keys -t "=$name:" -l -- "$*" ;;
      "")      exec "$TMUX" -L "$SOCK" send-keys -t "=$name:" Enter ;;
      *)       T send-keys -t "=$name:" -l -- "$*"; exec "$TMUX" -L "$SOCK" send-keys -t "=$name:" Enter ;;
    esac
    ;;
  wait)                      # wait <name> <regex> [timeout_s]   until screen matches
    need_name "${2:-}" "wait <name> <regex> [timeout_s]"
    [ -n "${3:-}" ] || die "wait needs a regex"
    exists "$2" || die "no session '$2'"
    deadline=$(( $(date +%s) + ${4:-30} ))
    while :; do
      if T capture-pane -p -t "=$2:" | grep -qE -- "$3"; then exit 0; fi
      [ "$(date +%s)" -lt "$deadline" ] || { echo "timeout waiting for /$3/" >&2; exit 2; }
      sleep 0.5
    done
    ;;
  status)
    need_name "${2:-}" "status <name>"
    exists "$2" || die "no session '$2'"
    exec "$TMUX" -L "$SOCK" display -p -t "=$2:" \
      '{"session":"#{session_name}","attached_clients":#{session_attached},"cols":#{pane_width},"rows":#{pane_height},"shell_pid":#{pane_pid},"running":"#{pane_current_command}","cwd":"#{pane_current_path}","created":"#{t:session_created}","log":"'"$LOG_DIR/$2.log"'"}'
    ;;
  list)
    T ls -F '#{session_name}  clients=#{session_attached}  #{pane_width}x#{pane_height}  running=#{pane_current_command}  created=#{t:session_created}' 2>/dev/null \
      || echo "No active sessions."
    ;;
  log)                       # log <name>   print transcript path;  log <name> -f  follow
    need_name "${2:-}" "log <name> [-f]"
    f="$LOG_DIR/$2.log"
    if [ "${3:-}" = "-f" ]; then exec tail -f "$f"; fi
    echo "$f"
    ;;
  kill)
    need_name "${2:-}" "kill <name>"
    exists "$2" || die "no session '$2'"
    T kill-session -t "=$2" && echo "killed $2"
    ;;
  help|--help|-h)
    cat <<EOF
shared-terminal: one tmux session Frank and an agent share (socket: tmux -L $SOCK)

Human side
  open <name> [cmd...]       attach (creates the session if missing)   detach: Ctrl-b d
  attach <name>              attach to an existing session
Agent side
  start <name> [cmd...]      create detached (no attach)
  snapshot <name> [--ansi]   current visible screen (what Frank sees)
  scrollback <name> [N|all]  last N lines of history (default 200)
  send <name> "text"         type text then Enter
  send <name> --no-enter "t" type text, no Enter
  send <name> --key K...     send tmux key names: C-c  C-d  Enter  Up  Escape  F1
  wait <name> <regex> [sec]  block until the screen matches (exit 2 on timeout)
Both
  status <name>  |  list  |  log <name> [-f]  |  kill <name>

Transcript logs: $LOG_DIR/<name>.log   Both parties must be the same Unix user.
EOF
    ;;
  *) die "unknown command '$1' (shared-terminal help)" ;;
esac
