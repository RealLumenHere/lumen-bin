#!/usr/bin/env python3
"""session-handoff — wq#1294, merged into HANDOFF.md by wq#1630.

Renders the live fleet state into a marked generated region at the TOP of
/home/lumen/HANDOFF.md: in-flight claims, last landed PRs, detector stamps, and
the orchestrator's in-progress notes. Everything outside the markers is hand
prose and is never touched. There is no second handoff file.

Runs from the 30-minute timer and, at read time, from `claude_context.sh --core`
(same pattern as fleet-tools-render), so the region a booting session reads is
seconds old, not up to 30 minutes old.

Usage:
  session-handoff                 re-render the generated region
  session-handoff --render        same (explicit form used by claude_context.sh)
  session-handoff --note "TEXT"   append TEXT to the in-progress log, then re-render
  session-handoff --out PATH      render into PATH instead of /home/lumen/HANDOFF.md (testing)
"""
import argparse
import os
import re
import sqlite3
import sys
import tempfile
from datetime import datetime, timezone

WQ_DB = "/home/lumen/agents/work-queue/queue.db"
HANDOFF_PATH = "/home/lumen/HANDOFF.md"
NOTES_PATH = "/home/lumen/kb/.session-handoff-notes.log"
LOG_DIR = "/home/lumen/logs"
NOTES_KEEP = 20
NOTES_SHOWN = 5

BEGIN_MARK = (
    "<!-- session-handoff:begin — GENERATED by bin/session-handoff (wq#1630); "
    "re-rendered at every --core boot; do not hand-edit, hand prose goes below the end marker -->"
)
END_MARK = "<!-- session-handoff:end -->"
BEGIN_RE = re.compile(r"^<!-- session-handoff:begin\b.*-->[ \t]*$", re.M)
END_RE = re.compile(r"^<!-- session-handoff:end -->[ \t]*$", re.M)

# name -> laststate file under LOG_DIR (None if the detector keeps no persistent
# state beyond its liveness stamp). Paths come from the detector scripts themselves
# (lumen-wq-health, lumen-log-watch, lumen-secret-check, lumen-model-check).
DETECTORS = [
    ("model-check", None),
    ("wq-health", ".wq-health.laststate"),
    ("secret-check", ".secret-check.laststate"),
    ("log-watch", ".log-watch.laststate"),
]

PR_URL_RE = re.compile(r"https?://\S+/pulls?/\d+")
WQ_TS_FMT = "%Y-%m-%d %H:%M:%S"


class RegionError(Exception):
    pass


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def db_conn():
    c = sqlite3.connect(f"file:{WQ_DB}?mode=ro", uri=True, timeout=5)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA busy_timeout=5000")
    return c


def fmt_age(ts, fmt=WQ_TS_FMT):
    """wq timestamps are naive UTC strings ('%Y-%m-%d %H:%M:%S'); render as a
    relative age so the doc stays readable without cross-referencing 'now'."""
    if not ts:
        return "?"
    try:
        t = datetime.strptime(ts, fmt).replace(tzinfo=timezone.utc)
    except ValueError:
        return ts
    secs = max(0, (datetime.now(timezone.utc) - t).total_seconds())
    if secs < 3600:
        return f"{int(secs // 60)}m ago"
    if secs < 86400:
        return f"{secs / 3600:.1f}h ago"
    return f"{secs / 86400:.1f}d ago"


def section_inflight(c):
    rows = c.execute(
        "SELECT id, lane, claimed_by, claimed_at, title FROM tasks "
        "WHERE status='claimed' ORDER BY lane, id"
    ).fetchall()
    if not rows:
        return "(none claimed)\n"
    return "\n".join(
        f"- wq#{r['id']} [{r['lane']}] {r['claimed_by'] or '?'} "
        f"(claimed {fmt_age(r['claimed_at'])}) — {r['title']}"
        for r in rows
    ) + "\n"


def section_landed_prs(c, limit=10, scan=300):
    """Last N done tickets whose notes cite a PR url. The note IS the verdict
    line: `wq done` requires it to name a verifiable artifact (wq#759), and for
    a PR artifact `wq done` itself already refused the close unless the PR had
    landed or was explicitly recorded --unmerged (wq#899) — so a done ticket's
    notes are already a checked verdict, not a bare link."""
    rows = c.execute(
        "SELECT id, done_at, notes FROM tasks WHERE status='done' AND notes IS NOT NULL "
        "ORDER BY done_at DESC LIMIT ?",
        (scan,),
    ).fetchall()
    out = []
    for r in rows:
        if len(out) >= limit:
            break
        note = (r["notes"] or "").replace("\n", " ")
        if not PR_URL_RE.search(note):
            continue
        out.append(f"- wq#{r['id']} ({fmt_age(r['done_at'])}): {note[:180]}")
    return ("\n".join(out) + "\n") if out else "(no recent done tickets carry a PR URL in notes)\n"


def read_file(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def section_detectors():
    lines = []
    for name, state_file in DETECTORS:
        stamp = os.path.join(LOG_DIR, f".stamp.{name}")
        try:
            mtime = os.path.getmtime(stamp)
            age = fmt_age(
                datetime.fromtimestamp(mtime, tz=timezone.utc).strftime(WQ_TS_FMT)
            )
        except OSError:
            age = "never ran (no stamp)"
        state = read_file(os.path.join(LOG_DIR, state_file)) if state_file else None
        lines.append(f"- {name}: last run {age}" + (f" — {state}" if state else ""))
    return "\n".join(lines) + "\n"


def section_notes():
    notes = read_file(NOTES_PATH)
    if not notes:
        return None
    return "\n".join(notes.splitlines()[-NOTES_SHOWN:]) + "\n"


def append_note(note):
    line = f"{now()} — {note}"
    prior = read_file(NOTES_PATH)
    lines = ((prior.splitlines() if prior else []) + [line])[-NOTES_KEEP:]
    with open(NOTES_PATH, "w") as f:
        f.write("\n".join(lines) + "\n")


def build_region(c):
    parts = [
        BEGIN_MARK,
        f"## LIVE HANDOFF — rendered {now()}",
        "_Derived from queue.db + detector stamps by `bin/session-handoff`; trust it over any "
        "hand prose below. Blocked tickets: `wq list --status blocked`._\n",
        "### In-flight workers\n\n" + section_inflight(c),
        "### Last landed PRs\n\n" + section_landed_prs(c),
        "### Detector state\n\n" + section_detectors(),
    ]
    notes = section_notes()
    if notes:
        parts.append("### Orchestrator notes (`session-handoff --note`)\n\n" + notes)
    parts.append(END_MARK)
    return "\n".join(parts)


def splice_region(text, region):
    """Replace the marked region in `text`, or prepend it if there is none.
    Text outside the markers is returned byte-for-byte."""
    b = BEGIN_RE.search(text)
    if not b:
        if END_RE.search(text):
            raise RegionError("end marker without begin marker; refusing to guess where the region is")
        return region + "\n\n" + text if text else region + "\n"
    e = END_RE.search(text, b.end())
    if not e:
        raise RegionError("begin marker without end marker; refusing to overwrite hand prose")
    return text[: b.start()] + region + text[e.end():]


def write_atomic(path, data):
    """Temp file + rename in the same dir, mode preserved: a concurrent reader
    (`cat HANDOFF.md` at --core boot) sees the old file or the new one, never half."""
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(prefix=".handoff.", dir=d)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(data)
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        except FileNotFoundError:
            os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def render(path):
    c = db_conn()
    try:
        region = build_region(c)
    finally:
        c.close()
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    write_atomic(path, splice_region(text, region))
    print(f"session-handoff: rendered region into {path}")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--render", action="store_true", help="re-render the generated region (the default)")
    ap.add_argument("--note", help="append a free-text note to the in-progress log")
    ap.add_argument("--out", default=HANDOFF_PATH, help="handoff file to render into")
    a = ap.parse_args()

    if a.note:
        append_note(a.note)
    try:
        render(a.out)
    except (RegionError, sqlite3.Error, OSError) as e:
        # A failed render leaves the previous region in place (stale, but its
        # timestamp shows it); a --core boot must never die on this.
        print(f"session-handoff: render failed, leaving {a.out} untouched: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
