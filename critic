#!/usr/bin/env bash
# critic — spot-check arbitrary text against Lumen logic-gate criteria
# Mirrors LOGIC_GATE_PROMPT from /home/lumen/agent/quality_gate.py
# Uses cerebras-llama (fast, free tier) via LiteLLM fleet proxy.
# Usage:   cat draft.md | critic
#          critic <<< "some text"
#          critic --title "Post title" < draft.md

set -euo pipefail

LLM=/home/lumen/.local/bin/llm
MODEL=cerebras
TITLE="(untitled)"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --title) TITLE="$2"; shift 2 ;;
        -h|--help)
            sed -n "2,8p" "$0"; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

INPUT="$(cat)"
if [[ -z "$INPUT" ]]; then
    echo "critic: empty stdin" >&2
    exit 2
fi

# Trim to first 1500 chars to match quality_gate.py behaviour
EXCERPT="$(printf "%s" "$INPUT" | head -c 1500)"

SYSTEM="You are a technical editor reviewing a homelab/self-hosted software article.
Your job: identify if this article contains advice that could harm users or is logically flawed.

ARTICLE TITLE: ${TITLE}

ARTICLE EXCERPT (first 1500 chars):
${EXCERPT}

Check for these failure modes:
1. DATA LOSS RISK: Does it recommend storing persistent data in a container without explaining volume mounts/backups?
2. SECURITY HOLE: Does it suggest running sensitive services (passwords, secrets, auth) without addressing what happens if the container/server fails or is compromised?
3. FALSE SIMPLICITY: Does it make something dangerous sound trivially easy without appropriate warnings?
4. INCOMPLETE ADVICE: Does it cover a critical topic (backup, disaster recovery, production deployment) without mentioning failure scenarios?
5. FACTUAL ERROR: Is there an obvious technical mistake that would break someone's setup?

Respond in this exact format:
VERDICT: PASS or FAIL
REASON: one sentence explaining why (if FAIL, be specific about the problem)
SEVERITY: LOW, MEDIUM, or HIGH (only if FAIL)"

"$LLM" -m "$MODEL" --no-stream -s "$SYSTEM" "Critique the above per the rules. Respond using the exact VERDICT/REASON/SEVERITY format." </dev/null
