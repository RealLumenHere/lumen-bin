def load_chats(now):
    """-> (chats newest-first, note). Snapshot + CCC exports, merged by uuid."""
    chats, notes = {}, []
    try:
        with open(CHATS_PATH) as f:
            snap = json.load(f)
        gen = parse_ts(snap.get("generated_at"))
        notes.append(f"snapshot {age(gen, now)} old ({len(snap.get('chats', []))} chats, "
                     f"{os.path.basename(CHATS_PATH)})")
        for c in snap.get("chats", []):
            key = c.get("uuid") or c.get("url")
            if key:
                chats[key] = dict(c, src="snapshot")
        stale = gen is None or now - gen > CHAT_STALE
    except FileNotFoundError:
        notes.append("no chat snapshot yet")
        stale = True
    except (OSError, ValueError, AttributeError) as e:
        notes.append(f"snapshot unreadable ({type(e).__name__})")
        stale = True
    n_ccc = 0
    for path in sorted(glob.glob(os.path.join(INBOX, "*", "conversation.json"))):
        try:
            if os.path.getsize(path) > CONV_MAX_BYTES:
                continue
            with open(path) as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        uuid = d.get("uuid")
        if not uuid:
            continue
        prev = chats.get(uuid)
        if prev and (parse_ts(prev.get("updated_at")) or now) >= (parse_ts(d.get("updated_at")) or now):
            continue
        chats[uuid] = {"uuid": uuid, "title": d.get("name") or "(untitled)",
                       "updated_at": d.get("updated_at"),
                       "summary": first_sentence(d.get("summary") or ""),
                       "url": f"https://claude.ai/chat/{uuid}", "src": "ccc-export"}
        n_ccc += 1
    if n_ccc:
        notes.append(f"{n_ccc} from CCC exports")
    rows = sorted(chats.values(), key=lambda c: parse_ts(c.get("updated_at")) or datetime.min.replace(tzinfo=timezone.utc), reverse=True)
    return rows, "; ".join(notes), stale


def first_sentence(text):
    text = html.unescape(text or "")
    lines = []
    for ln in text.splitlines():
        ln = ln.strip()
        if not ln or re.fullmatch(r"\**[A-Za-z ]+\**:?", ln):   # '**Conversation Overview**'
            continue
        lines.append(ln)
    s = re.sub(r"\*\*|__|`", "", " ".join(lines))
    m = re.match(r"(.{20,240}?[.!?])(\s|$)", s)
    return one(m.group(1) if m else s, 240)


