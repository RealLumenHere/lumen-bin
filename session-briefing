    h = data["health"]
    if h["disarm"]:
        L.append(f"- {RED} dispatch latch: DISPATCH_DISARM PRESENT ({age(h['disarm'], now)} old), "
                 f"no fworker starts. Re-arm is a Frank decision. `{DISARM}`")
    else:
        L.append("- dispatch latch: absent (armed)")
    if h["pause"]:
        L.append(f"- {RED} DISPATCH_PAUSE present ({age(h['pause'], now)} old) `{PAUSE}`")
    parts = []
    for t, en, ac in h["timers"]:
        bad = ac != "active" and t != "lumen-auto-dispatch.timer"   # auto-dispatch is staged-off by design
        parts.append(f"{RED + ' ' if bad else ''}{t[:-6] if t.endswith('.timer') else t} {en}/{ac}")
    L.append("- timers: " + " · ".join(parts))
    u = h.get("usage")
    if u is None:
        L.append(f"- {RED} usage: state unreadable ({h.get('usage_err', '?')}) `{USAGE_STATE}`")
    else:
        lg = u["last_good"]
        stale = u["stale"] or not lg or now - lg > USAGE_STALE
        pct = ", ".join(f"{k} {v.get('percent')}%" for k, v in u["limits"].items() if isinstance(v, dict))
        L.append(f"- {RED + ' ' if stale else ''}usage: last good read {age(lg, now)} ago ({pt(lg)})"
                 + (f", fail streak {u['streak']}" if stale and u.get("streak") else "")
                 + (f" · as of then: {pct}" if pct else "")
                 + (" · STALE: nothing on the box knows current usage" if stale else ""))
    fw = h.get("fworkers")
    L.append(f"- {RED + ' ' if (fw == 0 and h['disarm']) else ''}fworkers running: {fw if fw is not None else '?'}")
    L.append("")
    return L


def render_pipeline(data, caps, now):
    L = ["## 2a. PROMPT PIPELINE (fleet-intel/prompts: paste prompts and their ticket state)"]
    if data.get("pipeline_err"):
        return L + [f"- (pipeline unavailable: {data['pipeline_err']})", ""]
    rows, templates = data["pipeline"]
    groups = [("READY (ticket open, paste it)", lambda r: r["status"] == "open"),
              ("RUNNING (ticket claimed)", lambda r: r["status"] == "claimed"),
              ("DONE, not archived yet (prompt-archive-sweep moves these)", lambda r: r["status"] == "done"),
              ("OTHER (blocked / gated / review / missing)",
               lambda r: r["ticket"] and r["status"] not in ("open", "claimed", "done")),
              ("UNTICKETED (invisible to the box: file a ticket, rename wq<N>-<slug>.md)", lambda r: not r["ticket"])]
    shown = 0
    for label, pred in groups:
        g = [r for r in rows if pred(r)]
        if not g:
            continue
        L.append(f"### {label}: {len(g)}")
        for r in g:
            if shown >= caps["pipeline"]:
                break
            shown += 1
            tk = f"wq#{r['ticket']} {r['status']}" if r["ticket"] else "no ticket"
            nm = "" if r["named"] or not r["ticket"] else " (rename to wq<N>-<slug>.md)"
            md = f" · MODEL {one(r['model'], 40)}" if r["model"] else " · no MODEL line"
            L.append(f"- `{r['name']}`{nm} · {tk} · {age(r['age_t'], now)} old{md}"
                     + (f" · {one(r['title'], 80)}" if r["title"] else ""))
    if not rows:
        L.append("- (no prompts)")
    L += more(len(rows), shown if rows else 0, f"ls -lt {PROMPTS_DIR}")
    if templates:
        L.append(f"_templates (never archived): {', '.join(templates)}_")
    L.append("")
    return L


def render_next(data, now):
    L = [f"## 2b. NEXT UP (top {NEXT_N} unblocked, non-gated open tickets by effective priority)"]
    if data.get("next_err"):
        return L + [f"- (next-up unavailable: {data['next_err']})", ""]
    for e, r, tup, src in data["next"]:
        L.append(f"- wq#{r['id']} eP{e} [{r['lane']}] {one(r['title'], 100)} · MODEL `{tup}` ({src})")
    if not data["next"]:
        L.append("- (nothing dispatchable)")
    L.append("_Paste prompt for one: `agent-prompt <id>`; full order: `wq list --sort effective`._")
    L.append("")
    return L


def render(data, caps, now):
    L = []
    L.append("# SESSION BRIEFING — read this first")
    L.append(f"_Generated {pt(now)} by /home/lumen/bin/session-briefing (wq#4787) on every state-regen "
             "and every `--core` boot. Never hand-edit: fix the source. Precedence: live VERIFY > this "
             "briefing > HANDOFF.md prose > claude_memory.md. Not the append-only log at "
             "scratch/subtraction/SESSION-BRIEFING.md._")
    L.append("")

    L += render_health(data, now)

    # 1 RECENT CHATS
    L.append("## 1. RECENT CHATS (what Frank has been doing, all sessions)")
    if data["chats_err"]:
        L.append(f"- (chat sources unavailable: {data['chats_err']})")
        chats, note, stale = [], "", True
    else:
        chats, note, stale = data["chats"]
    L.append(f"_Source: {note or 'none'}. Refresh from a claude.ai session: pipe recent_chats(n=20) output "
             "into `ssh lumen@100.117.66.102 'session-briefing ingest-chats'`._")
    for ch in chats[: caps["chats"]]:
        t = parse_ts(ch.get("updated_at"))
        summ = f" — {one(ch.get('summary'), 180)}" if ch.get("summary") else ""
        L.append(f"- {pt(t)} · **{one(ch.get('title') or '(untitled)', 80)}**{summ} · {ch.get('url', '')}")
    if stale or len(chats) < 5:
        proxy = data.get("proxy") or []
        n = max(0, min(caps["chats"], 10) if chats else caps["chats"])
        if proxy and n:
            why = "missing" if not chats else ("stale" if stale else "thin")
            L.append(f"_PROXY (snapshot {why}): latest claude-session episodes_")
            for r in proxy[:n]:
                ref = f" [{r['source_ref']}]" if r["source_ref"] else ""
                L.append(f"- {pt(parse_ts(r['created_at']))} · {one(r['title'], 160)}{ref}")
        elif data.get("proxy_err"):
            L.append(f"- (proxy unavailable: {data['proxy_err']})")
    L.append("")

    # 2 ACTIVE WORK
    L.append("## 2. ACTIVE WORK")
    if data["work_err"]:
        L.append(f"- (queue unavailable: {data['work_err']})")
    else:
        tasks, grants = data["work"]
        by = {s: [t for t in tasks if t["status"] == s] for s in ("frank_gated", "claimed", "pending_review", "blocked")}
        gated = by["frank_gated"]
        L.append(f"### Waiting on Frank — {len(gated)} frank_gated, {len(grants)} pending grant request(s)")
        for g in grants[:10]:
            L.append(f"- grant#{g['id']} for wq#{g['ticket_id']}: {g['class']} → {one(g['target'], 90)} "
                     f"(requested {pt(parse_ts(g['requested_at']))})")
        for t in gated[: caps["gated"]]:
            why = f" — {one(t['decision_prompt'], 140)}" if t["decision_prompt"] else ""
            L.append(f"- wq#{t['id']} P{t['pri']} [{t['lane']}] {one(t['title'], 100)}{why}")
        L += more(len(gated), min(len(gated), caps["gated"]), "wq list --status frank_gated")
        cl = by["claimed"]
        L.append(f"### In flight — {len(cl)} claimed")
        for owner, pred in (("orchestrator", lambda w: w and not w.startswith("fworker")),
                            ("fworker", lambda w: w and w.startswith("fworker"))):
            for t in [t for t in cl if pred(t["claimed_by"] or "")]:
                L.append(f"- {owner} `{t['claimed_by']}`: wq#{t['id']} P{t['pri']} {one(t['title'], 110)} "
                         f"(claimed {age(parse_ts(t['claimed_at']), now)} ago)")
        pr = by["pending_review"]
        if pr:
            L.append(f"### Pending review — {len(pr)}")
            for t in pr[:10]:
                L.append(f"- wq#{t['id']} P{t['pri']} {one(t['title'], 120)}")
            L += more(len(pr), min(len(pr), 10), "wq list --status pending_review")
        bl = by["blocked"]
        L.append(f"### Blocked — {len(bl)} (highest pri first)")
        for t in bl[: caps["blocked"]]:
            why = f" — {one(t['block_reason'], 140)}" if t["block_reason"] else ""
            L.append(f"- wq#{t['id']} P{t['pri']} {one(t['title'], 90)}{why}")
        L += more(len(bl), min(len(bl), caps["blocked"]), "wq list --status blocked")
    L.append("")

    L += render_pipeline(data, caps, now)
    L += render_next(data, now)

    # 3 LAST 48H
    L.append("## 3. LAST 48H — episodes, failures, Frank's decisions")
    if data["episodes_err"]:
        L.append(f"- (episodes unavailable: {data['episodes_err']})")
    else:
        eps = data["episodes"]
        n_fail = 0
        for r in eps[: caps["episodes"]]:
            failed = md_section(r["content"], "What failed")
            changed = md_section(r["content"], "What changed")
            ref = f" [{r['source_ref']}]" if r["source_ref"] else ""
            line = f"- {pt(parse_ts(r['created_at']))} · {r['kind']} · {one(r['title'], 150)}{ref}"
            if changed:
                line += f" · changed: {one('; '.join(changed), 90)}"
            if failed:
                n_fail += 1
                line += f" · **FAILED:** {one('; '.join(failed), 120)}"
            L.append(line)
        if not eps:
            L.append("- (no episodes in the last 48h)")
        L += more(len(eps), min(len(eps), caps["episodes"]), "lumen_episode.py recall '<topic>'")
    facts = data.get("facts") or []
    decs = data.get("decisions") or []
    if facts or decs:
        L.append("### Frank-stated facts and active decisions (last 7d)")
        for f in facts:
            L.append(f"- {pt(parse_ts(f['ingested_at']))} · {f['subject']}.{f['predicate']} = {one(f['value'], 130)}")
        for d in decs:
            L.append(f"- decision#{d['id']} {pt(parse_ts(d['created_at']))} · {one(d['decision'], 150)}")
    for k in ("facts_err", "decisions_err"):
        if data.get(k):
            L.append(f"- ({k[:-4]} unavailable: {data[k]})")
    L.append("")

    # 4 STANDING ORDERS
    L.append("## 4. STANDING ORDERS (things incoming agents keep violating — from claude_memory.md)")
    if data["orders_err"]:
        L.append(f"- (claude_memory.md unreadable: {data['orders_err']})")
    else:
        orders = data["orders"]
        for o in orders[: caps["orders"]]:
            L.append(f"- {one(o, 220)}")
        L += more(len(orders), min(len(orders), caps["orders"]), "grep -nE 'STANDING ORDER|NEVER|RETIRED|DEAD' /home/lumen/claude_memory.md")
    L.append("")

    # 5 OPEN HANDOFFS
    L.append("## 5. OPEN HANDOFFS (open tickets whose notes say handoff / incomplete / not done)")
    if data["handoffs_err"]:
        L.append(f"- (queue unavailable: {data['handoffs_err']})")
    else:
        ho = data["handoffs"]
        for r, hit in ho[: caps["handoffs"]]:
            L.append(f"- wq#{r['id']} P{r['pri']} {r['status']} · {one(r['title'], 80)} — {one(hit, 140)}")
        if not ho:
            L.append("- (none)")
        L += more(len(ho), min(len(ho), caps["handoffs"]), "wq show <id>")
    L.append("_Last sessions' close-out prose: HANDOFF.md 'Orchestrator notes' and "
             "`tail -60 /home/lumen/scratch/subtraction/SESSION-BRIEFING.md`._")
    return L


def build(now=None):
    now = now or datetime.now(timezone.utc)
    data = collect(now)
    caps = dict(CAPS)
    lines = render(data, caps, now)
    while len(lines) > MAX_LINES:
        k = next((k for k in TRIM_ORDER if caps[k] > FLOORS[k]), None)
        if k is None:
            break
        caps[k] = max(FLOORS[k], caps[k] - max(1, (len(lines) - MAX_LINES)))
        lines = render(data, caps, now)
    if len(lines) > MAX_LINES:
        lines = lines[: MAX_LINES - 1] + [f"_(truncated at {MAX_LINES} lines)_"]
    return mask("\n".join(lines) + "\n")


# ---------------------------------------------------------------- ingest-chats
def parse_chat_input(text):
    text = text.strip()
    if text.startswith("[") or text.startswith("{"):
        d = json.loads(text)
        items = d.get("chats", []) if isinstance(d, dict) else d
        out = []
        for c in items:
            url = c.get("url") or (f"https://claude.ai/chat/{c['uuid']}" if c.get("uuid") else "")
            uuid = c.get("uuid") or url.rstrip("/").rsplit("/", 1)[-1]
            if uuid:
                out.append({"uuid": uuid, "url": url, "updated_at": c.get("updated_at"),
                            "title": one(c.get("title") or c.get("name") or "(untitled)", 120),
                            "summary": first_sentence(c.get("summary") or "")})
        return out
    out = []
    for _q1, url, _q2, upd, body in CHAT_RE.findall(text):
        body = html.unescape(body)
        uuid = url.rstrip("/").rsplit("/", 1)[-1]
        if "[Content redacted" in body:
            title, summ = "(content redacted by classifier)", ""
        else:
            m = re.search(r"^\s*Title:\s*(.+)$", body, re.M)
            title = m.group(1).strip() if m else "(untitled)"
            summ = ""
            sm = (re.search(r"^\s*Summary:\s*(.*)", body, re.M | re.S)
                  or re.search(r"<chat_summary>(.*?)(?:</chat_summary>|$)", body, re.S))
            if sm:
                summ = first_sentence(sm.group(1)[:3000])
            else:
                hm = re.search(r"^(?:H|Human):[ \t]*(\S.*)$", body, re.M)
                if hm:
                    summ = "Frank: " + one(hm.group(1), 160)
        out.append({"uuid": uuid, "url": url, "updated_at": upd, "title": one(title, 120), "summary": summ})
    return out


def ingest_chats(text, now=None):
    now = now or datetime.now(timezone.utc)
    new = parse_chat_input(text)
    if not new:
        print("session-briefing: ingest-chats parsed 0 chats (expected recent_chats output or JSON)", file=sys.stderr)
        return 2
    merged = {}
    try:
        with open(CHATS_PATH) as f:
            for c in json.load(f).get("chats", []):
                if c.get("uuid"):
                    merged[c["uuid"]] = c
    except (OSError, ValueError, AttributeError):
        pass
    for c in new:
        prev = merged.get(c["uuid"])
        if not prev or (parse_ts(c.get("updated_at")) or now) >= (parse_ts(prev.get("updated_at")) or now):
            merged[c["uuid"]] = {k: mask(v) if isinstance(v, str) else v for k, v in c.items()}
    rows = sorted(merged.values(), key=lambda c: parse_ts(c.get("updated_at")) or datetime.min.replace(tzinfo=timezone.utc), reverse=True)[:CHAT_KEEP]
    snap = {"generated_at": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
            "source": "claude.ai recent_chats via browser session (session-briefing ingest-chats)",
            "chats": rows}
    atomic_write(CHATS_PATH, json.dumps(snap, indent=1, ensure_ascii=False) + "\n", mode=0o600)
    print(f"session-briefing: ingested {len(new)} chat(s); snapshot holds {len(rows)} -> {CHATS_PATH}")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="session-briefing", description=__doc__.split("\n")[0])
    ap.add_argument("cmd", nargs="?", choices=["render", "ingest-chats", "dashboard"], default="render")
    ap.add_argument("--out", default=OUT_PATH)
    ap.add_argument("--stdout", action="store_true")
    ap.add_argument("--file", help="ingest-chats: read this file instead of stdin")
    a = ap.parse_args(argv)
    if a.cmd == "ingest-chats":
        text = open(a.file).read() if a.file else sys.stdin.read()
        try:
            return ingest_chats(text)
        except ValueError as e:
            print(f"session-briefing: bad JSON: {e}", file=sys.stderr)
            return 2
    if a.cmd == "dashboard":
        now = datetime.now(timezone.utc)
        data = collect(now)
        lines = render_health(data, now) + render_pipeline(data, dict(CAPS), now) + render_next(data, now)
        sys.stdout.write(mask("\n".join(lines) + "\n"))
        return 0
    text = build()
    if a.stdout:
        sys.stdout.write(text)
        return 0
    try:
        atomic_write(a.out, text)
    except OSError as e:
        print(f"session-briefing: could not write {a.out}: {e} (previous file kept)", file=sys.stderr)
        return 1
    print(f"session-briefing: wrote {a.out} ({text.count(chr(10))} lines)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
