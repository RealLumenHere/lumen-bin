def md_section(content, name):
    m = re.search(r"^## " + re.escape(name) + r"\n(.*?)(?=^## |\Z)", content or "", re.S | re.M)
    if not m:
        return []
    items = [ln[2:].strip() for ln in m.group(1).splitlines() if ln.startswith("- ")]
    return [i for i in items if i.lower().strip(". ") not in ("(none)", "none", "nothing", "n/a", "")]


def load_orders():
    """Standing-order lines from claude_memory.md, hand prose first, deduped."""
    with open(MEMORY_MD) as f:
        lines = f.read().splitlines()
    by_sec = {k: [] for k in ORDER_SECTIONS}
    sec, sub, sub_hit, sub_used = None, None, False, False

    def close_sub():
        # a hand-prose heading that is itself an order ("M80 DEAD — final") but has no
        # matching body line still counts, once, as its own entry
        if sec == "HAND PROSE" and sub and sub_hit and not sub_used:
            by_sec[sec].append([f"[{sub}]"])

    for ln in lines:
        if ln.startswith("## ") or ln.startswith("### "):
            close_sub()
            if ln.startswith("## "):
                sec = next((k for k in ORDER_SECTIONS if ln[3:].upper().startswith(k)), None)
                sub, sub_hit = None, False
            else:
                sub = ln[4:].strip()
                sub_hit = bool(ORDER_RE.search(sub))
            sub_used = False
            if sec == "HAND PROSE" and ln.startswith("### "):
                by_sec[sec].append([])          # one group per dated hand-prose block
            continue
        if sec is None or not ORDER_RE.search(ln):
            continue
        text = re.sub(r"^\s*(?:[-*]|\d+\.)\s*", "", ln)
        text = re.sub(r"^(?:note|description):\s*", "", text)
        if sec == "HAND PROSE":
            if sub:
                text = f"[{sub}] {text}"
                sub_used = True
            if not by_sec[sec]:
                by_sec[sec].append([])
            by_sec[sec][-1].append(text)
        else:
            by_sec[sec].append(text)
    close_sub()
    # hand prose blocks are dated ascending: newest block first, lines in order within it
    hand = [t for grp in reversed(by_sec["HAND PROSE"]) for t in grp]
    ordered = hand + by_sec["PERMANENT DECISIONS"] + by_sec["FRANK CORRECTIONS"] + by_sec["STANDING RULES"]
    seen, out = set(), []
    for t in ordered:
        key = re.sub(r"[^a-z0-9]+", " ", t.lower()).strip()[:100]
        if key and key not in seen:
            seen.add(key)
            out.append(t)
    return out


# ---------------------------------------------------------------- wq#5082 loaders
def _run(cmd, timeout=5):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return None, type(e).__name__


def _mtime(path):
    try:
        return datetime.fromtimestamp(os.stat(path).st_mtime, timezone.utc)
    except OSError:
        return None


def load_health(now):
    h = {"disarm": _mtime(DISARM), "pause": _mtime(PAUSE), "timers": [], "usage": None}
    for t in TIMERS:
        rc1, en = _run([SYSTEMCTL, "is-enabled", t])
        rc2, ac = _run([SYSTEMCTL, "is-active", t])
        en = en.splitlines()[0] if rc1 is not None and en else "?"
        ac = ac.splitlines()[0] if rc2 is not None and ac else "?"
        h["timers"].append((t, en, ac))
    rc, out = _run([PGREP, "-fc", FWORKER_PAT])
    h["fworkers"] = int(out) if rc in (0, 1) and out.isdigit() else None
    try:
        with open(USAGE_STATE) as f:
            u = json.load(f)
        h["usage"] = {"last_good": parse_ts(u.get("last_good_at")), "stale": bool(u.get("stale")),
                      "streak": u.get("primary_fail_streak"), "limits": u.get("limits") or {}}
    except (OSError, ValueError, AttributeError) as e:
        h["usage_err"] = type(e).__name__
    return h


def _cols(c, table):
    return {r[1] for r in c.execute(f"PRAGMA table_info({table})")}


def _status_map(c, ids):
    if not ids:
        return {}
    q = "SELECT id, status, title FROM tasks WHERE id IN (%s)" % ",".join("?" * len(ids))
    return {r["id"]: r for r in c.execute(q, sorted(ids))}


def load_pipeline(c, now):
    """-> (rows, templates). rows: dict(name, ticket, status, title, model, age_t, named)."""
    rows, templates, ids = [], [], set()
    for name in sorted(os.listdir(PROMPTS_DIR)):
        p = os.path.join(PROMPTS_DIR, name)
        if not name.endswith(".md") or not os.path.isfile(p):
            continue
        if TEMPLATE_RE.search(name):
            templates.append(name)
            continue
        try:
            with open(p, errors="replace") as f:
                head = f.read(4096)
        except OSError:
            head = ""
        m = TICKET_FILE_RE.match(name) or TICKET_LINE_RE.search(head)
        n = int(m.group(1)) if m else None
        first = head.splitlines()[0] if head else ""
        model = first.split(":", 1)[1].split("#")[0].strip() if first.upper().startswith("MODEL:") else ""
        rows.append({"name": name, "ticket": n, "model": model, "age_t": _mtime(p),
                     "named": bool(TICKET_FILE_RE.match(name))})
        if n:
            ids.add(n)
    st = _status_map(c, ids)
    for r in rows:
        t = st.get(r["ticket"])
        r["status"] = t["status"] if t else ("missing" if r["ticket"] else None)
        r["title"] = t["title"] if t else ""
    return rows, templates


def eff_pri(pri, status, gate, created_at, now):
    """mirror of wq.effective_pri (wq#661): open, ungated tickets gain one tier after AGING_DAYS."""
    pri = 9 if pri is None else pri
    if status != "open" or (gate or "").strip():
        return pri
    t = parse_ts(created_at)
    if not t:
        return pri
    return max(1, pri - min(1, int((now - t).total_seconds() / 86400 / AGING_DAYS)))


def router_tuple(tid, model, effort):
    if model:
        return (f"{model}@{effort}" if effort else model), "stamp"
    if not ROUTER or not os.path.exists(ROUTER):
        return "?", "no router"
    rc, out = _run([sys.executable, ROUTER, "assign", str(tid), "--dry-run"], timeout=10)
    try:
        rung = json.loads(out.splitlines()[-1])["rung"]
        return (f"{rung['model']}@{rung['effort']}" if rung.get("effort") else rung["model"]), "router"
    except (ValueError, KeyError, IndexError, TypeError, AttributeError):
        return "?", f"router rc={rc}"


def load_next(c, now):
    cols = _cols(c, "tasks")
    want = ["id", "lane", "pri", "title", "status", "created_at", "gate", "deps", "model", "effort"]
    sel = ", ".join(x if x in cols else f"NULL AS {x}" for x in want)
    rows = c.execute(f"SELECT {sel} FROM tasks WHERE status='open'").fetchall()
    cand = []
    for r in rows:
        lane = r["lane"] or ""
        if (r["gate"] or "").strip() or lane in NEXT_SKIP_LANES or lane.startswith("frank"):
            continue
        if NOAUTO_RE.search(r["title"] or ""):
            continue
        deps = [int(d) for d in re.findall(r"\d+", r["deps"] or "")]
        cand.append((eff_pri(r["pri"], r["status"], r["gate"], r["created_at"], now), r["id"], r, deps))
    cand.sort(key=lambda x: (x[0], x[1]))
    out, dep_status = [], {}
    for e, _i, r, deps in cand:
        missing = {d for d in deps if d not in dep_status}
        if missing:
            dep_status.update({k: v["status"] for k, v in _status_map(c, missing).items()})
        if any(dep_status.get(d) != "done" for d in deps):
            continue
        out.append((e, r))
        if len(out) >= NEXT_N:
            break
    return [(e, r, *router_tuple(r["id"], r["model"], r["effort"])) for e, r in out]


# ---------------------------------------------------------------- rendering
def safe(fn, *a):
    try:
        return fn(*a), None
    except Exception as e:  # one broken source must not kill the briefing
        return None, f"{type(e).__name__}: {one(e, 160)}"


def collect(now):
    data = {}
    data["chats"], data["chats_err"] = safe(load_chats, now)
    try:
        with closing(ro(WQ_DB)) as c:
            data["work"], data["work_err"] = safe(load_work, c, now)
            data["handoffs"], data["handoffs_err"] = safe(load_handoffs, c)
            data["pipeline"], data["pipeline_err"] = safe(load_pipeline, c, now)
            data["next"], data["next_err"] = safe(load_next, c, now)
    except sqlite3.Error as e:
        for k in ("work", "handoffs", "pipeline", "next"):
            data[k], data[k + "_err"] = None, f"queue.db: {e}"
    try:
        with closing(ro(MINERVA_DB)) as c:
            data["proxy"], data["proxy_err"] = safe(load_proxy_sessions, c, CAPS["chats"])
            data["episodes"], data["episodes_err"] = safe(load_episodes, c, now)
            data["facts"], data["facts_err"] = safe(load_frank_facts, c, now)
            data["decisions"], data["decisions_err"] = safe(load_decisions, c, now)
    except sqlite3.Error as e:
        for k in ("proxy", "episodes", "facts", "decisions"):
            data[k], data[k + "_err"] = None, f"minerva.db: {e}"
    data["orders"], data["orders_err"] = safe(load_orders)
    data["health"], data["health_err"] = safe(load_health, now)
    return data


