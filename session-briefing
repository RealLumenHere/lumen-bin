def load_work(c, now):
    tasks = c.execute(
        "SELECT id, lane, pri, title, status, claimed_by, claimed_at, block_reason, "
        "decision_prompt, notes, created_at FROM tasks "
        "WHERE status IN ('claimed','frank_gated','pending_review','blocked') "
        "ORDER BY COALESCE(pri, 9) ASC, id DESC").fetchall()
    grants = c.execute(
        "SELECT id, ticket_id, class, target, requested_at, expires_at FROM grant_requests "
        "WHERE state='pending' ORDER BY id DESC").fetchall()
    live = [g for g in grants if not g["expires_at"] or (parse_ts(g["expires_at"]) or now) > now]
    return tasks, live


def load_handoffs(c):
    rows = c.execute(
        "SELECT id, pri, status, title, notes FROM tasks "
        "WHERE status NOT IN ('done','cancelled','rejected','retired') AND notes IS NOT NULL "
        "AND (notes LIKE '%hand%off%' OR notes LIKE '%handover%' OR notes LIKE '%SESSION-BRIEFING%' "
        "OR notes LIKE '%incomplete%' OR notes LIKE '%not done%' OR notes LIKE '%not-done%') "
        "ORDER BY COALESCE(pri, 9) ASC, id DESC").fetchall()
    out = []
    for r in rows:
        hits = [ln for ln in (r["notes"] or "").splitlines() if HANDOFF_RE.search(ln)]
        if hits:
            out.append((r, hits[-1]))
    return out


