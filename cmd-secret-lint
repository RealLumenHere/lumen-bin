#!/usr/bin/env python3
"""cmd-secret-lint (wq#4600) - refuse text that carries a secret literal.

WHY: wq#4550 found Thor's ~/.bash_history holding live tokens because agents handed Frank commands with the
secret inline (`ssh lumen ... printf %s <token> > file`). Shell history, PR bodies, tickets and chat all keep
what they are given. A secret goes through stdin from a 0600 file, or an interactive `read -s`; never as a literal.

  cmd-secret-lint [--name LABEL] [FILE ...]      reads stdin when no FILE (or FILE is -)
  exit 0 clean | 1 secret literal found | 2 usage/read error

Never prints the literal: only LABEL:LINE, a class and a 12-char sha256 fingerprint.
Always flagged: prefixed tokens (ghp_/github_pat_/cfat_/cfut_/sk-ant-/sk-/AKIA/glpat-/xox*), PEM private-key headers, JWTs,
`Bearer <24+ chars>`, `://user:password@host`. Bare 40-128 hex is flagged ONLY on a line that also looks credential-like
(token/secret/password/api key/auth/bearer/.secrets/`printf %s`), so git SHAs and sha256sum lines are left alone.
Placeholders (`<token>`, `$TOKEN`, `${X}`, REDACTED, xxxx, ...) are not secrets. A line containing
`cmd-secret-lint: ok` is skipped (for a documented false positive).
"""
import argparse, hashlib, re, sys

PREFIXED = [
    ("github-pat", r"github_pat_[A-Za-z0-9_]{30,}"),
    ("github-token", r"gh[pousr]_[A-Za-z0-9]{30,}"),
    ("cloudflare-user-token", r"cfut_[A-Za-z0-9_\-]{20,}"),
    ("cloudflare-account-token", r"cfat_[A-Za-z0-9_\-]{20,}"),
    ("anthropic-key", r"sk-ant-[A-Za-z0-9_\-]{20,}"),
    ("api-key-sk", r"(?<![A-Za-z0-9])sk-[A-Za-z0-9_\-]{24,}"),
    ("aws-access-key", r"AKIA[0-9A-Z]{16}"),
    ("gitlab-pat", r"glpat-[A-Za-z0-9_\-]{20,}"),
    ("slack-token", r"xox[baprs]-[A-Za-z0-9\-]{20,}"),
    ("private-key", r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    ("jwt", r"\beyJ[A-Za-z0-9_\-]{10,}\.eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}"),
]
PREFIXED = [(n, re.compile(p)) for n, p in PREFIXED]
BEARER = re.compile(r"[Bb]earer\s+([A-Za-z0-9._~+/=\-]{24,})")
URLPW = re.compile(r"://[^/\s:@]+:([^/\s@]{8,})@")
HEX = re.compile(r"(?<![0-9A-Za-z])[0-9a-fA-F]{40,128}(?![0-9A-Za-z])")
CTX = re.compile(r"(token|secret|passw|api[_-]?key|apikey|\bauth|bearer|credential|\.secrets|printf\s+['\"]?%s)", re.I)
PLACEHOLDER = re.compile(r"[<>${}]|REDACTED|example|changeme|your[_-]|xxxx|\.\.\.", re.I)
SKIP = "cmd-secret-lint: ok"


def real(v):
    return not PLACEHOLDER.search(v) and len(set(v)) > 4


def fp(v):
    return hashlib.sha256(v.encode()).hexdigest()[:12]


def scan(text):
    """[(lineno, class, fp)] - one finding per distinct (line, value)."""
    out = []
    for i, ln in enumerate(text.splitlines(), 1):
        if SKIP in ln:
            continue
        seen = set()
        def add(cls, v):
            if real(v) and (v not in seen):
                seen.add(v); out.append((i, cls, fp(v)))
        for name, rx in PREFIXED:
            for m in rx.finditer(ln):
                add(name, m.group(0))
        for m in BEARER.finditer(ln):
            add("bearer-token", m.group(1))
        for m in URLPW.finditer(ln):
            add("url-password", m.group(1))
        if CTX.search(ln):
            for m in HEX.finditer(ln):
                add("hex-secret-in-credential-context", m.group(0))
    return out


def main():
    ap = argparse.ArgumentParser(prog="cmd-secret-lint", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--name", default=None, help="label used in messages (default: file name or 'stdin')")
    ap.add_argument("files", nargs="*")
    a = ap.parse_args()
    srcs = a.files or ["-"]
    bad = 0
    for f in srcs:
        try:
            text = sys.stdin.read() if f == "-" else open(f, errors="replace").read()
        except OSError as e:
            print("cmd-secret-lint: cannot read %s: %s" % (f, e), file=sys.stderr); return 2
        label = a.name or ("stdin" if f == "-" else f)
        for ln, cls, f12 in scan(text):
            bad += 1
            print("cmd-secret-lint: %s:%d: %s fp=%s" % (label, ln, cls, f12), file=sys.stderr)
    if bad:
        print("cmd-secret-lint: %d secret literal(s). Do not put a secret in a command, prompt, PR body or note: pass it via stdin "
              "from a 0600 file or an interactive `read -s`, and refer to it by path or name." % bad, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
