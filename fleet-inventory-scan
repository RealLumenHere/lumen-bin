#!/usr/bin/env python3
"""fleet-inventory-scan -- per-machine inventory scanner (wq#4918).

Runs ON LUMEN. One read-only SSH session per target: a probe script is fed on
stdin to `bash -s`, its sections are parsed here, and the result is rendered to
/home/lumen/fleet-inventory/<name>.md (atomic write).

  fleet-inventory-scan NAME [NAME...]      scan + write
  fleet-inventory-scan --all               scan every machine in FLEET
  fleet-inventory-scan NAME --dry-run      render to stdout, write nothing
  fleet-inventory-scan NAME --target USER@HOST[,HOSTKEYALIAS]   extra ssh target (repeatable, tried first)
  fleet-inventory-scan --mark-offline NAME "reason"
  fleet-inventory-scan --readme            regenerate the README.md table only

Safety: nothing on a target is modified (no sudo, no writes, no service or
package-manager calls). Host-key checking stays ON (StrictHostKeyChecking=yes);
a changed key is reported, never bypassed. Re-scans keep hand edits (Purpose,
Disabled/not-used when edited by hand) and move superseded values into
"Previous configuration" + "Change log".
Exit: 0 ok, 2 unreachable (status recorded), 1 error.
"""
import argparse, json, os, re, subprocess, sys, tempfile
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

INV_DIR = Path(os.environ.get("FLEET_INVENTORY_DIR", "/home/lumen/fleet-inventory"))
STATUS_DIR = INV_DIR / ".status"
STATE_PY = "/home/lumen/minerva/lumen_state.py"
PT = ZoneInfo("America/Los_Angeles")
DATA_TAG = "fleet-inventory-scan:data"
LOCAL = {"lumen"}

# name -> ordered ssh candidates (user@host, HostKeyAlias|None). First that answers wins.
# horus: LAN .229 serves Horus's own host keys (verified out-of-band 2026-11-05) but Lumen's
# known_hosts holds stale entries for that IP; the alias reuses the trusted tailnet-IP entry.
