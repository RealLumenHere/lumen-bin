    "lumen": [],
    "thor":   [("thor@100.112.151.100", None), ("thor@192.168.8.132", None)],
    "thoth":  [("thoth@100.75.1.108", None), ("thoth@192.168.8.218", None)],
    "anubis": [("anubis@100.121.17.5", None), ("anubis@192.168.8.232", None)],
    "horus":  [("horus@192.168.8.229", "100.83.19.124"), ("horus@100.83.19.124", None)],
    "ptah":   [("ptah@100.78.207.56", None), ("ptah@192.168.8.125", None)],
    "neith":  [("neith@100.108.107.111", None), ("neith@192.168.8.147", None)],
    "khnum":  [("khnum@100.76.194.58", None), ("khnum@192.168.8.110", None)],
