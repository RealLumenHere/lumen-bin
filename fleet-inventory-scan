command -v dpkg-query >/dev/null 2>&1 && dpkg-query -W -f='${db:Status-Abbrev}|${Package}|${Version}\n' plexmediaserver qbittorrent-nox apache2 postgresql grafana prometheus-node-exporter samba nfs-kernel-server ntfy openvino 2>/dev/null | awk -F"|" '$1 ~ /^ii/ {print $2"|"$3}'
