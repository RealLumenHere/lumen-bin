#!/usr/bin/env bash
# wq-drift-guard — detect when the deployed wq diverges from reviewed code.
# wq#886: untracked, shared, mutable binary means any worker can silently
# clobber the tool every other worker depends on. This guard fires every
# few minutes and ntfy-alerts on drift so a clobber is caught in minutes
# instead of hours. Manual: wq-drift-guard [--fix|--status]
#
# wq#1653: two different faults leave the deployed wq unreviewed, and this guard
# used to report both as a clobber:
#   CLOBBER (exit 1) — repo is on its default branch and $FILE differs from HEAD.
#     One file was overwritten. --fix restores it.
#   BRANCH  (exit 4) — the repo itself is parked off its default branch. HEAD is
#     then not reviewed code, so "$FILE matches HEAD" proves nothing and "$FILE
#     differs from HEAD" is not a clobber. The whole tree is at fault, it is
#     primary_tree_guard.py's to restore, and --fix here would deploy $FILE *from
#     the feature branch*. So BRANCH is reported under its own alert title, takes
#     precedence over the $FILE comparison, and refuses --fix.
set -uo pipefail

REPO=${WQ_DRIFT_GUARD_REPO:-/home/lumen/bin}
FILE=${WQ_DRIFT_GUARD_FILE:-wq}
NTFY_TOPIC=lumen-alerts
NTFY_TAG=wq-drift
LOCKFILE=${WQ_DRIFT_GUARD_LOCK:-/tmp/.wq-drift-guard.lock}
STATE=${WQ_DRIFT_GUARD_STATE:-/tmp/.wq-drift-guard.state}
BRANCH_STATE="$STATE.branch"
PRIMARY_TREE_GUARD=${PRIMARY_TREE_GUARD:-/home/lumen/foreman/harness/primary_tree_guard.py}

# ── one-at-a-time ──
exec 9>"$LOCKFILE"
flock -n 9 || exit 0

cd "$REPO" || { echo "wq-drift-guard: repo $REPO missing" >&2; exit 2; }

drift() {
    # exit 0 = drifted, exit 1 = clean
    git diff --quiet HEAD -- "$FILE" 2>/dev/null && return 1 || return 0
}

disk_hash() { sha256sum "$REPO/$FILE" 2>/dev/null | cut -d' ' -f1; }
git_hash()  { git show "HEAD:$FILE" 2>/dev/null | sha256sum | cut -d' ' -f1; }

# The tree's deployment branch: main, then master, else none — the same rule as
# harness/primary_tree_guard.py default_branch(), which owns the BRANCH fault.
default_branch() {
    local cand
    for cand in main master; do
        git rev-parse --verify --quiet "refs/heads/$cand" >/dev/null \
            && { echo "$cand"; return 0; }
    done
    return 1
}

current_branch() { git rev-parse --abbrev-ref HEAD 2>/dev/null; }

# exit 0 = the repo is parked off its default branch. A detached HEAD reports as
# "HEAD" and counts too: it is equally not the reviewed branch.
on_branch() {
    local cur def
    def=$(default_branch) || return 1
    cur=$(current_branch)
    [ -n "$cur" ] && [ "$cur" != "$def" ]
}

alert() {
    local msg="$1" title="${2:-wq DRIFT DETECTED}"
    echo "$msg" >&2
    ntfy-send -t "$NTFY_TOPIC" -p urgent -T "$title" "$msg" 2>/dev/null || true
}

branch_msg() {
    local cur def
    cur=$(current_branch); def=$(default_branch)
    echo "$REPO is parked on '$cur', not '$def' — HEAD is not reviewed code, so every tool deployed from $REPO is running branch code (wq#900 class). This is NOT a $FILE clobber and --fix will not touch it. Move the branch work into a worktree (lumen-pr start $REPO <branch> --worktree), then: python3 $PRIMARY_TREE_GUARD check"
}

ARG="${1-}"
case "${ARG#--}" in
    status)
        if on_branch; then
            echo "BRANCH — $REPO on '$(current_branch)', default '$(default_branch)'"
            drift && echo "  ($FILE also differs from that branch's HEAD — still a BRANCH fault, not a clobber)"
            exit 4
        fi
        if drift; then
            echo "DRIFTED — disk=$(disk_hash) git=$(git_hash)"
            echo "  git diff HEAD -- $FILE:"
            git diff --stat HEAD -- "$FILE"
            exit 1
        else
            echo "CLEAN — $(disk_hash)"
            exit 0
        fi
        ;;
    fix)
        # BRANCH first: on a feature branch `git checkout HEAD -- $FILE` would deploy
        # the branch's $FILE over the disk copy and call the tree fixed.
        if on_branch; then
            echo "REFUSING --fix: $(branch_msg)"
            exit 4
        fi
        if ! drift; then echo "already clean"; exit 0; fi
        FORCE="${2-}"

        # wq#1030: NEVER discard the on-disk copy without preserving it first.
        # A prior version ran `git checkout HEAD -- $FILE` unconditionally,
        # which silently destroys real uncommitted work whenever disk is
        # AHEAD of HEAD (a shipped-but-uncommitted fix), not just when disk
        # is a stale/reverted copy (the wq#886 case this guard exists for).
        BACKUP_DIR="/home/lumen/backups/wq-drift-guard"
        mkdir -p "$BACKUP_DIR"
        cur_hash=$(disk_hash)
        ts=$(date +%Y%m%d_%H%M%S)
        backup_file="$BACKUP_DIR/${FILE}.disk.${ts}.${cur_hash:0:12}.bak"
        cp -p "$REPO/$FILE" "$backup_file"
        echo "preserved current disk copy -> $backup_file"

        # Classify the drift: if disk's diff against HEAD is pure addition
        # (0 deletions), disk looks like ahead-with-uncommitted-work, not a
        # stale/reverted copy — refuse to auto-revert and surface it for a
        # human instead. `--fix --force` overrides (still backed up above).
        del_count=$(git diff --numstat HEAD -- "$FILE" 2>/dev/null | awk '{print $2+0}')
        if [ "${del_count:-0}" -eq 0 ] && [ "$FORCE" != "--force" ]; then
            echo "REFUSING auto-revert: disk is a pure superset of git HEAD (0 deletions vs HEAD)."
            echo "This looks like uncommitted legitimate work (wq#1030 class), not a stale/reverted copy."
            echo "Your disk copy is safe — nothing was touched. Backup also saved at: $backup_file"
            echo "  Review the diff below, then either commit it:"
            echo "    cd $REPO && git add $FILE && git commit -m 'fix($FILE): <describe>'"
            echo "  or, if you're SURE disk should be discarded:"
            echo "    wq-drift-guard --fix --force"
            git diff HEAD -- "$FILE"
            alert "wq-drift-guard: drift on $FILE looks like UNCOMMITTED WORK — NOT auto-reverted. Backup: $backup_file. Review: git -C $REPO diff HEAD -- $FILE"
            exit 3
        fi

        echo "restoring $FILE from git HEAD (disk copy preserved at $backup_file)..."
        git checkout HEAD -- "$FILE"
        chmod +x "$FILE"
        echo "restored — $(disk_hash)"
        echo "clean" > "$STATE"
        ;;
    check|"")
        if on_branch; then
            # Own alert title and own dedup record: one alert per (repo, wrong branch)
            # episode, independent of the $FILE-clobber record so neither mutes the other.
            cur_branch=$(current_branch)
            prev_branch=""
            [ -f "$BRANCH_STATE" ] && prev_branch=$(cat "$BRANCH_STATE" 2>/dev/null)
            if [ "$cur_branch" != "$prev_branch" ]; then
                echo "$cur_branch" > "$BRANCH_STATE"
                alert "$(branch_msg)" "wq REPO OFF DEFAULT BRANCH"
            else
                echo "BRANCH — $REPO on '$cur_branch' (already alerted)" >&2
            fi
            exit 4
        fi
        [ -f "$BRANCH_STATE" ] && rm -f "$BRANCH_STATE"
        if ! drift; then
            # clean — clear any prior alert state
            [ -f "$STATE" ] && rm -f "$STATE"
            exit 0
        fi
        # drifted — alert once per drift episode
        cur_hash=$(disk_hash)
        prev_hash=""
        [ -f "$STATE" ] && prev_hash=$(cat "$STATE" 2>/dev/null)
        if [ "$cur_hash" = "$prev_hash" ]; then
            # already alerted for this exact drift — don't spam
            exit 1
        fi
        echo "$cur_hash" > "$STATE"
        alert "wq on disk (${cur_hash:0:12}…) != git HEAD ($(git_hash | cut -c1-12)…). A lane likely clobbered it. Run: wq-drift-guard --fix OR git -C $REPO checkout HEAD -- $FILE"
        exit 1
        ;;
    *)
        echo "usage: wq-drift-guard [--status|--fix|--check]" >&2
        echo "exit: 0 clean, 1 CLOBBER, 2 usage/repo error, 3 fix refused (uncommitted work), 4 BRANCH" >&2
        exit 2
        ;;
esac