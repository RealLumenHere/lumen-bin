#!/usr/bin/env python3
"""
ui-inventory (wq#770) — derive the live service inventory from what is ACTUALLY
running, and render the generated sections of the dashboards from it.

SOURCES OF TRUTH (all read-only):
  - /etc/cloudflared/config.yml   ingress hostname -> local origin
  - docker ps                     running containers
  - systemctl                     lumen-*.service units
  - ss -ltn                       local listeners
  - fleet inventory (machines/*.yaml, MONITORED)   fleet nodes  (wq#1456)

The ONLY hand-maintained data here is PRESENTATION metadata (title/group) and
the INFRA set (hostnames that are machine endpoints, not user-facing links).
A hostname nobody has classified still lands on the dashboard under "Services"
— new services appear by default, they are never silently dropped.

Writes: /home/lumen/sentinel/ui_inventory.json
Usage:  ui-inventory [--json] [--emit-glance] [--write-glance]
"""
import json, os, re, subprocess, sys, datetime, shutil
from pathlib import Path

CF_CONFIG   = Path("/etc/cloudflared/config.yml")
GLANCE_YML  = Path("/home/lumen/glance/glance.yml")
MC_LINKS_TS = Path("/home/lumen/mission-control/ui/src/lib/api.ts")
OUT_JSON    = Path("/home/lumen/sentinel/ui_inventory.json")

# wq#1456: fleet nodes come from the fleet inventory, not a lumen_state scrape.
FLEET_INVENTORY_DIR = os.environ.get("FLEET_INVENTORY_DIR", "/home/lumen/fleet/inventory")
sys.path.insert(0, FLEET_INVENTORY_DIR)
import fleet_inventory as inv  # noqa: E402

# Machine endpoints — real services, deliberately NOT dashboard links.
# Adding a hostname here is a deliberate act; anything not listed is user-facing.
