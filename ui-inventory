PRESENTATION = {
    "qbit.lumennode.uk":      ("qBittorrent", "Media",        False),
    "plex.lumennode.uk":      ("Plex",        "Media",        False),
    "projects.lumennode.uk":  ("Projects",    "Productivity", False),
    "actual.lumennode.uk":    ("Actual Budget","Productivity",False),
    "n8n.lumennode.uk":       ("n8n",         "Productivity", False),
    "vault.lumennode.uk":     ("Vaultwarden", "Productivity", False),
    "scribe.lumennode.uk":    ("Scribe",      "Productivity", True),
    "langfuse.lumennode.uk":  ("Langfuse",    "AI & Chat",    False),
    "chat.lumennode.uk":      ("Chat",        "AI & Chat",    True),
    "pokemon.lumennode.uk":   ("Lumen Plays Pokemon", "AI & Chat", False),
    "mctl.lumennode.uk":      ("Mission Control", "AI & Chat", False),
    "propose.lumennode.uk":   ("Proposals",   "AI & Chat",    True),
    "beszel.lumennode.uk":    ("Beszel",      "Monitoring",   False),
    "analytics.lumennode.uk": ("Analytics",   "Monitoring",   False),
    "power.lumennode.uk":     ("Power",       "Monitoring",   False),
    "status.lumennode.uk":    ("Status",      "Monitoring",   True),
    "ntfy.lumennode.uk":      ("ntfy",        "Monitoring",   True),
    "bench.lumennode.uk":     ("Bench",       "Monitoring",   True),
