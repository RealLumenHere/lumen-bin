    "mcp-backend.lumennode.uk", "postgres-mcp.lumennode.uk",
    "postgres-mcp-plausible.lumennode.uk", "memory-mcp.lumennode.uk",
    "copilot.lumennode.uk", "vip.lumennode.uk",
    # the dashboard itself — a self-link is noise, not a service link
    "home.lumennode.uk",
}

