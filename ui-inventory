GROUP_ORDER = ["Media", "Productivity", "AI & Chat", "Monitoring", "Services"]

# Deep links: the hostname root is not the useful landing page.
URL_OVERRIDE = {
    "plex.lumennode.uk": "https://plex.lumennode.uk/web",
    "status.lumennode.uk": "https://status.lumennode.uk/webapp_login",
}


def sh(cmd, timeout=30):
    try:
        r = subprocess.run(cmd, shell=isinstance(cmd, str), capture_output=True,
                           text=True, timeout=timeout)
        return r.returncode, (r.stdout or "").strip(), (r.stderr or "").strip()
    except Exception as e:
        return None, "", f"{type(e).__name__}: {e}"


def discover_ingress():
    import yaml
    # wq#3668: cloudflared config is world-readable (644 root:root), no sudo needed
    rc, out, err = sh(["cat", str(CF_CONFIG)])
    if rc != 0 or not out:
        try:
            out = CF_CONFIG.read_text()
        except Exception:
            return [], f"cloudflared config unreadable: {err}"
    doc = yaml.safe_load(out) or {}
    rows = []
    for e in doc.get("ingress", []) or []:
        h = e.get("hostname")
        if not h:
            continue
        rows.append({
            "hostname": h,
            "origin": e.get("service", ""),
            "public_url": f"https://{h}",
            "infra": h in INFRA_HOSTS,
            "retired": h in RETIRED_HOSTS,
        })
    return rows, None


def discover_containers():
    rc, out, _ = sh(["docker", "ps", "--format",
                     "{{.Names}}\t{{.Image}}\t{{.Ports}}\t{{.Status}}"])
    rows = []
    for line in (out or "").splitlines():
        p = line.split("\t")
        if len(p) >= 4:
            rows.append({"name": p[0], "image": p[1], "ports": p[2], "status": p[3]})
    return rows


def discover_units():
    rc, out, _ = sh("systemctl list-units --type=service --all --no-legend --no-pager "
                    "'lumen-*.service' | awk '{print $1, $3, $4}'")
    rows = []
    for line in (out or "").splitlines():
        p = line.split()
        if len(p) >= 3 and p[0].endswith(".service"):
            rows.append({"unit": p[0], "active": p[1], "sub": p[2]})
    return rows


def discover_listeners():
    rc, out, _ = sh("ss -ltn | tail -n +2 | awk '{print $4}'")
    ports = set()
    for a in (out or "").splitlines():
        m = re.search(r":(\d+)$", a.strip())
        if m:
            ports.add(int(m.group(1)))
    return sorted(ports)


def discover_nodes():
    """wq#1456: fleet nodes come from the fleet inventory (DESIGN_SOT.md), MONITORED() only, so a
    decommissioned or parked box never reaches a dashboard. Same keys as the old lumen_state
    scrape (tailscale_ip, lan_ip, role, status, hardware) so downstream readers are unchanged."""
    try:
        recs = inv.monitored()
    except inv.InventoryError as e:
        print(f"ui-inventory: inventory unreadable and no last-good roster: {e}", file=sys.stderr)
        return {}
    nodes = {}
    for rec in recs:
        net, st, ident = rec.get("network") or {}, rec.get("status") or {}, rec.get("identity") or {}
        nodes[ident["name"]] = {
            "tailscale_ip": inv._clean(net.get("tailscale_ip")) or "",
            "lan_ip": inv._clean(net.get("lan_ip")) or "",
            "role": ", ".join(rec.get("roles") or []),
            "status": st.get("status", ""),
            "hardware": inv._clean(ident.get("make_model")) or "",
        }
    return nodes


HOST_RE = re.compile(r"https?://([a-z0-9.\-]+\.lumennode\.uk)[^\s\"'<>)]*", re.I)
URL_RE = re.compile(r"https?://[^\s\"'<>)]+", re.I)


def discover_dashboard_links():
    """Every link the dashboards actually present, with where it came from."""
    links = []
    try:
        txt = GLANCE_YML.read_text()
    except Exception:
        txt = ""
    section = "glance"
    for i, line in enumerate(txt.splitlines(), 1):
        if re.search(r"^\s*-\s*name:\s*(.+)$", line):
            section = "glance:" + re.search(r"^\s*-\s*name:\s*(.+)$", line).group(1).strip()
        for u in URL_RE.findall(line):
            u = u.rstrip(',"\'')
            if "localhost:5959/assets" in u:
                continue
            links.append({"source": section, "line": i, "url": u,
                          "kind": "feed" if (".rss" in u or "atom" in u or "feed" in u)
                          else "link"})
    try:
        ts = MC_LINKS_TS.read_text()
        for m in re.finditer(r"label:\s*'([^']+)',\s*href:\s*'([^']+)'", ts):
            links.append({"source": "mission-control", "line": 0,
                          "url": m.group(2), "kind": "link", "label": m.group(1)})
    except Exception:
        pass
    return links


def build():
    ingress, ierr = discover_ingress()
    inv = {
        "generated_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "ingress": ingress,
        "ingress_error": ierr,
        "containers": discover_containers(),
        "units": discover_units(),
        "listeners": discover_listeners(),
        "nodes": discover_nodes(),
        "dashboard_links": discover_dashboard_links(),
        "infra_hosts": sorted(INFRA_HOSTS),
        "retired_hosts": RETIRED_HOSTS,
    }
    return inv


BEGIN_MARK = "          # BEGIN GENERATED SERVICES (ui-inventory wq#770)"
END_MARK   = "          # END GENERATED SERVICES (ui-inventory wq#770)"


def presentable(inv):
    """(title, group, drawer) for every user-facing ingress hostname."""
    rows = []
    for e in inv["ingress"]:
        h = e["hostname"]
        if e["infra"] or e["retired"]:
            continue
        title, group, drawer = PRESENTATION.get(h, (None, None, False))
        if title is None:
            title = h.split(".")[0].capitalize()
        if group is None:
            group = "Services"
        rows.append({"hostname": h, "title": title, "group": group,
                     "drawer": drawer,
                     "url": URL_OVERRIDE.get(h, e["public_url"])})
    return rows


def render_glance_block(inv):
    rows = presentable(inv)
    main = [r for r in rows if not r["drawer"]]
    drawer = sorted([r for r in rows if r["drawer"]], key=lambda r: r["title"].lower())
    out = [BEGIN_MARK,
           "          # Generated from cloudflared ingress + docker/systemd discovery.",
           "          # Do not hand-edit: run `ui-inventory --write-glance`.",
           "          # Hand-written widgets OUTSIDE these markers survive regeneration.",
           "          - type: bookmarks",
           "            title: Lumen Services",
           "            groups:"]
    for g in GROUP_ORDER:
        items = sorted([r for r in main if r["group"] == g], key=lambda r: r["title"].lower())
        if not items:
            continue
        out.append(f"              - title: {g}")
        out.append("                links:")
        for r in items:
            out.append(f"                  - title: {r['title']}")
            out.append(f"                    url: {r['url']}")
    out += ["",
            "          - type: custom-api",
            "            cache: 24h",
            "            url: http://localhost:5959/assets/other.json",
            "            template: |",
            '              <details class="other-drawer">',
            '                <summary class="color-subdue">Other</summary>',
            '                <div class="other-drawer-links">']
    for r in drawer:
        out.append(f'                  <a class="color-highlight" href="{r["url"]}" '
                   f'target="_blank" rel="noreferrer">{r["title"]}</a>')
    out += ['                </div>', '              </details>', END_MARK]
    return "\n".join(out)


def write_glance(inv, dry=False):
    import yaml
    txt = GLANCE_YML.read_text()
    lines = txt.splitlines()
    try:
        b = next(i for i, l in enumerate(lines) if "BEGIN GENERATED SERVICES" in l)
        e = next(i for i, l in enumerate(lines) if "END GENERATED SERVICES" in l)
    except StopIteration:
        print("REFUSED: generation markers not found in glance.yml.\n"
              "  Add these two lines around the Lumen Services + Other drawer widgets:\n"
              f"{BEGIN_MARK}\n{END_MARK}", file=sys.stderr)
        return 2
    if e < b:
        print("REFUSED: END marker precedes BEGIN marker.", file=sys.stderr)
        return 2
    new = lines[:b] + render_glance_block(inv).splitlines() + lines[e + 1:]
    cand = "\n".join(new) + "\n"
    try:
        yaml.safe_load(cand)
    except Exception as ex:
        print(f"REFUSED: generated glance.yml does not parse: {ex}", file=sys.stderr)
        return 3
    if cand == txt:
        print("glance.yml already current — no write.")
        return 0
    if dry:
        print(cand)
        return 0
    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    shutil.copy2(GLANCE_YML, f"{GLANCE_YML}.bak.{stamp}")
    GLANCE_YML.write_text(cand)
    print(f"glance.yml regenerated (backup {GLANCE_YML}.bak.{stamp}). "
          "Restart the glance container to apply.")
    return 0


def main():
    args = sys.argv[1:]
    inv = build()
    OUT_JSON.parent.mkdir(parents=True, exist_ok=True)
    OUT_JSON.write_text(json.dumps(inv, indent=2))
    if "--emit-glance" in args:
        print(render_glance_block(inv))
        return 0
    if "--write-glance" in args:
        return write_glance(inv, dry="--dry-run" in args)
    if "--json" in args:
        print(json.dumps(inv, indent=2))
        return 0
    rows = presentable(inv)
    print(f"ui-inventory {inv['generated_at']}")
    print(f"  ingress hostnames : {len(inv['ingress'])} "
          f"({sum(1 for e in inv['ingress'] if e['infra'])} infra, {len(rows)} user-facing)")
    print(f"  containers        : {len(inv['containers'])}")
    print(f"  lumen-* units     : {len(inv['units'])}")
    print(f"  listeners         : {len(inv['listeners'])}")
    print(f"  fleet nodes       : {len(inv['nodes'])}")
    print(f"  dashboard links   : {len(inv['dashboard_links'])}")
    print(f"  -> {OUT_JSON}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
