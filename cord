#!/usr/bin/env python3
"""cord — ask Frank for a value and get it back, without a terminal prompt.

  cord request "hathor sudo password" --note "needed to install the drop-in"
      -> pages Frank, blocks until he pastes it, prints the value on stdout

  cord get "hathor sudo password"     # take something Frank already sent
  cord status <id>                    # is it filled yet
  cord await <id>                     # block on an existing request

The value goes to stdout and nowhere else. Never echo it into a log, a journal
line, a ticket, or a chat message.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE = os.environ.get("CORD_URL", "http://127.0.0.1:8152")
TOKEN_PATH = os.environ.get("CORD_TOKEN", "/home/lumen/.secrets/cord-service.token")


def token() -> str:
    try:
        with open(TOKEN_PATH) as fh:
            return fh.read().strip()
    except OSError as exc:
        sys.exit(f"cord: cannot read service token: {exc}")


def call(method: str, path: str, payload=None, timeout: int = 60):
    url = BASE.rstrip("/") + path
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", "Bearer " + token())
    if data:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        raise SystemExit(f"cord: {exc.code} {body}")
    except urllib.error.URLError as exc:
        raise SystemExit(f"cord: cannot reach {BASE}: {exc.reason}")


def poll(drop_id: str, wait: int) -> str:
    """Long-poll in chunks so a proxy idle timeout can't kill the whole wait."""
    left = wait
    while left > 0:
        chunk = min(left, 120)
        url = f"/api/await/{drop_id}?timeout={chunk}"
        try:
            return call("GET", url, timeout=chunk + 20)["value"]
        except SystemExit as exc:
            if "408" in str(exc):
                left -= chunk
                continue
            raise
    raise SystemExit(f"cord: {drop_id} still unanswered after {wait}s")


def main():
    ap = argparse.ArgumentParser(prog="cord")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("request", help="ask Frank for a value")
    p.add_argument("label")
    p.add_argument("--note", default="", help="why you need it — Frank sees this")
    p.add_argument("--as", dest="requester",
                   default=os.environ.get("WQ_AGENT", "agent"))
    p.add_argument("--ttl", type=int, default=60, help="minutes before it expires")
    p.add_argument("--wait", type=int, default=900,
                   help="seconds to block; 0 returns the id immediately")
    p.add_argument("--keep", action="store_true",
                   help="do not burn on read (reusable)")

    g = sub.add_parser("get", help="take something already sent")
    g.add_argument("label")

    a = sub.add_parser("await", help="block on an existing request")
    a.add_argument("id")
    a.add_argument("--wait", type=int, default=900)

    s = sub.add_parser("status", help="check a request")
    s.add_argument("id")

    sub.add_parser("health", help="is cord up")
    args = ap.parse_args()


    if args.cmd == "request":
        res = call("POST", "/api/request", {
            "label": args.label, "note": args.note, "requester": args.requester,
            "ttl_min": args.ttl, "burn": not args.keep,
        })
        if args.wait <= 0:
            print(res["id"])
            return
        print(f"cord: asked Frank for {args.label!r} ({res['id']}), waiting…",
              file=sys.stderr)
        sys.stdout.write(poll(res["id"], args.wait))
        return

    if args.cmd == "await":
        sys.stdout.write(poll(args.id, args.wait))
        return

    if args.cmd == "get":
        res = call("GET", "/api/get?" + urllib.parse.urlencode({"label": args.label}))
        sys.stdout.write(res["value"])
        return

    if args.cmd == "status":
        res = call("GET", f"/api/status/{args.id}")
        print(f"{res['id']}  {res['status']}  {res['label']}  expires {res['expires_at']}")
        return

    if args.cmd == "health":
        req = urllib.request.Request(BASE.rstrip("/") + "/healthz")
        with urllib.request.urlopen(req, timeout=10) as resp:
            print(resp.read().decode())


if __name__ == "__main__":
    main()
