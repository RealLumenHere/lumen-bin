#!/usr/bin/env python3
"""secret-backup-sweep (wq#4599) - find, classify and retire secret-bearing backup files.

WHY: pre-rotation backups (agent/.env.bak.*, gate-snapshot pre-images, *.bak.* beside a secret) outlive the
rotation that made them. wq#4550: a Gitea token stayed LIVE for 50 days in backups after it had left the real
env. This tool answers, per backup and WITHOUT printing a value: is every secret in it either still in use /
identical to a live value (nothing unique to lose) or proven dead? Only then is the backup shredded.

NEVER prints a secret. Output carries key names, 12-char sha256 fingerprints and verdicts only.

  secret-backup-sweep report  [--json] [--no-probe] [--ttl DAYS] [--aq]   classify every backup (read-only)
  secret-backup-sweep apply   [--confirm] [--ttl DAYS]                      shred ELIGIBLE+expired backups (dry-run without --confirm)
  secret-backup-sweep scan    [--ttl DAYS]                                  offline: count overdue secret-bearing backups (exit 1 if any)
  secret-backup-sweep register PATH [--ttl 7d] [--owner X] [--why T]        record an expiry for a backup (best-effort, exit 0)
  secret-backup-sweep timer                                                 what the systemd timer runs (apply if armed, else report --aq)

Per-value classes   OK (shreddable): REDUNDANT (same key, same value as the live file)  IN_USE (value is live in ANY live
                    source, e.g. renamed key)  REVOKED (probe rejected it)  DEAD_SERVICE (its service was retired)
                    DEAD_VERIFIER (verifier is down AND the value is in no live config)
                    NOT OK: LIVE (authenticates but is in no live source = orphan)  UNPROVEN:<why> (kept)
Verdicts per backup ELIGIBLE (all values OK)  HOLD (>=1 UNPROVEN, kept)  ORPHAN_LIVE (>=1 LIVE, kept, aq HIGH)
Probe controls      a probe class is trusted only if a CURRENT credential is accepted AND a random value is rejected in
                    the same run. Otherwise everything that probe touches stays UNPROVEN.
Age                 max(mtime, ctime, filename stamp, registry): `cp -a` keeps the SOURCE mtime, so mtime alone would make
                    a backup made a minute ago look weeks old. apply refuses while a rotation journal (*.inprogress) exists.
Auto-apply is OFF until ~/.maint-ops/secret-backup-sweep.auto exists (same latch convention as bin-drift-rescue).
"""
import argparse, datetime as dt, fcntl, glob, hashlib, json, os, re, secrets as _rnd, socket, subprocess, sys, time
import urllib.error, urllib.request
from urllib.parse import urlsplit, unquote

HOME = os.environ.get("SBS_HOME", "/home/lumen")
REGISTRY = os.path.join(HOME, ".secrets", ".backup-registry.jsonl")
LATCH = os.path.join(HOME, ".maint-ops", "secret-backup-sweep.auto")
LOG = os.path.join(HOME, "logs", "secret-backup-sweep.log")
VAULT = os.path.join(HOME, ".secrets", "gate-snapshots")
DEFAULT_TTL = 7
OK = {"REDUNDANT", "IN_USE", "REVOKED", "DEAD_SERVICE", "DEAD_VERIFIER"}
SHIM_ADDR = ("127.0.0.1", 8091)

SEC_KEY = re.compile(r"(KEY|TOKEN|SECRET|PASS|PASSWORD|DSN|DATABASE_URL|CREDENTIAL|AUTH)", re.I)
STRONG = re.compile(r"(sk-[A-Za-z0-9_\-]{20,}|ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|gh[osu]_[A-Za-z0-9]{30,}"
                    r"|cfat_[A-Za-z0-9_\-]{20,}|cfut_[A-Za-z0-9_\-]{20,}|glpat-[A-Za-z0-9_\-]{20}|AKIA[0-9A-Z]{16}"
                    r"|\b[0-9a-f]{40}\b|\b[0-9a-f]{64}\b)")
KV = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*?)\s*$")   # strict env syntax: `key = "x"` in source code is not a credential
KV_LOOSE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*[=:]\s*(.*?)\s*$")
URLFULL = re.compile(r"[A-Za-z][A-Za-z0-9+.\-]*://([^/\s:@]+):([^/\s@]+)@([^/\s]+)")
PLAINURL = re.compile(r"^[a-z][a-z0-9+.\-]*://[^@\s]*$", re.I)
VAULT_NAME = re.compile(r"(_\.env|\.env|\.token|\.key|\.pem|credentials|\.secrets?[A-Za-z0-9_.\-]*)$")
VAULT_SKIP = re.compile(r"^(enforce-conditions-|tier-medium-)")
CODE_RX = re.compile(r"\.(py|sh|bash|js|mjs|ts|go|rb|php|pl|service|timer|md|html|css)(\.bak[\w.\-]*)?$", re.I)
STAMP = re.compile(r"(20\d{2})(\d{2})(\d{2})[_T](\d{2})(\d{2})(\d{2})")


def fp(v):
    return hashlib.sha256(v.encode()).hexdigest()[:12]


def say(m):
    print(m, flush=True)


# ---------------------------------------------------------------- parsing
def parse_env(path):
    out = {}
    try:
        for ln in open(path, errors="replace"):
            if ln.lstrip().startswith("#"):
                continue
            m = KV.match(ln)
            if m:
                out[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def extract(path):
    """[{key,value,[pw,host]}] of secret-shaped values in one file. Env-style, URL-credential and bare-token files."""
    try:
        text = open(path, errors="replace").read()
    except OSError:
        return []
    env, items = parse_env(path), []
    if CODE_RX.search(os.path.basename(path)):
        # source code: `key=...` assignments are not credentials; only an actual credential-shaped literal counts
        return [{"key": "literal", "value": m.group(1)} for m in STRONG.finditer(text)]
    for k, v in env.items():
        if not v:
            continue
        m = URLFULL.search(v)
        if m:
            items.append({"key": k, "value": v, "pw": m.group(2), "host": m.group(3)}); continue
        if PLAINURL.match(v):
            continue
        if (SEC_KEY.search(k) and len(v) >= 12 and not v.startswith("/") and not re.fullmatch(r"[\d.]+|true|false", v, re.I)) or STRONG.search(v):
            items.append({"key": k, "value": v})
    if not env:
        for m in URLFULL.finditer(text):
            items.append({"key": "url-credential", "value": m.group(2), "pw": m.group(2), "host": m.group(3)})
        t = text.strip()
        if not items and t and len(t) <= 512 and not re.search(r"\s", t) and (STRONG.search(t) or len(t) >= 24):
            items.append({"key": "token", "value": t})
    return items


def values_in_text(text):
    for ln in text.splitlines():
        if ln.lstrip().startswith("#"):
            continue
        m = KV_LOOSE.match(ln)
        if m:
            v = m.group(2).strip().strip('"').strip("'")
            yield m.group(1), v
            u = URLFULL.search(v)
            if u:
                yield "pw", u.group(2)
        for u in URLFULL.finditer(ln):
            yield "pw", u.group(2)
        for s in STRONG.finditer(ln):
            yield "literal", s.group(1)
        if not m and re.fullmatch(r"\S{20,}", ln.strip()):
            yield "bare", ln.strip()


# ---------------------------------------------------------------- live index (what is genuinely in use right now)
def live_index():
    idx, creds = {}, {"gitea": [], "github": [], "cfuser": []}
    files = [os.path.join(HOME, "agent", ".env"), os.path.join(HOME, ".git-credentials"), os.path.join(HOME, "agent", "litellm_config.yaml"),
             os.path.join(HOME, "minerva", "context", "claude_credentials.md")]
    for p in glob.glob(os.path.join(HOME, ".secrets", "**", "*"), recursive=True) + glob.glob(os.path.join(HOME, ".secrets", ".*")):
        b = os.path.basename(p)
        if os.path.isfile(p) and "gate-snapshots" not in p and ".bak" not in b and "inprogress" not in b and not b.startswith(".backup-registry") \
                and os.path.getsize(p) < 20000:
            files.append(p)
    for p in files:
        try:
            text = open(p, errors="replace").read()
        except OSError:
            continue
        lab = os.path.basename(p)
        for _, v in values_in_text(text):
            if v:
                idx.setdefault(fp(v), []).append(lab)
        for u in URLFULL.finditer(text):
            h = u.group(3).lower()
            if "github.com" in h:
                creds["github"].append(u.group(2))
            elif "100.121.17.5" in h or "3000" in h:
                creds["gitea"].append(unquote(u.group(2)))
        if "gitea" in lab.lower() and lab.endswith(".token"):
            creds["gitea"].append(text.strip())
        creds["github"] += [s.group(1) for s in re.finditer(r"(ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})", text)]
        creds["cfuser"] += [s.group(1) for s in re.finditer(r"(cfut_[A-Za-z0-9_\-]{20,})", text)]
    if not os.environ.get("SBS_NO_DOCKER"):
        try:
            names = subprocess.run(["docker", "ps", "--format", "{{.Names}}"], capture_output=True, text=True, timeout=15).stdout.split()
            for n in names:
                env = subprocess.run(["docker", "inspect", n, "--format", "{{range .Config.Env}}{{println .}}{{end}}"],
                                     capture_output=True, text=True, timeout=15).stdout
                for _, v in values_in_text(env):
                    if v:
                        idx.setdefault(fp(v), []).append("container:" + n)
        except Exception:
            pass
    return idx, creds


# ---------------------------------------------------------------- targets / age / registry
def counterpart(path):
    b = os.path.basename(path)
    if b.startswith(".env.bak."):
        return os.path.join(os.path.dirname(path), ".env")
    if ".bak." in b:
        return os.path.join(os.path.dirname(path), b.split(".bak.")[0])
    if b.endswith("home_lumen_agent_.env"):
        return os.path.join(HOME, "agent", ".env")
    return None


def targets():
    t = set(glob.glob(os.path.join(HOME, "agent", ".env.bak.*")))
    t |= set(glob.glob(os.path.join(HOME, ".secrets", "*.bak.*")))
    t |= set(glob.glob(os.path.join(HOME, ".secrets", "**", "*.bak.*"), recursive=True))
    t |= set(glob.glob(os.path.join(HOME, ".git-credentials.bak*")))
    for p in glob.glob(os.path.join(VAULT, "*")):
        b = os.path.basename(p)
        if VAULT_NAME.search(b) and not VAULT_SKIP.match(b) and not b.endswith(".held-out"):
            t.add(p)
    return sorted(x for x in t if os.path.isfile(x) and not os.path.islink(x))


def born(path):
    """Latest evidence of when this copy came to exist. ctime cannot be backdated (cp -a keeps the source mtime)."""
    st, t = os.stat(path), [os.path.getmtime(path)]
    t.append(st.st_ctime)
    m = STAMP.search(os.path.basename(path))
    if m:
        try:
            t.append(time.mktime(tuple(int(x) for x in m.groups()) + (0, 0, -1)))
        except (ValueError, OverflowError):
            pass
    return max(t)


def load_registry():
    reg = {}
    try:
        for ln in open(REGISTRY):
            try:
                r = json.loads(ln); reg[r["path"]] = r
            except (ValueError, KeyError):
                continue
    except OSError:
        pass
    return reg


def register(path, ttl_days, owner, why):
    try:
        os.makedirs(os.path.dirname(REGISTRY), exist_ok=True, mode=0o700)
        now = dt.datetime.now(dt.timezone.utc)
        rec = {"path": os.path.abspath(path), "registered_at": now.isoformat(timespec="seconds"),
               "expires_at": (now + dt.timedelta(days=ttl_days)).isoformat(timespec="seconds"),
               "owner": owner or os.environ.get("WQ_AGENT", "?"), "why": why or ""}
        fd = os.open(REGISTRY, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.write(json.dumps(rec) + "\n")
        return True
    except Exception as e:  # registering must never break the caller
        print("secret-backup-sweep register: %s" % e, file=sys.stderr)
        return False


def expiry_of(path, reg, ttl_days):
    """Never earlier than born()+ttl, even if a registry entry says sooner (a stale entry must not shorten the life of a new copy)."""
    base = born(path) + ttl_days * 86400
    r = reg.get(os.path.abspath(path))
    if r:
        try:
            return max(base, dt.datetime.fromisoformat(r["expires_at"]).timestamp()), True
        except ValueError:
            pass
    return base, False


def rotation_in_progress():
    d = os.path.join(HOME, ".secrets")
    try:
        return [n for n in os.listdir(d) if "inprogress" in n]
    except OSError:
