# ---------------------------------------------------------------- probes: probe(ctx, value) -> live|revoked|unreachable|error
def _http(url, headers, timeout=6):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=timeout) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except (urllib.error.URLError, OSError, socket.timeout):
        return None


def _bearer(fmt):
    def probe(ctx, value):
        code = _http(ctx["base"], {"Authorization": fmt % value, "User-Agent": "secret-backup-sweep"})
        return "live" if code == 200 else "revoked" if code in (401, 403) else "unreachable" if code is None else "error"
    return probe


def probe_pg(ctx, value):
    try:
        import psycopg2
    except ImportError:
        return "error"
    try:
        psycopg2.connect(host=ctx["host"], port=ctx["port"], user=ctx["user"], dbname=ctx["db"], password=value, connect_timeout=5).close()
        return "live"
    except psycopg2.OperationalError as e:
        return "revoked" if "authentication failed" in str(e).lower() else "unreachable"
    except Exception:
        return "error"


PROBES = {"gitea": _bearer("token %s"), "github": _bearer("Bearer %s"), "litellm": _bearer("Bearer %s"),
          "shim": _bearer("Bearer %s"), "pg": probe_pg, "cfuser": _bearer("Bearer %s"), "litellm-sk": _bearer("Bearer %s")}
# a family whose "rejected" answer proves nothing (an sk- key may belong to some other provider): it can raise LIVE, never REVOKED
LIVE_ONLY = {"litellm-sk"}


def langfuse_dead(env_backup):
    """Langfuse was retired (wq#3912). Evidence: no langfuse container AND nothing langfuse-shaped answers."""
    try:
        names = subprocess.run(["docker", "ps", "-a", "--format", "{{.Names}} {{.Image}}"], capture_output=True, text=True, timeout=15).stdout.lower()
    except Exception:
        return None
    if "langfuse" in names:
        return None
    host = env_backup.get("LANGFUSE_HOST", "")
    if host:
        try:
            body = urllib.request.urlopen(urllib.request.Request(host.rstrip("/") + "/api/public/health"), timeout=5).read(300).decode(errors="replace").lower()
            if '"status"' in body and "ok" in body:
                return None
        except Exception:
            pass
    return True


_LF = {}


def langfuse_dead_cached(env_backup):
    k = env_backup.get("LANGFUSE_HOST", "")
    if k not in _LF:
        _LF[k] = langfuse_dead(env_backup)
    return _LF[k]


def port_refused(addr):
    try:
        socket.create_connection(addr, timeout=3).close()
        return False
    except ConnectionRefusedError:
        return True
    except OSError:
        return False


def family(it, path):
    k, b, host = it["key"].upper(), os.path.basename(path).lower(), it.get("host", "").lower()
    if k in ("GITHUB_TOKEN", "GH_TOKEN") or "github.com" in host:
        return "github"
    if ("GITEA" in k and "TOKEN" in k) or "100.121.17.5" in host or "3000" in host or (it["key"] == "token" and "gitea" in b):
        return "gitea"
    if ("LITELLM" in k and "KEY" in k) or (it["key"] == "token" and "litellm" in b):
        return "litellm"
    if k == "CLAUDE_SHIM_API_KEY":
        return "shim"
    if k in ("DATABASE_URL", "LUMEN_PGVECTOR_PASSWORD"):
        return "pg"
    # value-shape guesses come LAST: a key NAME that identifies its family always wins over a prefix
    v = it["value"]
    if v.startswith("cfut_"):
        return "cfuser"
    if v.startswith("sk-") and not v.startswith("sk-ant-"):
        return "litellm-sk"
    return None


def make_ctx(fam, it, live_env):
    if fam == "gitea":
        return {"base": (live_env.get("GITEA_URL") or "http://100.121.17.5:3000").rstrip("/") + "/api/v1/user"}, unquote(it.get("pw") or it["value"])
    if fam == "github":
        return {"base": "https://api.github.com/user"}, it.get("pw") or it["value"]
    if fam in ("litellm", "litellm-sk"):
        return {"base": "http://127.0.0.1:4000/v1/models"}, it["value"]
    if fam == "cfuser":
        return {"base": "https://api.cloudflare.com/client/v4/user/tokens/verify"}, it["value"]
    if fam == "shim":
        return {"base": "http://%s:%d/v1/models" % SHIM_ADDR}, it["value"]
    if fam == "pg":
        if it["key"].upper() == "DATABASE_URL" and it.get("pw") is not None:
            u = urlsplit(it["value"])
            host = "127.0.0.1" if u.hostname in ("lumen-pgvector", "localhost") else u.hostname
            port = 5433 if host == "127.0.0.1" and u.port in (None, 5432) else (u.port or 5432)
            return {"host": host, "port": port, "user": u.username, "db": (u.path or "/").lstrip("/")}, it["pw"]
        return {"host": live_env.get("LUMEN_PGVECTOR_HOST", "127.0.0.1"), "port": int(live_env.get("LUMEN_PGVECTOR_PORT", 5433)),
                "user": live_env.get("LUMEN_PGVECTOR_USER", "lumen"), "db": live_env.get("LUMEN_PGVECTOR_DB", "research")}, it["value"]
    return None, it["value"]


def control_values(fam, it, live_env, live_creds):
    if fam == "gitea":
        return [live_env.get("GITEA_TOKEN")] + live_creds["gitea"]
    if fam == "github":
        return live_creds["github"]
    if fam in ("litellm", "litellm-sk"):
        return [live_env.get("LITELLM_MASTER_KEY")]
    if fam == "cfuser":
        return live_creds["cfuser"]
    if fam == "shim":
        return [live_env.get("CLAUDE_SHIM_API_KEY")]
    if fam == "pg":
        v = live_env.get("DATABASE_URL" if it["key"].upper() == "DATABASE_URL" else "LUMEN_PGVECTOR_PASSWORD")
        m = URLFULL.search(v or "") if it["key"].upper() == "DATABASE_URL" else None
        return [m.group(2) if m else (None if it["key"].upper() == "DATABASE_URL" else v)]
    return []


class Prober:
    """Runs probes, trusting a (family, ctx) only after the controls pass."""
    def __init__(self, enabled=True):
        self.enabled, self.trust, self.calls = enabled, {}, 0

    def trusted(self, fam, ctx, controls):
        k = (fam, json.dumps(ctx, sort_keys=True))
        if k not in self.trust:
            fn = PROBES[fam]
            self.trust[k] = any(c and fn(ctx, c) == "live" for c in controls) and fn(ctx, _rnd.token_urlsafe(24)) == "revoked"
        return self.trust[k]

    def verdict(self, fam, ctx, value, controls):
        if not self.enabled:
            return "UNPROVEN:probe-off"
        if not self.trusted(fam, ctx, controls):
            return "UNPROVEN:%s-probe-controls-failed-or-service-down" % fam
        self.calls += 1
        r = PROBES[fam](ctx, value)
        if r == "revoked" and fam in LIVE_ONLY:
            return "UNPROVEN:%s-not-accepted-here-origin-unknown" % fam
        return {"live": "LIVE", "revoked": "REVOKED"}.get(r, "UNPROVEN:%s-%s" % (fam, r))


# ---------------------------------------------------------------- classification
def classify(path, prober, ttl_days, reg, live, live_creds):
    cp = counterpart(path)
    cur = parse_env(cp) if cp and os.path.isfile(cp) else {}
    live_env = parse_env(os.path.join(HOME, "agent", ".env"))
    bak = parse_env(path)
    is_lf = "langfuse" in os.path.basename(path).lower()
    vals = []
    for it in extract(path):
        key, value = it["key"], it["value"]
        shown = fp(it.get("pw") or value) if key in ("url-credential", "token") else fp(value)
        if key not in ("url-credential", "token") and cur.get(key) == value:
            v = "REDUNDANT"
        elif fp(value) in live or (it.get("pw") and fp(it["pw"]) in live):
            v = "IN_USE"
        elif is_lf or key.upper().startswith("LANGFUSE"):
            v = "DEAD_SERVICE" if langfuse_dead_cached(bak) else "UNPROVEN:langfuse-still-present"
        else:
            fam = family(it, path)
            if not fam:
                v = "UNPROVEN:no-probe-for-%s" % key
            else:
                ctx, pv = make_ctx(fam, it, live_env)
                v = prober.verdict(fam, ctx, pv, control_values(fam, it, live_env, live_creds))
                if fam == "shim" and v.startswith("UNPROVEN") and port_refused(SHIM_ADDR):
                    v = "DEAD_VERIFIER"
        vals.append((key, shown, v))
    exp, registered = expiry_of(path, reg, ttl_days)
    kinds = [v for _, _, v in vals]
    verdict = "ORPHAN_LIVE" if "LIVE" in kinds else "HOLD" if any(k.startswith("UNPROVEN") for k in kinds) else "ELIGIBLE" if kinds else "NO_SECRETS"
    return {"path": path, "verdict": verdict, "values": vals, "expired": time.time() >= exp, "registered": registered,
            "age_days": round((time.time() - born(path)) / 86400, 1), "counterpart": cp if cur else None}


def classify_all(args):
    reg, prober = load_registry(), Prober(enabled=not getattr(args, "no_probe", False))
    live, creds = live_index()
    return [classify(p, prober, args.ttl, reg, live, creds) for p in targets()], prober


def render(rows, as_json):
    if as_json:
        print(json.dumps(rows, indent=1)); return
    for r in rows:
        if r["verdict"] == "NO_SECRETS":
            continue
        cnt = {}
        for _, _, v in r["values"]:
            k = v.split(":")[0]; cnt[k] = cnt.get(k, 0) + 1
        say("%-12s %-5s age=%5sd exp=%-3s %-72s %s" % (r["verdict"], "reg" if r["registered"] else "unreg", r["age_days"],
            "YES" if r["expired"] else "no", os.path.basename(r["path"])[-72:], " ".join("%s=%d" % x for x in sorted(cnt.items()))))
        if r["verdict"] in ("ORPHAN_LIVE", "HOLD"):
            for k, f, v in r["values"]:
                if v.split(":")[0] not in OK:
                    say("    %-28s fp=%s  %s" % (k, f, v))


