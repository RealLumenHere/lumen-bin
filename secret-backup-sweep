    for r in rows:
        tally[r["verdict"]] = tally.get(r["verdict"], 0) + 1
    summary = "secret-backup-sweep: %s  probes=%d" % (", ".join("%s=%d" % x for x in sorted(tally.items())) or "no backups", pr.calls)
    print(summary, file=sys.stderr if a.json else sys.stdout, flush=True)  # keep --json stdout parseable
    if a.aq:
        for r in rows:
            if r["verdict"] == "ORPHAN_LIVE":
                ks = ",".join(k for k, _, v in r["values"] if v == "LIVE")
                aq_add(os.path.basename(r["path"]), "[sec] backup holds a LIVE credential absent from every live source: %s" % os.path.basename(r["path"]),
                       "keys=%s. Revoke at the provider, then run: secret-backup-sweep apply --confirm. Path: %s" % (ks, r["path"]))
        hold = [r for r in rows if r["verdict"] == "HOLD" and r["expired"]]
        if hold:
            aq_add("hold-overdue", "[sec] %d expired secret backups cannot be proven dead (kept)" % len(hold),
                   "run: secret-backup-sweep report  (unprovable keys listed with fingerprints, never values)")
    return 1 if any(r["verdict"] == "ORPHAN_LIVE" for r in rows) else 0


def shred(path):
    subprocess.run(["shred", "-u", path], capture_output=True)
    if os.path.exists(path):
        os.unlink(path)
    return not os.path.exists(path)


def cmd_apply(a):
    busy = rotation_in_progress()
    if busy:
        say("apply: REFUSED, a rotation is in progress (%s); backups may be the only copy of old keys. Nothing touched." % ",".join(busy))
        return 0
    rows, _ = classify_all(a)
    todo = [r for r in rows if r["verdict"] == "ELIGIBLE" and r["expired"]]
    keep = [r for r in rows if r["verdict"] in ("HOLD", "ORPHAN_LIVE")]
    for r in todo:
        say("%s %s (age %sd, %d values: %s)" % ("SHRED" if a.confirm else "would shred", os.path.basename(r["path"]), r["age_days"], len(r["values"]),
            ",".join(sorted({v.split(":")[0] for _, _, v in r["values"]}))))
        if a.confirm:
            ok = shred(r["path"]); log("%s %s %s" % ("shredded" if ok else "SHRED-FAILED", r["path"], sorted({v for _, _, v in r["values"]})))
    say("apply: %s=%d kept(HOLD/ORPHAN_LIVE)=%d eligible-not-yet-expired=%d" % ("shredded" if a.confirm else "would-shred", len(todo), len(keep),
        sum(1 for r in rows if r["verdict"] == "ELIGIBLE" and not r["expired"])))
    if not a.confirm and todo:
        say("(dry-run: pass --confirm to shred)")
    return 0


def cmd_scan(a):
    reg, over, bearing = load_registry(), 0, 0
    for p in targets():
        if not extract(p):
            continue
        bearing += 1
        over += time.time() >= expiry_of(p, reg, a.ttl)[0]
    say("secret-backups: secret_bearing=%d overdue=%d" % (bearing, over))
    return 1 if over else 0


def cmd_register(a):
    m = re.fullmatch(r"(\d+)([dh]?)", str(a.ttl))
    days = (int(m.group(1)) / (24 if m.group(2) == "h" else 1)) if m else DEFAULT_TTL
    if not os.path.exists(a.path):
        print("secret-backup-sweep register: no such file (nothing registered): " + a.path, file=sys.stderr)
        return 0
    ok = register(a.path, days, a.owner, a.why)
    return 0 if ok or not a.strict else 1


def cmd_timer(a):
    a.json, a.aq, a.no_probe = False, True, False
    if os.path.exists(LATCH):
        a.confirm = True
        cmd_apply(a)
    return cmd_report(a)


def main():
    ap = argparse.ArgumentParser(prog="secret-backup-sweep", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for n in ("report", "apply", "scan", "timer"):
        s = sub.add_parser(n); s.add_argument("--ttl", type=float, default=DEFAULT_TTL)
        if n == "report":
            s.add_argument("--json", action="store_true"); s.add_argument("--no-probe", action="store_true"); s.add_argument("--aq", action="store_true")
        if n == "apply":
            s.add_argument("--confirm", action="store_true"); s.add_argument("--no-probe", action="store_true")
    s = sub.add_parser("register"); s.add_argument("path"); s.add_argument("--ttl", default="7d"); s.add_argument("--owner"); s.add_argument("--why")
    s.add_argument("--strict", action="store_true")
    a = ap.parse_args()
    sys.exit({"report": cmd_report, "apply": cmd_apply, "scan": cmd_scan, "register": cmd_register, "timer": cmd_timer}[a.cmd](a))


if __name__ == "__main__":
    main()
