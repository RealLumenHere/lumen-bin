#!/usr/bin/env bash
set -euo pipefail
V=/home/lumen/obsidian-vault
cd "$V"
git add -A
if ! git diff --cached --quiet; then
  git -c user.name='Lumen Fleet' -c user.email='lumen@lumennode.uk' \
      commit -q -m "auto: fleet memory sync $(date -u +%FT%TZ)"
  git -c credential.helper=store push -q origin main
  echo "pushed $(date -u +%FT%TZ)"
else
  echo "no changes"
fi
