#!/usr/bin/env python3
"""ops-deploy-drift (wq#1696 item 2+4): which foreman/ops bundles never reached the box.

Read-only. For every shippable file in /home/lumen/foreman/ops/wq*/ (skips docs, tests,
diffs, install.sh itself), look for a byte-identical copy under the deploy roots.
Bundle verdict:
  LIVE     every shippable file has a byte-identical copy on the box
  PARTIAL  some do
  DRIFTED  every non-matching file exists on the box by name but differs (deployed, later edited)
  ABSENT   none reached the box, not even by name
  PARTIAL  mix: at least one file absent by name
  NOTHING  bundle ships no installable files (docs/diffs only) -> needs a human look
AUTHORITATIVE for bundles whose install.sh carries the --verify handler
(ops/VERIFY_CONTRACT.md): VERIFIED / VERIFY_FAIL / VERIFY_ERR come from the bundle
itself, and only these can open aq rows (--aq; auto-resolved on VERIFIED).
HEURISTIC, TRIAGE ONLY, for every other bundle: a file installed under a different name (trivy -> lumen-trivy-weekly)
or merged into another module reads ABSENT. Truth needs the per-bundle install.sh --verify
contract (wq#1696 item 2). Heuristic verdicts never reach aq.
RETIRED (wq#3487): a bundle carrying a RETIRED marker file is reported as RETIRED and
never alerts — the lightweight alternative to hand-writing an inverted --verify handler
(ops/VERIFY_CONTRACT.md "Bundles that are retired or superseded"). --aq auto-resolves any
open ops-drift:<bundle> row for it, same as a VERIFIED run.
Exit 0 always; --json for machine output; --aq opens one keyed aq row per ABSENT/PARTIAL
bundle older than 24h (key ops-drift:<bundle>).
"""
import hashlib, json, os, subprocess, sys, time

OPS = os.environ.get("OPS_DEPLOY_DRIFT_OPS", "/home/lumen/foreman/ops")  # env override is for tests
ROOTS = ["/home/lumen/bin", "/home/lumen/minerva", "/home/lumen/agents", "/home/lumen/foreman",
         "/home/lumen/autonomy", "/etc/systemd/system", "/home/lumen/.config/systemd/user", "/etc/lumen",
         "/home/lumen/agent", "/usr/local/bin", "/home/lumen/services", "/home/lumen/maint",
         "/home/lumen/fleet-units"]
SKIP_DIRS = {"__pycache__", ".git", "node_modules", "tests", "test", "_runs", "ops", ".pytest_cache", "worktrees"}
RUNNERS = {"install.sh", "uninstall.sh", "rollback.sh", "Makefile", "apply.sh", "deploy.sh", "verify.sh", "loadtest.sh", ".gitignore"}
ONESHOT = ("backfill_", "reopen_", "sweep_", "quarantine_", "migrate_", "remove-units", "deploy-", "verify-", "verify_", "ensure_", "apply_", "retire_", "install-", "rollout-", "measure_")
DOC_EXT = {".md", ".txt", ".diff", ".patch", ".log", ".example", ".template", ".tsv"}
MAX = 5 * 1024 * 1024


def sha(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def shippable(name):
    if name in RUNNERS or name.startswith(ONESHOT):
        return False
    if name.startswith("test_") or name.endswith("_test.py") or ".bak" in name:
        return False
    return os.path.splitext(name)[1] not in DOC_EXT


NAMES = set()


def _norm(n):
    return n.replace("-", "_").rsplit(".py", 1)[0].lower()


def index_roots():
    idx = set()
    for r in ROOTS:
        for dp, dns, fns in os.walk(r, onerror=lambda e: None):
            dns[:] = [d for d in dns if d not in SKIP_DIRS]
            for fn in fns:
                p = os.path.join(dp, fn)
                try:
                    if os.path.isfile(p) and not os.path.islink(p) and os.path.getsize(p) <= MAX:
                        idx.add(sha(p))
                        NAMES.add(_norm(fn))
                except OSError:
                    pass
    return idx


def retired_reason(bd):
    """wq#3487: RETIRED marker — first line is the reason, honored in place of a custom
    inverted --verify handler. Returns the reason, or None if the bundle is not marked."""
    try:
        with open(os.path.join(bd, "RETIRED")) as f:
            return (f.readline().strip() or "retired") or "retired"
    except OSError:
        return None


def has_verify(bd):
    """Contract marker (ops/VERIFY_CONTRACT.md). Without it --verify is NEVER run:
    a script that does not know the flag would ignore it and install."""
    try:
        head = open(os.path.join(bd, "install.sh")).read(20000)
    except OSError:
        return False
    return ("= --verify ]" in head) or ("--verify)" in head)


def run_verify(bd):
    try:
        p = subprocess.run(["bash", os.path.join(bd, "install.sh"), "--verify"], capture_output=True,
                           text=True, timeout=60, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return "VERIFY_ERR", ["timeout"]
    lines = [l for l in (p.stdout or "").splitlines() if l.startswith(("MISS", "ERR"))]
    return {0: "VERIFIED", 1: "VERIFY_FAIL"}.get(p.returncode, "VERIFY_ERR"), lines


def main():
    idx = index_roots()
    out = []
    for b in sorted(os.listdir(OPS)):
        bd = os.path.join(OPS, b)
        if not (b.startswith("wq") and os.path.isdir(bd)):
            continue
        age_h = (time.time() - os.path.getmtime(bd)) / 3600
        reason = retired_reason(bd)
        if reason is not None:
            out.append({"bundle": b, "verdict": "RETIRED", "authoritative": True, "files": 0,
                        "live": 0, "missing": [], "drifted": [], "reason": reason,
                        "age_h": round(age_h, 1)})
            continue
        if has_verify(bd):
            v, lines = run_verify(bd)
            out.append({"bundle": b, "verdict": v, "authoritative": True, "files": 0, "live": 0,
                        "missing": lines, "drifted": [], "age_h": round(age_h, 1)})
            continue
        files = []
        for dp, dns, fns in os.walk(bd):
            dns[:] = [d for d in dns if d not in SKIP_DIRS]
            files += [os.path.join(dp, f) for f in fns if shippable(f)]
        hit = [f for f in files if os.path.getsize(f) <= MAX and sha(f) in idx]
        missf = [f for f in files if f not in hit]
        drift = [os.path.relpath(f, bd) for f in missf if _norm(os.path.basename(f)) in NAMES]
        miss = [os.path.relpath(f, bd) for f in missf if _norm(os.path.basename(f)) not in NAMES]
        v = ("NOTHING" if not files else "LIVE" if not missf else
             "DRIFTED" if not miss else "ABSENT" if not hit and not drift else "PARTIAL")
        out.append({"bundle": b, "verdict": v, "authoritative": False, "files": len(files), "live": len(hit),
                    "missing": miss, "drifted": drift, "age_h": round(age_h, 1)})
    if "--json" in sys.argv:
        print(json.dumps(out, indent=1))
    else:
        for r in out:
            m = ("  reason: " + r["reason"]) if r.get("reason") else ""
            m += ("  absent: " + ", ".join(r["missing"][:4])) if r["missing"] else ""
            m += ("  drifted: " + ", ".join(r["drifted"][:3])) if r["drifted"] else ""
            print(f"{r['verdict']:8} {r['live']}/{r['files']:<3} {r['bundle']}{m}")
        c = {}
        for r in out:
            c[r["verdict"]] = c.get(r["verdict"], 0) + 1
        print("summary:", c)
    if "--aq" in sys.argv:
        # Only authoritative (--verify) results alert. Heuristic verdicts never do.
        sys.path.insert(0, "/home/lumen/agents/alert-queue")
        import aq
        for r in out:
            if not r.get("authoritative"):
                continue
            key = f"ops-drift:{r['bundle']}"
            if r["verdict"] == "VERIFY_FAIL" and r["age_h"] > 24:
                aq.ingest(source="ops-deploy-drift", key=key, title=f"ops bundle not live: {r['bundle']}",
                          message=f"install.sh --verify FAIL: {'; '.join(r['missing'][:8])} "
                                  f"(fix: run the bundle's install.sh, or retire the bundle; wq#1696)")
            elif r["verdict"] in ("VERIFIED", "RETIRED"):
                note = "auto-cleared: --verify OK" if r["verdict"] == "VERIFIED" else "auto-cleared: RETIRED marker"
                c = aq.db()
                c.execute("UPDATE alerts SET status='resolved', note=?, "
                          "resolved_ts=? WHERE source='ops-deploy-drift' AND key=? AND status='open'",
                          (note, aq.now(), key))
                c.commit(); c.close()


if __name__ == "__main__":
    main()
