#!/usr/bin/env bash
# lumen-pr — branch + PR helper for Lumen Industries repos.
#
# WHY: github-standards.md §2/§5/§11. Every change on a Class A repo arrives via a
# short-lived branch and a pull request, because the PR is the artifact an outside
# developer reads to see that a human process happened. This script makes the
# compliant path the easy path, and refuses the non-compliant one.
#
# Usage:
#   lumen-pr start  <repo-path> <type>/<slug> [--worktree|--primary|--adopt]
#   lumen-pr commit <repo-path> "<conventional subject>" [--refs wq#N] [--body-file F]
#   lumen-pr open   <repo-path> --title T --body-file F [--draft] [--allow-second-person]
#   lumen-pr comment <repo-path> <pr-number> --body-file F   # wq#2273: via broker pr-comment
#   lumen-pr land   <repo-path> <pr-number> [--timeout SEC] [--merge] [--allow-dirty]
#   lumen-pr check  <repo-path>            # what state am I in?
#   lumen-pr gitlock <repo-path> scope|status|acquire|release   # wq#532a, mostly for tests
#   lumen-pr dirtycheck <repo-path> [--mode refuse|warn] [--head REV] <path>...  # wq#771/wq#792 guard
#   lumen-pr ffprimary <repo-path> [--head REV]  # wq#1536: ff the primary tree to origin/main, or say why not
#
# wq#532a: `land` takes the repo git lock ITSELF, around the merge only, and releases it in a
# trap. There is no shell idiom left for a caller to get wrong. The dispatch used to tell every
# agent to chain `slock acquire -> lumen-pr land -> slock release` by hand; a careful agent
# following that in good faith breached the lock twice in one session (--ttl 5m was rejected by
# argparse and the chain used `;`, then a piped acquire returned tail`s exit status through &&).
# A rule a careful agent cannot execute reliably is a broken rule, not a discipline problem.
#
# Every subcommand is idempotent and exits non-zero with a readable reason.
# Credentials: NONE (wq#2273, token-engine T4). This tool never reads a token
# file and never builds an Authorization header. Every forge API call is a
# broker verb (pr-open/pr-update/pr-comment/pr-view/pr-checks/pr-files/
# pr-list/pr-merge) over the token-engine socket; the daemon (uid tokeneng)
# picks the forge, base URL and token per repo slug and answers with scalars
# only — a PR number and url, never a credential. Titles and bodies travel as
# file paths, never argv, so nothing lands in /proc/*/cmdline. `git push`
# still authenticates via git's own credential path until T1 (wq#2271).
#
# wq#1282 (ISSUE-LOG #23): LUMEN_PR_ALLOW_DIRTY is RETIRED. The wq#771 target-tree guard
# has no override. It was added for a false-block that no longer exists — the daemons
# rewriting tracked runtime state — and once that state moved under gitignored runtime/
# dirs, every remaining trip of the guard is a true positive: real work about to be
# silently superseded. Setting the variable now fails loudly rather than landing.
#
# wq#1121: that is still true, and `land --allow-dirty` is therefore accepted-and-inert —
# it says once that no override exists, then lands or refuses on the guard's own verdict.
# What DID need fixing is the guard's reach: it counted an un-pushed commit on the target
# tree as a collision even when the branch being landed already CONTAINED that commit, so
# the PR that carried the un-pushed work — the guard's own prescribed fix — was the one
# thing it refused. dirty_target_guard now clears the un-pushed set on that ancestry, and
# ff_primary_after_land re-points a target tree whose local commits are already on origin.
set -uo pipefail

BIN_DIR=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)

# Overridable for the same reason LUMEN_PR_SLOCK is: verifying the worktree guard requires
# CREATING worktrees, and doing that under the live root would leave test debris in the one
# directory sibling agents actually work in. Every other path here was already overridable;
# this one was hardcoded purely by omission (same shape as the wq#562 LOGDIR finding).
WORKTREE_ROOT=${LUMEN_PR_WORKTREE_ROOT:-/home/lumen/scratch/worktrees}
SLOCK=${LUMEN_PR_SLOCK:-/home/lumen/bin/slock}   # overridable so the guard can test the copy under review
# Seconds-to-a-minute operation. Short on purpose: a merge that somehow hangs must not park the
# lock behind it for an hour, which is what stranded a finished, green ticket for 65 minutes.
GITLOCK_TTL=${LUMEN_PR_GITLOCK_TTL:-10}
# Resolved ONCE. slock's default holder falls back to hostname:pid when WQ_AGENT is unset, and
# every slock call is a separate process, so a pid-derived holder would acquire under one name
# and fail to release under another.
GITLOCK_HOLDER=${WQ_AGENT:-lumen-pr:$$}
GITLOCK_SCOPE=""
GITLOCK_TAKEN=0
CONV_TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
SUBJECT_RE="^(${CONV_TYPES})(\([a-z0-9._-]+\))?!?: .{1,60}$"
BRANCH_RE="^(${CONV_TYPES})/[a-z0-9][a-z0-9-]*$"
FOOTER_ASSIST='Assisted-by: Claude (Anthropic) via Lumen Industries automation'

die() { printf 'lumen-pr: %s\n' "$*" >&2; exit 1; }
note() { printf 'lumen-pr: %s\n' "$*"; }

# Never let a token reach stdout/stderr, whatever a remote hands back.
redact() { sed -E 's#(gh[pousr]_[A-Za-z0-9]{6})[A-Za-z0-9_]*#\1REDACTED#g; s#https://[^@/]*@#https://REDACTED@#g'; }

# --- token-engine broker (wq#2273, T4) --------------------------------------
# Every forge API call goes through the token-engine daemon; this process holds
# no token at any point. The grant is self-attested (the T2 trust model — the
# broker's enforced value today is the audit line per call, scalar-only
# responses, and the daemon-side forge/token pinning), minted per invocation
# with a short TTL, scoped to exactly this repo's node, and removed on exit.
# It lives under the events tree because the daemon's PrivateTmp hides /tmp,
# and events/ carries a default ACL tokeneng can read through (gate_replay.sh
# established the pattern).
TE_CLIENT=${LUMEN_PR_TE_CLIENT:-/usr/local/lib/token-engine/te_client.py}
TE_GRANT_DIR=${LUMEN_PR_TE_GRANT_DIR:-/home/lumen/foreman/events}
TE_TICKET="" TE_WORKER="" TE_GRANT_FILE="" TE_GRANT_SHA="" TE_GRANT_SLUG=""
TE_CLEANUP_DIR=""
BROKER_RESULT='{}' BROKER_RULE="" BROKER_REASON=""

cleanup_on_exit() {
  gitlock_release
  [ -n "$TE_CLEANUP_DIR" ] && rm -rf "$TE_CLEANUP_DIR"
}

te_identity() {
  # Ticket id for the audit line: the fworker convention (WQ_AGENT=fworker-wqN)
  # when present, an explicit adhoc marker otherwise — never a guess.
  case "${WQ_AGENT:-}" in
    fworker-wq[0-9]*) TE_TICKET="wq${WQ_AGENT#fworker-wq}" ;;
    *)                TE_TICKET="adhoc-lumen-pr" ;;
  esac
  TE_WORKER=$(printf '%s' "${WQ_AGENT:-lumen-pr-$$}" | tr -cd 'A-Za-z0-9._-')
  [ -n "$TE_WORKER" ] || TE_WORKER="lumen-pr-$$"
}

te_grant() { # mint (once per SLUG per process) the per-repo grant
  [ -n "$TE_GRANT_FILE" ] && [ "$TE_GRANT_SLUG" = "$SLUG" ] && return 0
  te_identity
  local dir exp
  dir=$(mktemp -d -p "$TE_GRANT_DIR" te-pr.XXXXXX) || die "cannot create grant dir under $TE_GRANT_DIR"
  chmod 755 "$dir"
  exp=$(date -u -d '+1 hour' +%Y-%m-%dT%H:%M:%SZ)
  jq -n --arg t "$TE_TICKET" --arg e "$exp" --arg n "repo:$SLUG" \
    '{ticket:$t, expires:$e, grants:[{kind:"pr_read",node:$n},{kind:"pr_write",node:$n},{kind:"pr_comment",node:$n}]}' \
    > "$dir/grant.json" || die "cannot write broker grant"
  chmod 644 "$dir/grant.json"
  TE_GRANT_FILE="$dir/grant.json"
  TE_GRANT_SHA=$(sha256sum "$TE_GRANT_FILE" | awk '{print $1}')
  TE_GRANT_SLUG="$SLUG"
  TE_CLEANUP_DIR="$dir"
  trap cleanup_on_exit EXIT INT TERM
  note "broker: $SLUG via $TE_CLIENT (ticket $TE_TICKET, worker $TE_WORKER)"
}

te_stage() { # te_stage <src-file> — copy where uid tokeneng can read; prints path
  local dst
  dst=$(mktemp -p "$TE_CLEANUP_DIR" stage.XXXXXX) || return 1
  cat "$1" > "$dst" || return 1
  chmod 644 "$dst"
  printf '%s\n' "$dst"
}

te_stage_text() { # te_stage_text <string>
  local dst
  dst=$(mktemp -p "$TE_CLEANUP_DIR" stage.XXXXXX) || return 1
  printf '%s\n' "$1" > "$dst"
  chmod 644 "$dst"
  printf '%s\n' "$dst"
}

broker() { # broker <verb> [argv-after-repo]... — response fields into BROKER_*
  local verb="$1"; shift
  te_grant
  local out rc
  out=$(python3 "$TE_CLIENT" --verb "$verb" --ticket "$TE_TICKET" --worker "$TE_WORKER" \
        --grant-file "$TE_GRANT_FILE" --grant-sha "$TE_GRANT_SHA" \
        --argv "$SLUG" "$@" 2>&1)
  rc=$?
  BROKER_RESULT=$(printf '%s' "$out" | jq -c '.result // {}' 2>/dev/null) || BROKER_RESULT='{}'
  BROKER_RULE=$(printf '%s' "$out" | jq -r '.rule // ""' 2>/dev/null)
  BROKER_REASON=$(printf '%s' "$out" | jq -r '.reason // ""' 2>/dev/null)
  if [ -z "$BROKER_RULE" ]; then
    # not a broker frame at all — socket down, client missing, python error
    BROKER_RULE="client_error"
    # tail, not head: a python traceback puts the exception on its LAST line, and head -c 300
    # kept only the frames above it (wq#2475: a PermissionError on /run/token-engine read as
    # a bare "Traceback ...").
    BROKER_REASON=$(printf '%s' "$out" | tail -n 3 | head -c 300)
  fi
  return $rc
}

rget() { printf '%s' "$BROKER_RESULT" | jq -r "$1"; }

broker_fail() { # broker_fail <what>
  printf 'lumen-pr: %s failed via broker [%s]: %s\n' \
    "$1" "$BROKER_RULE" "$BROKER_REASON" | redact >&2
  exit 1
}

# --- git lock (wq#532a) -----------------------------------------------------
# The scope vocabulary is GITHUB_DISPATCH.md's: "<repo>-git", with lpp-git as the established
# alias for lumen-plays-pokemon. Derived from the SLUG so a linked worktree and its primary tree
# always resolve to the SAME scope - locking per-worktree would lock nothing.
gitlock_scope() {
  local name="${SLUG##*/}"
  case "$name" in
    lumen-plays-pokemon) printf 'lpp-git\n' ;;
    *) printf '%s-git\n' "$name" ;;
  esac
}

gitlock_holder_of() { # gitlock_holder_of <scope>  -> holder on stdout, empty if unheld
  local out
  out=$("$SLOCK" who "$1" 2>/dev/null) || return 0
  case "$out" in
    "(no active locks)"*) return 0 ;;
  esac
  printf '%s\n' "$out" | awk 'NR==1{print $2}'
}

gitlock_acquire() { # gitlock_acquire <scope> <note>
  local scope="$1" note="${2:-}" pre
  pre=$(gitlock_holder_of "$scope")
  if [ -n "$pre" ] && [ "$pre" = "$GITLOCK_HOLDER" ]; then
    # The caller already wrapped this by hand (the old dispatch idiom). Refresh nothing, and
    # do NOT release on exit - the lock is theirs to drop, not this script`s.
    note "git lock '$scope' is already held by $GITLOCK_HOLDER — leaving it to the caller"
    GITLOCK_SCOPE="$scope"; GITLOCK_TAKEN=0
    return 0
  fi
  # Exit status checked DIRECTLY. No pipe, no `;` chain: a pipeline reports its LAST command`s
  # status, which is how a DENIED acquire has already been walked straight through.
  if ! "$SLOCK" acquire "$scope" --ttl "$GITLOCK_TTL" --holder "$GITLOCK_HOLDER" --note "$note"; then
    die "could not take the git lock '$scope' — another agent is mid-merge on this repo.
      Wait and re-run; never force it, and never work around it."
  fi
  GITLOCK_SCOPE="$scope"; GITLOCK_TAKEN=1
  # cleanup_on_exit = gitlock_release + broker grant removal (wq#2273); one
  # trap slot, so the two cleanups share a function instead of clobbering.
  trap cleanup_on_exit EXIT INT TERM
}

gitlock_release() {
  [ "$GITLOCK_TAKEN" = 1 ] || return 0
  GITLOCK_TAKEN=0
  "$SLOCK" release "$GITLOCK_SCOPE" --holder "$GITLOCK_HOLDER" >/dev/null 2>&1 \
    && note "released git lock '$GITLOCK_SCOPE'" \
    || note "WARNING: could not release git lock '$GITLOCK_SCOPE' — check: $SLOCK who $GITLOCK_SCOPE"
}

cmd_gitlock() {
  need_repo "${1:-}"; local action="${2:-scope}"
  local scope; scope=$(gitlock_scope)
  case "$action" in
    scope)   printf '%s\n' "$scope" ;;
    status)  local h; h=$(gitlock_holder_of "$scope")
             printf '%s %s\n' "$scope" "${h:-(unheld)}" ;;
    acquire) gitlock_acquire "$scope" "lumen-pr gitlock (manual)"; trap - EXIT INT TERM
             GITLOCK_TAKEN=0 ;;
    release) GITLOCK_SCOPE="$scope"; GITLOCK_TAKEN=1; gitlock_release ;;
    *) die "usage: lumen-pr gitlock <repo-path> scope|status|acquire|release" ;;
  esac
}

# --- repo helpers -----------------------------------------------------------
need_repo() {
  REPO_PATH="${1:-}"
  [ -n "$REPO_PATH" ] || die "missing <repo-path>"
  # `.git` is a directory in a normal clone and a FILE in a linked worktree.
  # §2 tells parallel agents to work in their own worktree, so both must work.
  git -C "$REPO_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1 || \
    die "not a git work tree: $REPO_PATH"
  REPO_PATH=$(cd "$REPO_PATH" && pwd)
  local url
  url=$(git -C "$REPO_PATH" remote get-url origin 2>/dev/null) || die "no 'origin' remote in $REPO_PATH"
  # wq#557: derive the slug for ANY forge, not just github over https. The old sed only
  # stripped a literal "https://", so a Gitea origin
  # (http://lumen@100.121.17.5:3000/lumen/lumen-bin.git) kept its scheme, userinfo, host
  # and port and became the ENTIRE URL as the slug — every API call then 404'd, silently,
  # because cmd_check swallowed the failure inside an `if`. Strip: scheme, userinfo,
  # host[:port], trailing .git; handle scp-form (git@host:owner/repo.git) too.
  local hostpart bare
  bare=$(printf '%s' "$url" | sed -E 's#^[a-z+]+://##; s#^[^/@]+@##; s#\.git$##')
  case "$bare" in
    *:*/*) hostpart=${bare%%:*}; bare=${bare#*:} ;;   # scp-form  host:owner/repo
    *)     hostpart=${bare%%/*}; bare=${bare#*/} ;;   # url-form  host[:port]/owner/repo
  esac
  hostpart=${hostpart%%:*}
  # wq#524: the forge API base, WITH the port, derived from the origin itself. FORGE_HOST
  # deliberately drops the port one line up (it exists to answer "is this github.com?"), so
  # it cannot serve as an API base — `http://$FORGE_HOST` is port 80 and nothing is there.
  # This value used to arrive as GITEA_URL, set only because load_token SOURCED agent/.env:
  # a hidden coupling between "read a token" and "know the forge URL" that fell over the
  # instant the token stopped being read that way (HTTP 000 on every Gitea call). The origin
  # already carries scheme, host and port and is the thing actually being talked to, so
  # derive it and drop the config dependency. An exported GITEA_URL still overrides.
  case "$url" in
    *://*) FORGE_BASE_URL=$(printf '%s' "$url" | sed -E 's#^([a-z+]+://)([^/@]+@)?([^/]+)/.*#\1\3#') ;;
    *)     FORGE_BASE_URL="http://$hostpart" ;;   # scp-form carries no scheme or port
  esac
  # Keep only the LAST two path segments: Gitea and GitHub both end .../owner/repo, and a
  # subpath-mounted forge would otherwise leak its prefix into the slug.
  SLUG=$(printf '%s' "$bare" | awk -F/ 'NF>=2{print $(NF-1) "/" $NF}')
  FORGE_HOST="$hostpart"
  case "$hostpart" in
    github.com|www.github.com) FORGE=github ;;
    *)                         FORGE=gitea ;;
  esac
  case "$SLUG" in
    */*) : ;;
    *) die "cannot parse owner/repo from origin url" ;;
  esac
  DEFAULT_BRANCH=$(git -C "$REPO_PATH" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
  [ -n "${DEFAULT_BRANCH:-}" ] || DEFAULT_BRANCH=main

  # wq#546 SCOPE FENCE. Every mutating subcommand routes through need_repo, so this is the
  # one chokepoint that covers start/commit/open/land. DEFAULT DENY: a repo with no ALLOW
  # line in agent-scope.conf is refused here, including a repo a playbook says is Class A.
  # A wrong sentence in a doc published winforge; a wrong sentence can no longer push.
  # LUMEN_PR_SCOPE_CHECK=0 exists for the probe ONLY — never set it to work around a DENY.
  if [ "${LUMEN_PR_SCOPE_CHECK:-1}" = 1 ] && [ "${SCOPE_OP:-write}" != "none" ]; then
    local scope_bin="${LUMEN_PR_SCOPE:-$BIN_DIR/lumen-repo-scope}"
    if [ -x "$scope_bin" ]; then
      # Pass the PATH, not "$SLUG". lumen-pr's own slug sed only strips `https://`, so a
      # Gitea origin (http://user@host:3000/owner/repo.git) becomes the ENTIRE URL as the
      # slug — that is wq#557, and it is why every API call 404s against lumen-bin. Feeding
      # that string to the fence made the fence DENY the fleet's own tooling repo, which I
      # hit while landing this very change. lumen-repo-scope does its own derivation
      # (strips scheme, userinfo, port, .git, scp-form) and is the stricter of the two, so
      # the SAFETY decision uses the correct owner/repo even while the API path is broken.
      "$scope_bin" check "$REPO_PATH" --op "${SCOPE_OP:-write}" || \
        die "refusing to operate on $SLUG — see the scope verdict above.
      This is github-standards.md §0a made mechanical (wq#546). If you believe the repo
      SHOULD be in scope, that is Frank's decision: file a ticket and stop. Do not edit
      /home/lumen/infra/github/agent-scope.conf to unblock yourself."
    else
      die "scope checker not found at $scope_bin, so this operation is DENIED.
      A fence that fails open is not a fence (wq#546). Restore lumen-repo-scope."
    fi
  fi
}

# --- lint helpers -----------------------------------------------------------
lint_subject() { # lint_subject "<subject>"
  local s="$1"
  [ -n "$s" ] || die "empty subject"
  printf '%s' "$s" | grep -qiE 'wq#|board:' && \
    die "subject contains an internal ticket/board marker (§3, §10.2-10.3). Put it in the Refs: footer instead:
      bad : $s
      good: fix(transit): flee-first policy for Mt Moon   [+ 'Refs: wq#N' footer]"
  printf '%s' "$s" | grep -qE "$SUBJECT_RE" || \
    die "subject is not a Conventional Commit (§3). Required: <type>(<scope>)?: <imperative, lowercase, <=60 chars, no trailing period>
      types: ${CONV_TYPES//|/ }
      got  : $s"
  case "$s" in
    *.) die "subject must not end with a period (§3)" ;;
  esac
  return 0
}

lint_second_person() { # lint_second_person <file-or-string> <label>
  local text="$1" label="$2"
  [ "${ALLOW_SECOND_PERSON:-0}" = 1 ] && return 0
  if printf '%s' "$text" | grep -qiE '(^|[^[:alnum:]])(you|your|yours|you'"'"'re|youre)([^[:alnum:]]|$)'; then
    printf 'lumen-pr: %s uses second person, which §5 bans — describe the CODE, not the author.\n' "$label" >&2
    printf '  bad : "your heartbeat disconnects every healthy client"\n' >&2
    printf '  good: "heartbeat interval races the pong deadline, disconnecting healthy clients"\n' >&2
    printf '  offending line(s):\n' >&2
    printf '%s' "$text" | grep -inE '(^|[^[:alnum:]])(you|your|yours)([^[:alnum:]]|$)' | head -5 | sed 's/^/    /' >&2
    printf '  If this is a false positive (quoted config, upstream text), re-run with --allow-second-person.\n' >&2
    exit 1
  fi
  return 0
}

lint_body_sections() { # lint_body_sections <body-text>
  local body="$1" missing=""
  for s in What Why How Testing; do
    printf '%s' "$body" | grep -qE "^##[[:space:]]+$s\b" || missing="$missing $s"
  done
  printf '%s' "$body" | grep -qE '^##[[:space:]]+Risk' || missing="$missing Risk/rollback"
  [ -n "$missing" ] && die "PR body is missing required §5 section(s):$missing
      Required headings: ## What / ## Why / ## How / ## Testing / ## Risk / rollback
      (add ## Disclosure too when contributing upstream — §4)"
  return 0
}

# --- dirty target-tree guard (wq#771, wq#792) -------------------------------
# WHY: on 2026-08-21 the dispatcher sat dead for ~3 hours. A session had edited
# dispatcher/config.json in the LIVE foreman tree (adding the 'build' lane) and never
# committed it. A second session cut a worktree from origin/main — which by definition
# did not contain that edit — and landed a PR touching the same file. Git reported NO
# conflict, because there was nothing COMMITTED to conflict with: the uncommitted lane
# was simply superseded, then looked like stale debris and was cleared. Net: the build
# lane silently deleted, 42 tickets invisible to autonomy, four dispatcher passes with
# candidates:2 spawned:0. Third instance of this class in that one file in one day.
#
# The existing locks are not broken and could not have caught it. gitlock (wq#532a) and
# slock serialise COMMITS and MERGES; wq leases protect TICKETS. Nothing in that set can
# see uncommitted working-tree state, and uncommitted working-tree state is exactly what
# was lost. The collision system was bypassed, not defeated.
#
# So: before a merge, look at the TARGET repo — the PRIMARY work tree, the one the fleet
# actually runs out of — and refuse when any path this PR touches is uncommitted there.
# Other linked worktrees are agent scratch and are NOT checked; the primary tree is the
# one whose uncommitted state is live configuration.
# There is no override (wq#1282): resolve the target tree, then re-run the land.
#
# wq#792: uncommitted working-tree state was the first shape of this loss, not the whole
# of it. An un-pushed local COMMIT on the target's default branch is the same class: a
# squash-merge on the remote lands a version of the touched paths branched from
# origin/$DEFAULT_BRANCH, which never saw that commit either, and it reads as silently
# superseded rather than conflicting. Found live: /home/lumen/bin's local main carried a
# commit no `land` had ever pushed, so every subsequently landed PR merged on the forge
# but never reached the tree every agent actually invokes. tree_unpushed (below) covers it.

# The main work tree of the repo, whichever tree we were pointed at. git-worktree(1)
# lists the main work tree first. The --git-common-dir parent is the fallback, and is
# resolved from INSIDE the repo because git returns that path relative to the repo, not
# to $PWD (the same trap cmd_land documents).
primary_worktree() {
  local out
  out=$(git -C "$REPO_PATH" worktree list --porcelain 2>/dev/null \
        | awk 'NR==1 && $1=="worktree" { print substr($0, 10); exit }')
  if [ -z "$out" ]; then
    out=$(cd "$REPO_PATH" && cd "$(git rev-parse --git-common-dir)/.." 2>/dev/null && pwd -P)
  fi
  [ -d "$out" ] || return 1
  printf '%s\n' "$out"
}

same_tree() { # same_tree <a> <b>
  local a b
  a=$(cd "$1" 2>/dev/null && pwd -P) || return 1
  b=$(cd "$2" 2>/dev/null && pwd -P) || return 1
  [ "$a" = "$b" ]
}

# Every path in <tree> that differs from its HEAD: unstaged, staged, or untracked.
# The ticket names the first two; untracked is here because a merge that ADDS a path
# git already sees untracked is refused by git itself ("untracked working tree file
# would be overwritten"), and because "operator wrote a file and never committed it" is
# the same loss with the same shape. core.quotePath=false keeps non-ASCII paths literal
# so they compare against the PR's list instead of against \xNN escapes.
tree_uncommitted() { # tree_uncommitted <tree>
  local t="$1"
  {
    git -C "$t" -c core.quotePath=false diff --name-only 2>/dev/null
    git -C "$t" -c core.quotePath=false diff --cached --name-only 2>/dev/null
    git -C "$t" -c core.quotePath=false ls-files --others --exclude-standard 2>/dev/null
  } | LC_ALL=C sort -u
}

# Paths touched by commits on <tree>'s $DEFAULT_BRANCH that origin/$DEFAULT_BRANCH does
# not have (wq#792). Only checked when $DEFAULT_BRANCH is actually checked out there — a
# tree parked on some other branch has nothing of $DEFAULT_BRANCH's to be ahead of, and a
# missing origin/$DEFAULT_BRANCH (never fetched) means "unknown", not "clean", so this
# returns nothing rather than guessing.
tree_unpushed() { # tree_unpushed <tree>
  local t="$1"
  [ "$(git -C "$t" branch --show-current 2>/dev/null)" = "$DEFAULT_BRANCH" ] || return 0
  git -C "$t" rev-parse --verify -q "refs/remotes/origin/$DEFAULT_BRANCH" >/dev/null 2>&1 || return 0
  git -C "$t" -c core.quotePath=false diff --name-only \
    "origin/$DEFAULT_BRANCH...$DEFAULT_BRANCH" 2>/dev/null | LC_ALL=C sort -u
}

# live_blob <tree> <path>  (wq#1490)
# The blob sha the working-tree file at <path> would be stored as, or nothing. This is the
# content half of the wq#771 question for UNCOMMITTED work: the guard's job is to keep live
# bytes from being silently superseded, so live bytes that already equal what is about to
# land are not at risk. Regular files only — a symlink hashes as its target text and a
# directory has no blob — and no output means "not provable", never "equal".
live_blob() {
  local f="$1/$2"
  { [ -f "$f" ] && [ ! -L "$f" ]; } || return 0
  git -C "$1" hash-object -- "$f" 2>/dev/null
}

# stage_identical_overlap <tree> <ref> <newline-separated paths>  (wq#1490)
# Of the uncommitted <paths> that an ff/re-point to <ref> would touch, stage every one whose
# live bytes already equal <ref>'s blob, and print the rest. A tree whose index matches the
# incoming entry is a clean two-way merge ("keep index") for both `merge --ff-only` and
# `reset --keep`, and staging changes no byte on disk — the file the fleet runs is the file
# it ran a second ago, now with HEAD agreeing. Anything not provably identical stays in the
# overlap and keeps its refusal.
stage_identical_overlap() {
  local t="$1" ref="$2" paths="$3" path b_live b_ref rest=""
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    b_live=$(live_blob "$t" "$path")
    b_ref=$(git -C "$t" rev-parse -q --verify "${ref}:${path}" 2>/dev/null) || b_ref=""
    if [ -n "$b_live" ] && [ -n "$b_ref" ] && [ "$b_live" = "$b_ref" ] \
       && git -C "$t" add -- "$path" 2>/dev/null; then
      :
    else
      rest="${rest}${path}
"
    fi
  done <<EOF_OVERLAP
$paths
EOF_OVERLAP
  printf '%s' "$rest" | grep -v '^$' | LC_ALL=C sort -u
}

# drop_identical_overlap <tree>  (wq#1490)
# Narrows the caller's $overlap (bash scoping: the caller's local) to the paths that are NOT
# byte-identical to origin/$DEFAULT_BRANCH, staging the identical ones, and says which. The
# note is printed here, not inside stage_identical_overlap, because that runs under $(...)
# and anything it printed would be read back as a path.
# unstage_identical <tree>  (wq#2063)
# stage_identical_overlap() runs `git add` BEFORE ff_primary_after_land has decided whether it
# can move the tree, so every refusal below used to return 1 with the index already mutated: a
# path the operator left as a clean untracked file came back as a staged `A ` entry they never
# created. Follow lumen-pr's own printed remedy and delete that file and the entry becomes `AD`,
# which then overlaps the ff forever and re-refuses with a message about a path the operator
# cannot see any more. A refusal must leave the tree exactly as it found it.
unstage_identical() {
  local t="$1" path
  [ -n "$STAGED_IDENTICAL" ] || return 0
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    git -C "$t" reset -q HEAD -- "$path" 2>/dev/null || true
  done <<EOF_UNSTAGE
$STAGED_IDENTICAL
EOF_UNSTAGE
  note "wq#2063: refusal is side-effect-free — unstaged the byte-identical path(s) staged above"
  STAGED_IDENTICAL=""
}

# verify_ff_restored <tree> <old_rev>  (wq#2063)
# A `git merge --ff-only` / `git reset --keep` that returns 0 is NOT proof that every file the
# move carried is on disk: git updates HEAD and the index, and skips materialising a path whose
# index entry already matches the target blob. wq#2063 saw a land print "fast-forwarded 1
# commit(s)" while two of seven new files were absent from the working tree, showing ` D`. A
# silent success-that-wasn't is worse than the refusal it replaced (same class as wq#771/wq#792,
# which land's own refusal message already cites), so prove the restore instead of assuming it.
#
# Scoped to paths the move itself touched, so an operator's own pre-existing deletion elsewhere
# is not swept up: a deleted tracked path that overlapped the incoming commits would have been
# refused above, and one that did not overlap is not in the moved set.
verify_ff_restored() {
  local t="$1" old="$2" moved gone missing
  moved=$(git -C "$t" -c core.quotePath=false diff --name-only "$old" HEAD 2>/dev/null \
            | LC_ALL=C sort -u)
  [ -n "$moved" ] || return 0
  gone=$(git -C "$t" -c core.quotePath=false diff --name-only --diff-filter=D HEAD 2>/dev/null \
            | LC_ALL=C sort -u)
  [ -n "$gone" ] || return 0
  missing=$(LC_ALL=C comm -12 <(printf '%s\n' "$gone") <(printf '%s\n' "$moved") | grep -v '^$')
  [ -n "$missing" ] || return 0
  note "wq#2063: the move touched $(printf '%s\n' "$missing" | grep -c .) path(s) that are NOT on disk after it —"
  printf '%s\n' "$missing" | sed 's/^/    /'
  note "  git reported success but the working tree is missing them; restoring from HEAD"
  # shellcheck disable=SC2086
  if git -C "$t" checkout HEAD -- $(printf '%s ' $missing) 2>/dev/null; then
    local still
    still=$(git -C "$t" -c core.quotePath=false diff --name-only --diff-filter=D HEAD 2>/dev/null \
              | LC_ALL=C sort -u)
    still=$(LC_ALL=C comm -12 <(printf '%s\n' "$still") <(printf '%s\n' "$moved") | grep -v '^$')
    if [ -z "$still" ]; then
      note "wq#2063: restored — every path the move touched now matches HEAD on disk"
      return 0
    fi
  fi
  note "wq#2063: RESTORE FAILED — these paths are in HEAD but not on disk, fix by hand:"
  printf '%s\n' "$missing" | sed "s|^|    git -C $t checkout HEAD -- |"
  return 1
}

drop_identical_overlap() {
  local t="$1" rest staged
  [ -n "$overlap" ] || return 0
  rest=$(stage_identical_overlap "$t" "origin/$DEFAULT_BRANCH" "$overlap")
  # wq#2063: stage_identical_overlap runs inside a command substitution, i.e. a subshell, so it
  # cannot record this itself — the parent shell has to derive it from the set difference.
  STAGED_IDENTICAL=$(LC_ALL=C comm -23 <(printf '%s\n' "$overlap") <(printf '%s\n' "$rest") | grep -v '^$')
  staged=$(printf '%s\n' "$STAGED_IDENTICAL" | grep -v '^$' | tr '\n' ' ')
  [ -z "$staged" ] || note "wq#1490: uncommitted in $t but already byte-identical to origin/$DEFAULT_BRANCH — staged, no file changed: $staged"
  overlap="$rest"
}

# landed_carries_unpushed <tree> <landed-head>  (wq#2099)
# Did the head that just landed CONTAIN <tree>'s un-pushed commits, and did that content actually
# reach origin? Ancestry answers the first half: a tip that is an ancestor of the head means the
# branch is a strict superset of the tree, the same statement dirty_target_guard clears the guard
# on. It does NOT answer the second — a squash leaves no commit of the head on origin to look for,
# so ancestry alone would re-point on a merge that never happened. The blob comparison is the
# arrival proof: every path those commits touch reads the same on origin as on the landed head.
# Both halves, or nothing: an unresolvable ref, a path origin does not match, or no head at all
# leaves the tree diverged, which is the safe verdict the wq#792 refusal exists to give.
landed_carries_unpushed() {
  local t="$1" landed="$2" tip path b_head b_origin
  [ -n "$landed" ] || return 1
  git -C "$t" cat-file -e "${landed}^{commit}" 2>/dev/null || return 1
  tip=$(git -C "$t" rev-parse -q --verify "refs/heads/$DEFAULT_BRANCH^{commit}" 2>/dev/null) || return 1
  [ -n "$tip" ] || return 1
  git -C "$t" merge-base --is-ancestor "$tip" "$landed" 2>/dev/null || return 1
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    b_head=$(git -C "$t" rev-parse -q --verify "${landed}:${path}" 2>/dev/null) || b_head=""
    b_origin=$(git -C "$t" rev-parse -q --verify "origin/$DEFAULT_BRANCH:${path}" 2>/dev/null) || b_origin=""
    [ "$b_head" = "$b_origin" ] || return 1
  done <<EOF_LANDED_PATHS
$(tree_unpushed "$t")
EOF_LANDED_PATHS
  return 0
}

# unpushed_are_upstream_equivalent <tree>  (wq#2099)
# Is every un-pushed commit already on origin as a patch? `git cherry` compares PATCH-IDs, so a
# commit that reached origin by rebase or cherry-pick — new sha, same diff — counts as present,
# and a '+' line (not upstream) means the tree is genuinely diverged. This is the only proof
# available to a bare `ffprimary` that was told no landed head. A squash merge is NOT this shape:
# the squash's patch is the whole branch, not any single commit, so it needs the superset proof.
unpushed_are_upstream_equivalent() {
  local t="$1" out
  out=$(git -C "$t" cherry "origin/$DEFAULT_BRANCH" "$DEFAULT_BRANCH" 2>/dev/null) || return 1
  [ -n "$out" ] || return 1
  printf '%s\n' "$out" | grep -q '^+' && return 1
  return 0
}

# ff_primary_after_land <tree> [landed-head]  (wq#1536)
# Bring <tree>'s $DEFAULT_BRANCH up to origin/$DEFAULT_BRANCH by fast-forward, or say EXACTLY
# why not, with the one command that fixes it. Before this, a --worktree land returned right
# after the merge and never touched the primary at all: /home/lumen/fleet/inventory (PR #6)
# and /home/lumen/foreman (PR #362) each sat one commit behind origin/main on 2026-09-08
# until someone ran the ff by hand, while claude_memory.md said land does it. The --primary
# path did try, but hid git's stderr behind 2>/dev/null and guessed "uncommitted work?".
# Every exit here prints its reason. Checks, in order: git lock, in-progress operation,
# wrong branch, diverged (wq#792), dirty overlap (the only dirt that blocks an ff), then the
# ff itself with git's own stderr kept. Never moves HEAD off another branch — the primary is
# shared, and parking it elsewhere is someone's deliberate act. Returns 0 on ff or already
# current, 1 otherwise; callers in land treat 1 as "merged, primary needs a hand", not a die.
ff_primary_after_land() {
  # wq#2063: paths staged by drop_identical_overlap, so a refusal can put them back.
  STAGED_IDENTICAL=""
  local tree="$1" landed="${2:-}" cur p f ahead behind incoming overlap n err
  [ -d "$tree" ] || { note "primary $tree NOT fast-forwarded: directory does not exist"; return 1; }
  git -C "$tree" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { note "primary $tree NOT fast-forwarded: not a git work tree"; return 1; }
  cur=$(git -C "$tree" branch --show-current 2>/dev/null)
  p=$(git -C "$tree" rev-parse --git-path index.lock 2>/dev/null)
  case "$p" in /*) : ;; *) p="$tree/$p" ;; esac
  if [ -e "$p" ]; then
    note "primary $tree NOT fast-forwarded: git lock present ($p) — another git process is"
    note "  running there, or one died. If nothing holds it: rm '$p' && lumen-pr ffprimary $tree"
    return 1
  fi
  for f in MERGE_HEAD REBASE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
    p=$(git -C "$tree" rev-parse --git-path "$f" 2>/dev/null)
    case "$p" in /*) : ;; *) p="$tree/$p" ;; esac
    if [ -e "$p" ]; then
      note "primary $tree NOT fast-forwarded: an operation is in progress there ($f present)."
      note "  finish or abort it, then: lumen-pr ffprimary $tree"
      return 1
    fi
  done
  if [ "$cur" != "$DEFAULT_BRANCH" ]; then
    note "primary $tree NOT fast-forwarded: it is on '${cur:-(detached HEAD)}', not $DEFAULT_BRANCH."
    note "  land never moves HEAD in the shared primary tree. When that branch is done:"
    note "  git -C $tree checkout $DEFAULT_BRANCH && lumen-pr ffprimary $tree"
    # The REF can still be kept current (ISSUE-LOG #237 precedent, wq#1533): when
    # $DEFAULT_BRANCH is checked out in no worktree at all, moving refs/heads/$DEFAULT_BRANCH
    # touches no file anywhere, and the repo sweep compares that ref to origin. Only ever
    # forward (ancestor check), never when any tree has it checked out.
    if git -C "$tree" rev-parse --verify -q "refs/heads/$DEFAULT_BRANCH" >/dev/null 2>&1 \
       && ! git -C "$tree" worktree list --porcelain 2>/dev/null | grep -qx "branch refs/heads/$DEFAULT_BRANCH" \
       && git -C "$tree" merge-base --is-ancestor "$DEFAULT_BRANCH" "origin/$DEFAULT_BRANCH" 2>/dev/null; then
      behind=$(git -C "$tree" rev-list --count "$DEFAULT_BRANCH..origin/$DEFAULT_BRANCH" 2>/dev/null || echo 0)
      if [ "${behind:-0}" -gt 0 ] && git -C "$tree" branch -f "$DEFAULT_BRANCH" "origin/$DEFAULT_BRANCH" >/dev/null 2>&1; then
        note "  local $DEFAULT_BRANCH REF (checked out nowhere) fast-forwarded $behind commit(s) to $(git -C "$tree" rev-parse --short "$DEFAULT_BRANCH") — no files changed"
      fi
    fi
    return 1
  fi
  git -C "$tree" rev-parse --verify -q "refs/remotes/origin/$DEFAULT_BRANCH" >/dev/null 2>&1 \
    || { note "primary $tree NOT fast-forwarded: no origin/$DEFAULT_BRANCH ref (never fetched?)"; return 1; }
  ahead=$(git -C "$tree" rev-list --count "origin/$DEFAULT_BRANCH..$DEFAULT_BRANCH" 2>/dev/null || echo 0)
  if [ "${ahead:-0}" -gt 0 ]; then
    # wq#1121: "ahead" is not always divergence. The land that wq#1121 unblocks squashes the
    # tree's own un-pushed commits onto origin, which leaves them ahead by COMMIT while their
    # content is already there — and without a re-point the tree stays permanently diverged, so
    # every later land warns about work that is already on origin AND the wq#771 guard refuses the
    # next PR that touches those paths as un-pushed (wq#2099: that refusal is the loop wq#1121 was
    # supposed to end). Three proofs, cheapest first, each content-not-commit (the standard wq#1474
    # uses in the guard) and each failing closed to the wq#792 refusal below:
    #   equal trees — the branch added nothing to the local commits (the only wq#1121 case)
    #   superset    — the tree's tip is an ancestor of the head that JUST landed AND origin now
    #                 carries that head's blob on every path those commits touch. wq#1121 claimed
    #                 the trees would be identical after such a land; they are not when the branch
    #                 re-edited a path the local commit touched, which is wq#1108's own shape
    #   patch-id    — git cherry finds every local commit upstream-equivalent (a rebase or
    #                 cherry-pick land, and the only proof a bare `ffprimary` has with no head)
    local ltree rtree proof=""
    ltree=$(git -C "$tree" rev-parse -q --verify "$DEFAULT_BRANCH^{tree}" 2>/dev/null) || ltree=""
    rtree=$(git -C "$tree" rev-parse -q --verify "origin/$DEFAULT_BRANCH^{tree}" 2>/dev/null) || rtree=""
    if [ -n "$ltree" ] && [ "$ltree" = "$rtree" ]; then
      proof="already on origin by content (identical tree) — no file changed"
    elif landed_carries_unpushed "$tree" "$landed"; then
      proof="carried to origin by the head that just landed ($(git -C "$tree" rev-parse --short "$landed" 2>/dev/null)), which contains every one of them (wq#2099)"
    elif unpushed_are_upstream_equivalent "$tree"; then
      proof="already on origin by patch: git cherry finds every one upstream-equivalent (wq#2099)"
    fi
    if [ -n "$proof" ]; then
      # Never move a tree whose uncommitted work overlaps the move. Under the equal-tree proof no
      # tracked file differs, so nothing could; the two wq#2099 proofs DO rewrite files, and while
      # `reset --keep` refuses such an overlap itself, checking first names the paths instead of
      # echoing git. --keep, not --hard, still: uncommitted work outside the overlap survives.
      incoming=$(git -C "$tree" -c core.quotePath=false diff --name-only \
                   "$DEFAULT_BRANCH" "origin/$DEFAULT_BRANCH" 2>/dev/null | LC_ALL=C sort -u)
      overlap=$(LC_ALL=C comm -12 <(printf '%s\n' "$incoming") <(tree_uncommitted "$tree"))
      drop_identical_overlap "$tree"
      if [ -n "$overlap" ]; then
        n=$(printf '%s\n' "$overlap" | grep -c .)
        note "primary $tree NOT re-pointed: its $ahead local commit(s) are $proof, but $n uncommitted path(s) there overlap the re-point:"
        printf '%s\n' "$overlap" | sed 's/^/    /'
        note "  commit or discard them (git -C $tree status --short), then: lumen-pr ffprimary $tree"
        unstage_identical "$tree"
        return 1
      fi
      local pre_move
      pre_move=$(git -C "$tree" rev-parse HEAD 2>/dev/null)
      if err=$(git -C "$tree" reset --keep "origin/$DEFAULT_BRANCH" 2>&1); then
        verify_ff_restored "$tree" "$pre_move" || return 1
        note "primary $tree re-pointed to origin/$DEFAULT_BRANCH ($(git -C "$tree" rev-parse --short HEAD)): its $ahead local commit(s) are $proof"
        return 0
      fi
      note "primary $tree NOT re-pointed: git reset --keep origin/$DEFAULT_BRANCH refused:"
      printf '%s\n' "${err:-(git printed nothing)}" | sed 's/^/    /'
    fi
    note "primary $tree NOT fast-forwarded: local $DEFAULT_BRANCH has $ahead commit(s) origin does not (diverged, wq#792):"
    git -C "$tree" log --oneline "origin/$DEFAULT_BRANCH..$DEFAULT_BRANCH" 2>/dev/null | sed 's/^/    /'
    note "  push them (git -C $tree push origin $DEFAULT_BRANCH) or land them as their own PR, then: lumen-pr ffprimary $tree"
    unstage_identical "$tree"
    return 1
  fi
  behind=$(git -C "$tree" rev-list --count "$DEFAULT_BRANCH..origin/$DEFAULT_BRANCH" 2>/dev/null || echo 0)
  if [ "${behind:-0}" = 0 ]; then
    note "primary $tree already at origin/$DEFAULT_BRANCH ($(git -C "$tree" rev-parse --short HEAD))"
    return 0
  fi
  incoming=$(git -C "$tree" -c core.quotePath=false diff --name-only \
               "$DEFAULT_BRANCH" "origin/$DEFAULT_BRANCH" 2>/dev/null | LC_ALL=C sort -u)
  overlap=$(LC_ALL=C comm -12 <(printf '%s\n' "$incoming") <(tree_uncommitted "$tree"))
  # wq#1490: an uncommitted path whose live bytes ARE the incoming blob is not in the way —
  # the guard just let that PR land on exactly that proof, and refusing the ff here would
  # leave the primary behind for the same non-reason.
  drop_identical_overlap "$tree"
  if [ -n "$overlap" ]; then
    n=$(printf '%s\n' "$overlap" | grep -c .)
    note "primary $tree NOT fast-forwarded: $n uncommitted path(s) there overlap the $behind incoming commit(s):"
    printf '%s\n' "$overlap" | sed 's/^/    /'
    note "  commit or discard them (git -C $tree status --short), then: lumen-pr ffprimary $tree"
    unstage_identical "$tree"
    return 1
  fi
  local pre_ff
  pre_ff=$(git -C "$tree" rev-parse HEAD 2>/dev/null)
  if err=$(git -C "$tree" merge --ff-only "origin/$DEFAULT_BRANCH" -q 2>&1); then
    verify_ff_restored "$tree" "$pre_ff" || return 1
    note "primary $tree fast-forwarded $behind commit(s) to $(git -C "$tree" rev-parse --short HEAD)"
    return 0
  fi
  note "primary $tree NOT fast-forwarded: git merge --ff-only origin/$DEFAULT_BRANCH failed:"
  printf '%s\n' "${err:-(git printed nothing)}" | sed 's/^/    /'
  note "  fix the cause above, then: lumen-pr ffprimary $tree"
  unstage_identical "$tree"
  return 1
}

# dirty_target_guard <refuse|warn> <label> <newline-separated paths>
# Paths arrive as an ARGUMENT, never on stdin: a function on the right of a pipe runs in
# a subshell, so `die` inside it would exit that subshell and the land would carry on.
dirty_target_guard() {
  local mode="$1" label="$2" paths="$3" head_sha="${4:-}" primary sorted uncommitted unpushed hits n
  [ -n "$paths" ] || return 0
  if ! primary=$(primary_worktree); then
    note "WARNING: cannot resolve the primary work tree of $SLUG — dirty-target guard (wq#771) SKIPPED" >&2
    return 0
  fi
  sorted=$(printf '%s\n' "$paths" | grep -v '^$' | LC_ALL=C sort -u)
  uncommitted=$(LC_ALL=C comm -12 <(printf '%s\n' "$sorted") <(tree_uncommitted "$primary"))
  unpushed=$(LC_ALL=C comm -12 <(printf '%s\n' "$sorted") <(tree_unpushed "$primary"))

  # wq#1121: an un-pushed commit on the target tree is only a hazard when the merge lands a
  # version of those paths that never saw it. When the target tree's $DEFAULT_BRANCH tip is an
  # ANCESTOR of the PR head, the branch CONTAINS those commits — it is a strict superset of the
  # target tree — so the squash carries them to origin instead of superseding them. That is
  # exactly what the refusal below tells the operator to do ("land it as its own PR, then
  # this"), and until now the guard refused that very PR: wq#1108 could not close a branch that
  # was foreman main 035bedb plus one commit. Whole-set, not per-path, because ancestry is one
  # statement about every commit in the range. Never touches $uncommitted: work in no commit
  # cannot be vouched for by any ancestry. Fails closed — an unresolvable tip or head, or a
  # non-zero merge-base, leaves every hit standing.
  if [ -n "$head_sha" ] && [ -n "$unpushed" ]; then
    local primary_tip dropped
    primary_tip=$(git -C "$primary" rev-parse -q --verify "refs/heads/$DEFAULT_BRANCH^{commit}" 2>/dev/null) || primary_tip=""
    if [ -n "$primary_tip" ] \
       && git -C "$REPO_PATH" cat-file -e "${head_sha}^{commit}" 2>/dev/null \
       && git -C "$REPO_PATH" cat-file -e "${primary_tip}^{commit}" 2>/dev/null \
       && git -C "$REPO_PATH" merge-base --is-ancestor "$primary_tip" "$head_sha" 2>/dev/null; then
      dropped=$(printf '%s\n' "$unpushed" | grep -c .)
      note "wq#1121: $primary $DEFAULT_BRANCH ($(git -C "$REPO_PATH" rev-parse --short "$primary_tip")) is an ancestor of ${label} head ${head_sha} — the branch is a superset of the target tree, so landing supersedes nothing; dropping $dropped un-pushed path(s)"
      unpushed=""
    fi
  fi

  # wq#1474: "unpushed" only means the primary tree is ahead of origin on this path —
  # it does NOT mean the PR being landed diverges from that unpushed content. When the
  # PR head carries the byte-identical blob for a path (e.g. it IS the push of that same
  # unpushed commit, possibly rebased — rebasing changes the COMMIT sha but not a file's
  # BLOB sha), landing supersedes nothing there. Narrow, content-scoped, provable: only
  # ever drops entries from the unpushed set, never uncommitted (no commit to diff
  # against there), and only when both blobs are actually resolvable and equal — any
  # failure to resolve either side leaves the path a hit (fails closed, not open).
  if [ -n "$head_sha" ] && [ -n "$unpushed" ] \
      && git -C "$REPO_PATH" cat-file -e "${head_sha}^{commit}" 2>/dev/null; then
    local path b_primary b_pr still_unpushed=""
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      b_primary=$(git -C "$primary" rev-parse -q --verify "${DEFAULT_BRANCH}:${path}" 2>/dev/null) || b_primary=""
      b_pr=$(git -C "$REPO_PATH" rev-parse -q --verify "${head_sha}:${path}" 2>/dev/null) || b_pr=""
      if [ -n "$b_primary" ] && [ "$b_primary" = "$b_pr" ]; then
        note "wq#1474: $path unpushed in $primary but blob-identical to PR head $head_sha — not a real collision, dropping"
      else
        still_unpushed="${still_unpushed}${path}
"
      fi
    done <<EOF_UNPUSHED
$unpushed
EOF_UNPUSHED
    unpushed=$(printf '%s' "$still_unpushed" | grep -v '^$' | LC_ALL=C sort -u)
  fi

  # wq#1490: the same content test for UNCOMMITTED paths, by live bytes instead of a commit.
  # lumen-bin PR#75 was refused on 2026-09-08 because two scripts had been patched in place
  # in /home/lumen/bin (a wq#1454 orchestrator apply) and the PR carried that identical
  # content: "work origin does not have" was literally true and operationally empty, since
  # landing would have changed nothing on disk. wq#1474 could not cover it — it compares the
  # tree's COMMITTED blob, and this work is in no commit — so hash the working-tree file
  # itself (live_blob) against the PR head's blob. Same discipline: both sides resolvable and
  # equal or the path stays a hit. A staged-but-different index, a symlink, or a deleted
  # file all fail closed.
  if [ -n "$head_sha" ] && [ -n "$uncommitted" ] \
      && git -C "$REPO_PATH" cat-file -e "${head_sha}^{commit}" 2>/dev/null; then
    local path b_pr b_live still_uncommitted=""
    while IFS= read -r path; do
      [ -n "$path" ] || continue
      b_live=$(live_blob "$primary" "$path")
      b_pr=$(git -C "$REPO_PATH" rev-parse -q --verify "${head_sha}:${path}" 2>/dev/null) || b_pr=""
      if [ -n "$b_live" ] && [ -n "$b_pr" ] && [ "$b_live" = "$b_pr" ]; then
        note "wq#1490: $path uncommitted in $primary but its live bytes are PR head $head_sha's blob — landing changes nothing there, dropping"
      else
        still_uncommitted="${still_uncommitted}${path}
"
      fi
    done <<EOF_UNCOMMITTED
$uncommitted
EOF_UNCOMMITTED
    uncommitted=$(printf '%s' "$still_uncommitted" | grep -v '^$' | LC_ALL=C sort -u)
  fi

  hits=$(printf '%s\n%s\n' "$uncommitted" "$unpushed" | grep -v '^$' | LC_ALL=C sort -u)
  [ -n "$hits" ] || return 0
  n=$(printf '%s\n' "$hits" | grep -c .)

  {
    printf 'lumen-pr: TARGET TREE HAS WORK ORIGIN DOES NOT (wq#771/wq#792)\n'
    printf '  target tree: %s\n' "$primary"
    printf '  %s path(s) this %s touches are affected:\n' "$n" "$label"
    if [ -n "$uncommitted" ]; then
      printf '  uncommitted there:\n'
      printf '%s\n' "$uncommitted" | sed 's/^/    /'
    fi
    if [ -n "$unpushed" ]; then
      printf '  in a local commit on %s never pushed to origin:\n' "$DEFAULT_BRANCH"
      printf '%s\n' "$unpushed" | sed 's/^/    /'
    fi
  } >&2

  # Non-zero from here down means "collision found". Nothing runs under `set -e`, so this
  # never aborts a caller by itself; it gives dirtycheck (and any future caller) something
  # to branch on without re-deriving the answer.
  if [ "$mode" != refuse ]; then
    note "WARNING: if this branch lands while that stays uncommitted/un-pushed, land will refuse (wq#771/wq#792)" >&2
    return 1
  fi

  if [ -n "${LUMEN_PR_ALLOW_DIRTY:-}" ]; then
    note "LUMEN_PR_ALLOW_DIRTY is RETIRED (wq#1282) and does nothing — resolve the target tree instead." >&2
  fi

  die "refusing to land over work the target tree $primary has that origin does not (listed above).
      Merging now lands a version of those paths branched from origin/$DEFAULT_BRANCH, which
      never saw the local work. Git will report NO conflict — there is nothing on that side to
      conflict with — so the local work is superseded silently and then reads as stale debris.
      That is the 2026-08-21 dispatcher stall (wq#771): build lane deleted, 42 tickets invisible,
      ~3h dead. An un-pushed commit (wq#792) is the same shape: it merges fine on the forge and
      silently never reaches the tree every agent actually runs out of.

      Decide in the TARGET tree, then re-run this land:
        git -C $primary status --short                                        # uncommitted?
        git -C $primary log --oneline origin/$DEFAULT_BRANCH..$DEFAULT_BRANCH  # un-pushed commit(s)?
      keep uncommitted work (land that first, then this):
        git -C $primary add -- <path> && git -C $primary commit -m '<type>(<scope>): <what>'
      keep an un-pushed commit (push it, or land it as its own PR, then this):
        git -C $primary push origin $DEFAULT_BRANCH
      discard it, deliberately:
        git -C $primary checkout -- <path>                          # tracked, modified
        rm -- $primary/<path>                                       # untracked
        git -C $primary reset --hard origin/$DEFAULT_BRANCH          # discard un-pushed commit(s) — destructive

      There is no override (LUMEN_PR_ALLOW_DIRTY retired, wq#1282; land --allow-dirty is
      accepted but inert, wq#1121). Runtime state that used to trip this guard now lives under
      gitignored runtime/ dirs, so a hit here is real work. The one automatic clearance is
      wq#1121: if this branch already CONTAINS the target tree's un-pushed commits, the guard
      drops them itself — reaching this message means it does not, or the hit is uncommitted."
}

# The paths a PR touches. Resolved LOCALLY where possible: merge-base(origin/default, head)
# ..head is exactly the set the squash lands, needs no pagination, and cannot be silently
# capped the way GitHub's /pulls/N/files is (30 per page, 300 files hard cap). The forge is
# the fallback for landing a PR whose head this clone has never fetched.
pr_changed_files() { # pr_changed_files <pr-number> <head-sha>
  local pr="$1" sha="$2" base
  if ! git -C "$REPO_PATH" cat-file -e "${sha}^{commit}" 2>/dev/null; then
    git -C "$REPO_PATH" fetch -q origin 2>/dev/null || true
  fi
  if git -C "$REPO_PATH" cat-file -e "${sha}^{commit}" 2>/dev/null; then
    base=$(git -C "$REPO_PATH" merge-base "origin/$DEFAULT_BRANCH" "$sha" 2>/dev/null)
    if [ -n "$base" ]; then
      # --name-status (not --name-only): an R100 rename reports ONLY the new filename
      # under --name-only, so the guard never checks the OLD path for uncommitted edits
      # there (wq#864). --name-status prints "R100\told\tnew" — emit both columns.
      git -C "$REPO_PATH" -c core.quotePath=false diff --name-status "$base" "$sha" | \
        awk -F'\t' '{ if ($1 ~ /^R/) { print $2; print $3 } else { print $2 } }'
      return 0
    fi
  fi
  # wq#2273: the forge fallback is the broker's pr-files verb — previous_filename
  # included daemon-side (a rename lands a DELETE of the old path, wq#864).
  if ! broker pr-files "$pr"; then
    note "WARNING: could not list PR #$pr files via broker [$BROKER_RULE] — the wq#771 guard is running on an INCOMPLETE file list" >&2
    return 0
  fi
  rget '.files' | grep -v '^$'
  [ "$(rget '.complete')" = true ] || \
    note "WARNING: PR #$pr changes more than 500 files — the wq#771 guard checked the first 500" >&2
  return 0
}

# start knows no file set (nothing is written yet), so the useful thing to say is WHICH
# paths are landmines: touch one and `land` will refuse.
dirty_target_start_notice() {
  # Called only from the --worktree branch, where the caller is about to go and work
  # SOMEWHERE ELSE. In the --primary flow the caller is standing in this tree and the
  # existing "uncommitted files carried into the branch" line already says it.
  local primary dirty n
  primary=$(primary_worktree) || return 0
  dirty=$(git -C "$primary" -c core.quotePath=false diff --name-only 2>/dev/null
          git -C "$primary" -c core.quotePath=false diff --cached --name-only 2>/dev/null)
  dirty=$(printf '%s\n' "$dirty" | grep -v '^$' | LC_ALL=C sort -u)
  [ -n "$dirty" ] || return 0
  n=$(printf '%s\n' "$dirty" | grep -c .)
  note "NOTE (wq#771): $n path(s) are uncommitted in the target tree $primary."
  note "  Your branch starts from origin/$DEFAULT_BRANCH and does NOT contain those edits."
  note "  Touch any of them and 'lumen-pr land' will refuse until they are committed or discarded:"
  printf '%s\n' "$dirty" | head -20 | sed 's/^/    /'
  [ "$n" -gt 20 ] && printf '    ... and %s more (git -C %s status --short)\n' "$((n - 20))" "$primary"
  return 0
}

# --- worktree ownership (wq#598) --------------------------------------------
# A worktree path is $WORKTREE_ROOT/<repo>-<branch-slug>, and §2 FORBIDS ticket ids and agent
# names inside a branch name — so the path is derived entirely from a slug that two sessions can
# independently choose. `-d "$wt"` used to be note-and-proceed, which meant a second session
# silently inherited whatever a sibling had left in that directory.
# The owner record lives OUTSIDE the worktree, under $WORKTREE_ROOT/.owners/, so it never appears
# in the repo's own `git status`; a marker file inside the tree would be untracked noise in every
# repo we ever clone, and the first agent to `git add -A` would commit it.
WT_OWNER_DIR="$WORKTREE_ROOT/.owners"

# WQ_AGENT is the only STABLE session identity available here. GITLOCK_HOLDER is not usable for
# this: it falls back to a pid, and every lumen-pr call is a new process, so a pid-derived owner
# would never match itself on the next call. Unset WQ_AGENT means we genuinely cannot tell one
# caller from another, so we claim no ownership at all rather than write a name that matches
# everybody. NOTE THE DELIBERATE HOLE: two drivers sharing one WQ_AGENT (the wq#594 case) match
# each other and pass silently. That is correct — wq#594's claim-time notice is what covers it.
wt_owner_id() { printf '%s' "${WQ_AGENT:-}"; }

wt_owner_write() {
  local wt="$1" id; id=$(wt_owner_id)
  [ -n "$id" ] || return 0
  mkdir -p "$WT_OWNER_DIR" 2>/dev/null || return 0
  printf 'agent=%s\ncreated=%s\n' "$id" "$(date -u +%FT%TZ)" \
    > "$WT_OWNER_DIR/$(basename "$wt")" 2>/dev/null || true
}

wt_owner_read() {
  local f="$WT_OWNER_DIR/$(basename "$1")"
  [ -f "$f" ] && sed -n 's/^agent=//p' "$f" | head -1
}

# Grade by the STATE of the tree, not by ownership alone — the wq#565 precedent (grade by property
# of the thing, not by which bucket it sits in). Adopting a CLEAN worktree already parked on the
# branch you asked for cannot lose anyone's work, and refusing there would fire on the one real
# abandoned worktree on this box today. Adopting a dirty one, or one parked on another branch, can.
wt_reuse_guard() {
  local wt="$1" branch="$2" adopt="$3"
  local owner me cur dirty who
  owner=$(wt_owner_read "$wt"); me=$(wt_owner_id)

  if [ -n "$me" ] && [ "$owner" = "$me" ]; then
    note "worktree already exists and is yours ($me): $wt"
    return 0
  fi

  cur=$(git -C "$wt" branch --show-current 2>/dev/null) || cur=""
  [ -n "$cur" ] || cur="(not a git worktree)"
  dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  who="${owner:-UNKNOWN (predates this guard, or an unregistered caller made it)}"

  if [ "$adopt" = 1 ]; then
    note "ADOPTING worktree owned by $who: $wt (on $cur, $dirty uncommitted path(s))"
    wt_owner_write "$wt"; return 0
  fi

  if [ "$cur" = "$branch" ] && [ "${dirty:-1}" = 0 ]; then
    note "worktree $wt exists and was made by $who, but it is CLEAN and already on $branch."
    note "adopting it — nothing of theirs can be lost this way. Say so in your report."
    wt_owner_write "$wt"; return 0
  fi

  die "refusing to reuse worktree $wt
      made by    : $who
      on branch  : $cur (you asked for $branch)
      uncommitted: $dirty path(s)
      A sibling session may be mid-ticket in there. §2 says two agents never share a branch, but a
      branch slug carries no ticket id and no agent name, so nothing in the path keeps you apart.
      Pick a different slug, or re-run with --adopt once you have established that tree is stale."
}

# --- subcommands ------------------------------------------------------------
cmd_start() {
  need_repo "${1:-}"; local branch="${2:-}"; shift 2 2>/dev/null || true
  local want_worktree=0 primary_ok=0 adopt_ok=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --worktree) want_worktree=1; shift ;;
      --primary)  primary_ok=1; shift ;;
      --adopt)    adopt_ok=1; want_worktree=1; shift ;;
      *) die "unknown flag for start: $1" ;;
    esac
  done
  [ -n "$branch" ] || die "usage: lumen-pr start <repo-path> <type>/<slug> [--worktree|--primary|--adopt]"

  # wq#512 SHARED-TREE FENCE. /home/lumen/pokemon is the PRIMARY tree and it belongs to the
  # pokemon lane, which runs live agents against it continuously. A github-lane agent that
  # checks out a feature branch there parks the shared tree mid-session — this already
  # happened once. On a fenced tree, --worktree is the default and moving HEAD is opt-in.
  case "$(cd "$REPO_PATH" && pwd -P)" in
    /home/lumen/pokemon)
      if [ "$want_worktree" = 0 ] && [ "$primary_ok" = 0 ]; then
        note "FENCED TREE (wq#512): /home/lumen/pokemon is shared with the live pokemon lane."
        note "defaulting to --worktree. Pass --primary only if you OWN the lpp-tree subsystem"
        note "(wq claim ... --subsystems lpp-tree) and no sibling agent has work in flight."
        want_worktree=1
      elif [ "$primary_ok" = 1 ]; then
        local wt_count; wt_count=$(git -C "$REPO_PATH" worktree list 2>/dev/null | grep -vc "^$REPO_PATH ")
        [ "${wt_count:-0}" -gt 0 ] && \
          die "refusing --primary: $wt_count linked worktree(s) are live, so a sibling agent is
      mid-ticket. Use --worktree instead, or wait. (git -C $REPO_PATH worktree list)"
        note "WARNING: moving HEAD in the SHARED primary tree by explicit --primary. Say so in your report."
      fi ;;
  esac
  printf '%s' "$branch" | grep -qE "$BRANCH_RE" || \
    die "branch name violates §2: expected <type>/<short-kebab-slug>, no ticket IDs, no agent names
      types: ${CONV_TYPES//|/ }
      got  : $branch"

  # --worktree: cut the branch in a private linked worktree instead of moving
  # HEAD in a tree that sibling agents are working in (§2: "each agent works in
  # its OWN branch/worktree. Two agents never share a branch.").
  if [ "$want_worktree" = 1 ]; then
    local wt="$WORKTREE_ROOT/$(basename "$REPO_PATH")-$(printf '%s' "$branch" | tr '/' '-')"
    if [ -d "$wt" ]; then
      wt_reuse_guard "$wt" "$branch" "$adopt_ok"
    else
      mkdir -p "$WORKTREE_ROOT"
      git -C "$REPO_PATH" fetch -q origin || die "git fetch failed"
      if git -C "$REPO_PATH" show-ref --quiet "refs/heads/$branch"; then
        git -C "$REPO_PATH" worktree add -q "$wt" "$branch" || die "could not add worktree for existing branch $branch"
      else
        git -C "$REPO_PATH" worktree add -q -b "$branch" "$wt" "origin/$DEFAULT_BRANCH" || \
          die "could not add worktree $wt on new branch $branch"
      fi
      wt_owner_write "$wt"
      note "created worktree $wt on $branch from origin/$DEFAULT_BRANCH"
    fi
    dirty_target_start_notice
    note "the shared tree at $REPO_PATH was NOT touched (still on $(git -C "$REPO_PATH" branch --show-current))"
    note "next: work in $wt, then: lumen-pr commit $wt \"<subject>\" --refs wq#N"
    printf '%s\n' "$wt"
    return 0
  fi

  local cur; cur=$(git -C "$REPO_PATH" branch --show-current)
  if [ "$cur" = "$branch" ]; then note "already on $branch — nothing to do"; return 0; fi
  if [ "$cur" != "$DEFAULT_BRANCH" ]; then
    die "HEAD is on '$cur', not '$DEFAULT_BRANCH'. Another agent may have a branch in flight in this
      shared working tree. Land or abandon it first (lumen-pr check $REPO_PATH)."
  fi
  git -C "$REPO_PATH" fetch -q origin || die "git fetch failed"
  if ! git -C "$REPO_PATH" merge-base --is-ancestor HEAD "origin/$DEFAULT_BRANCH" 2>/dev/null; then
    note "WARNING: local $DEFAULT_BRANCH has commits not on origin — branching from local HEAD"
  else
    git -C "$REPO_PATH" merge --ff-only "origin/$DEFAULT_BRANCH" -q 2>/dev/null || \
      note "WARNING: could not fast-forward $DEFAULT_BRANCH (dirty tree overlaps incoming changes) — branching from local HEAD"
  fi
  if git -C "$REPO_PATH" show-ref --quiet "refs/heads/$branch"; then
    git -C "$REPO_PATH" checkout -q "$branch" || die "checkout $branch failed"
    note "branch $branch already existed — checked out"
  else
    git -C "$REPO_PATH" checkout -q -b "$branch" || die "could not create branch $branch"
    note "created $branch from $(git -C "$REPO_PATH" rev-parse --short HEAD)"
  fi
  note "uncommitted files carried into the branch (unchanged): $(git -C "$REPO_PATH" status --porcelain | wc -l)"
  note "next: git -C $REPO_PATH add <only-the-paths-you-touched>  then  lumen-pr commit"
}

cmd_commit() {
  need_repo "${1:-}"; local subject="${2:-}"; shift 2 2>/dev/null || true
  local refs="" body_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --refs) refs="${2:-}"; shift 2 ;;
      --body-file) body_file="${2:-}"; shift 2 ;;
      *) die "unknown flag for commit: $1" ;;
    esac
  done
  lint_subject "$subject"
  local cur; cur=$(git -C "$REPO_PATH" branch --show-current)
  [ "$cur" = "$DEFAULT_BRANCH" ] && \
    die "refusing to commit directly to '$DEFAULT_BRANCH' (§2, §10.1). Run: lumen-pr start $REPO_PATH <type>/<slug>"
  git -C "$REPO_PATH" diff --cached --quiet && \
    die "nothing staged. Stage ONLY the paths this ticket touched: git -C $REPO_PATH add <paths>  (git add -A is banned, §10.8)"
  # wq#771: warn, never refuse. Committing destroys nothing in the target tree — landing
  # does. Saying it here means the collision is visible while the branch is still cheap to
  # re-scope, instead of at land time after CI has run. Skipped when this IS the target
  # tree: then the staged files are the caller's own work, and warning about them is noise.
  if ! primary_worktree >/dev/null || ! same_tree "$REPO_PATH" "$(primary_worktree)"; then
    dirty_target_guard warn "commit" "$(git -C "$REPO_PATH" -c core.quotePath=false diff --cached --name-only)"
  fi
  local msg; msg="$subject"
  if [ -n "$body_file" ]; then
    [ -r "$body_file" ] || die "cannot read body file: $body_file"
    msg="$msg

$(cat "$body_file")"
  fi
  msg="$msg
"
  [ -n "$refs" ] && msg="$msg
Refs: $refs"
  msg="$msg
$FOOTER_ASSIST"
  # wq#657: record HEAD before the commit so we can detect a silent no-op — git
  # commit exits 0 in some edge cases without actually creating a commit (e.g.
  # empty diff after rebase, or an amend that collapses to the same tree).
  local pre_head; pre_head=$(git -C "$REPO_PATH" rev-parse HEAD)
  printf '%s\n' "$msg" | git -C "$REPO_PATH" commit -q -F - || die "git commit failed"
  local post_head; post_head=$(git -C "$REPO_PATH" rev-parse HEAD)
  [ "$pre_head" != "$post_head" ] || die "git commit exited 0 but HEAD did not move ($pre_head). This is a silent no-op — stage the right files and retry."
  note "committed $(git -C "$REPO_PATH" rev-parse --short HEAD) on $cur"
  git -C "$REPO_PATH" log -1 --pretty='  %s' 
  note "staged files in this commit:"
  git -C "$REPO_PATH" show --stat --oneline HEAD | tail -n +2 | sed 's/^/  /'
}

cmd_open() {
  need_repo "${1:-}"; shift
  local title="" body_file="" draft=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) title="${2:-}"; shift 2 ;;
      --body-file) body_file="${2:-}"; shift 2 ;;
      --draft) draft=true; shift ;;
      --allow-second-person) ALLOW_SECOND_PERSON=1; shift ;;
      *) die "unknown flag for open: $1" ;;
    esac
  done
  [ -n "$title" ] || die "missing --title"
  [ -n "$body_file" ] && [ -r "$body_file" ] || die "missing or unreadable --body-file"
  local body; body=$(cat "$body_file")
  lint_subject "$title"
  lint_body_sections "$body"
  lint_second_person "$title" "PR title"
  lint_second_person "$body" "PR body"

  local branch; branch=$(git -C "$REPO_PATH" branch --show-current)
  [ "$branch" = "$DEFAULT_BRANCH" ] && die "on '$DEFAULT_BRANCH' — nothing to open a PR from (§2)"
  git -C "$REPO_PATH" rev-parse --verify -q "origin/$DEFAULT_BRANCH" >/dev/null || git -C "$REPO_PATH" fetch -q origin
  [ -n "$(git -C "$REPO_PATH" log --oneline "origin/$DEFAULT_BRANCH..$branch" 2>/dev/null)" ] || \
    die "branch '$branch' has no commits ahead of origin/$DEFAULT_BRANCH — nothing to review"

  git -C "$REPO_PATH" push -q -u origin "$branch" 2>&1 | redact || die "push of $branch failed"
  note "pushed $branch"

  # wq#2273: find-or-create-or-update is the DAEMON's pr-open, including the
  # wq#557 dedup (Gitea ignores the head= filter, so the daemon matches on
  # head.ref client-side — an open PR for a different branch is never patched).
  # Title and body go as staged file paths, never argv.
  te_grant
  local title_f body_f draft_arg=nodraft
  title_f=$(te_stage_text "$title") || die "cannot stage PR title for the broker"
  body_f=$(te_stage "$body_file") || die "cannot stage PR body for the broker"
  [ "$draft" = true ] && draft_arg=draft
  broker pr-open "$branch" "$DEFAULT_BRANCH" "$title_f" "$body_f" "$draft_arg" \
    || broker_fail "PR open"
  PR_NUMBER=$(rget '.number')
  if [ "$(rget '.action')" = updated ]; then
    note "PR #$PR_NUMBER already open for $branch — updated title/body"
  else
    note "opened PR #$PR_NUMBER"
  fi
  rget '.url'
}

# wq#2273: PR comments through the broker's pr-comment verb (grant kind
# pr_comment). Body as a staged file path, same as open.
cmd_comment() {
  need_repo "${1:-}"; shift
  local pr="" body_file=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --body-file) body_file="${2:-}"; shift 2 ;;
      --allow-second-person) ALLOW_SECOND_PERSON=1; shift ;;
      -*) die "unknown flag for comment: $1" ;;
      *) [ -z "$pr" ] || die "unexpected argument '$1'"; pr="$1"; shift ;;
    esac
  done
  [ -n "$pr" ] || die "usage: lumen-pr comment <repo-path> <pr-number> --body-file F"
  [ -n "$body_file" ] && [ -r "$body_file" ] || die "missing or unreadable --body-file"
  lint_second_person "$(cat "$body_file")" "PR comment"
  te_grant
  local staged
  staged=$(te_stage "$body_file") || die "cannot stage comment body for the broker"
  broker pr-comment "$pr" "$staged" || broker_fail "PR comment"
  note "commented on PR #$pr (comment id $(rget '.id'))"
  rget '.url'
}

# wq#563: forge-aware pre-merge mergeability guard. Reads the PR body already in
# the pr-view result (cmd_land re-fetches immediately before merging) and either dies, warns, or
# stays silent.
#
# THE DEFECT: this used to switch on .mergeable_state unconditionally. That is a GITHUB
# field. Gitea returns null for it, so BOTH arms of the case were dead on a Gitea repo and
# the guard silently did nothing — verified against the live instance (1.26.4), not assumed.
#
# WHY NOT A ONE-LINE PORT: Gitea exposes .mergeable, a BOOLEAN. That is a different
# contract from GitHub's enum, and false does NOT mean "conflict" specifically — it also
# covers unmet branch protection. Mapping false -> "merge conflicts" would print a
# confident wrong diagnosis, which is worse than the silence it replaces. So the Gitea arm
# names BOTH candidate causes and refuses to pick one.
#
# WHY IT STILL DIES ON false: measured on a deliberately conflicting PR — Gitea's own merge
# call answers HTTP 405 {"message":"Please try again later"}. That reads as a TRANSIENT
# fault for a PERMANENT conflict, and an agent obeying it retries forever. Failing here
# with a real reason is strictly better than passing that message up.
#
# UNKNOWN IS NEVER A DIAGNOSIS: null/absent/"unknown" warns and proceeds on both forges.
# The merge call is authoritative; a guard that guesses is worse than one that abstains.
# Deliberately NOT polling for it: on Gitea both verdicts were stable and immediate at
# +0s through +8s on freshly-opened PRs (conflicted false, clean true), so a poll would add
# latency to the lock-held window — the exact cost wq#532a was filed about — to fix a race
# never observed. If an unknown is ever seen in the wild, revisit with that evidence.
mergeability_guard() {
  # Reads the pr-view result the caller just fetched into BROKER_RESULT (wq#2273).
  local pr="$1" ms mf
  ms=$(rget '.mergeable_state // "null"')
  mf=$(rget 'if .mergeable == null then "null" else (.mergeable|tostring) end')

  if [ "${FORGE:-github}" = gitea ]; then
    case "$mf" in
      true)  : ;;   # clean
      false)
        die "PR #$pr is NOT MERGEABLE into $DEFAULT_BRANCH (gitea reports mergeable=false).
      Gitea does not say WHICH, and this tool will not guess. It is one of:
        - a merge conflict with $DEFAULT_BRANCH  -> rebase the branch onto $DEFAULT_BRANCH
        - an unmet branch-protection requirement -> check required approvals/status checks
      Do not just retry: gitea's merge endpoint answers 405 'Please try again later' for a
      permanent conflict, which is why this is caught here instead." ;;
      *)
        note "WARNING: gitea did not report mergeability for PR #$pr (mergeable=null) — attempting merge anyway" ;;
    esac
    return 0
  fi

  # GitHub: today's exact behaviour is preserved. dirty dies, blocked warns, everything
  # else proceeds silently — deliberately unchanged, because lumen-pr is how every lane
  # lands and this is not the ticket to retune GitHub's thresholds.
  case "$ms" in
    dirty) die "PR #$pr has merge conflicts with $DEFAULT_BRANCH — rebase the branch first" ;;
    blocked) note "WARNING: mergeable_state=blocked (ruleset requirement unmet) — attempting merge anyway" ;;
    unknown|null) note "WARNING: github has not finished computing mergeability for PR #$pr (mergeable_state=$ms) — attempting merge anyway" ;;
  esac
}

cmd_land() {
  need_repo "${1:-}"; local pr="${2:-}"; shift 2 2>/dev/null || true
  local timeout=600 merge_method=squash
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout) timeout="${2:-600}"; shift 2 ;;
      --merge) merge_method=merge; shift ;;
      # wq#1121: recognised and deliberately inert. A headless worker that trips the wq#771
      # guard is told to use an override; the env one (LUMEN_PR_ALLOW_DIRTY) was retired by
      # wq#1282 AND is unreachable anyway, because the worker allowlist matches the bare
      # `/home/lumen/bin/lumen-pr` prefix and an `VAR=1 lumen-pr ...` line does not start
      # with it. So the worker reached for --allow-dirty and got `unknown flag`: a dead end
      # at both doors. Accepting it here costs nothing, says once that no override exists,
      # and stops a land that would have passed anyway from dying in argument parsing.
      --allow-dirty)
        note "WARNING: --allow-dirty is accepted but does NOTHING (wq#1121). The wq#771/wq#792" >&2
        note "  target-tree guard has had no override since wq#1282 — a trip is real work about to" >&2
        note "  be superseded, and the refusal prints the exact commands that resolve it. If this" >&2
        note "  branch already CONTAINS the target tree's un-pushed commits, the guard clears" >&2
        note "  itself and this land proceeds with no flag at all." >&2
        shift ;;
      *) die "unknown flag for land: $1" ;;
    esac
  done
  [ -n "$pr" ] || die "usage: lumen-pr land <repo-path> <pr-number>"
  broker pr-view "$pr" || broker_fail "PR fetch"
  local state merged head_sha head_ref draft
  state=$(rget '.state')
  merged=$(rget '.merged')
  draft=$(rget '.draft')
  head_sha=$(rget '.head_sha')
  head_ref=$(rget '.head_ref')
  if [ "$merged" = true ]; then note "PR #$pr is already merged — nothing to do"; return 0; fi
  [ "$state" = open ] || die "PR #$pr is '$state', not open"
  [ "$draft" = true ] && die "PR #$pr is a draft — mark it ready before landing (§5)"

  # wq#771: BEFORE the CI wait and before the git lock. Everything above this point is a
  # read, so refusing here costs nothing and — unlike refusing after a ten-minute check
  # poll — does not park a shared lock behind a decision a human has to make anyway.
  local pr_files; pr_files=$(pr_changed_files "$pr" "$head_sha")
  dirty_target_guard refuse "PR #$pr" "$pr_files" "$head_sha"

  # Wait for checks. A repo with no CI yet has nothing to wait for; say so loudly
  # rather than silently treating 'no checks' as 'green'.
  local waited=0 total
  while :; do
    # wq#2273: the forge split lives in the daemon's pr-checks now — Gitea has
    # no check-runs endpoint (wq#557: commit statuses instead) and reports a
    # never-ran queue cancellation as status=failure (wq#986: an infra gap, not
    # a failing check). The daemon normalises both into
    # total/pending/failed/cancelled plus pre-formatted detail lines, so the
    # policy here (never merge red, say so loudly when there is no CI at all)
    # is written once and means the same thing on both forges.
    local pending failed cancelled
    broker pr-checks "$head_sha" || broker_fail "checks fetch"
    total=$(rget '.total')
    pending=$(rget '.pending')
    failed=$(rget '.failed')
    cancelled=$(rget '.cancelled')
    if [ "$total" = 0 ]; then
      note "NO CI CHECKS configured on this repo (§8 not yet satisfied) — landing on review alone"
      break
    fi
    if [ "$cancelled" -gt 0 ]; then
      rget '.cancelled_detail' >&2
      note "WARNING: $cancelled check(s) never ran (cancelled — most likely no runner registered for this repo). Not treated as a failing check. If this hides a real problem, check the run at $FORGE_BASE_URL/$SLUG/actions."
    fi
    if [ "$failed" -gt 0 ]; then
      rget '.failed_detail' >&2
      die "PR #$pr has failing checks — fix them, do not merge red (§5)"
    fi
    if [ "$pending" = 0 ]; then
      if [ "${cancelled:-0}" -gt 0 ]; then
        note "all $total check(s) settled: $cancelled cancelled-unrun (wq#986, not blocking), rest green"
      else
        note "all $total check(s) green"
      fi
      break
    fi
    [ "$waited" -ge "$timeout" ] && die "timed out after ${timeout}s with $pending check(s) still running"
    note "waiting on $pending/$total check(s)... (${waited}s)"
    sleep 15; waited=$((waited + 15))
  done

  # wq#532a: the lock goes HERE, not at the top. Everything above is a read or a wait - the CI
  # poll alone can run for ten minutes, and holding a shared lock across it is the 65-minute
  # stranding this ticket was filed about. The merge and the local fast-forward are the only
  # genuinely shared state.
  gitlock_acquire "$(gitlock_scope)" "lumen-pr land $SLUG #$pr"

  broker pr-view "$pr" || broker_fail "PR re-fetch"
  mergeability_guard "$pr"

  # wq#657: merge_method is 'squash' (default) or 'merge' (--merge flag). Squash
  # is the §2 default — one Conventional Commit per PR on main. --merge preserves
  # individual branch commits when a landing ticket explicitly asks for N logical
  # commits in main's history.
  #
  # Squash: the squashed subject becomes the Conventional Commit that release
  # tooling reads, so it must be the PR title verbatim (§2, §7). The squashed
  # BODY must carry the §3 footers forward — GitHub's default squash body is a
  # bullet list of branch subjects, and an empty body drops Refs:/Assisted-by:
  # off main's history entirely.
  #
  # Merge: the merge commit carries the PR title + footers. Individual branch
  # commits keep their own messages intact — that is the whole point.
  # wq#2273: title, §3 footers (from the branch commits, deduped — GitHub's
  # default squash body would drop Refs:/Assisted-by: off main), the per-forge
  # merge call (wq#557: GitHub PUT vs Gitea POST-with-`do`) and the head-branch
  # removal all live in the daemon's pr-merge verb now.
  broker pr-merge "$pr" "$merge_method" || broker_fail "$merge_method merge"
  note "merged PR #$pr as $(rget '.sha' | cut -c1-10) ($merge_method) on $FORGE_HOST"
  if [ "$(rget '.branch_deleted')" = true ]; then
    note "deleted remote branch $head_ref"
  else
    note "remote branch $head_ref already gone (or removal requested via delete_branch_after_merge)"
  fi

  # Return the local tree to the default branch and catch it up. In a LINKED
  # worktree we must not: the default branch is checked out in the primary tree
  # and git refuses the same branch in two places. Leave it for `worktree remove`.
  local cur gitdir commondir
  cur=$(git -C "$REPO_PATH" branch --show-current)
  gitdir=$(git -C "$REPO_PATH" rev-parse --absolute-git-dir)
  # --git-common-dir is returned RELATIVE to the repo, not to $PWD, so it must be
  # resolved from inside $REPO_PATH. Resolving it from the caller's cwd silently
  # yields an empty string, which makes every primary tree look like a linked
  # worktree and leaves it parked on the merged branch.
  commondir=$(cd "$REPO_PATH" && cd "$(git rev-parse --git-common-dir)" && pwd)
  git -C "$REPO_PATH" fetch -q origin
  if [ "$gitdir" != "$commondir" ]; then
    note "linked worktree — leaving it on '$cur'. Clean up with: git -C $REPO_PATH worktree remove $REPO_PATH"
    # wq#1536: this `return` used to be the whole story, so the PRIMARY never moved and every
    # --worktree land left it one commit behind origin/main. The fetch above already updated
    # the shared refs; now catch the primary tree up (or print exactly why it cannot be).
    local primary
    if primary=$(primary_worktree); then
      ff_primary_after_land "$primary" "$head_sha" || true
    else
      note "WARNING: cannot resolve the primary work tree of $SLUG — it was NOT fast-forwarded"
    fi
    gitlock_release
    trap - EXIT INT TERM
    return 0
  fi
  if [ "$cur" = "$head_ref" ]; then
    git -C "$REPO_PATH" checkout -q "$DEFAULT_BRANCH" || die "merged, but could not switch back to $DEFAULT_BRANCH — do it by hand"
  fi
  # wq#1536: same function as the linked-worktree path — no more 2>/dev/null guesswork.
  ff_primary_after_land "$REPO_PATH" "$head_sha" || true
  git -C "$REPO_PATH" branch -q -d "$head_ref" 2>/dev/null \
    && note "deleted local branch $head_ref" \
    || note "local branch $head_ref kept (not fully merged locally, or already gone)"
  gitlock_release
  # keep the EXIT trap: the lock is released (idempotent) but the broker grant
  # (wq#2273) still needs removing when the process ends.
  trap cleanup_on_exit EXIT
}

cmd_check() {
  need_repo "${1:-}"
  local branch; branch=$(git -C "$REPO_PATH" branch --show-current)
  printf 'repo    : %s (%s)\n' "$REPO_PATH" "$SLUG"
  printf 'branch  : %s (default: %s)\n' "$branch" "$DEFAULT_BRANCH"
  printf 'staged  : %s file(s)\n' "$(git -C "$REPO_PATH" diff --cached --name-only | wc -l)"
  printf 'dirty   : %s file(s) (may belong to a sibling agent — never git add -A)\n' "$(git -C "$REPO_PATH" status --porcelain | wc -l)"
  if [ "$branch" != "$DEFAULT_BRANCH" ]; then
    printf 'ahead   : %s commit(s) vs origin/%s\n' "$(git -C "$REPO_PATH" rev-list --count "origin/$DEFAULT_BRANCH..$branch" 2>/dev/null || echo '?')" "$DEFAULT_BRANCH"
  fi
  # wq#557: this used to swallow the failure. A silent omission of the open-PR
  # line looked like a clean run with no open PRs, which is how the Gitea
  # breakage went unnoticed — a tool that reports partial success without
  # saying it is partial is worse than one that fails. Same rule on the broker
  # path (wq#2273): a failed pr-list is reported as UNKNOWN, loudly.
  if broker pr-list; then
    local prs; prs=$(rget '.prs')
    printf 'open PRs: %s\n' "${prs:-none}"
  else
    printf 'open PRs: UNKNOWN — broker pr-list failed [%s]: %s\n' \
      "$BROKER_RULE" "$BROKER_REASON" >&2
    return 1
  fi
}

cmd_dirtycheck() {
  need_repo "${1:-}"; shift 2>/dev/null || true
  local mode=refuse paths="" n head="" head_sha=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --mode) mode="${2:-}"; shift 2 ;;
      # wq#1121: the head the paths would land as. `land` has always passed it (it is what
      # the wq#1474 blob check and the wq#1121 ancestry check read), but dirtycheck could
      # not, so the only way to exercise either narrowing was to drive a real merge against
      # a real forge. With --head the whole guard is checkable offline, by the test gate and
      # by an agent that wants to know whether its branch will land before it asks.
      --head) head="${2:-}"; shift 2 ;;
      -)      paths="$paths$(cat)"$'\n'; shift ;;
      *)      paths="$paths$1"$'\n'; shift ;;
    esac
  done
  case "$mode" in refuse|warn) : ;; *) die "unknown --mode '$mode' (refuse|warn)" ;; esac
  if [ -n "$head" ]; then
    head_sha=$(git -C "$REPO_PATH" rev-parse -q --verify "${head}^{commit}" 2>/dev/null) \
      || die "--head '$head' does not resolve to a commit in $REPO_PATH"
  fi
  [ -n "${paths//[$'\n']/}" ] || die "usage: lumen-pr dirtycheck <repo-path> [--mode refuse|warn] [--head REV] <path>... | -"
  n=$(printf '%s' "$paths" | grep -c .)
  dirty_target_guard "$mode" "path list" "$paths" "$head_sha" || return 1
  note "clean: none of the $n path(s) given is uncommitted or in an un-pushed commit in $(primary_worktree)"
}

# wq#1536: the post-land primary catch-up as its own subcommand. Two reasons: it is the fix
# command every "NOT fast-forwarded" reason points at (re-diagnoses, then ffs — the operator
# never gets a bare `git merge` that fails for the same unexplained reason), and the test gate
# can drive the REAL function against a throwaway repo instead of a re-implementation.
# Local only: fetches, then ff-only on the primary. No forge write, so no scope fence.
cmd_ffprimary() {
  need_repo "${1:-}"; shift 2>/dev/null || true
  local primary head="" head_sha=""
  # wq#2099: --head is the head that was just landed, and it is what the superset proof reads.
  # `land` passes it from the merge it just performed; here it makes that path drivable by hand
  # (a land whose ff was interrupted) and by the test gate, exactly as dirtycheck --head does.
  while [ $# -gt 0 ]; do
    case "$1" in
      --head) head="${2:-}"; shift 2 ;;
      *)      die "unknown flag '$1' (usage: lumen-pr ffprimary <repo-path> [--head REV])" ;;
    esac
  done
  if [ -n "$head" ]; then
    head_sha=$(git -C "$REPO_PATH" rev-parse -q --verify "${head}^{commit}" 2>/dev/null) \
      || die "--head '$head' does not resolve to a commit in $REPO_PATH"
  fi
  git -C "$REPO_PATH" fetch -q origin || die "fetch from origin failed in $REPO_PATH"
  primary=$(primary_worktree) || die "cannot resolve the primary work tree of $SLUG"
  ff_primary_after_land "$primary" "$head_sha"
}

case "${1:-}" in
  start)  shift; cmd_start "$@" ;;
  commit) shift; cmd_commit "$@" ;;
  open)   shift; cmd_open "$@" ;;
  comment) shift; cmd_comment "$@" ;;
  land)   shift; cmd_land "$@" ;;
  # wq#546: gitlock and check are READ-ONLY inspections. They still resolve a repo, but
  # refusing to LOOK at an out-of-scope repo would push agents toward raw git, which is the
  # opposite of a chokepoint. The fence guards mutation; SCOPE_OP=none marks a non-mutation.
  gitlock) shift; SCOPE_OP=none cmd_gitlock "$@" ;;
  check)  shift; SCOPE_OP=none cmd_check "$@" ;;
  # wq#771: the guard's decision, on an explicit path list, with no forge and no merge.
  # Read-only like check/gitlock. Exists so the probe can exercise the REAL function
  # instead of a re-implementation of it, and so an operator can ask "would this land?"
  dirtycheck) shift; SCOPE_OP=none cmd_dirtycheck "$@" ;;
  # wq#1536: local ff of the primary to origin/main, the step `land` runs last. No forge
  # write (the fence guards pushes), so SCOPE_OP=none like the inspections above.
  ffprimary) shift; SCOPE_OP=none cmd_ffprimary "$@" ;;
  ''|-h|--help|help)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown subcommand '$1' (start|commit|open|comment|land|check|gitlock|dirtycheck|ffprimary)" ;;
esac
