    if "lease_ttl"    not in cols: c.execute("ALTER TABLE tasks ADD COLUMN lease_ttl INTEGER")
    # wq#617 (foreman T3): the orchestrator's (model, effort) assignment + the archetype it was
    # derived from, written INTO the ticket so any dispatcher (fworker, agent-prompt, a human)
    # reads the same tuple. ADDITIVE — NULL on every pre-existing row = "unassigned, router
    # decides at dispatch". Values are the CLI strings (claude-sonnet-5 / high), never integers.
    if "model"        not in cols: c.execute("ALTER TABLE tasks ADD COLUMN model TEXT")
    if "effort"       not in cols: c.execute("ALTER TABLE tasks ADD COLUMN effort TEXT")
    if "archetype"    not in cols: c.execute("ALTER TABLE tasks ADD COLUMN archetype TEXT")
    # wq#741 via wq#841(a2): _finish writes these on every done/block. Lost in the 2026-08-23
    # 12:17Z revert of /home/lumen/bin/wq; restored here because a fresh DB is unusable without
