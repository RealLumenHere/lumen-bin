    c.execute("UPDATE tasks SET hold_by=?, hold_expires=? WHERE id=?", (agent, exp, a.id))
    c.execute("COMMIT"); c.close()
    print(f"HELD wq#{a.id} by '{agent}' until {exp}Z (ttl {a.ttl}m)")
def cmd_preflight(a):
    """Ad-hoc guard: warn if about to touch subsystems with no held lock for this holder."""
    holder = a.holder or os.environ.get("WQ_AGENT", "").strip() or f"{socket.gethostname()}:{os.getpid()}"
    subs = parse_subs(a.subsystems)
    ping("preflight")
    if not subs: print("no subsystems given"); return
    c = conn(); c.execute("DELETE FROM slocks WHERE expires_at < ?", (now(),)); c.commit()
    t_now = now(); unlocked=[]; foreign=[]
    for s in subs:
        r = c.execute("SELECT holder FROM slocks WHERE scope=? AND expires_at>=?", (s, t_now)).fetchone()
        if not r: unlocked.append(s)
        elif r[0] != holder: foreign.append((s, r[0]))
    c.close()
    if foreign:
        for s,h in foreign: print(f"BLOCKED: '{s}' held by {h} — do NOT touch. Coordinate or wait.")
        sys.exit(1)
    if unlocked:
        print(f"WARNING: no slock held for: {', '.join(unlocked)}")
        print(f"Before state-changing work run: slock acquire <scope> --holder {holder}")
        sys.exit(2)
    print(f"OK: all of [{', '.join(subs)}] locked by you ({holder}).")
