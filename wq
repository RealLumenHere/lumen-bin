        # dead session's specific ticket: reclaimed LOUDLY above, then claimed here.
        rid, st_now, holder, deps, subsystems, gate, title, hold_by, hold_expires = c.execute(
            "SELECT id, status, claimed_by, deps, subsystems, gate, title, hold_by, hold_expires "
            "FROM tasks WHERE id=?", (target_id,)).fetchone()
        refuse = None; ok_subs = []
