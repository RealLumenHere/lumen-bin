            if not ok:
                refuse = why
        if refuse:
            c.execute("COMMIT"); c.close()
            for line in reclaim_lines: print(line)
            print(f"REFUSED: cannot claim wq#{target_id} by id — {refuse}")
            print("  wq#582: every claim-by-lane guard applies to claim --id, none relaxed, and")
            print("  there is deliberately no --force.")
            sys.exit(1)
        pick = rid; picked_subs = ok_subs
        for h_rid, h_deps, h_ss, h_gate, h_title, h_hold_by, h_hold_exp in rows:
            h_ok, _w, _s, _sil = _eligible(h_rid, h_deps, h_ss, h_gate, h_title, h_hold_by, h_hold_exp)
            if h_ok:
                if h_rid != pick:
                    head_notice = (f"NOTICE: out-of-order claim — lane '{lane}' head is "
                                   f"#{h_rid}; wq#{pick} was claimed BY ID (wq#582), on the record.")
