_SWEEP_TITLE_PREFIX = "[repo-sweep] "
_SWEEP_DETAIL_RE = re.compile(r"^Automated sweep detected \S+ in (\S+)\.")
def unmapped_dispatch_lanes():
    """wq#2139: (lanes enabled for dispatch with no LANE_REPO row, human lanes, the one lane the
    dispatcher resolves off the ticket itself, managed repos). None means a foreman file could
    not be read or parsed — callers must fail OPEN (wq#912 precedent)."""
    try:
        cfg = json.loads(_git_head_text(DISPATCHER_CONFIG))
        enabled = {ln for ln, p in cfg["lanes"].items()
                   if isinstance(p, dict) and p.get("enabled") is True}
        lane_repo = _committed_assign(FOREMAN_ROUTER_PY, "LANE_REPO")
        mapped = {ast.literal_eval(k) for k in lane_repo.keys}
        human = set(ast.literal_eval(_committed_assign(FOREMAN_DISPATCHER_PY, "HUMAN_LANES")))
        hint_lane = ast.literal_eval(_committed_assign(FOREMAN_DISPATCHER_PY, "REPO_HINT_LANE"))
        managed = {_static_str(FOREMAN_ROUTER_PY, v) for v in lane_repo.values}
        managed |= set(ast.literal_eval(_committed_assign(FOREMAN_REPO_SWEEP_PY, "EXTRA_REPOS")))
    except (OSError, ValueError, KeyError, TypeError, AttributeError, SyntaxError,
            subprocess.SubprocessError) as e:
        eprint(f"WARNING (wq#2139): dispatch-lane repo check skipped, foreman policy unreadable: "
               f"{type(e).__name__}: {str(e).splitlines()[0][:120] if str(e) else ''}")
        return None
    return enabled - mapped - human, human, hint_lane, managed
_UNMAPPED_FORCE_NOTE = ("[{how} wq#2139] filed in lane {lane!r} with no LANE_REPO row and no repo the "
                        "dispatcher can resolve: it will skip this as lane_unmapped until re-laned or fixed")
def _resolvable_repo(title, needs, detail, managed):
    """wq#2144: the repo the dispatcher's repo_for_ticket resolves for an unmapped-lane ticket,
    mirroring the two sources it reads: the first needs repo(<path>) tag (--needs, then the
    detail's first `Needs:` line — router.needs_repo_hint) and a repo-sweep ticket's own
    title/detail (repo_sweep.repo_hint). Both are honoured only for a managed repo."""
    line = re.search(r"^Needs:\s*(.+)$", detail or "", re.M)
    tag = _REPO_TAG_RE.search((needs or "") + "\n" + (line.group(1) if line else ""))
    if tag and tag.group(1) in managed:
        return tag.group(1)
    if (title or "").startswith(_SWEEP_TITLE_PREFIX):
        sweep = _SWEEP_DETAIL_RE.match(detail or "")
        if sweep and sweep.group(1) in managed:
            return sweep.group(1)
    return None
def check_lane_has_repo(lane, needs, detail, force, title=None):
    """wq#2139: refuse `lane` when the dispatcher can never land it (enabled, no LANE_REPO row,
    human lanes exempt). wq#2144: only the hint lane ('auto', foreman_dispatcher.REPO_HINT_LANE)
    can be rescued by the ticket itself — a managed needs repo(...) tag or the repo-sweep
    title/detail shape; the dispatcher skips every other unmapped lane as lane_unmapped BEFORE it
    reads the tag. Returns "--force" / "warn-mode" when the ticket is filed anyway (caller records
    it in the notes)."""
    if not lane:
        return False
    res = unmapped_dispatch_lanes()
    if res is None or lane not in res[0]:
        return False
    if lane == res[2] and _resolvable_repo(title, needs, detail, res[3]):
        return False
    if force:
        warn(f"--force: lane {lane!r} has no LANE_REPO row and the dispatcher cannot resolve a repo for it")
        return "--force"
    # wq#2127: the CLI DEFAULT lane ('auto') is itself such a lane and ~3 tickets/day are filed
    # into it by unattended producers (minerva_defer_review, fleet-update-check, sessions). A hard
    # refusal there loses the ticket, which is worse than a ticket that needs re-laning, so the
    # default is warn + note. WQ_LANE_REPO_GUARD=refuse turns the refusal on.
    if os.environ.get("WQ_LANE_REPO_GUARD", "warn") != "refuse":
        warn(f"lane {lane!r} is enabled for dispatch but has no LANE_REPO row and the dispatcher cannot "
             f"resolve a repo for this ticket: it will skip it as lane_unmapped until it is re-laned "
             f"or fixed (wq#2139). Filed anyway; set WQ_LANE_REPO_GUARD=refuse to refuse instead.")
        return "warn-mode"
    print(f"REFUSED: lane {lane!r} is enabled for dispatch but has no LANE_REPO row in the foreman "
          f"router — the dispatcher would skip this ticket as lane_unmapped forever (wq#2139).")
    if lane == res[2]:
        print(f"Ways out: pick a mapped lane (e.g. build, ops, research, fleet), or give lane {lane!r} a "
              f"repo it can resolve: --needs 'repo(<managed repo path>)' (the path must be in "
              f"repo_sweep.managed_repos()). --force overrides, on the record in the ticket notes.")
    else:
        print("Ways out: pick a mapped lane (e.g. build, ops, research, fleet) or add a LANE_REPO row "
              "for it in foreman orchestrator/router.py — a needs repo(...) tag does NOT rescue an "
              "unmapped lane other than 'auto' (wq#2144). --force overrides, on the record in the "
              "ticket notes.")
    sys.exit(1)
