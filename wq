    if "block_reason" not in cols: c.execute("ALTER TABLE tasks ADD COLUMN block_reason TEXT")
    if "blocked_at"   not in cols: c.execute("ALTER TABLE tasks ADD COLUMN blocked_at TEXT")
    # wq#841 (escalated from wq#787's verify-pass of wq#763): rework needs a DURABLE signal.
