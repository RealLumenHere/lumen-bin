        if hold_by and hold_expires and hold_expires >= t_now and hold_by != agent:
            return False, f"held by '{hold_by}' until {hold_expires}Z (wq hold, wq#1461)", [], False
        if not deps_met(c, deps):
            return False, f"deps not met ({deps})", [], True
        ok, why = gate_met(gate)
        if not ok:
            return False, why, [], False
        subs = parse_subs(subsystems)
        blocked = subs_free(c, subs, agent, t_now)
        if blocked:
            return False, f"subsystem {blocked[0][0]} held by {blocked[0][1]}", [], False
        return True, "", subs, False
    if target_id is not None:
