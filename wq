def known_models():
    """wq#1442: alias/bare-shorthand -> full CLI id, mirrors orchestrator/router.py's
    _build_aliases() (models[].id + models[].alias) so `wq add/edit --model` can
    canonicalize a raw alias before it lands on a ticket. wq#1436/wq#1434 stored
    '--model opus-5' verbatim; fworker.py handed that string straight to
    `claude --model opus-5`, which 404s (model_not_found) since the CLI only knows
    'claude-opus-5' — two attempts burned and UNKNOWN:CRASH before the router ever
    got a chance to resolve it (router.resolve_alias only runs for tuples the
    router itself assigns, not ones typed straight onto a ticket).

    Returns (aliases, ids): aliases maps alias/shorthand -> full id, ids is the
    full set of accepted ids (a full id is also valid input, mapping to itself).
    None means the manifest couldn't be read — callers must fail OPEN (wq#912/
    wq#1368 precedent): a missing/unreadable file never blocks `wq add`."""
    try:
        import yaml
    except ImportError:
        return None
    try:
        with open(FOREMAN_MODELS_YAML) as f:
            data = yaml.safe_load(f) or {}
    except (OSError, ValueError):
        return None
    aliases, ids = {}, set()
    for m in (data.get("models") or []):
        mid = m.get("id")
        if not mid:
            continue
        ids.add(mid)
        alias = m.get("alias")
        if alias:
            aliases[alias] = mid
        if mid.startswith("claude-"):
            aliases[mid[len("claude-"):]] = mid
    return aliases, ids
