_REPO_TAG_RE = re.compile(r"(?:needs:)?repo\(\s*([^)\s][^)]*?)\s*\)")
def _git_head_text(path):
    """`path` as committed at HEAD of its containing repo. Raises on any failure."""
    path = os.path.abspath(path)
    repo_dir = os.path.dirname(path)
    top = subprocess.run(["git", "-C", repo_dir, "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True, timeout=10, check=True).stdout.strip()
    return subprocess.run(["git", "-C", repo_dir, "show", f"HEAD:{os.path.relpath(path, top)}"],
                          capture_output=True, text=True, timeout=10, check=True).stdout
def _committed_assign(path, name):
    """The value node of the module-level `name = ...` in `path` at git HEAD (no import: the
    router/dispatcher modules have import-time side effects)."""
    for node in ast.parse(_git_head_text(path)).body:
        if isinstance(node, ast.Assign) and any(
                isinstance(t, ast.Name) and t.id == name for t in node.targets):
            return node.value
    raise ValueError(f"{name} not found in {path}")
def _static_str(path, node):
    """A router string constant without importing it: a literal, a module-level name bound to
    one, or os.environ.get(KEY, "default") (the default is what an unset env resolves to)."""
    if isinstance(node, ast.Name):
        node = _committed_assign(path, node.id)
    if isinstance(node, ast.Call) and len(node.args) == 2:
        node = node.args[1]
    return ast.literal_eval(node)
# wq#2144: repo_sweep.managed_repos() = LANE_REPO values + EXTRA_REPOS, read from git HEAD.
