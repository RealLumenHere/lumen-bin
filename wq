def cmd_review(a):
    """wq#662: ORCH reviews Frank's response on a pending_review ticket.
    verdict=accept  -> status='open', gate_type cleared, answer recorded. Ticket is now
                       claimable and the decision gate is considered resolved.
    verdict=reject  -> status='frank_gated', frank_response/response_ts cleared so Frank
                       knows to re-answer, reason recorded in review_reason.
    Ticket must be in pending_review status AND have a frank_response set."""
    ping("review")
    verdict = (a.verdict or "").strip().lower()
    if verdict not in ("accept", "reject"):
        print("REFUSED: verdict must be 'accept' or 'reject'"); sys.exit(1)
    reason = (a.reason or "").strip()
    if verdict == "reject" and not reason:
        print("REFUSED: --reason is required when rejecting (blank/insufficient response needs an explanation)"); sys.exit(1)
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    r = c.execute("SELECT status, frank_response, decision_prompt FROM tasks WHERE id=?", (a.id,)).fetchone()
    if not r:
        c.execute("COMMIT"); c.close(); print(f"REFUSED: wq#{a.id} not found"); sys.exit(1)
    st, fr, dp = r
    if st != 'pending_review':
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: wq#{a.id} is {st!r} — review only acts on pending_review tickets"); sys.exit(1)
    if not fr:
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: wq#{a.id} has no frank_response — Frank must run `wq answer` first"); sys.exit(1)
    if verdict == "accept":
        c.execute("""UPDATE tasks SET status='open', review_verdict='accept', review_reason=?
                     WHERE id=?""", (reason or None, a.id))
        c.execute("COMMIT"); c.close()
        print(f"reviewed wq#{a.id}: pending_review -> open (ACCEPTED)")
        if reason: print(f"  note : {reason}")
        print("  Ticket is now claimable. Decision gate cleared.")
    else:
        c.execute("""UPDATE tasks SET status='frank_gated', review_verdict='reject',
                     review_reason=?, frank_response=NULL, response_ts=NULL
                     WHERE id=?""", (reason, a.id))
        c.execute("COMMIT"); c.close()
        print(f"reviewed wq#{a.id}: pending_review -> frank_gated (REJECTED)")
        print(f"  reason : {reason}")
        print(f"  Frank's response was cleared — `wq answer {a.id}` to resubmit")

