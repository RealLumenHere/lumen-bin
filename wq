# ---------------------------------------------------------------- wq#1158 idempotency helper
# The fence stops a duplicate worker from CORRUPTING the ticket. It does nothing about the side
# effects that worker already had outside the DB — and the expensive one is a second pull
# request, which costs a human a review and leaves two branches that both look authoritative.
#
# The fix is to make every side effect keyed on the TICKET rather than on the session that
# happens to be doing it: same ticket -> same branch name -> same output directory -> and a PR
# lookup on that branch that answers "already exists" instead of creating a second one. Two
# workers then converge on one artifact rather than racing to make two.
#
# Branch shape is <type>/wq<id>-<title-slug>, NOT the bare `wq-<id>` the ticket sketched:
# lumen-pr's BRANCH_RE requires a Conventional-Commit type segment and rejects anything else
# outright, so `wq-1158` could not be pushed by the tool that opens every PR here. Determinism
# is the requirement and it holds — the name is a pure function of (type, id, title).
CONV_TYPES = ("feat", "fix", "docs", "style", "refactor", "perf", "test",
              "build", "ci", "chore", "revert")
def idem_slug(title, cap=48):
    s = re.sub(r"^\s*\[[^\]]*\]\s*", "", title or "")          # drop a [DRAFT]/[WIP] prefix
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    if len(s) > cap:
        s = s[:cap].rstrip("-")
    return s or "task"
def idem_branch(tid, title, typ="feat"):
    return f"{typ}/wq{tid}-{idem_slug(title)}"
def idem_path(tid):
    return os.path.join(SCRATCH_ROOT, f"wq{tid}")
def cmd_idem(a):
    """Deterministic, ticket-keyed names for the side effects a duplicate worker would double."""
    c = conn()
    row = c.execute("SELECT id, title FROM tasks WHERE id=?", (a.id,)).fetchone()
    c.close()
    if not row:
        print(f"REFUSED: no such task {a.id}"); sys.exit(1)
    if a.type not in CONV_TYPES:
        print(f"REFUSED: --type must be one of {'|'.join(CONV_TYPES)} (lumen-pr BRANCH_RE, "
              f"github-standards.md §2), got {a.type!r}"); sys.exit(2)
    branch = a.branch or idem_branch(row[0], row[1], a.type)
    if a.kind == "branch":
        print(branch); return
    if a.kind == "path":
        # Ticket-keyed, deliberately NOT session-keyed (the opposite of `wq scratch`, wq#598).
        # Per-session paths keep two workers from noticing each other; that is right for ad-hoc
        # files and wrong for a ticket's output, where the whole point is that the second worker
        # lands on the first one's artifacts instead of quietly building a parallel set.
        print(idem_path(row[0])); return
    # kind == "pr": check-then-create, keyed on the branch. wq NEVER creates the PR — lumen-pr
    # owns that, with guards this command has no business duplicating. All this answers is
    # "does one already exist for this ticket's branch", which is the question a second worker
    # fails to ask.
    gh = os.environ.get("WQ_GH_BIN", "gh")
    try:
        import subprocess
        pr = subprocess.run([gh, "pr", "list", "--head", branch, "--state", "all",
                             "--limit", "1", "--json", "url,state,number"],
                            capture_output=True, text=True, timeout=45)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"UNKNOWN {branch} — could not ask the forge ({e.__class__.__name__}). Treat as "
              f"unknown, not as absent: creating a PR on an unanswered check is how the "
              f"duplicate gets made.")
        sys.exit(4)
    if pr.returncode != 0:
        print(f"UNKNOWN {branch} — `gh pr list` failed ({(pr.stderr or '').strip()[:200]}). "
              f"Treat as unknown, not as absent.")
        sys.exit(4)
    try:
        found = json.loads(pr.stdout or "[]")
    except ValueError:
        print(f"UNKNOWN {branch} — unparseable gh output. Treat as unknown, not as absent.")
        sys.exit(4)
    if found:
        print(f"EXISTS {found[0].get('url')} state={found[0].get('state')} branch={branch}")
        print(f"  wq#{a.id} already has a pull request. Push to {branch} and update that PR — "
              f"do NOT open a second one.")
        return
    print(f"ABSENT {branch}")
    sys.exit(3)

