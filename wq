            elif r[7] < t_now: lz = f" lease=EXPIRED@{r[7]}Z"
            else: lz = f" lease={r[7]}Z"
        print(f"[{r[0]:>3}] {r[1]:<4} p{r[2]} {r[3]:<8} {r[4][:66]}{cb}{dep}{sub}{gt}{lz}")
