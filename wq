                _aq_unverified(a.id, why)
            elif verdict == "landed":
                print(f"note: {why} — accepting as landed.")
        # wq#1673: the artifact is a path, so where it resolved is part of the evidence.
        elif kind == "path":
            abs_path = os.path.realpath(detail)
            a.notes, new_token = canonicalize_evidence(notes, token, abs_path)
            if new_token != token:
                print(f"note: evidence path canonicalized to {new_token} (wq#1673).")
            verdict, why = evidence_durability(abs_path)
            unlanded = getattr(a, "unlanded", None)
            if verdict == "ephemeral" and not unlanded:
                eprint(f"REFUSED: wq#1673 evidence-durability gate — task {a.id} not closed. "
                      f"Its evidence {why}. A worktree is deleted at the end of its run and a "
                      f"live edit in a primary tree is overwritten by the next landing, so the "
                      f"citation stops meaning anything — TICKET_CLOSURE_AUDIT.md F4, wq#1702 "
                      f"D3. Land it "
                      f"(`lumen-pr land`) and re-run `wq done`; if it just landed, the local "
                      f"ref may be stale, so `git -C <repo> fetch origin main` and retry. If "
                      f"the file is deliberately not on main, say so on the record with "
                      f"--unlanded \"<reason>\".")
                sys.exit(6)
            if verdict == "unknown":
                print(f"WARNING: wq#1673 evidence-durability gate could not verify {abs_path} "
                      f"({why}). Closing anyway — the gate does not block on git trouble.")
            ov, owhy = ops_deploy_check(abs_path, getattr(a, "deployed", None))
            if ov == "undeployed" and not getattr(a, "no_deploy_needed", None):
                eprint(f"REFUSED: wq#1724 ops-deploy gate — task {a.id} not closed. {owhy}. "
                      f"An ops/*/install.sh landing on main is not deploy evidence by itself "
                      f"(wq#1632: closed done this way, artifact never reached its target). "
                      f"Prove the target was actually touched with --deployed \"<live target "
                      f"path>\" (its bytes must match a file this artifact ships), or record "
                      f"why no deploy applies with --no-deploy-needed \"<reason>\".")
