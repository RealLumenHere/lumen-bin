    # wq#1675: SHARED (read-only) subsystem holds. A separate table because `slocks` is
    # keyed scope-unique by design and shared with bin/slock — a reader SET cannot live in
    # one row, and widening that key would change a table four other tools read. ADDITIVE:
    # only wq and slock's writer check read this, so queue-status/mctl/lumen-sqlutil are
    # untouched.
    c.execute("""CREATE TABLE IF NOT EXISTS slocks_ro(
        scope TEXT NOT NULL, holder TEXT NOT NULL, acquired_at TEXT,
