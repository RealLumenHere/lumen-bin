    q = "SELECT id,lane,pri,status,title,claimed_by,deps,lease_expires,subsystems,gate FROM tasks"
    if conds: q += " WHERE " + " AND ".join(conds)
    q += " ORDER BY lane,pri,id"
    rows = c.execute(q, params).fetchall(); c.close()
    if not rows: print("(empty)"); return
    t_now = now()
    for r in rows:
        cb = f" <{r[5]}>" if r[5] else ""
        dep = f" deps={r[6]}" if r[6] else ""
        sub = f" subs={r[8]}" if r[8] else ""
