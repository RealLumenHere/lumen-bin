    if pick is None:
        c.execute("COMMIT"); c.close()
        for line in reclaim_lines: print(line)
        msg = f"NONE — lane '{a.lane}' empty or all remaining blocked"
        if skips: msg += " [skipped: " + "; ".join(skips[:6]) + ("; ..." if len(skips) > 6 else "") + "]"
        print(msg); return
    # wq#530 (2): the FIRST lease is short. Promotion to the full ttl is driven by heartbeat —
    # or by any other wq call the holder makes — never by elapsed time alone, because elapsed
    # time cannot tell a dead session from a working one. A session that dies in its first
    # minute frees its ticket in PROVISIONAL_MIN instead of parking it for the full ttl.
    # wq#594: ONE session id driven from TWO places. Captured BEFORE the claim lands so `pick`
    # is not in its own answer. See cmd_concurrency for why this is a symptom detector and not
    # an identity check — an identity check is not available at this chokepoint at all.
    prior_held = [h for h in session_holdings(c, agent, t_now)[0] if h != pick]
    prov = min(PROVISIONAL_MIN, a.ttl)
    lease = lease_from(prov)
    # wq#1158: ONE guarded statement, not a read-then-write. BEGIN IMMEDIATE already serialises
    # this against a sibling claimer, so the predicate is not what makes today's claim safe — it
    # is what keeps it safe: the rule now lives IN the statement rather than in the transaction
    # discipline of the 200 lines above it, and RETURNING is what mints the fence. Zero rows back
    # means the row moved out from under the scan and somebody else won.
    #
    # The expiry test demands BOTH columns agree the lease is dead. They are written together
    # (lease_set_sql) so they should never disagree — but if they ever do, requiring both makes
    # the reclaim MORE conservative, never less. A divergence must not be able to steal a live
    # ticket; at worst it declines to reclaim a dead one, which `wq reap` sweeps anyway.
    fence = None
    if lease_fenced(c):
        won = c.execute(
            """UPDATE tasks SET status='claimed', claimed_by=?, claimed_at=?, lease_expires=?,
                   lease_ttl=?, lease_owner=?, lease_expires_at=?,
                   fence=COALESCE(fence,0)+1, attempt=COALESCE(attempt,0)+1,
                   hold_by=NULL, hold_expires=NULL
               WHERE id=? AND (status='open'
                               OR (status='claimed'
                                   AND COALESCE(lease_expires_at,0) < unixepoch()
                                   AND COALESCE(lease_expires,'') < ?))
               RETURNING id, fence""",
            (agent, t_now, lease, a.ttl, agent, epoch_of(lease), pick, t_now)).fetchone()
        if won is None:
            c.execute("ROLLBACK"); c.close()
            for line in reclaim_lines: print(line)
            print(f"RACE-LOST: wq#{pick} was claimed by someone else between the lane scan and "
                  f"the write. Nothing was taken and nothing was clobbered — this is the "
                  f"wq#1158 atomic claim working. Re-run `wq claim` for the next ticket.")
            return
        fence = won[1]
    else:
        c.execute("""UPDATE tasks SET status='claimed', claimed_by=?, claimed_at=?, lease_expires=?,
                     lease_ttl=?, hold_by=NULL, hold_expires=NULL WHERE id=?""",
                  (agent, t_now, lease, a.ttl, pick))
    if picked_subs:
        acquire_subs(c, picked_subs, agent, prov, f"wq#{pick}")
    c.execute("COMMIT")
    t = c.execute("SELECT id,pri,title,detail,deps,subsystems FROM tasks WHERE id=?", (pick,)).fetchone()
    c.close()
    for line in reclaim_lines: print(line)
    for line in skips:
        # wq#532(d): skipped tickets used to be reported ONLY when the lane came back empty, so a
        # [DRAFT] or a gated ticket was passed over in total silence whenever anything else was
        # claimable. A guard nobody can see is indistinguishable from no guard.
        print(f"(skipped {line})")
    if prov < a.ttl:
        print(f"CLAIMED {t[0]} (pri {t[1]}) by {agent} — PROVISIONAL lease until {lease}Z ({prov}m)")
        print(f"  wq#530: the first lease is deliberately short. ANY further wq call you make "
              f"(heartbeat/list/show/done)")
        print(f"  promotes it to the full {a.ttl}m. Go silent for {prov}m and this ticket returns "
              f"to the queue, loudly.")
        print(f"  Long uninterrupted work with no wq calls: run `wq heartbeat {t[0]}` first.")
    else:
        print(f"CLAIMED {t[0]} (pri {t[1]}) by {agent} — lease until {lease}Z (ttl {a.ttl}m; heartbeat to extend)")
    if fence is not None:
        # wq#1158: printed on its own line, in a fixed shape, because a worker loop has to be
        # able to capture it — `FENCE=<n>` is what a shell reads back out of the claim output.
        print(f"FENCE={fence}")
        print(f"  Pass it to every write-back: wq heartbeat/done/release/block {t[0]} --fence {fence}")
        print(f"  If a write is refused for a stale fence, your claim ended and someone else "
              f"holds this ticket now. Stop; do not re-claim.")
    if picked_subs: print(f"LOCKED subsystems: {', '.join(picked_subs)}")
    if head_notice: print(head_notice)
    if prior_held:
        # NOTE, never REFUSE — decided from the data, not from taste. Across the whole
        # registered-session era exactly ONE session ever closed a ticket entirely inside
        # another of its own ticket windows (fleet6-a13cac, wq#565 inside wq#563 — the
        # incident). But it is not the only co-hold: rabbit17b-6f8be9 took wq#522 and wq#547
        # 36s apart and closed both in the same second, which is a deliberate pair. Refusing
        # would have broken that, and a guard that breaks legitimate work gets routed around.
        print(f"NOTICE (wq#594): you ALREADY HOLD "
              f"{', '.join('#' + str(h) for h in prior_held)} on a live lease.")
        print(f"  Normal if you meant to work several at once. If you did NOT claim "
              f"{'that' if len(prior_held) == 1 else 'those'}, a SECOND instance is driving")
        print(f"  '{agent}' — a continuation that inherited WQ_AGENT without re-registering. "
              f"Two drivers under")
        print(f"  one id share /tmp paths, branch bases and worktrees; atomic claims will not "
              f"save those.")
        print(f"  Check: wq concurrency   |   Fix: unset WQ_AGENT; wq whoami --register <name>")
    # wq#598: point at the session's own scratch dir, ONCE, on the first claim of the session.
    # Self-limiting on purpose — the directory's own existence is the "already told you" flag,
    # so no DB query and no per-claim nagging. wq#594 established that a notice printed on every
    # claim is noise rather than signal, and this is guidance, not a finding.
    try:
        _scr = os.path.join(SCRATCH_ROOT, agent.replace("/", "_"))
        if not os.path.isdir(_scr):
            os.makedirs(_scr, mode=0o700, exist_ok=True)
            print(f"SCRATCH (wq#598): write ad-hoc files under {_scr}/ , not bare /tmp.")
            print(f"  /tmp is one flat namespace shared by every live session (5 at once here, "
                  f"most recently)")
            print(f"  and it records nobody's name, so a clobbered file looks exactly like your "
                  f"own. Path: wq scratch")
    except OSError:
        pass  # scratch is a convenience; never let it fail a claim
    print(f"TITLE: {t[2]}\nDEPS: {t[4] or 'none'}\n---\n{t[3]}")
SCRATCH_ROOT = os.environ.get("WQ_SCRATCH_ROOT", "/tmp")

def cmd_scratch(a):
    """wq#598: a per-session scratch directory, so ad-hoc files stop sharing a namespace.

    MEASURED FIRST, and the measurement changed what this is. lumen-pr writes NOTHING to /tmp,
    and no dispatch document contains a /tmp path — so there was no code owner to fix and no
    convention to correct. Every colliding file in /tmp was typed by hand by an agent. Of the
    lumen-owned entries, ~180 carry names any agent would independently pick (a.txt, g.txt,
    o.txt, v1.txt, red.txt, pre.txt, land.txt, chk.txt), and up to 5 sessions run at once here.

    SO BE HONEST ABOUT WHAT THIS IS: guidance, not enforcement. Nothing can stop an agent
    typing `> /tmp/a.txt`. What this does is make the correct path one token long and put it in
    front of the agent at claim time, which is the only moment it is certainly reading.

    The SECOND effect is the one that may matter more than collision-avoidance: /tmp today is
    unattributable. Nothing records who wrote a file, which is why the wq#594 incident was only
    ever caught by a human noticing a PR body they had not written. A path under the session id
    names its writer for free.

    DELIBERATE HOLE, same as the lumen-pr worktree guard: two drivers sharing one WQ_AGENT get
    the SAME directory and still collide. That is correct — it is what wq#594's notice is for.
    """
    ident, explicit = resolve_identity(a)
    d = os.path.join(SCRATCH_ROOT, ident.replace("/", "_"))
    if not a.path_only:
        try:
            os.makedirs(d, mode=0o700, exist_ok=True)
        except OSError as e:
            print(f"could not create {d}: {e}", file=sys.stderr); sys.exit(1)
    print(d)
    if not explicit:
        print("NOTE: WQ_AGENT is not set, so this path is a hostname:pid fallback that CHANGES "
              "every call.\n  Register first: wq whoami --register <name>", file=sys.stderr)

def cmd_concurrency(a):
    """wq#594: report ONE session id being driven from TWO places.

    WHY THIS IS A SYMPTOM DETECTOR AND NOT AN IDENTITY CHECK, stated here because the next
    person will reach for the identity check first, as the filing ticket did:

    There is no per-instance signal available at this chokepoint. Every wq call arrives as a
    freshly-spawned process off ONE shared long-lived gateway, so pid/ppid/sid/pgid are
    per-CALL and boot_id is per-HOST — none of them names a driver. A nonce minted at first
    call fails differently and worse: it would have to live in the environment or a file, and
    a continuation inherits WQ_AGENT through exactly that channel, so it would inherit the
    nonce meant to disambiguate it. Credential-style distinction is not merely unbuilt here,
    it is unavailable. What IS observable is the footprint two drivers leave: concurrent
    holdings under one id. That is what this reports.

    LIMIT, stated rather than discovered later: two drivers that never hold tickets at the
    same time are invisible to this, and so is a driver that only edits files and never calls
    wq — the same structural gap wq#568 recorded for its own scope. This narrows the blind
    spot; it does not close it.

    Exit 1 on a finding so a systemd OnFailure= can fire (wq#565 B5: never pipe it).
    """
    c = conn()
    t_now = now()
    findings = []
    live = c.execute("""SELECT claimed_by, id FROM tasks WHERE status='claimed'
                        AND claimed_by IS NOT NULL AND lease_expires IS NOT NULL
                        AND lease_expires >= ? ORDER BY claimed_by, id""", (t_now,)).fetchall()
    held = {}
    for by, tid in live:
        held.setdefault(by, []).append(tid)
    for by, tids in sorted(held.items()):
        if len(tids) > 1:
            findings.append(("CO-HELD NOW", by,
                             f"holds {', '.join('#' + str(t) for t in tids)} on live leases "
                             f"at the same time"))
    # Historical shape, kept separate: a ticket claimed AND closed entirely inside another of
    # the same session's ticket windows. Strictly rarer than co-holding and the sharper signal
    # — measured across every registered session since wq#502, it matches the wq#594 incident
    # and nothing else.
    rows = c.execute("""SELECT id, claimed_by, claimed_at, done_at FROM tasks
                        WHERE claimed_by IS NOT NULL AND claimed_at IS NOT NULL
                          AND done_at IS NOT NULL""").fetchall()
    per = {}
    for tid, by, ca, da in rows:
        per.setdefault(by, []).append((tid, ca, da))
    for by, items in sorted(per.items()):
        if not SESSION_RE.match(by or ""):
            continue  # bare pre-wq#502 names shared a base by design; not evidence of anything
        for outer in items:
            for inner in items:
                if outer[0] == inner[0]:
                    continue
                if outer[1] < inner[1] and inner[2] < outer[2]:
                    findings.append(("NESTED CLOSE", by,
                                     f"#{inner[0]} [{inner[1]} .. {inner[2]}] closed entirely "
                                     f"inside #{outer[0]} [{outer[1]} .. {outer[2]}]"))
    c.close()
    if not findings:
        print("wq concurrency: no session id shows signs of being driven from two places.")
        return
    print(f"wq concurrency: {len(findings)} finding(s) — one session id, possibly two drivers.\n")
    for kind, by, detail in findings:
        print(f"  [{kind}] {by}")
        print(f"      {detail}")
    print("\nCO-HELD NOW is often legitimate: an agent deliberately working a pair trips it too.")
    print("NESTED CLOSE is the sharper one — a session that finished a whole ticket inside")
    print("another of its own ticket windows was almost certainly two instances, not one.")
    print("If a session did not mean to hold these: unset WQ_AGENT; wq whoami --register <name>.")
    sys.exit(1)

ORCH_PREFIX = "orch:"
ORCH_GLOB = ORCH_PREFIX + "*"
def orch_leases(c, t_now):
    """Live orchestrator lane leases as (lane, holder, acquired_at, expires_at, note)."""
    return [(s[len(ORCH_PREFIX):], h, aq, ex, nt) for s, h, aq, ex, nt in c.execute(
        "SELECT scope,holder,acquired_at,expires_at,note FROM slocks "
        "WHERE scope GLOB ? AND expires_at >= ? ORDER BY scope", (ORCH_GLOB, t_now))]

def fmt_orch(rows):
    """One line per DRIVER, not per lane — 'who is orchestrating' is the question being asked."""
    by_holder = {}
    for lane, h, aq, ex, nt in rows:
        d = by_holder.setdefault(h, {"lanes": [], "since": aq, "until": ex, "note": nt})
        d["lanes"].append(lane)
        d["since"] = min(d["since"], aq); d["until"] = min(d["until"], ex)
    return [f"  {h} active since {d['since']}Z on lanes {','.join(sorted(d['lanes']))} "
            f"(lease to {d['until']}Z)" + (f" — {d['note']}" if d["note"] else "")
            for h, d in sorted(by_holder.items())]

def cmd_orch(a):
    """wq#1116: ONE orchestrator per lane-set, leased and visible before it touches anything.

    wq#594 detects two drivers on one session id AFTER the fact, from the footprint they leave;
    this is the before-the-fact half. It is deliberately a LEASE and not an identity check for
    the reason wq#594's docstring already established: two claude.ai sessions riding one
    Commander leave no per-instance signal at this chokepoint, so nothing here can tell them
    apart. They cannot both hold the same lane-set lease, though, and the loser is told who is
    already driving and since when — which is the sentence that was missing at 01:22Z on
    2026-08-30, when the second session spawned workers into a batch the first was still
    verifying.

    Registration is REQUIRED to acquire. That is the point rather than a side effect: wq#502's
    holder checks and wq#594's report both key on a registered identity, and both orchestrators
    in the incident had skipped `whoami --register`, so every mechanism keyed on it had nothing
    to read. Making the lease the thing an orchestrator wants is what makes registering the
    thing it does first.

    Stored as slocks under 'orch:<lane>' rather than a new table: expiry, holder, the
    never-purge-a-live-holder rule (wq#530) and retirement's release-everything sweep (wq#568)
    all already operate on slocks, and a new table would have to re-earn every one of them.
    """
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    c.execute("DELETE FROM slocks WHERE scope GLOB ? AND expires_at < ?", (ORCH_GLOB, now()))
    ident, _ = resolve_identity(a, c)
    t_now = now()
    if getattr(a, "release", False):
        mine = [lane for lane, h, *_ in orch_leases(c, t_now) if h == ident]
        release_subs(c, [ORCH_PREFIX + l for l in mine], ident)
        mark_alive(c, ident, "orch:release")
        c.execute("COMMIT"); c.close()
        print(f"{ident}: released orchestrator lease on "
              f"{','.join(mine) if mine else 'nothing (held none)'}")
        return
    if getattr(a, "acquire", None):
        if not is_session(c, ident):
            c.execute("COMMIT"); c.close()
            print(f"REFUSED: '{ident}' is not a registered session, so it cannot hold an\n"
                  f"  orchestrator lease. An unregistered name changes every wq call, which is\n"
                  f"  exactly what makes a second driver invisible (wq#1116).\n"
                  f"    wq whoami --register orch-<slug>     # then export the WQ_AGENT it prints\n"
                  f"    wq orch --acquire {a.acquire}")
            sys.exit(2)
        lanes = parse_subs(a.acquire)
        if not lanes:
            c.execute("COMMIT"); c.close()
            print("REFUSED: --acquire needs at least one lane (e.g. --acquire build,auto)")
            sys.exit(2)
        known = configured_lanes()
        if known is not None:
            unknown = [l for l in lanes if l not in known and l not in LANE_EXEMPT]
            if unknown:
                # A lease on a lane nobody dispatches protects nothing, and reads as if it does.
                warn(f"lane(s) {','.join(unknown)} have no dispatcher/config.json entry — a lease "
                     f"on them guards no dispatch (wq#912). Typo, or a lane still to be added?")
        taken = [(lane, h, aq) for lane, h, aq, _e, _n in orch_leases(c, t_now)
                 if lane in lanes and h != ident]
        if taken:
            rows = orch_leases(c, t_now)
            c.execute("COMMIT"); c.close()
            print(f"REFUSED: another orchestrator already holds "
                  f"{','.join(l for l, _h, _a in taken)}.")
            for line in fmt_orch(rows): print(line)
            print(f"  You are {ident}. Two orchestrators on one lane-set is the wq#1116\n"
                  f"  collision: both spawn workers into the same batch, both close each other's\n"
                  f"  tickets, and the later `wq done` overwrites the earlier one's notes.\n"
                  f"  -> Take a DISJOINT lane-set, or wait for that lease to lapse, or, if you\n"
                  f"     know that session is gone: wq retire {taken[0][1]}")
            sys.exit(2)
        ttl = getattr(a, "ttl", None) or ORCH_TTL_MIN
        acquire_subs(c, [ORCH_PREFIX + l for l in lanes], ident, ttl,
                     getattr(a, "note", None) or "orchestrator")
        mark_alive(c, ident, "orch:acquire")
        rows = orch_leases(c, now())
        c.execute("COMMIT"); c.close()
        print(f"{ident}: holds orchestrator lease on {','.join(lanes)} for {ttl}m")
        for line in fmt_orch(rows): print(line)
        print("Release it on the way out: wq orch --release (or wq whoami --release).")
        return
    rows = orch_leases(c, t_now)
    c.execute("COMMIT"); c.close()
    if not rows:
        print("wq orch: no orchestrator holds a lane-set lease.")
        print(f"  You are {ident}. Claim one before dispatching: wq orch --acquire <lanes>")
        return
    print(f"wq orch: {len(set(h for _l, h, *_ in rows))} orchestrator(s) driving "
          f"{len(rows)} lane(s):")
    for line in fmt_orch(rows): print(line)
    print(f"  (you are {ident})")

def cmd_heartbeat(a):
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    r = c.execute("SELECT status, claimed_by, subsystems FROM tasks WHERE id=?", (a.id,)).fetchone()
    if not r or r[0] != 'claimed':
        c.execute("COMMIT"); c.close()
        eprint(f"REFUSED: task {a.id} is not claimed (status={r[0] if r else 'missing'})"); sys.exit(1)
    caller, _ = resolve_identity(a)
    if not owner_ok(c, caller, r[1], "heartbeat", a.id):
        c.execute("COMMIT"); c.close(); sys.exit(1)
    # wq#1158: the fence check comes BEFORE mark_alive, because mark_alive PROMOTES leases —
    # a zombie must not get to extend a lease it no longer holds on its way to being refused.
    fcl, fpar = fence_guard(c, a, a.id, "heartbeat")
    mark_alive(c, caller, "heartbeat")
    lease = lease_from(a.ttl)
    frag, fparams = lease_set_sql(c, r[1], lease)
    cur = c.execute(f"UPDATE tasks SET lease_expires=?, lease_ttl=?{frag} WHERE id=?{fcl}",
                    [lease, a.ttl] + fparams + [a.id] + fpar)
    if cur.rowcount == 0:
        c.execute("ROLLBACK"); c.close()
        print(f"REFUSED: heartbeat {a.id} matched no row under fence "
              f"{getattr(a,'fence',None)} — the claim moved while this call was in flight "
              f"(wq#1158)."); sys.exit(5)
    subs = parse_subs(r[2])
    if subs: acquire_subs(c, subs, r[1], a.ttl, f"wq#{a.id}")  # extends held slocks for same holder
    c.execute("COMMIT"); c.close()
    print(f"heartbeat {a.id}: lease + {len(subs)} slock(s) extended to {lease}Z (holder {r[1]})")
# ---------------------------------------------------------------- wq#759 evidence gate
# PROBLEM (FLEET_OPS_AUDIT_2026-08-21 F8): 29 done tickets carry no report notes — nothing
# gated closure on evidence, so 'done' meant 'an agent said done'. From here, `wq done`
# refuses unless --notes names something checkable (an existing file path, a PR/commit URL,
# or a commit sha) or the caller states --no-artifact "<reason>" explicitly, on the record.
ARTIFACT_URL_RE = re.compile(r"https?://\S*/(?:pulls?|commits?)/\S+")
# a git sha is hex and 7-40 chars; require >=1 a-f letter so plain decimal tokens (dates,
# ticket ids) never false-positive as shas.
ARTIFACT_SHA_RE = re.compile(r"(?=[0-9a-f]{7,40}$)[0-9a-f]*[a-f][0-9a-f]*")

# ------------------------------------------------- wq#1673 evidence-durability gate (F3/F4)
# PROBLEM (TICKET_CLOSURE_AUDIT.md §4 F4): find_artifact resolves a bare token against the
# CLOSER's cwd and records the token exactly as typed. Agents run `wq done` from inside the
# worktree they did the work in, so "reports/foo.md" resolved there, went onto the ticket
# verbatim, and stopped meaning anything the moment the worktree was removed — 10 of 419
# closes sampled since 2026-09-01 cite a path nothing under /home/lumen can find today.
# Three parts, all here:
#   1. canonicalize — `done` rewrites the accepted token to the absolute path find_artifact
#      actually stat()ed, so a later reader checks the same file wq did;
#   2. require it landed — a file that exists only in a LINKED worktree is not evidence, it
#      is a file about to be deleted with that worktree. Refuse unless the same repo-relative
#      path is on origin/main (or main), or the caller records --unlanded "<reason>";
#   3. a sha must resolve (§4 P3) — `git cat-file -e` in the caller's repo or any checkout
#      under /home/lumen. A 7-hex token nothing can resolve is a typo, not evidence.
# The audit scoped (2) to `scratch/worktrees/`; the test here is "is this a linked worktree",
# which is the actual invariant and also covers /home/lumen/worktrees/ — where the fworker
# BUILD lane runs, and where all 10 dead citations were written.
# FAIL OPEN ON INFRASTRUCTURE, FAIL CLOSED ON FACTS, same as the wq#899 gate below: no git,
# no main ref, unreadable repo -> warn and allow.
GIT_EVIDENCE_TIMEOUT = float(os.environ.get("WQ_GIT_EVIDENCE_TIMEOUT", "8"))
MAIN_REFS = ("origin/main", "main", "origin/master", "master")

def _git(cwd, *args):
    """git in `cwd`. None means git itself failed to run — 'no opinion', never 'no'."""
    import subprocess
    try:
        return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True,
                              timeout=GIT_EVIDENCE_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return None

def _sha_repo_candidates():
    """Repos a fleet sha could plausibly live in: the caller's cwd first, then every git
    checkout directly under /home/lumen and its two repo-holding subdirs."""
    seen, out, kids = set(), [], []
    for base in ("/home/lumen", "/home/lumen/projects", "/home/lumen/agents"):
        try:
            kids += sorted(os.path.join(base, n) for n in os.listdir(base))
        except OSError:
            pass
    for d in [os.getcwd()] + kids:
        real = os.path.realpath(d)
        if real in seen or not os.path.isdir(d):
            continue
        seen.add(real)
        if os.path.exists(os.path.join(d, ".git")):
            out.append(d)
    return out

_SHA_CACHE = {}

def sha_resolves(sha):
    """Does this sha name a commit in any repo on this box? True on 'cannot tell' (no git,
    no repos) — the gate is here to catch a fabricated citation, not to wedge a lane."""
    if sha in _SHA_CACHE:
        return _SHA_CACHE[sha]
    saw_git = False
    for repo in _sha_repo_candidates():
        r = _git(repo, "cat-file", "-e", sha + "^{commit}")
        if r is None:
            continue
        saw_git = True
        if r.returncode == 0:
            _SHA_CACHE[sha] = True
            return True
    _SHA_CACHE[sha] = not saw_git
    return _SHA_CACHE[sha]

def _worktree_of(path):
    """(toplevel, is_linked_worktree) for the worktree containing `path`, else (None, False).
    A linked worktree's --git-dir (…/.git/worktrees/<name>) differs from its --git-common-dir
    (…/.git); the primary checkout's are the same directory."""
    d = os.path.dirname(os.path.abspath(path)) or "/"
    if not os.path.isdir(d):
        return None, False
    r = _git(d, "rev-parse", "--show-toplevel", "--git-dir", "--git-common-dir")
    if r is None or r.returncode != 0:
        return None, False
    lines = [ln.strip() for ln in r.stdout.splitlines() if ln.strip()]
    if len(lines) < 3:
        return None, False
    top, gitdir, common = lines[0], lines[1], lines[2]
    absolve = lambda p: os.path.realpath(p if os.path.isabs(p) else os.path.join(d, p))
    return top, absolve(gitdir) != absolve(common)

def evidence_durability(abs_path):
    """Would this citation still resolve from a clean checkout, or only from the tree the
    closer happened to be standing in? Returns (verdict, why) — 'durable', 'ephemeral'
    (linked worktree, absent from main), or 'unknown' (fail open)."""
    verdict, why, _ = _durability(abs_path)
    return verdict, why

def _durability(abs_path):
    """evidence_durability plus a third field, `on_main`: True only when the file is committed
    on a main ref. wq#1702 needs the difference between 'durable because it is on main' and
    'durable because git does not track it' — only the first one proves something LANDED."""
    root, linked = _worktree_of(abs_path)
    if root is None:
        return "durable", "not inside a git worktree", False
    rel = os.path.relpath(os.path.realpath(abs_path), os.path.realpath(root))
    if rel.startswith(".."):
        return "unknown", f"resolved outside the worktree {root} it sits under", False
    checked, saw_git = [], False
    for ref in MAIN_REFS:
        rv = _git(root, "rev-parse", "--verify", "--quiet", ref)
        if rv is None:
            return "unknown", "git unavailable", False
        saw_git = True
        if rv.returncode != 0:
            continue
        checked.append(ref)
        e = _git(root, "cat-file", "-e", f"{ref}:{rel}")
        if e is None:
            return "unknown", "git unavailable", False
        if e.returncode == 0:
            return "durable", f"{rel} is on {ref} of {root}", True
    if not checked:
        return ("unknown", f"no main/master ref in {root}" if saw_git else "git unavailable", False)
    if not linked:
        # wq#1702 (D3): a PRIMARY checkout used to pass unconditionally, so a file written into
        # /home/lumen/bin and never committed counted as landed — the live-only-hunk class
        # (wq#1653). Gitignored files are on-box state by design and stay durable; an untracked
        # or branch-only file in the primary tree is exactly as unlanded as one in a worktree.
        ig = _git(root, "check-ignore", "-q", "--", rel)
        if ig is None:
            return "unknown", "git unavailable", False
        if ig.returncode == 0:
            return "durable", f"{rel} is gitignored in {root} (on-box state, not a landing)", False
        return "ephemeral", (f"{rel} is in the primary checkout {root} but not committed on "
                             f"{'/'.join(checked)} — written live, never landed"), False
    return "ephemeral", (f"{rel} exists only inside the linked worktree {root} — not on "
                         f"{'/'.join(checked)}"), False

def canonicalize_evidence(notes, token, abs_path):
    """Rewrite the accepted token in `notes` to the absolute path it resolved to, keeping any
    :N/:N-M line locator. Returns (notes, new_token); a no-op when it was already absolute."""
    loc = re.search(r":\d+(-\d+)?$", token)
    new = abs_path + (loc.group(0) if loc else "")
    if new == token:
        return notes, token
    return notes.replace(token, new, 1), new

def _artifact_path_candidates(token):
    """Resolve a bare token to the paths it could mean: as given, relative to the caller's
    cwd (the common case — agents run `wq done` from inside their own worktree), and
    relative to /home/lumen (the fleet home, for notes written from elsewhere)."""
    if os.path.isabs(token):
        return [token]
    return [token, os.path.join(os.getcwd(), token), os.path.join("/home/lumen", token)]

def find_artifact(notes, resolve_sha=False):
    """Does `notes` name a verifiable artifact? Returns (ok, kind, detail, token) — `token` is
    the substring of `notes` the answer came from, so a caller can rewrite it in place.

    resolve_sha (wq#1673, audit §4 P3) makes the sha branch prove the commit exists somewhere
    on this box instead of trusting its shape; it costs a few `git cat-file` calls, so it is
    off by default and on for `done`, the one caller whose verdict decides a ticket's fate."""
    notes = notes or ""
    m = ARTIFACT_URL_RE.search(notes)
    if m:
        return True, "url", m.group(0).rstrip(".,)"), m.group(0)
    for raw in notes.split():
        tok = raw.strip(".,;:()[]\"'")
        if tok and ARTIFACT_SHA_RE.fullmatch(tok):
            if resolve_sha and not sha_resolves(tok):
                continue  # unresolvable sha — treated like a missing path (audit §4 P3)
            return True, "sha", tok, tok
    for raw in notes.split():
        tok = raw.strip(".,;:()[]\"'")
        if not tok or tok.startswith("http"):
            continue
        # wq#1374: accept a trailing :N or :N-M line-locator (path/to/file.py:88-104) — the
        # evidence gate's own citation format — without forcing a rewrite to a bare path.
        # wq#1673: strip it BEFORE the path-shape test, not after; a bare "wq.py:88-104" has
        # no slash and no extension at the end, so the shape test used to skip it unread.
        path_tok = re.sub(r":\d+(-\d+)?$", "", tok)
        if "/" not in path_tok and not re.search(r"\.[A-Za-z0-9]{1,5}$", path_tok):
            continue  # doesn't look path-shaped — skip rather than stat() every word
        for cand in _artifact_path_candidates(path_tok):
            if os.path.exists(cand):
                return True, "path", cand, tok
    return False, None, None, None

# ---------------------------------------------------------------- wq#899 merge-state gate
# PROBLEM (FLEET_OPS_AUDIT_2026-08-23): wq#759 SHAPE-checks the artifact — a PR URL counts as
# evidence the moment it parses. The 2026-08-23 audit found ~30 tickets closed `done` citing a
# PR that was still open, and one of them (wq#825) had its only copy of the code in a working
# tree, where the next clean checkout would have erased it. A PR URL proves a branch exists.
# It does not prove the work landed.
#
# So when the artifact IS a pull-request URL, resolve it. Merged is evidence. Head already
# reachable from the base branch is evidence too — a squash or cherry-pick leaves the PR open
# while the code is genuinely on main. An open PR whose head is nowhere near main is not
# evidence, and `done` refuses it.
#
# FAIL OPEN ON INFRASTRUCTURE, FAIL CLOSED ON FACTS. No token, no network, unknown forge, HTTP
# error, ambiguous answer -> warn and allow. This gate exists to catch a mistake, not to wedge
# every lane in the fleet the first time the forge restarts.
PR_URL_RE = re.compile(r"https?://([^/\s]+)/([^/\s]+)/([^/\s]+?)/pulls?/(\d+)")
MERGE_STATE_TIMEOUT = float(os.environ.get("WQ_MERGE_STATE_TIMEOUT", "8"))

GITHUB_IDENTITY_LIB = os.environ.get("WQ_GITHUB_IDENTITY_LIB", "/home/lumen/bin/lumen-github-identity.sh")

def _github_token(slug):
    """wq#1702 (D4, audit F1): the token comes from the SAME resolver lumen-pr sources —
    identity-map entry for the slug, then .secrets/github-frank.token, then agent/.env —
    run in a subprocess, read from its stdout, never printed. The python copy of that search
    order is what drifted (wq#1581) and blinded the merge gate for every github.com PR; one
    resolver cannot drift from itself. $GITHUB_TOKEN stays as the last rung."""
    import subprocess
    if slug and os.path.isfile(GITHUB_IDENTITY_LIB):
        script = ('source "$1" >/dev/null 2>&1 || exit 1; '
                  'resolve_github_token "$2" >/dev/null 2>&1 || exit 1; printf %s "$GITHUB_TOKEN"')
        try:
            r = subprocess.run(["bash", "-c", script, "wq-github-token", GITHUB_IDENTITY_LIB, slug],
                               capture_output=True, text=True, timeout=MERGE_STATE_TIMEOUT)
            tok = (r.stdout or "").strip()
            if r.returncode == 0 and tok:
                return tok
        except (OSError, subprocess.SubprocessError):
            pass
    return os.environ.get("GITHUB_TOKEN", "").strip() or None

def _forge_token(host, slug=None):
    """github.com: the lumen-github-identity.sh resolver (wq#1702). Gitea: same file order
    lumen-pr uses. Returned to the caller, never printed."""
    if host in ("github.com", "www.github.com"):
        return _github_token(slug)
    for path in (os.environ.get("GITEA_TOKEN_FILE") or "/home/lumen/.secrets/gitea-lumen.token",):
        try:
            with open(path) as fh:
                tok = fh.read().strip()
                if tok:
                    return tok
        except OSError:
            pass
    try:
        with open("/home/lumen/agent/.env") as fh:
            for line in fh:
                if line.startswith("GITEA_TOKEN="):
                    tok = line.split("=", 1)[1].strip().strip("\"'")
                    if tok:
                        return tok
    except OSError:
        pass
    return None

def _forge_get(host, path, token):
    import json as _json, urllib.request, urllib.error
    if host in ("github.com", "www.github.com"):
        base, auth = "https://api.github.com", f"Bearer {token}"
    else:
        base, auth = f"http://{host}/api/v1", f"token {token}"
    req = urllib.request.Request(base + path, headers={
        "Authorization": auth, "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=MERGE_STATE_TIMEOUT) as r:
            return _json.load(r)
    except (urllib.error.URLError, OSError, ValueError) as e:
        return {"_error": str(e)[:120]}

def _head_on_main(sha, base_ref):
    """Is `sha` already an ancestor of the base branch in the repo the caller is standing in?

    Agents run `wq done` from inside the worktree they did the work in, so cwd is nearly always
    the right clone. Cheap, offline, and it catches the squash-merge case the forge reports as
    'still open'. Any doubt at all -> None, meaning 'no local opinion', not 'no'."""
    import subprocess
    def g(*args):
        return subprocess.run(["git", *args], capture_output=True, text=True,
                              timeout=MERGE_STATE_TIMEOUT)
    try:
        if g("rev-parse", "--git-dir").returncode != 0:
            return None
        if g("cat-file", "-e", sha + "^{commit}").returncode != 0:
            return None
        for ref in (f"origin/{base_ref}", base_ref, "origin/main", "main"):
            if g("rev-parse", "--verify", "--quiet", ref).returncode == 0:
                return g("merge-base", "--is-ancestor", sha, ref).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return None
    return None

def pr_merge_state(url):
    """Resolve a PR URL to (verdict, detail). verdict is one of:
        'merged'  — the forge says it merged
        'landed'  — still open, but its head is already an ancestor of the base branch
        'open'    — open, and the head is not on the base branch: the wq#899 failure
        'unknown' — could not tell (no token, network down, HTTP error, not a PR URL)"""
    m = PR_URL_RE.search(url or "")
    if not m:
        return "unknown", "not a pull-request URL"
    host, owner, repo, num = m.group(1), m.group(2), m.group(3), m.group(4)
    token = _forge_token(host, f"{owner}/{repo}")
    if not token:
        return "unknown", f"no forge token for {host}"
    pr = _forge_get(host, f"/repos/{owner}/{repo}/pulls/{num}", token)
    if "_error" in pr or not isinstance(pr, dict) or "state" not in pr:
        return "unknown", f"{host} unreachable or refused: {pr.get('_error', 'bad response')}"
    if pr.get("merged"):
        return "merged", f"{owner}/{repo}#{num} merged"
    head = (pr.get("head") or {}).get("sha") or ""
    base_ref = ((pr.get("base") or {}).get("ref")) or "main"
    if head and _head_on_main(head, base_ref) is True:
        return "landed", f"{owner}/{repo}#{num} open, but {head[:10]} is already on {base_ref}"
    if pr.get("state") == "closed":
        return "open", f"{owner}/{repo}#{num} was CLOSED without merging"
    return "open", f"{owner}/{repo}#{num} is still OPEN and {head[:10] or 'its head'} is not on {base_ref}"

# wq#841: the single definition of "this ticket came back from the dead". Rework is a move INTO
# an in-flight state FROM a terminal one. A lease reap or a release of a claim nobody finished is
# claimed->open — not rework, and it must not inflate the metric.
TERMINAL_STATUSES = ("done", "rejected")
INFLIGHT_STATUSES = ("open", "claimed", "blocked")
def is_reopen(old_status, new_status):
    return (old_status or "") in TERMINAL_STATUSES and (new_status or "") in INFLIGHT_STATUSES
def bump_reopened(c, tid):
    """Monotonic +1 in its own column. COALESCE covers rows that predate the migration."""
    c.execute("UPDATE tasks SET reopened_count=COALESCE(reopened_count,0)+1, reopened_at=? WHERE id=?",
              (now(), tid))
    return c.execute("SELECT reopened_count FROM tasks WHERE id=?", (tid,)).fetchone()[0]

def _finish(a, new_status):
    """Returns the new reopened_count if this call was a reopen, else 0."""
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    r = c.execute("SELECT claimed_by, subsystems, status FROM tasks WHERE id=?", (a.id,)).fetchone()
    if r is None:
        c.execute("COMMIT"); c.close(); eprint(f"REFUSED: no such task {a.id}"); sys.exit(1)
    caller, _ = resolve_identity(a)
    holder = r[0]
    # wq#1539: the --dead-worker override's OWN eligibility (holder set, holder != caller,
    # holder_is_dead()) is checked BEFORE owner_ok is called at all — was after. owner_ok
    # eprints its REFUSED banner unconditionally on refusal, so calling it first made every
    # successful `release --dead-worker` open its stderr with a false-looking REFUSED line
    # ahead of the WARNING + released lines. Calling owner_ok only when the override does NOT
    # apply means a verified-dead holder never triggers that banner at all (wq#1539).
    dead_worker = new_status == 'open' and getattr(a, 'dead_worker', False)
    if dead_worker and holder and holder != caller and holder_is_dead(c, holder):
        # wq#1498: `wq release --dead-worker` is the stale-claim path owner_ok's refusal text
        # recommends INSTEAD of `wq retire` for a per-ticket fworker identity — retiring that
        # identity poisons every future spawn of the ticket, this does not.
        warn(f"wq#{a.id}: holder '{holder}' verified dead (no live session"
             + (", no running unit" if FWORKER_IDENTITY_RE.match(holder) else "")
             + f") — releasing under --dead-worker on behalf of '{caller}' (wq#1498).")
        log_activity(c, caller, f"dead-worker-release:{holder}")
    elif not owner_ok(c, caller, holder, new_status if new_status != 'open' else 'release', a.id):
        if dead_worker:
            c.execute("COMMIT"); c.close()
            eprint(f"REFUSED: wq#{a.id} held by '{holder}' — --dead-worker liveness check found "
                  f"it still alive (a live session row, or a running lumen-job-{holder}-* unit "
                  f"per `lumen-run list`). Not releasing.")
            sys.exit(1)
        else:
            c.execute("COMMIT"); c.close(); sys.exit(1)
    # wq#1116: `done` REPLACES notes wholesale, so a second close silently destroys the first
    # one's evidence — that is how session A's `wq done 1096` erased session B's note two minutes
    # after B had already closed it. Identity does not enter into this: re-closing a ticket that
    # is ALREADY done is a write with nothing to gain and a citation to lose, whoever does it.
    # release/block on a done ticket are deliberate reopens (wq#841) and stay untouched.
    if new_status == 'done' and (r[2] or '') == 'done':
        prev = c.execute("SELECT done_at, notes FROM tasks WHERE id=?", (a.id,)).fetchone()
        reclose = getattr(a, "reclose", None)
        if not reclose:
            c.execute("COMMIT"); c.close()
            eprint(f"REFUSED: wq#{a.id} is already done (closed {prev[0]}Z) and `done` REPLACES\n"
                  f"  notes, so this call would destroy the evidence already on the record:\n"
                  f"    {(prev[1] or '(empty)')[:200]}\n"
                  f"  If you closed this and the notes need correcting, say so on the record:\n"
                  f"    wq done {a.id} --notes \"...\" --reclose \"<why the first close was wrong>\"\n"
                  f"  If you did NOT close it, someone else already finished this ticket — read\n"
                  f"  `wq show {a.id}` before overwriting it (wq#1116).")
            sys.exit(4)
        a.notes = ((getattr(a, 'notes', '') or '') +
                   (" " if getattr(a, 'notes', '') else "") + f"[RECLOSE: {reclose}]").strip()
        warn(f"wq#{a.id} re-closed over a {prev[0]}Z close; previous notes: {(prev[1] or '(empty)')[:120]}")
    # wq#1158: checked before mark_alive for the same reason as heartbeat — promotion is a
    # write, and a stale-fence caller gets to make none. `fence` is deliberately NOT cleared or
    # reset by any of these three transitions: it is monotonic per ticket, so a holder that
    # released and re-claimed cannot land a write minted under the earlier claim.
    fcl, fpar = fence_guard(c, a, a.id, {"done": "done", "open": "release",
                                         "blocked": "block"}[new_status])
    mark_alive(c, caller, {"done": "done", "open": "release", "blocked": "block"}[new_status])
    if r and r[1]:
        release_subs(c, parse_subs(r[1]), r[0] or "")
    clr = lease_clear_sql(c)
    if new_status == 'done':
        cur = c.execute(f"UPDATE tasks SET status='done', done_at=?, notes=?, lease_expires=NULL, "
                        f"lease_ttl=NULL, block_reason=NULL, blocked_at=NULL, hold_by=NULL, "
                        f"hold_expires=NULL{clr} WHERE id=?{fcl}",
                        [now(), getattr(a,'notes','') or '', a.id] + fpar)
    elif new_status == 'open':
        cur = c.execute(f"UPDATE tasks SET status='open', claimed_by=NULL, claimed_at=NULL, "
                        f"lease_expires=NULL, lease_ttl=NULL, block_reason=NULL, blocked_at=NULL, "
                        f"hold_by=NULL, hold_expires=NULL"
                        f"{clr} WHERE id=?{fcl}", [a.id] + fpar)
    elif new_status == 'blocked':
        # wq#741: block_reason/blocked_at are the structural home for this — notes keeps
        # getting the same string too, so `wq show`/`wq list` need no changes.
        cur = c.execute(f"UPDATE tasks SET status='blocked', notes=?, block_reason=?, blocked_at=?, "
                        f"lease_expires=NULL{clr} WHERE id=?{fcl}",
                        [a.reason, a.reason, now(), a.id] + fpar)
    if cur.rowcount == 0:
        c.execute("ROLLBACK"); c.close()
        eprint(f"REFUSED: {new_status} on wq#{a.id} matched no row under fence "
              f"{getattr(a,'fence',None)} — the claim moved while this call was in flight "
              f"(wq#1158)."); sys.exit(5)
    reopened = bump_reopened(c, a.id) if is_reopen(r[2], new_status) else 0
    c.execute("COMMIT"); c.close()
    return reopened
# ------------------------------------------------ wq#1702 the ticket's own terms (D1/D2)
# wq#1673 added a `deliverable` column and nobody sets it (0 of 1119 tickets since 08-15), so
# that gate never fired. The terms are already in the ticket text; read them from there.
# PRECISION OVER RECALL: a false refusal wedges a real close, a miss just falls back to the
# notes gates above. So only explicit markers count. Backtest over 918 closes (design doc
# design/wq1702-done-gate.md): `Deliverable:`/`Output:`/`-> path` named 17, all 17 resolve;
# `Report:` was dropped because tickets use it for INPUTS (#1037).
_DELIV_EXT = r"(?:md|py|json|jsonl|sh|txt|ya?ml|csv|html|toml|conf|service|timer)"
_DELIV_PATH = r"`?((?:/|~/|\./)?[\w.@+-]+(?:/[\w.@+-]+)*\." + _DELIV_EXT + r")\b`?"
DELIVERABLE_MARK_RE = re.compile(r"(?im)\b(?:deliverables?|outputs?)\s*[:=]\s*" + _DELIV_PATH)
DELIVERABLE_ARROW_RE = re.compile(r"(?:->|\u2192)\s*" + _DELIV_PATH)
# a ticket that says HOW it lands has made landing part of done (D2)
LANDING_DEMAND_RE = re.compile(r"(?i)\b(?:via lumen-pr|lumen-pr land)\b")

def derive_deliverable(title, detail):
    txt = f"{title or ''}\n{detail or ''}"
    m = DELIVERABLE_MARK_RE.search(txt) or DELIVERABLE_ARROW_RE.search(txt)
    return os.path.expanduser(m.group(1)) if m else None

def landing_demanded(title, detail):
    m = LANDING_DEMAND_RE.search(f"{title or ''}\n{detail or ''}")
    return m.group(0) if m else None

_PRIMARY_ROOTS = None

def _primary_repo_roots():
    """PRIMARY checkouts one and two levels under /home/lumen (fleet/inventory, projects/x).
    A linked worktree (.git is a file) is skipped: a deliverable that only resolves inside one
    is found through cwd instead, and then correctly judged ephemeral. wq#1702 replay: #1455's
    `www/fleet.html` lives in /home/lumen/fleet/inventory, two levels down."""
    global _PRIMARY_ROOTS
    if _PRIMARY_ROOTS is None:
        roots = []
        for base in ["/home/lumen"] + sorted(os.path.join("/home/lumen", n) for n in _ls("/home/lumen")):
            for n in sorted(_ls(base)):
                d = os.path.join(base, n)
                if os.path.isdir(os.path.join(d, ".git")) and not os.path.islink(d):
                    roots.append(d)
        _PRIMARY_ROOTS = [r for r in dict.fromkeys(roots) if "/worktrees/" not in r + "/"]
    return _PRIMARY_ROOTS

def _ls(d):
    try:
        return [n for n in os.listdir(d) if not n.startswith(".")] if os.path.isdir(d) else []
    except OSError:
        return []

def _deliverable_candidates(want, notes):
    """Where a named output could be: as given / cwd / /home/lumen (wq#1673), then relative
    to each repo checkout on the box, then any path in the closing notes that ENDS in the
    named relative path (`reports/x.md` named, `/home/lumen/minerva/v4/reports/x.md` cited)."""
    out = list(_artifact_path_candidates(want))
    if not os.path.isabs(want):
        # the queue's own directory first: `reports/x.md` in a ticket means work-queue/reports
        bases = [os.path.dirname(os.path.realpath(DB))] + _sha_repo_candidates() + _primary_repo_roots()
        out += [os.path.join(r, want) for r in bases]
        tail = "/" + want.lstrip("./")
        for raw in (notes or "").split():
            tok = re.sub(r":\d+(-\d+)?$", "", raw.strip(".,;:()[]\"'"))
            if os.path.isabs(tok) and tok.endswith(tail):
                out.append(tok)
    return out

def deliverable_check(ticket_id, notes=""):
    """wq#1673 (audit §4 P2) + wq#1702: the output the ticket named — the `deliverable` column
    if set, else the one its own text names (derive_deliverable). Returns (verdict, why):
    'none', 'durable', 'missing', 'ephemeral', or 'unknown' (fail open)."""
    c = conn()
    try:
        row = c.execute("SELECT deliverable, title, detail FROM tasks WHERE id=?", (ticket_id,)).fetchone()
    except sqlite3.OperationalError:
        return "unknown", "no deliverable column on this queue"  # pre-migration DB
    finally:
        c.close()
    if not row:
        return "none", ""
    want, source = (row[0] or "").strip(), "deliverable"
    if not want:
        want, source = (derive_deliverable(row[1], row[2]) or ""), "deliverable named in the ticket text"
    if not want:
        return "none", ""
    derived = source != "deliverable"
    import glob as _glob
    for cand in _deliverable_candidates(want, notes):
        # wq#1702 replay: ticket templates name `reports/foo-YYYYMMDD.md`; the file has a date.
        hits = _glob.glob(_placeholder_glob(cand)) if derived and _PLACEHOLDER_RE.search(cand) else (
            [cand] if os.path.exists(cand) else [])
        if hits:
            verdict, why = evidence_durability(os.path.realpath(sorted(hits)[-1]))
            return verdict, f"{source} {want}: {why}"
    if derived and not os.path.isabs(want):
        # A RELATIVE path the ticket text named but did not anchor is ambiguous, not missing:
        # the replay back to 06-01 found ~45 real reports under pack dirs no base can guess
        # (fable-prep/<pack>/reports/...). Fail open, visibly; an absolute path stays a fact.
        return "unknown", f"{source} {want} is relative and resolved under no known base"
    return "missing", f"{source} {want} does not exist anywhere this close can see"

_PLACEHOLDER_RE = re.compile(r"YYYY|<[^>/]+>|\{[^}/]+\}")

def _placeholder_glob(p):
    g = _glob_escape(p)
    g = g.replace("YYYY", "[0-9][0-9][0-9][0-9]").replace("MM", "[0-9][0-9]").replace("DD", "[0-9][0-9]")
    return re.sub(r"<[^>/]+>|\{[^}/]+\}", "*", g)

def _glob_escape(p):
    return re.sub(r"([\[\]?*])", r"[\1]", p)

def _sha_on_main(sha):
    """(True, why) if the commit is reachable from a main ref of a repo on this box, (False,
    why) if it exists but only off main, (None, why) if no repo here knows it."""
    seen = False
    for repo in _sha_repo_candidates():
        r = _git(repo, "cat-file", "-e", sha + "^{commit}")
        if r is None or r.returncode != 0:
            continue
        seen = True
        for ref in MAIN_REFS:
            rv = _git(repo, "rev-parse", "--verify", "--quiet", ref)
            if rv is None or rv.returncode != 0:
                continue
            a = _git(repo, "merge-base", "--is-ancestor", sha, ref)
            if a is not None and a.returncode == 0:
                return True, f"{sha} is on {ref} of {repo}"
    return (False, f"{sha} exists but is on no main ref") if seen else (None, f"no repo here has {sha}")

def landing_proof(notes, pr_verdicts=None):
    """wq#1702 (D2): does anything in `notes` prove the work LANDED? Scans every citation, not
    just the first: a PR the forge calls merged/landed, a sha on a main ref, or a path
    committed on main. Returns (verdict, why): 'landed', 'unverified' (a PR whose state the
    forge would not tell us — fail open, stamped), or 'not-landed'."""
    notes = notes or ""
    pr_verdicts = dict(pr_verdicts or {})
    unverified = None
    for m in PR_URL_RE.finditer(notes):
        url = m.group(0)
        if url not in pr_verdicts:
            pr_verdicts[url] = pr_merge_state(url)
        v, why = pr_verdicts[url]
        if v in ("merged", "landed"):
            return "landed", why
        if v == "unknown" and unverified is None:
            unverified = why
    for raw in notes.split():
        tok = raw.strip(".,;:()[]\"'")
        cm = re.search(r"/commits?/([0-9a-f]{7,40})\b", tok)
        sha = cm.group(1) if cm else (tok if ARTIFACT_SHA_RE.fullmatch(tok) else None)
        if sha:
            ok, why = _sha_on_main(sha)
            if ok:
                return "landed", why
            continue
        if tok.startswith("http"):
            continue
        path_tok = re.sub(r":\d+(-\d+)?$", "", tok)
        if "/" not in path_tok:
            continue
        for cand in _artifact_path_candidates(path_tok):
            if os.path.exists(cand):
                verdict, why, on_main = _durability(os.path.realpath(cand))
                if on_main:
                    return "landed", why
                break
    if unverified:
        return "unverified", unverified
    return "not-landed", "no merged PR, no commit on a main ref, no path committed on main"

def _stamp(notes, tag):
    return ((notes or "") + (" " if notes else "") + tag).strip()

def _aq_unverified(ticket_id, why):
    """One keyed aq row per forge host, only against the LIVE queue (tests use a scratch DB).
    Best effort: aq trouble never blocks a close."""
    if os.path.realpath(DB) != os.path.realpath("/home/lumen/agents/work-queue/queue.db"):
        return
    import subprocess
    host = (re.search(r"for ([\w.:-]+)", why) or re.search(r"^([\w.:-]+) unreachable", why))
    key = f"unverified-pr:{host.group(1) if host else 'forge'}"
    try:
        subprocess.run(["aq", "add", "wq-done-gate", key,
                        "wq done closed over a PR it could not verify",
                        f"wq#{ticket_id}: {why}. The merge gate failed open; fix the forge/token path."],
                       capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass

# ------------------------------------------------- wq#1724 ops-artifact deploy gate
# PROBLEM: an ops/*/install.sh artifact passes the wq#1673 durability gate the moment it is
# committed on main — that gate proves the SCRIPT landed, not that it ever ran against its
# target. wq#1632 closed done this way 2026-09-10: install.sh landed, `wq done` accepted it as
# evidence, and lumen_state.py never saw a write (0 lifecycle rows live). Same gate, a stricter
# fact for this one shape of citation — not a second gate (ticket text: "extend wq#1673's
# deliverable check rather than adding a second one").
OPS_INSTALL_RE = re.compile(r"/ops/wq\d+[\w.-]*/install\.sh$")

def _sha256(path):
    import hashlib
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None

def ops_deploy_check(abs_path, deployed_target):
    """abs_path is the citation `find_artifact` resolved for this close. Returns (verdict, why):
    'none' when abs_path isn't an ops/*/install.sh artifact at all (gate does not apply);
    'deployed' when --deployed names a live file whose bytes match a file shipped alongside
    install.sh in the same artifact dir (proof the install actually ran, not just that the
    script exists); 'undeployed' otherwise — no --deployed given, the named target is missing,
    or its bytes match nothing the artifact ships (install.sh landed but never ran, or ran
    against a target this citation doesn't name)."""
    if not OPS_INSTALL_RE.search(abs_path):
        return "none", ""
    if not deployed_target:
        return "undeployed", (f"{abs_path} is an ops install artifact — its existence on main "
                              f"proves the script landed, not that it ran against a target")
    if not os.path.exists(deployed_target):
        return "undeployed", f"--deployed {deployed_target} does not exist"
    target_hash = _sha256(deployed_target)
    art_dir = os.path.dirname(abs_path)
    for root, _dirs, files in os.walk(art_dir):
        for name in files:
            if name == "install.sh":
                continue
            cand = os.path.join(root, name)
            if target_hash is not None and _sha256(cand) == target_hash:
                return "deployed", f"{deployed_target} byte-matches {cand} shipped in {art_dir}"
    return "undeployed", (f"--deployed {deployed_target} matches no file shipped in {art_dir} — "
                          f"install.sh landed but its target does not carry the artifact's bytes")

def cmd_done(a):
