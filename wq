                  f"lands ({demand!r}), and nothing in the notes proves it did: {lwhy}. Cite the "
                  f"merged PR URL, a commit that is on main, or a path committed on main. If it "
                  f"legitimately did not need to land (stale, duplicate, no-op), say so on the "
                  f"record with --unlanded \"<reason>\".")
            sys.exit(8)
        if lv == "unverified" and "[UNVERIFIED-PR" not in (a.notes or ""):
            print(f"WARNING: wq#1702 landing gate could not verify ({lwhy}). Closing anyway, "
                  f"stamped [UNVERIFIED-PR].")
            a.notes = _stamp(a.notes, f"[UNVERIFIED-PR: {lwhy}]")
            _aq_unverified(a.id, lwhy)
        elif lv == "landed":
            print(f"note: wq#1702 landing gate — {lwhy}.")
    # wq#1673: one stamp, whichever of the two durability gates the caller overrode — the
    # override has to be legible on the ticket even when the path branch never ran.
    unlanded = getattr(a, "unlanded", None)
    if unlanded:
        a.notes = ((getattr(a, "notes", "") or "") +
                   (" " if getattr(a, "notes", "") else "") + f"[UNLANDED: {unlanded}]").strip()
    _finish(a, 'done')
    print(f"done {a.id} (subsystem locks released)")
def _reopen_tag(n): return f" [REOPENED — reopened_count={n}]" if n else ""
def cmd_release(a): print(f"released {a.id} (subsystem locks released){_reopen_tag(_finish(a, 'open'))}")
def cmd_block(a):
    # wq#1676: block was ungated — free-text block_reason the sweep can never read. Same
    # mandatory-tag on-ramp as add/decide (frank_gated=True unconditionally: a block is in
    # scope for the backlog sweep regardless of lane, so it always needs a probe path).
    # The liveness gate's detail write only runs when a lightweight ownership+fence
    # pre-check agrees this block would proceed — a stale/zombie/wrong-owner caller gets
    # _finish's own refusal (rc=5 stale fence, rc=1 wrong owner) untouched, and this
    # writes nothing: the liveness gate must never be how a fence gets bypassed.
    c = conn()
    r = c.execute("SELECT title, detail, lane, claimed_by FROM tasks WHERE id=?", (a.id,)).fetchone()
    if r:
        title, detail, lane, claimed_by = r
        caller, _ = resolve_identity(a)
        want_fence = getattr(a, "fence", None)
        fence_ok = True
        if want_fence is not None:
            cur_fence = fence_of(c, a.id)
            fence_ok = cur_fence is not None and cur_fence == int(want_fence)
        pre_owner_ok = owner_ok(c, caller, claimed_by, "block", a.id)
        c.close()
        if fence_ok and pre_owner_ok:
            # wq#1998: fatal=False. The gate is advisory HERE and nowhere else — a refused
            # block returns before _finish(a, 'blocked') below and strands the row 'claimed'
            # under a caller that has already given up. A retreat must always land.
            new_detail = _liveness_creation_check(title, detail, lane, True, verb="block",
                                                  liveness=getattr(a, "liveness", None),
                                                  no_probe=getattr(a, "no_probe", None),
                                                  accept_probe=getattr(a, "accept_probe", False),
                                                  fatal=False)
            if new_detail != (detail or ""):
                c2 = conn(); c2.isolation_level = None; c2.execute("BEGIN IMMEDIATE")
                c2.execute("UPDATE tasks SET detail=? WHERE id=?", (new_detail, a.id))
                c2.execute("COMMIT"); c2.close()
    else:
        c.close()
    print(f"blocked {a.id}: {a.reason} (subsystem locks released){_reopen_tag(_finish(a, 'blocked'))}")
def cmd_hold(a):
