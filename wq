def utcnow(): return datetime.datetime.now(datetime.timezone.utc)
def now(): return utcnow().strftime(FMT)
def lease_from(minutes): return (utcnow() + datetime.timedelta(minutes=minutes)).strftime(FMT)
def norm_title(t): return re.sub(r"[^a-z0-9]+", " ", (t or "").lower()).strip()
def parse_subs(s):
    return [x.strip().lower() for x in (s or "").replace(",", " ").split() if x.strip()]
# wq#1675: subsystem MODE. A declared subsystem is '<base>', '<base>:rw' or '<base>:ro'.
# Bare and ':rw' are the EXCLUSIVE lock wq has always taken (one holder, everyone else
# blocked) — every subsystems value in the live DB is bare, so nothing about those tickets
# changes. ':ro' is a SHARED lock: any number of readers hold one base at once, and a writer
# is refused for as long as any live reader holds it. wq#1668 (read-only closure audit) sat
# unclaimable behind wq#1667 (read-only walkthrough) because both declared `foreman` and the
# lock could not tell two readers apart from two writers.
SUB_MODES = ("rw", "ro")
def split_sub(tok):
    """'<base>:ro' -> ('<base>', 'ro'). Bare, or any other suffix, -> (tok, 'rw'). An
    unrecognised suffix is deliberately NOT an error: the orchestrator's own scopes are
    'orch:<lane>', and reading 'orch:build' as base 'orch' would merge every lane's
    orchestrator lock into one."""
    base, _, mode = (tok or "").rpartition(":")
    if base and mode in SUB_MODES:
        return base, mode
    return tok, "rw"
def sub_base(tok): return split_sub(tok)[0]
def is_ro(tok):    return split_sub(tok)[1] == "ro"
def has_explicit_mode(tok): return split_sub(tok)[0] != tok
# wq#1675: archetypes whose entire output is analysis — they read a subsystem and write a
# report, never the subsystem itself. `wq add` records their subsystems as ':ro' so two of
# them never serialize behind each other. Explicit ':rw' opts out and is never rewritten.
RO_DEFAULT_ARCHETYPES = {"research-synthesis", "verify-pass"}
# wq#617: (model, effort) vocabulary. Full CLI ids only (a bare alias like "sonnet" is what
# the router resolves; the ticket stores what `claude --model` will be handed). Effort names
# only — the CLI takes low|medium|high|xhigh|max, never integers (FOREMAN_RESEARCH §3).
EFFORTS = ("low", "medium", "high", "xhigh", "max")
MODEL_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
def norm_tuple(model, effort, force=False):
    model = (model or "").strip() or None
    effort = (effort or "").strip().lower() or None
    if model and not MODEL_RE.match(model):
        print(f"REFUSED: bad model id {model!r}"); sys.exit(2)
    if model:
        known = known_models()
        if known is not None:
            aliases, ids = known
            canonical = aliases.get(model, model)
            if canonical not in ids and not force:
                print(f"REFUSED: model {model!r} has no entry in research/models.yaml "
                      f"(wq#1442) — fworker would hand this straight to `claude --model` "
                      f"and it 404s (model_not_found) unless it happens to already be a "
                      f"full CLI id. Known aliases: {', '.join(sorted(aliases))}")
                sys.exit(2)
            model = canonical
    if effort and effort not in EFFORTS:
        print(f"REFUSED: effort must be one of {'|'.join(EFFORTS)} (names, never integers), got {effort!r}"); sys.exit(2)
    if effort and not model:
        print("REFUSED: --effort without --model"); sys.exit(2)
    return model, effort
def conn():
    c = sqlite3.connect(DB, timeout=30)
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA busy_timeout=30000")
    return c
def init():
    c = conn()
    c.execute("""CREATE TABLE IF NOT EXISTS tasks(
        id INTEGER PRIMARY KEY AUTOINCREMENT, lane TEXT DEFAULT 'auto',
        pri INTEGER DEFAULT 2, title TEXT, detail TEXT, deps TEXT DEFAULT '',
        status TEXT DEFAULT 'open', claimed_by TEXT, claimed_at TEXT,
