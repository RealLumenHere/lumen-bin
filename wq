    c.execute("""CREATE TABLE IF NOT EXISTS retired_sessions(
        session_id TEXT PRIMARY KEY, base_name TEXT, retired_at TEXT,
        kind TEXT, reason TEXT)""")
    c.execute("CREATE INDEX IF NOT EXISTS idx_retired_base ON retired_sessions(base_name)")
    c.commit(); c.close()

# ---------------------------------------------------------------- wq#1158 lease/fence layer
# PROBLEM. `owner_ok` compares NAMES, and a respawned worker has the same name it always had.
# So the one thing the ownership rule cannot see is the case it most needs to: a session whose
# lease expired, whose ticket was reclaimed and re-claimed (often by its own replacement under
# the same base name), and which then wakes up and runs `wq done`. Every guard passes. The
# replacement's evidence is overwritten by a worker that has been asleep for hours.
#
# A fence token separates them without needing to tell the two processes apart at all. Every
# claim bumps `fence`; a holder is handed the value its claim minted; a write-back that carries
# a fence must match the one on the row. The zombie is holding fence 3 against a row that has
# moved on to 4, so its write is refused — not because wq worked out that it was a zombie, but
# because being one is exactly what a stale fence means.
#
# NOT AUTO-APPLIED, unlike every other column on tasks. init() adds those on the next
# invocation, which is fine when a column is inert storage. These four are not inert: the
# moment they exist, the claim protocol changes for every in-flight claim on a queue shared by
# live sessions. That is an operator's decision with a backup behind it, so the columns are
# owned by migrations/wq1158_lease_fence.py and wq FEATURE-DETECTS them. Pre-migration, wq
# behaves exactly as it did before — except that `--fence` is REFUSED rather than ignored,
# because a caller that passes a fence is relying on it.
LEASE_COLS = ("lease_owner", "lease_expires_at", "fence", "attempt")
_FENCED = None
def lease_fenced(c):
    """True when this DB has had the wq#1158 migration applied. Cached per invocation."""
    global _FENCED
    if _FENCED is None:
        _FENCED = set(LEASE_COLS) <= {r[1] for r in c.execute("PRAGMA table_info(tasks)")}
    return _FENCED
# wq#1331: per-ticket capability tags (claude-foreman WORKER_EXEC_CAPABILITY_GAP.md
# §2.3 closed set). The column is owned by migrations/wq1331_needs.py — same contract
# as wq#1158: wq FEATURE-DETECTS it, and `--needs` is REFUSED (never silently dropped)
# pre-migration, because a caller passing tags is relying on foreman's resolver
# honouring them. The reader lives in claude-foreman harness/needs.py; this validator
# only guards what gets stored.
NEEDS_TAGS = ("ssh", "root", "restart", "copy", "repo", "dir", "bench", "power")
_NEEDS_TAG_RE = re.compile(r"(?:needs:)?([a-z_-]+)\(([^)]*)\)")
_NEEDS_READY = None
def needs_ready(c):
    """True when this DB has had the wq#1331 migration applied. Cached per invocation."""
    global _NEEDS_READY
    if _NEEDS_READY is None:
        _NEEDS_READY = "needs" in {r[1] for r in c.execute("PRAGMA table_info(tasks)")}
    return _NEEDS_READY
def validate_needs(text):
    """(ok, error) for a needs value about to be stored. '' clears."""
    text = (text or "").strip()
    if not text:
        return True, None
    parsed = _NEEDS_TAG_RE.findall(text)
    leftover = _NEEDS_TAG_RE.sub("", text).replace(",", "").strip()
    if leftover:
        return False, f"unparseable needs fragment: {leftover!r} (want tag(arg), comma-separated)"
    for name, arg in parsed:
        if name not in NEEDS_TAGS:
            return False, f"unknown needs tag {name!r} (vocabulary: {', '.join(NEEDS_TAGS)})"
        if not arg.strip():
            return False, f"needs tag {name}() has an empty argument"
        if name in ("repo", "dir") and not arg.strip().startswith("/"):
            return False, f"needs:{name}({arg}) must be an absolute path"
    return True, None
def check_needs_or_die(c, val):
    """Shared by add/edit: refuse --needs pre-migration or with an invalid value."""
    if not needs_ready(c):
        print("REFUSED: --needs requires the wq#1331 migration (tasks.needs column):\n"
              "  python3 migrations/wq1331_needs.py --db <queue.db> --yes")
        c.close(); sys.exit(1)
    ok, err = validate_needs(val)
    if not ok:
        print(f"REFUSED: {err}")
        c.close(); sys.exit(1)
def epoch_of(ts):
    """FMT text -> unix epoch int. Returns None for NULL/unparseable, which every caller
    treats as 'no lease', matching how the TEXT column has always been read."""
    try:
        return int(datetime.datetime.strptime(ts, FMT)
                   .replace(tzinfo=datetime.timezone.utc).timestamp())
    except (TypeError, ValueError):
        return None
def lease_set_sql(c, owner, expires):
    """SET fragment + params that keep the epoch mirror in step with lease_expires.

    `lease_expires` (TEXT) stays the single source of truth: every pre-existing reader —
    queue-status, mctl, reap, promote_leases, the watchdogs — reads it, and wq#1158 does not
    get to make nine call sites disagree about when a lease ends. `lease_expires_at` is its
    epoch mirror, written HERE and only here so the two cannot drift apart in one site's
    hand-rolled UPDATE."""
    if not lease_fenced(c): return "", []
    return ", lease_owner=?, lease_expires_at=?", [owner, epoch_of(expires)]
def lease_clear_sql(c):
    return ", lease_owner=NULL, lease_expires_at=NULL" if lease_fenced(c) else ""
def fence_of(c, tid):
    r = c.execute("SELECT fence FROM tasks WHERE id=?", (tid,)).fetchone() if lease_fenced(c) else None
    return int(r[0] or 0) if r else None
def fence_guard(c, a, tid, action):
    """Resolve --fence into (sql fragment, params) for the write-back, refusing loudly on a
    stale one. The predicate goes ON the UPDATE as well as being checked here: the check gives
    the human-readable refusal, the predicate is what makes the refusal atomic."""
    want = getattr(a, "fence", None)
    if want is None: return "", []
    if not lease_fenced(c):
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: --fence {want} was given but this queue has NOT had the wq#1158 "
              f"migration applied, so there is no fence to check. Refusing rather than "
              f"ignoring it — a caller that passes a fence is relying on it.\n"
              f"  Apply it: python3 migrations/wq1158_lease_fence.py --db <queue.db> --yes")
        sys.exit(5)
    cur = fence_of(c, tid)
    if cur is None:
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: no such task {tid}"); sys.exit(1)
    if cur != int(want):
        holder, exp = c.execute("SELECT lease_owner, lease_expires FROM tasks WHERE id=?",
                                (tid,)).fetchone()
        c.execute("COMMIT"); c.close()
        # A fence ABOVE the live one was never minted by any claim — that is a made-up token,
        # not a stale one, and saying "your claim ended" would send the reader looking for a
        # lease expiry that never happened.
        why = (f"  Fence {want} has never been minted for this ticket (claims have only reached "
               f"{cur}), so this token did not come from a `wq claim`. Nothing was written."
               if int(want) > cur else
               f"  Your claim ended and the ticket was claimed again since. Your `{action}` would "
               f"overwrite work done under the newer claim, so it is refused.\n"
               f"  If you are a resumed session: stop here. Do not re-claim and do not re-run the\n"
               f"  work — read `wq show {tid}` first; the current holder may already have finished it.")
        print(f"REFUSED: stale fence (wq#1158) — you hold fence {want} for wq#{tid}, the live "
              f"claim is at fence {cur} (holder {holder or 'none'}, lease {exp or 'none'}).\n{why}")
        sys.exit(5)
    return " AND fence=?", [int(want)]

# ---------------------------------------------------------------- wq#502 identity layer
def warn(msg): sys.stderr.write(f"WARNING: {msg}\n")
def eprint(*a, **k):
    """wq#1479: a refusal is an error, and errors go to stderr. `wq done` used to print
    REFUSED on stdout, so an orchestrator reading `tail -1` of a refused close saw the
    last line of the explanation and reported two still-blocked tickets as done."""
    k["file"] = sys.stderr
    print(*a, **k)

def is_session(c, ident):
    """Authoritative: a string is a session id ONLY if the registry says so. Never guess from
    shape — base names legitimately contain hyphens (claude-web-0812b)."""
    if not ident: return None
    return c.execute("SELECT session_id,base_name FROM agent_sessions WHERE session_id=?",
                     (ident,)).fetchone()

def base_of(c, ident):
    r = is_session(c, ident)
    if r: return r[1]
    m = SESSION_RE.match(ident or "")
    return m.group("base") if m else (ident or "")

def touch_session(c, ident):
    c.execute("UPDATE agent_sessions SET last_seen=? WHERE session_id=?", (now(), ident))

# ---------------------------------------------------------------- wq#530 liveness layer
def log_activity(c, ident, cmd):
    """Append-only. Never allowed to break the command that emitted it."""
    try:
        c.execute("INSERT INTO agent_activity(session_id,base_name,cmd,ts) VALUES(?,?,?,?)",
                  (ident, base_of(c, ident), cmd, now()))
        c.execute("DELETE FROM agent_activity WHERE id <= "
                  "(SELECT MAX(id) FROM agent_activity) - ?", (ACTIVITY_KEEP,))
    except sqlite3.Error:
        pass

def idle_minutes(last_seen):
    try:
        t = datetime.datetime.strptime(last_seen, FMT).replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return None
    return (utcnow() - t).total_seconds() / 60.0

def session_holdings(c, sid, t_now):
    held = [r[0] for r in c.execute(
        """SELECT id FROM tasks WHERE claimed_by=? AND status='claimed'
           AND lease_expires IS NOT NULL AND lease_expires >= ?""", (sid, t_now))]
    locks = [r[0] for r in c.execute(
        "SELECT scope FROM slocks WHERE holder=? AND expires_at >= ?", (sid, t_now))]
    # wq#1675: a reader holds just as much as a writer. Omitting it here would let the
    # never-purge-a-holder rule and every refusal that names a blocking holder miss a live
    # read-only session.
    locks += [r[0] + ":ro" for r in c.execute(
        "SELECT scope FROM slocks_ro WHERE holder=? AND expires_at >= ?", (sid, t_now))]
    return held, locks

def promote_leases(c, ident):
    """ANY wq call by the holder is evidence of life: restore every provisional lease it holds
    to the ttl that claim asked for, and extend the slocks with it so the two never diverge.
    Only ever LENGTHENS, and never touches a lease that has already expired — that one may
    already belong to someone else."""
    if not ident: return 0
    t_now = now(); n = 0
    for tid, subsystems, exp, ttl in c.execute(
            """SELECT id, subsystems, lease_expires, lease_ttl FROM tasks
               WHERE claimed_by=? AND status='claimed'
                 AND lease_expires IS NOT NULL AND lease_expires >= ?""", (ident, t_now)).fetchall():
        full = int(ttl) if ttl else DEFAULT_TTL_MIN
        target = lease_from(full)
        if target <= exp: continue
        frag, fparams = lease_set_sql(c, ident, target)
        c.execute(f"UPDATE tasks SET lease_expires=?{frag} WHERE id=?", [target] + fparams + [tid])
        subs = parse_subs(subsystems)
        if subs: acquire_subs(c, subs, ident, full, f"wq#{tid}")
        n += 1
    return n

def mark_alive(c, ident, cmd):
    """One call per subcommand. Registered sessions get last_seen + an activity row; ANY holder
    (registered or bare) gets its provisional leases promoted."""
    if not ident: return
    if is_session(c, ident):
        touch_session(c, ident)
        log_activity(c, ident, cmd)
    promote_leases(c, ident)

def ping(cmd):
    """Best-effort liveness ping for read-only subcommands. A liveness signal must never be able
    to fail the command that carries it."""
    ident = os.environ.get("WQ_AGENT", "").strip()
    if not ident: return
    try:
        c = conn(); c.isolation_level = None
        c.execute("BEGIN IMMEDIATE")
        mark_alive(c, ident, cmd)
        c.execute("COMMIT"); c.close()
    except sqlite3.Error:
        pass

# ---------------------------------------------------------------- wq#568 retirement layer
def retired_row(c, ident):
    if not ident: return None
    return c.execute("SELECT session_id, base_name, retired_at, kind, reason "
                     "FROM retired_sessions WHERE session_id=?", (ident,)).fetchone()

def _ntfy(title, msg):
    """Best-effort, bounded. A notification must never be able to fail the command."""
    try:
        import subprocess
        subprocess.run([NTFY_BIN, "-t", "lumen-fleet", "-T", title, msg],
                       capture_output=True, timeout=15)
    except Exception:
        pass

def release_session_holdings(c, sid):
    """Revert every claimed/blocked ticket to open and drop every slock for this holder. The
    atomic half of retirement — a respawn cannot land or hold anything, and the orchestrator
    stops hand-editing status to clean claimed_by residue. wq#1374: 'blocked' keeps claimed_by
    set (see cmd_block), so a session that retires while holding a blocked ticket used to leave
    it stranded under a dead claimed_by — reverting it here collapses the old
    retire->edit->claim->done dead-worker dance into a single retire call."""
    t_now = now()
    tickets = [r[0] for r in c.execute(
        "SELECT id FROM tasks WHERE claimed_by=? AND status IN ('claimed','blocked')", (sid,))]
    if tickets:
        c.execute(f"""UPDATE tasks SET status='open', claimed_by=NULL, claimed_at=NULL,
                     lease_expires=NULL, lease_ttl=NULL, block_reason=NULL,
                     blocked_at=NULL{lease_clear_sql(c)}
                     WHERE claimed_by=? AND status IN ('claimed','blocked')""", (sid,))
    locks = [r[0] for r in c.execute("SELECT scope FROM slocks WHERE holder=?", (sid,))]
    if locks:
        c.execute("DELETE FROM slocks WHERE holder=?", (sid,))
    # wq#1675: retirement drops read holds too, or a retired session leaves every base it
    # was reading blocked against writers until the TTL runs out.
    ro = [r[0] + ":ro" for r in c.execute("SELECT scope FROM slocks_ro WHERE holder=?", (sid,))]
    if ro:
        c.execute("DELETE FROM slocks_ro WHERE holder=?", (sid,))
    return tickets, locks + ro

def holder_unit_running(name):
    """wq#1498: is a live `lumen-job-<name>-<ts>.service` unit running right now, per
    `lumen-run list`? Fails CLOSED (assume running) on any lumen-run trouble — a liveness
    check that can't reach lumen-run must never be read as 'confirmed dead'."""
    try:
        import subprocess
        p = subprocess.run([LUMEN_RUN_BIN, "list"], capture_output=True, text=True, timeout=15)
    except Exception:
        return True
    if p.returncode != 0:
        return True
    for line in p.stdout.splitlines():
        if "running" not in line:
            continue
        m = LUMEN_RUN_UNIT_RE.search(line)
        if m and m.group("name") == name:
            return True
    return False

def holder_is_dead(c, holder):
    """wq#1498: the liveness check `wq release --dead-worker` uses instead of `wq retire` on a
    per-ticket fworker identity. Dead means BOTH: no live agent_sessions row (fworker never
    registers, so this alone can't distinguish idle-between-attempts from actually-dead), AND —
    when the holder has the fworker-wq<id> shape — no running lumen-job-<holder>-<ts> unit per
    `lumen-run list`. A holder that isn't the per-ticket shape has no unit-name signal to check,
    so the session-row check is all that applies to it."""
    if is_session(c, holder):
        return False
    if FWORKER_IDENTITY_RE.match(holder or "") and holder_unit_running(holder):
        return False
    return True

def mark_retired(c, sid, base, kind, reason):
    c.execute("""INSERT INTO retired_sessions(session_id, base_name, retired_at, kind, reason)
                 VALUES(?,?,?,?,?)
                 ON CONFLICT(session_id) DO UPDATE SET retired_at=excluded.retired_at,
                   kind=excluded.kind, reason=excluded.reason""",
              (sid, base, now(), kind, reason))
    c.execute("DELETE FROM agent_sessions WHERE session_id=?", (sid,))

def stop_banner(sid, retired_at, kind, reason):
    b = ("\n================== STOP — SESSION RETIRED ==================\n"
         f"Session '{sid}' was retired at {retired_at}Z ({kind}):\n"
         f"  {reason}\n"
         "THIS SESSION MUST STOP NOW.\n"
         "Do not claim, do not lock, do not resume work, do not re-register.\n"
         "If you are an auto-continued agent: END YOUR RUN IMMEDIATELY.\n"
         "(A human reusing this shell: unset WQ_AGENT, or register a fresh\n"
         " name in a clean environment. This identity stays dead.)\n"
         "============================================================")
    print(b); sys.stderr.write(b + "\n")

def enforce_retirement(a):
    """wq#568 entry gate — runs before EVERY subcommand, read-only ones included, because a
    respawn's first act is a wq call and this is where a stop can bite. Ordering inside:
      1. already-retired          -> log the refusal (the metric), banner, exit 3.
      2. 'deregistered' marker    -> the auto-continue signature: upgrade to retired, release
                                     anything --force left behind, ntfy, banner, exit 3.
      3. live registered session  -> budget backstops (age / closed tickets); trip = retire,
                                     release, ntfy, banner, exit 3.
      4. unregistered legacy name -> untouched (wq#530 backcompat, pinned by Frank), UNLESS
                                     that exact name was explicitly retired (case 1 catches it).
    The happy path costs one indexed SELECT."""
    ident = getattr(a, "agent", None) or getattr(a, "by", None) \
            or os.environ.get("WQ_AGENT", "").strip()
    if not ident: return
    ident = ident.strip()
    try:
        c = conn()
        r = retired_row(c, ident)
        if r:
            sid, base, rat, kind, reason = r
            if kind == "deregistered":
                c.isolation_level = None
                c.execute("BEGIN IMMEDIATE")
                tk, lk = release_session_holdings(c, ident)
                reason = ("auto-continue signature: wq call after clean deregistration "
                          f"(deregistered {rat}Z, first refused cmd={getattr(a,'cmd','?')})")
                mark_retired(c, ident, base, "auto-respawn", reason)
                log_activity(c, ident, "auto-retire:respawn")
                c.execute("COMMIT"); c.close()
                _ntfy("wq auto-retire (respawn)",
                      f"{ident}: wq '{getattr(a,'cmd','?')}' after clean deregistration — "
                      f"auto-continued agent stopped at the chokepoint."
                      + (f" released tickets={tk}" if tk else "")
                      + (f" dropped slocks={lk}" if lk else ""))
                stop_banner(ident, now(), "auto-respawn", reason)
            else:
                c.isolation_level = None
                c.execute("BEGIN IMMEDIATE")
                log_activity(c, ident, f"RETIRED-REFUSED:{getattr(a,'cmd','?')}")
                c.execute("COMMIT"); c.close()
                stop_banner(ident, rat, kind, reason or "(no reason recorded)")
            sys.exit(3)
        row = is_session(c, ident)
        if row:
            fs = c.execute("SELECT first_seen FROM agent_sessions WHERE session_id=?",
                           (ident,)).fetchone()[0]
            age = idle_minutes(fs)  # minutes since first_seen; None if unparseable
            done_n = c.execute("SELECT COUNT(*) FROM tasks WHERE claimed_by=? AND status='done'",
                               (ident,)).fetchone()[0]
            # wq#1374: orchestrator-class identity gets the exempt/higher budget instead of
            # the global BUILD-worker one.
            if ORCH_SESSION_RE.match(row[1] or ""):
                max_age_min, max_tickets = ORCH_SESSION_MAX_AGE_MIN, ORCH_SESSION_MAX_TICKETS
                age_env, tickets_env = "WQ_ORCH_SESSION_MAX_AGE", "WQ_ORCH_SESSION_MAX_TICKETS"
            else:
                max_age_min, max_tickets = SESSION_MAX_AGE_MIN, SESSION_MAX_TICKETS
                age_env, tickets_env = "WQ_SESSION_MAX_AGE", "WQ_SESSION_MAX_TICKETS"
            trip = None
            if age is not None and age > max_age_min:
                trip = ("auto-age", f"session age {age:.0f}m exceeds {age_env}="
                                    f"{max_age_min}m (budget backstop; raise the env "
                                    f"for a legitimate marathon session)")
            elif done_n >= max_tickets:
                trip = ("auto-tickets", f"{done_n} closed claims reaches {tickets_env}="
                                        f"{max_tickets} (budget backstop)")
            if trip:
                kind, reason = trip
                c.isolation_level = None
                c.execute("BEGIN IMMEDIATE")
                tk, lk = release_session_holdings(c, ident)
                mark_retired(c, ident, row[1], kind, reason)
                log_activity(c, ident, f"auto-retire:{kind}")
                c.execute("COMMIT"); c.close()
                _ntfy(f"wq auto-retire ({kind})",
                      f"{ident}: {reason}."
                      + (f" released tickets={tk}" if tk else "")
                      + (f" dropped slocks={lk}" if lk else ""))
                stop_banner(ident, now(), kind, reason)
                sys.exit(3)
        c.close()
    except sqlite3.Error:
        # The gate must never brick wq on a broken/locked DB — the underlying command's own
        # error handling owns that. Failing OPEN here only skips the gate for one call.
        pass

def partition_for_base(c, base, exclude_sid):
    """Split every registry row for this base into BLOCKING and STALE.

    A row is STALE only when all three hold: idle past WQ_STALE_MIN, holding no live lease or
    slock, and no task claimed under the literal bare base name. The last clause is not
    paranoia — owner_ok() lets a registered session adopt a claim held under its own bare base
    name, so two sessions sharing a base while such a claim exists is the one wq#502 inversion
    that session-unique ids did NOT close."""
    t_now = now()
    bare = [r[0] for r in c.execute(
        """SELECT id FROM tasks WHERE claimed_by=? AND status='claimed'
           AND lease_expires IS NOT NULL AND lease_expires >= ?""", (base, t_now))]
    blocking, stale = [], []
    for sid, fs, ls in c.execute(
            "SELECT session_id, first_seen, last_seen FROM agent_sessions "
            "WHERE base_name=? AND session_id<>?", (base, exclude_sid or "")).fetchall():
        held, locks = session_holdings(c, sid, t_now)
        idle = idle_minutes(ls)
        row = (sid, held, locks, fs, ls, idle)
        if held or locks or idle is None or idle < STALE_MIN or bare:
            blocking.append(row)
        else:
            stale.append(row)
    return blocking, stale, bare

def fmt_idle(idle):
    return "idle=?" if idle is None else f"idle={idle:.0f}m"

def purge_stale_sessions(c, ttl_min=DEFAULT_TTL_MIN):
    """(3) sessions idle > lease TTL auto-expire — but NEVER purge one still holding a live
    lease or slock, or we would lose the ability to name the blocking holder."""
    cutoff = (utcnow() - datetime.timedelta(minutes=ttl_min)).strftime(FMT)
    t_now = now()
    c.execute("""DELETE FROM agent_sessions WHERE last_seen < ?
                 AND session_id NOT IN (SELECT COALESCE(claimed_by,'') FROM tasks
                       WHERE status='claimed' AND lease_expires IS NOT NULL AND lease_expires >= ?)
                 AND session_id NOT IN (SELECT COALESCE(holder,'') FROM slocks WHERE expires_at >= ?)
                 AND session_id NOT IN (SELECT COALESCE(holder,'') FROM slocks_ro WHERE expires_at >= ?)""",
              (cutoff, t_now, t_now, t_now))  # wq#1675: a live reader is a holder
    return c.execute("SELECT changes()").fetchone()[0]

def live_sessions_for_base(c, base, exclude_sid):
    """Registered sessions sharing this base name that currently hold an ACTIVE lease or slock.
    Used by cmd_claim — steady-state check, deliberately unchanged by wq#537 so existing
    in-flight claims are never retroactively invalidated."""
    t_now = now()
    out = []
    for sid, in c.execute("SELECT session_id FROM agent_sessions WHERE base_name=? AND session_id<>?",
                          (base, exclude_sid or "")):
        held = c.execute("""SELECT id FROM tasks WHERE claimed_by=? AND status='claimed'
                            AND lease_expires IS NOT NULL AND lease_expires >= ?""", (sid, t_now)).fetchall()
        locks = c.execute("SELECT scope FROM slocks WHERE holder=? AND expires_at >= ?", (sid, t_now)).fetchall()
        locks += c.execute("SELECT scope || ':ro' FROM slocks_ro WHERE holder=? AND expires_at >= ?",
                           (sid, t_now)).fetchall()  # wq#1675
        if held or locks:
            out.append((sid, [r[0] for r in held], [r[0] for r in locks]))
    return out

def resolve_identity(a, c=None):
    """--agent/positional > WQ_AGENT > hostname:pid (legacy, unregistered)."""
    ident = getattr(a, "agent", None) or getattr(a, "by", None) or os.environ.get("WQ_AGENT", "").strip()
    if ident and ident.strip().isdigit():
        print(f"REFUSED: agent name '{ident}' is numeric — that looks like a TICKET id.\n"
              "  `wq claim` does NOT take a ticket id; it hands you the next eligible ticket.\n"
              "  Correct form: wq claim --lane <lane> <your-agent-name>   (or export WQ_AGENT=...)\n"
              "  To claim THAT ticket: wq claim --id <ticket-id>   (every guard applies, wq#582)\n"
              "  Register a session first: wq whoami --register <your-agent-name>")
        sys.exit(1)
    if ident: return ident.strip(), True
    return f"{socket.gethostname()}:{os.getpid()}", False

# wq#1116 GRANDFATHER — DELETE THIS AND ITS USE ONCE NO PRE-CUTOFF CLAIM IS STILL OPEN.
# At the time this shipped, fworker claimed a ticket under its OWN `lumen:<pid>` while handing
# the worker that would close it a different WQ_AGENT (fworker-wq<id>-a<n>), so caller and holder
# legitimately disagreed on every dispatch. harness/fworker.py now claims under the worker's own
# identity, but six claims were already in flight under the old scheme and refusing them would
# have failed closes for work that was already finished. Claims made before the cutoff keep the
# old warn-and-allow; claims made after it are guarded. Env-overridable so the test suite can
# pin it rather than depend on the wall clock.
OWNER_STRICT_FROM = os.environ.get("WQ_OWNER_STRICT_FROM", "2026-08-31 00:00:00")
def claim_guarded(c, tid):
    """Is this claim one the wq#1116 ownership rule protects? Two ways it is not:

    NO LIVE LEASE  wq#530 already rules that a claim with no unexpired lease is free —
      housekeeping reverts it to open and the next claimer takes it — and `blocked` drops the
      lease outright. Guarding those would protect nobody while refusing dispatcher self-heal
      its entire job, which is releasing INFRA_CRASH-blocked tickets it never claimed.
    PRE-CUTOFF     the grandfather above.

    A ticket that has already reached a terminal state is not protected here either; the wholly
    separate `--reclose` guard covers that, and covers it for registered callers too.
    """
    r = c.execute("SELECT lease_expires, claimed_at FROM tasks WHERE id=?", (tid,)).fetchone()
    if not r or not r[0] or r[0] < now():
        return False
    return (r[1] or "") >= OWNER_STRICT_FROM

def owner_ok(c, caller, claimed_by, action, tid):
    """(4) an agent may never heartbeat/close/release another session's claim.

    Asymmetric by design, so (4) enforcement and (5) backcompat can both hold:
      1. caller IS the holder                      -> OK
      2. caller registered, holder = caller's OWN
         bare base name                            -> OK (adopting a pre-registration claim;
                                                     safe because registration already refuses
                                                     when another live session owns that base)
      3. caller registered, holder is someone else -> REFUSE. A registered session always knows
                                                     its identity and has no excuse.
      4. caller UNREGISTERED (bare/fallback)       -> wq#1116: REFUSE while the claim is one
                                                     claim_guarded() protects (live lease, made
                                                     after the grandfather cutoff); otherwise
                                                     warn + allow. WQ_STRICT=1 refuses either
                                                     way. Read-only subcommands never reach here.
    """
    if not claimed_by or caller == claimed_by: return True
    caller_is_session = is_session(c, caller)
    if caller_is_session and base_of(c, caller) == claimed_by and not is_session(c, claimed_by):
        warn(f"wq#{tid} was claimed as bare name '{claimed_by}' before you registered; "
             f"adopting it as {caller}.")
        return True
    if not caller_is_session and not STRICT and not claim_guarded(c, tid):
        warn(f"wq#{tid} is recorded against '{claimed_by}' but is not a guarded live claim "
             f"(expired lease, blocked, or pre-cutoff), so '{caller}' may {action} it. wq#1116.")
        return True
    why = ("A registered session always knows its identity and has no excuse."
           if caller_is_session else
           "wq#1116: an unregistered caller may no longer write to another identity's LIVE claim.")
    # wq#1498: fworker-wq<id> is the STABLE per-ticket identity, never a dead session — retiring
    # it (the old advice below) poisons every future spawn of that ticket. Point at the release
    # path instead: it verifies liveness and clears the claim without planting that marker.
    if FWORKER_IDENTITY_RE.match(claimed_by or ""):
        stale_hint = (f"  `wq release {tid} --dead-worker` releases it on the record once "
                      f"liveness is verified (no live session, no running unit) — do NOT\n"
                      f"  `wq retire {claimed_by}`: that is a per-ticket identity, not a dead "
                      f"session, and retiring it refuses every future spawn of wq#{tid} too "
                      f"(wq#1498).")
    else:
        stale_hint = (f"  `wq retire {claimed_by}` to revert its claims and drop its slocks on "
                      f"the record.")
    eprint(f"REFUSED: wq#{tid} is held by '{claimed_by}', you are '{caller}'.\n"
          f"  An agent may never {action} another session's claim. {why}\n"
          f"  If that session is dead, let its lease expire (auto-reverts to open), or\n"
          f"{stale_hint}\n"
          f"  If you ARE that worker: register first — wq whoami --register <your-agent-name>\n"
          f"  — so your identity survives across wq invocations instead of changing every call.")
    return False
def deps_met(c, deps):
    if not deps or not deps.strip(): return True
    for d in [x.strip() for x in deps.split(',') if x.strip()]:
        r = c.execute("SELECT status FROM tasks WHERE id=?", (d,)).fetchone()
        if not r or r[0] != 'done': return False
    return True
def gate_met(gate):
    """Enforced precondition. Format: comma-list of 'path' (must exist) or 'path:exists'/'path:missing'.
    Empty gate = always met. Returns (ok, reason)."""
    if not gate or not gate.strip(): return True, ""
    for clause in [x.strip() for x in gate.split(',') if x.strip()]:
        if ':' in clause:
            path, cond = clause.rsplit(':', 1)
        else:
            path, cond = clause, 'exists'
        path = path.strip(); cond = cond.strip().lower()
        present = os.path.exists(path)
        if cond == 'exists' and not present: return False, f"gate: {path} missing"
        if cond == 'missing' and present:    return False, f"gate: {path} present (must be absent)"
    return True, ""
def ro_holders(c, base, t_now, exclude=None):
    """wq#1675: live readers on a base scope, minus `exclude` (normally the caller, whose own
    read hold must never block its own writer claim on the same base)."""
    return [h for (h,) in c.execute(
        "SELECT holder FROM slocks_ro WHERE scope=? AND expires_at >= ?", (base, t_now))
        if h != exclude]
def subs_free(c, subs, holder, t_now):
    """Which declared subsystems are held by a DIFFERENT holder (blocking). Expired = free.
    wq#1675: a ':ro' token is blocked by a live WRITER only; a writer token is blocked by a
    live writer OR by any live reader. The returned scope is the DECLARED token, not the
    base, so the refusal names the mode the ticket actually asked for."""
    blocked = []
    for s in subs:
        base = sub_base(s)
        r = c.execute("SELECT holder,expires_at FROM slocks WHERE scope=?", (base,)).fetchone()
        if r and r[1] >= t_now and r[0] != holder:
            blocked.append((s, r[0]))
            continue
        if not is_ro(s):
            readers = ro_holders(c, base, t_now, exclude=holder)
            if readers:
                more = f" +{len(readers) - 1} more" if len(readers) > 1 else ""
                blocked.append((s, f"{readers[0]}{more} (read-only)"))
    return blocked
def acquire_subs(c, subs, holder, ttl_min, note):
    exp = lease_from(ttl_min)
    for s in subs:
        base, mode = split_sub(s)
        if mode == "ro":
            # wq#1675: keyed (scope,holder), so a second reader ADDS a row instead of
            # stealing the first one's. Re-acquiring is how heartbeat extends a read hold.
            c.execute("""INSERT INTO slocks_ro(scope,holder,acquired_at,expires_at,note)
                         VALUES(?,?,?,?,?)
                         ON CONFLICT(scope,holder) DO UPDATE SET
                           expires_at=excluded.expires_at, note=excluded.note""",
                      (base, holder, now(), exp, note))
            continue
        c.execute("""INSERT INTO slocks(scope,holder,acquired_at,expires_at,note)
                     VALUES(?,?,?,?,?)
                     ON CONFLICT(scope) DO UPDATE SET holder=excluded.holder,
                       expires_at=excluded.expires_at, note=excluded.note""",
                  (base, holder, now(), exp, note))
def release_subs(c, subs, holder):
    """wq#1675: drops BOTH modes for every declared base. A ticket whose subsystems were
    edited from ':ro' to ':rw' mid-claim would otherwise leave the hold it originally took
    behind to expire on its own, blocking the base for a full TTL."""
    for s in subs:
        base = sub_base(s)
        c.execute("DELETE FROM slocks WHERE scope=? AND holder=?", (base, holder))
        c.execute("DELETE FROM slocks_ro WHERE scope=? AND holder=?", (base, holder))
def cmd_whoami(a):
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    purged = purge_stale_sessions(c)

    # wq#530 (3): the only zero-false-positive liveness signal is the agent saying so itself.
    if getattr(a, "release", False):
        ident, _ = resolve_identity(a, c)
        if not is_session(c, ident):
            c.execute("COMMIT"); c.close()
            print(f"not registered: {ident} — nothing to release (already deregistered, or a bare name)")
            return
        my_base = base_of(c, ident)
        held, locks = session_holdings(c, ident, now())
        if (held or locks) and not a.force:
            c.execute("COMMIT"); c.close()
            print(f"REFUSED: session {ident} still holds work:")
            print(f"  tickets : {held or 'none'}")
            print(f"  slocks  : {locks or 'none'}")
            print("  Deregistering now would leave that work owned by a name the registry no longer\n"
                  "  knows, which is the state manual releases have been cleaning up all day.\n"
                  "  -> hand it back first:  wq done <id> --notes ...   or   wq release <id>\n"
                  "  -> only if it is genuinely abandoned and you know that: --force")
            sys.exit(1)
        log_activity(c, ident, "deregister")
        c.execute("DELETE FROM agent_sessions WHERE session_id=?", (ident,))
        # wq#568: plant the 'deregistered' marker. This is NOT retirement and fires no alert —
        # clean exits are normal. It is the tripwire: any LATER wq call under this identity is
        # the auto-continue signature and upgrades it to retired at the entry gate.
        c.execute("""INSERT INTO retired_sessions(session_id, base_name, retired_at, kind, reason)
                     VALUES(?,?,?,?,?)
                     ON CONFLICT(session_id) DO UPDATE SET retired_at=excluded.retired_at,
                       kind=excluded.kind, reason=excluded.reason""",
                  (ident, my_base, now(), "deregistered", "clean deregistration"))
        c.execute("COMMIT"); c.close()
        if held or locks:
            warn(f"--force: deregistered {ident} while it still held tickets={held or 'none'} "
                 f"slocks={locks or 'none'} — those are now owned by an unregistered name.")
        print(f"DEREGISTERED session: {ident}")
        print(f"  base name '{my_base}' is free for immediate reuse.")
        return

    if not a.register:
        ident, explicit = resolve_identity(a, c)
        r = c.execute("SELECT session_id,base_name,pid,first_seen,last_seen FROM agent_sessions WHERE session_id=?",
                      (ident,)).fetchone()
        mark_alive(c, ident, "whoami")
        c.execute("COMMIT")
        t_now = now(); rows = []
        for sid, bn, fs, ls in c.execute("""SELECT session_id,base_name,first_seen,last_seen
                                            FROM agent_sessions ORDER BY last_seen DESC"""):
            h, lk = session_holdings(c, sid, t_now)
            rows.append((sid, bn, fs, ls, idle_minutes(ls), h, lk))
        c.close()
        print(f"identity : {ident}" + ("" if explicit else "  (fallback — WQ_AGENT not set)"))
        if r:
            _, base, pid, fs, ls = r
            print(f"status   : REGISTERED session (base {base})")
            print(f"           minted {fs}Z, last_seen {ls}Z, by pid {pid} on this host.")
            print(f"           wq#537: that pid belongs to the one-shot `wq whoami --register`")
            print(f"           process that minted this id — it exits immediately and will NEVER")
            print(f"           match a caller's own pid, including this one. It is provenance,")
            print(f"           not a liveness or identity-match signal.")
        else:
            print("status   : UNREGISTERED legacy name")
            print("           -> register with: wq whoami --register <your-agent-name>")
        if rows:
            print(f"\nactive session registry ({len(rows)}) — STALE past {STALE_MIN}m idle (wq#530):")
            for sid, bn, fs, ls, idle, h, lk in rows:
                if h or lk:
                    mark = f"HOLDING tickets={h or 'none'} slocks={lk or 'none'} — never stale"
                elif idle is not None and idle >= STALE_MIN:
                    mark = "STALE — holds nothing, its base name is reusable"
                else:
                    mark = "live"
                print(f"  {sid:<24} base={bn:<16} {fmt_idle(idle):<11} last={ls}Z  {mark}")
        else:
            print("\nactive session registry: (empty)")
        # wq#568 (5): RETIRED is shown distinctly from STALE — stale frees a name, retired
        # kills an identity. 'deregistered' rows are dormant tripwires, labelled as such.
        c2 = conn()
        ret = c2.execute("""SELECT session_id, base_name, retired_at, kind, reason
                            FROM retired_sessions ORDER BY retired_at DESC LIMIT 10""").fetchall()
        c2.close()
        if ret:
            print(f"\nretired / deregistered identities (last {len(ret)}) — wq#568:")
            for sid, bn, rat, kind, reason in ret:
                label = ("clean exit; tripwire armed" if kind == "deregistered"
                         else f"RETIRED ({kind})")
                print(f"  {sid:<24} base={bn:<16} at={rat}Z  {label}"
                      + (f" — {reason[:60]}" if reason and kind != "deregistered" else ""))
        return
    base = a.register.strip()
    if not base or base.isdigit():
        c.execute("COMMIT"); c.close()
        print("REFUSED: --register needs a non-numeric agent name (e.g. rabbit5, gh1)"); sys.exit(1)
    blockers, stale, bare = partition_for_base(c, base, None)
    if blockers and not a.force:
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: base name '{base}' is already registered by a DIFFERENT session:")
        for sid, held, locks, fs, ls, idle in blockers:
            why = ("holds live work" if (held or locks)
                   else f"claim(s) {bare} are held under the BARE name '{base}'" if bare
                   else f"idle only {fmt_idle(idle)}, under the {STALE_MIN}m stale threshold")
            print(f"  {sid}  tickets={held or 'none'}  slocks={locks or 'none'}  "
                  f"{fmt_idle(idle)}  -> {why}")
            print(f"      first_seen={fs}Z last_seen={ls}Z")
        print("  wq#530: a registration is only stepped over when it is idle past "
              f"{STALE_MIN}m AND holds\n"
              "  no lease/slock AND no claim exists under its bare base name. Holding live work\n"
              "  means NEVER stale — a quiet agent mid-experiment is not a dead one.\n"
              "  Two sessions sharing a base name is exactly the failure wq#502 fixes:\n"
              "  every lock check silently inverts and you can take each other's tickets.\n"
              "  wq#537: this now refuses on EXISTENCE, not just an active lease/slock — the old\n"
              "  check missed the startup window where a second registration lands before the\n"
              "  first session has claimed or locked anything.\n"
              "  -> Pick a DISTINCT agent name, or wait for that session to idle out and be purged\n"
              f"     ({DEFAULT_TTL_MIN}m from its last activity, sooner if it releases everything\n"
              "     and a future purge pass runs).\n"
              "  -> Only if you are certain that session is dead: --force")
        sys.exit(2)
    sid = f"{base}-{secrets.token_hex(3)}"
    while c.execute("SELECT 1 FROM agent_sessions WHERE session_id=?", (sid,)).fetchone():
        sid = f"{base}-{secrets.token_hex(3)}"
    c.execute("""INSERT INTO agent_sessions(session_id,base_name,host,pid,first_seen,last_seen)
                 VALUES(?,?,?,?,?,?)""", (sid, base, socket.gethostname(), os.getpid(), now(), now()))
    c.execute("COMMIT"); c.close()
    if stale:
        # NB: distinct loop names. `sid` is the id just minted three lines above, and rebinding
        # it here printed the STALE row's id as the new session's — caught by probe A2.
        print(f"NOTE: stepped over {len(stale)} STALE registration(s) for base '{base}' (wq#530):")
        for s_sid, _h, _l, _fs, s_ls, s_idle in stale:
            print(f"  {s_sid}  {fmt_idle(s_idle)} (>{STALE_MIN}m), holding nothing, last={s_ls}Z")
        print("  They keep their registry rows so the history stays readable; they just no")
        print("  longer park the name. If one of them is actually alive, say so on the board.")
    if blockers and a.force:
        warn(f"--force used: '{base}' already live as {', '.join(b[0] for b in blockers)}")
    if purged: print(f"(expired {purged} stale session(s) from registry)")
    print(f"REGISTERED session: {sid}")
    print(f"export WQ_AGENT={sid}")
    print("^ put that in your env; claim/heartbeat/done/release/slock will use it automatically.")

