# wq#661: aging escalation — open unclaimed tickets gain +1 effective priority tier per
# WQ_AGING_DAYS days without a claim, capped at 1 tier. Blocked/gated tickets are excluded:
# they are waiting on an identified condition and should not be escalated.
AGING_DAYS = _envint("WQ_AGING_DAYS", 7)
def effective_pri(pri, status, gate, created_at):
    """wq#661: effective priority = stored pri minus age boost (never mutates stored pri).
    Only open/unclaimed tickets are boosted. Blocked and gated tickets are excluded —
    they are waiting on something identified and should not drift up the queue on their own.
    Boost: +1 tier per AGING_DAYS days open, capped at 1. effective_pri never goes below 1."""
    if status != 'open': return pri
    if gate and gate.strip(): return pri  # gated — has an identified blocking condition
    try:
        created = datetime.datetime.strptime(created_at, FMT).replace(tzinfo=datetime.timezone.utc)
        days = (utcnow() - created).total_seconds() / 86400.0
    except (TypeError, ValueError):
        return pri
    boost = min(1, int(days / AGING_DAYS))
    return max(1, pri - boost)
