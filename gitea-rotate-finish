#!/usr/bin/env bash
# gitea-rotate-finish — wq#2545: ONE entrypoint for rotating the lumen Gitea token.
#
# wq#2514 rotation raced: two orchestrators each minted a token within 60s and
# overwrote each other (id11 vs id12, reconciled by hand) because nothing made
# rotation take a lock. The token also lives in 4 places — this file, the git
# credential store, agent/.env, and the token-engine secrets store (T10) — and
# no single tool synced all four; two of them expected a human to paste a value.
#
# This script: acquires the gitea-lumen-token slock (refuses if held — the wq#2514
# fix), mints a fresh token on Anubis via the Gitea admin CLI, validates it BEFORE
# writing anything, writes all 4 copies, verifies every consumer (API, git
# ls-remote on every gitea repo, the token-engine broker via lumen-pr), then
# deletes the OLD token row and proves the old value now 401s. The token itself
# never appears in argv, in a log line, or in this script's own output — only its
# length and a byte count ever print, same convention as gitea-cred-restore.
#
# Every path below is overridable via env (all default to the real production
# location) so this can be exercised against a scratch sandbox before trusting it
# against the live fleet credential — see tests/test_gitea_rotate_finish.sh.
set -uo pipefail
[ "$(hostname)" = lumen ] || { echo "gitea-rotate-finish: lumen only" >&2; exit 9; }

HOST=${GITEA_ROTATE_HOST:-100.121.17.5:3000}
ANUBIS=${GITEA_ROTATE_ANUBIS_HOST:-anubis}
GUSER=${GITEA_ROTATE_USER:-lumen}
ENVF=${GITEA_ROTATE_ENV_FILE:-/home/lumen/agent/.env}
CRED=${GITEA_ROTATE_CRED_FILE:-/home/lumen/.git-credentials}
SECFILE=${GITEA_ROTATE_SEC_FILE:-/home/lumen/.secrets/gitea-lumen.token}
ENGINE_DIR=${GITEA_ROTATE_ENGINE_DIR:-/var/lib/token-engine/secrets}
ENGINE_FILE=${GITEA_ROTATE_ENGINE_FILE:-$ENGINE_DIR/gitea-lumen.token}
# wq#3565: lumen-messenger-cc moved to /scratch/fleet/projects under wq#3532.
REPOS=${GITEA_ROTATE_REPOS:-"/home/lumen/bin /home/lumen/messenger /home/lumen/minerva /scratch/fleet/projects/lumen-messenger-cc /home/lumen/foreman"}
# wq#5238: the scope set and its probes are read from the broker's own per-verb table
# (token_engine_daemon.GITEA_VERB_SCOPES), never kept here. Imported, not executed:
# running an older daemon file with an unknown flag would fall through to main().
TE_LIB=${GITEA_ROTATE_TE_LIB:-/usr/local/lib/token-engine}
TE_CLIENT=${GITEA_ROTATE_TE_CLIENT:-$TE_LIB/te_client.py}
TE_GRANT_DIR=${GITEA_ROTATE_TE_GRANT_DIR:-/home/lumen/foreman/events}
PROBE_REPO=${GITEA_ROTATE_PROBE_REPO:-lumen/claude-foreman}
LOCK_SCOPE=gitea-lumen-token
LOCK_TTL=${GITEA_ROTATE_LOCK_TTL:-15}
HOLDER=${GITEA_ROTATE_HOLDER:-gitea-rotate-finish-$$}
STAMP=$(date +%Y%m%d_%H%M%S)

die(){ echo "gitea-rotate-finish: $*" >&2; exit 1; }

echo "0) acquiring lock '$LOCK_SCOPE' as $HOLDER ..."
slock acquire "$LOCK_SCOPE" --holder "$HOLDER" --ttl "$LOCK_TTL" \
  --note "gitea-rotate-finish $STAMP" \
  || die "lock refused — a rotation is already in progress. Wait or: slock who"
RELEASED=0
release_lock(){ [ "$RELEASED" = 1 ] && return; slock release "$LOCK_SCOPE" --holder "$HOLDER" >/dev/null 2>&1; RELEASED=1; }
trap release_lock EXIT

echo "1) identifying the token row to retire ..."
P=$(grep -oP '^GITEA_PASSWORD=\K.*' "$ENVF" | tr -d '"')
[ -n "$P" ] || die "no GITEA_PASSWORD in $ENVF"
TOKLIST=$(curl -sS --max-time 15 -u "$GUSER:$P" "http://$HOST/api/v1/users/$GUSER/tokens") \
  || die "could not list existing tokens"
RETIRE_ID=${GITEA_ROTATE_RETIRE_ID:-}
RETIRE_NAME=${GITEA_ROTATE_RETIRE_NAME:-}
if [ -z "$RETIRE_ID" ]; then
  MATCHES=$(printf '%s' "$TOKLIST" | jq -r '.[] | select(.name | startswith("lumen-fleet-")) | "\(.id) \(.name)"')
  N=$(printf '%s\n' "$MATCHES" | grep -c .)
  [ "$N" -eq 1 ] || die "expected exactly one lumen-fleet-* token to retire, found $N — pass GITEA_ROTATE_RETIRE_ID/_NAME explicitly. Candidates: $MATCHES"
  RETIRE_ID=$(printf '%s' "$MATCHES" | awk '{print $1}')
  RETIRE_NAME=$(printf '%s' "$MATCHES" | cut -d' ' -f2-)
fi
echo "   retiring: id=$RETIRE_ID name=$RETIRE_NAME"

# --- credential rotation safety gate (wq#3747): before anything is minted or written ---
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/require-vault-backup.sh"
require_vault_backup "gitea-token" "$SECFILE" || exit $?
# --- end gate ---

# wq#5238: the 10-23 rotation minted from a list hardcoded on the line below
# (write:repository,write:user) and silently dropped the write:issue that wq#1727 had
# added by hand, so every lumen/* pr-comment 403'd. The set now comes from the one
# table the broker asserts, and the new value is probed for each scope before use.
te_table(){ python3 -I -c 'import sys; sys.path.insert(0, sys.argv[1]); import token_engine_daemon as D; exec(sys.argv[2])' "$TE_LIB" "$1" 2>/dev/null; }
SCOPES=$(te_table 'print(",".join(D.gitea_required_scopes()))')
[[ "$SCOPES" =~ ^[a-z_]+:[a-z_]+(,[a-z_]+:[a-z_]+)*$ ]] \
  || die "could not read the required scope set from $TE_LIB/token_engine_daemon.py (got '${SCOPES:-nothing}'). Refusing to mint a token that could drop a verb's scope (wq#5238); deploy token-engine first (install.sh --daemon-only). Nothing changed."
PROBES=$(te_table 'for s, (m, q) in sorted(D.GITEA_SCOPE_PROBES.items()): print(s, m, q)')
[ -n "$PROBES" ] || die "could not read the scope probes from $TE_LIB — nothing changed"
echo "   scopes (broker per-verb table): $SCOPES"

echo "2) minting a new token on Anubis ..."
NEWNAME="lumen-fleet-$STAMP"
NEW=$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$ANUBIS" \
  "sudo -u gitea gitea admin user generate-access-token -c /etc/gitea/app.ini -w /var/lib/gitea --username $GUSER --token-name $NEWNAME --scopes $SCOPES --raw" 2>/dev/null | tr -d '[:space:]')
[ ${#NEW} -ge 30 ] || die "mint failed or returned a short value — nothing changed"
echo "   minted $NEWNAME (len=${#NEW})"

echo "3) validating the new token BEFORE writing it anywhere ..."
CODE=$(curl -sS -o "/tmp/grf.$$.json" --max-time 10 -w '%{http_code}' -H "Authorization: token $NEW" "http://$HOST/api/v1/user")
WHO=$(jq -r '.login // "?"' "/tmp/grf.$$.json" 2>/dev/null); rm -f "/tmp/grf.$$.json"
[ "$CODE" = 200 ] && [ "$WHO" = "$GUSER" ] || die "new token failed to validate (HTTP $CODE, login=$WHO) — nothing changed"
echo "   OK: authenticates as $WHO"

# Remove the just-minted row when the new value is refused before anything was written.
retire_new(){
  local id
  id=$(curl -sS --max-time 15 -u "$GUSER:$P" "http://$HOST/api/v1/users/$GUSER/tokens" \
       | jq -r --arg n "$NEWNAME" '.[]? | select(.name == $n) | .id' 2>/dev/null | head -1)
  [ -n "$id" ] && curl -sS -o /dev/null --max-time 10 -u "$GUSER:$P" -X DELETE \
       "http://$HOST/api/v1/users/$GUSER/tokens/$id" && echo "   removed new row $NEWNAME (id=$id)"
}

echo "3b) probing the new token for every scope a broker verb needs ..."
while read -r SC M PTH; do
  [ -n "$SC" ] || continue
  PTH=${PTH//\{slug\}/$PROBE_REPO}
  DATA=(); [ "$M" = GET ] || DATA=(-H 'Content-Type: application/json' -d '{}')
  PC=$(curl -sS -o /dev/null --max-time 10 -w '%{http_code}' -X "$M" "${DATA[@]}" \
       -H "Authorization: token $NEW" "http://$HOST/api/v1$PTH")
  case "$PC" in
    401|403) retire_new
             die "new token fails the $SC probe (HTTP $PC on $M $PTH): minted without a scope a broker verb needs. Nothing written." ;;
  esac
  echo "   OK   $SC (HTTP $PC, non-mutating)"
done <<< "$PROBES"

OLD=$(tr -d '\n\r ' < "$SECFILE" 2>/dev/null || true)

# wq#4599: every pre-rotation backup gets an expiry. secret-backup-sweep shreds it once its old values are proven dead.
reg_bak() { /home/lumen/bin/secret-backup-sweep register "$1" --ttl 7d --owner gitea-rotate-finish --why "pre-rotate backup (old Gitea token)" >/dev/null 2>&1 || true; }

echo "4) writing all 4 copies ..."
TMPTOK="/tmp/gitea-rotate.$$.tok"
umask 077
printf '%s' "$NEW" > "$TMPTOK"

cp -a "$SECFILE" "$SECFILE.bak.${STAMP}_pre_rotate" 2>/dev/null || true
reg_bak "$SECFILE.bak.${STAMP}_pre_rotate"
install -m600 "$TMPTOK" "$SECFILE"
echo "   OK $SECFILE"

cp -a "$CRED" "$CRED.bak.${STAMP}_pre_rotate"
reg_bak "$CRED.bak.${STAMP}_pre_rotate"
ENC=${HOST/:/%3a}
grep -v "$ENC" "$CRED" > "/tmp/gc.$$" 2>/dev/null || true
printf 'http://%s:%s@%s\n' "$GUSER" "$NEW" "$ENC" >> "/tmp/gc.$$"
install -m600 "/tmp/gc.$$" "$CRED"; rm -f "/tmp/gc.$$"
echo "   OK $CRED"

cp -a "$ENVF" "$ENVF.bak.${STAMP}_pre_rotate"
reg_bak "$ENVF.bak.${STAMP}_pre_rotate"
NEWTOK="$NEW" python3 - "$ENVF" <<'PY'
import re, os, sys
tok = os.environ["NEWTOK"]; p = sys.argv[1]
out, n = [], 0
for l in open(p).read().splitlines():
    if re.match(r'^GITEA_TOKEN=', l):
        out.append("GITEA_TOKEN=" + tok); n += 1
    else:
        out.append(l)
fd = os.open(p + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(fd, ("\n".join(out) + "\n").encode()); os.close(fd)
os.replace(p + ".tmp", p)
print("   rewrote %d line(s) in agent/.env" % n)
PY

if sudo -n test -d "$ENGINE_DIR" 2>/dev/null; then
  sudo -n cp -a "$ENGINE_FILE" "$ENGINE_FILE.bak.${STAMP}_pre_rotate" 2>/dev/null || true
  reg_bak "$ENGINE_FILE.bak.${STAMP}_pre_rotate"   # owned by another user: the sweep cannot read it, so this only records intent
  sudo -n install -m600 -o tokeneng -g tokeneng "$TMPTOK" "$ENGINE_FILE"
  echo "   OK $ENGINE_FILE"
else
  echo "   SKIP $ENGINE_FILE (no sudo reach into $ENGINE_DIR — check drifted)"
fi
shred -u "$TMPTOK" 2>/dev/null || rm -f "$TMPTOK"
unset NEW NEWTOK

echo "5) verifying every consumer ..."
FAIL=0
CODE2=$(curl -sS -o /dev/null --max-time 10 -w '%{http_code}' -H "Authorization: token $(tr -d '\n\r ' < "$SECFILE")" "http://$HOST/api/v1/user")
[ "$CODE2" = 200 ] && echo "   OK   API /user" || { echo "   FAIL API /user (HTTP $CODE2)"; FAIL=1; }

for r in $REPOS; do
  [ -d "$r/.git" ] || { echo "   SKIP $(basename "$r") (not a repo)"; continue; }
  if git -C "$r" ls-remote --exit-code origin HEAD >/dev/null 2>&1; then
    echo "   OK   $(basename "$r") ls-remote"
  else
    echo "   FAIL $(basename "$r") ls-remote"; FAIL=1
  fi
done

if command -v lumen-pr >/dev/null 2>&1; then
  if lumen-pr check /home/lumen/bin >/dev/null 2>&1; then
    echo "   OK   broker (lumen-pr check)"
  else
    echo "   FAIL broker (lumen-pr check) — token-engine may need a moment to pick up $ENGINE_FILE"
    FAIL=1
  fi
fi

# wq#5238: the broker re-probes the store copy it actually serves, per verb.
if [ -f "$TE_CLIENT" ] && GD=$(mktemp -d -p "$TE_GRANT_DIR" te-grf.XXXXXX 2>/dev/null); then
  chmod 755 "$GD"
  jq -n --arg e "$(date -u -d '+10 min' +%Y-%m-%dT%H:%M:%SZ)" \
    '{ticket:"adhoc-gitea-rotate", expires:$e, grants:[{kind:"token_engine", node:"daemon"}]}' > "$GD/grant.json"
  chmod 644 "$GD/grant.json"
  ST=$(python3 "$TE_CLIENT" --verb scope-selftest --ticket adhoc-gitea-rotate \
       --worker gitea-rotate-finish --grant-file "$GD/grant.json" \
       --grant-sha "$(sha256sum "$GD/grant.json" | awk '{print $1}')" 2>/dev/null)
  rm -rf "$GD"
  STOK=$(printf '%s' "$ST" | jq -r '.ok // false' 2>/dev/null)
  STRULE=$(printf '%s' "$ST" | jq -r '.rule // ""' 2>/dev/null)
  STFAIL=$(printf '%s' "$ST" | jq -r '.result.failing // "?"' 2>/dev/null)
  if [ "$STOK" = true ] && [ -z "$STFAIL" ]; then
    echo "   OK   broker scope-selftest (every verb's scope present)"
  elif [ "$STRULE" = verb_unknown ]; then
    echo "   WARN broker has no scope-selftest verb yet — deploy token-engine (wq#5238)"
  else
    echo "   FAIL broker scope-selftest [${STRULE:-no frame}] failing=${STFAIL:-?}"; FAIL=1
  fi
else
  echo "   SKIP broker scope-selftest (no te_client at $TE_CLIENT or no grant dir)"
fi

[ "$FAIL" = 0 ] || die "one or more consumers failed with the new token — investigate before deleting the old one. Old token row is UNTOUCHED."

echo "6) deleting the retired token row (id=$RETIRE_ID name=$RETIRE_NAME) ..."
DELCODE=$(curl -sS -o /dev/null --max-time 10 -w '%{http_code}' -u "$GUSER:$P" -X DELETE "http://$HOST/api/v1/users/$GUSER/tokens/$RETIRE_ID")
[ "$DELCODE" = 204 ] || die "delete of token id=$RETIRE_ID returned HTTP $DELCODE — investigate. New token IS deployed; old row may still be live."
echo "   OK   deleted (HTTP 204)"

if [ -n "$OLD" ]; then
  echo "7) proving the old value is dead ..."
  OLDCODE=$(curl -sS -o /dev/null --max-time 10 -w '%{http_code}' -H "Authorization: token $OLD" "http://$HOST/api/v1/user")
  [ "$OLDCODE" = 401 ] && echo "   OK   old token now HTTP 401" || echo "   WARN old token returned HTTP $OLDCODE (expected 401) — check manually"
fi

echo "done. '$NEWNAME' is live in all reachable copies; old row id=$RETIRE_ID deleted."
