#!/bin/bash
# dispatch-report — read-only snapshot of the ticket pipeline + fleet inference capacity.
# Session pipeline-complete-01cecf 2026-10-07. Safe to run any time; changes nothing.
# Counts come from `wq list` (open/claimed/blocked) and queue.db done_at (done today):
# `wq list --status done` prints no timestamps, so a date grep on it is always 0.
export PATH=/home/lumen/bin:/home/lumen/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
QDB=/home/lumen/agents/work-queue/queue.db
ENVF=/home/lumen/agent/.env
TODAY=$(date +%F)

count() { wq list --status "$1" 2>/dev/null | grep -c '^\['; }

echo "=== Dispatch Report $TODAY $(date +%H:%M%Z) ==="
echo "Open:    $(count open)"
echo "Claimed: $(count claimed)"
echo "Blocked: $(count blocked)"
DONE_TODAY=$(python3 - "$QDB" "$TODAY" <<'PY'
import sqlite3, sys
db, today = sys.argv[1], sys.argv[2]
try:
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    n = c.execute("select count(*) from tasks where status='done' and substr(done_at,1,10)=?", (today,)).fetchone()[0]
    print(n)
except Exception as e:
    print(f"? ({e})")
PY
)
echo "Done today (UTC date in done_at): $DONE_TODAY"
echo ""
echo "Fworker sessions:     $(pgrep -fc "^python3 /home/lumen/foreman/harness/fworker.py run")"
echo "Claude Code sessions: $(pgrep -fc '/claude -p ')"
echo "Dispatch disarm latch: $([ -e /home/lumen/autonomy/DISPATCH_DISARM ] && echo PRESENT-DISPATCH-OFF || echo absent-ok)"
echo "Broker timer: $(systemctl list-timers --no-legend lumen-foreman-dispatch.timer 2>/dev/null | awk '{print $1,$2,$3,"(next)"}' | head -1)"
echo ""
# LiteLLM /models needs the master key (401 otherwise). Key is read, never printed.
K=$(grep -h '^LITELLM_MASTER_KEY=' "$ENVF" 2>/dev/null | cut -d= -f2- | tr -d '"'"'")
if [ -n "$K" ]; then
  echo "LiteLLM models: $(curl -s -m 10 -H "Authorization: Bearer $K" http://localhost:4000/models 2>/dev/null | python3 -c 'import sys,json;print(len(json.load(sys.stdin).get("data",[])))' 2>/dev/null || echo '?')"
else
  echo "LiteLLM models: ? (no master key readable at $ENVF)"
fi
unset K
echo ""
echo "Ollama endpoints (models served; derived from LiteLLM api_base, wq#5129):"
# Derived, not hardcoded: every distinct :11434 api_base the gateway routes to. The old
# hardcoded isis/hathor/khepri/nephthys list probed nodes retired 2026-10-22.
LCFG=/home/lumen/agent/litellm_config.yaml
bases=$(grep -oE 'api_base:[[:space:]]*"?http://[^[:space:]"]+:11434' "$LCFG" 2>/dev/null | sed -E 's/.*(http:[^"]+).*/\1/' | sort -u)
[ -z "$bases" ] && echo "  (none found in $LCFG)"
for base in $bases; do
  ip=${base#http://}; ip=${ip%%:*}
  case "$ip" in
    172.17.0.1|127.0.0.1|localhost) h="lumen" ;;
    *) h=$(tailscale status 2>/dev/null | awk -v ip="$ip" '$1==ip{print $2; exit}'); h=${h:-$ip} ;;
  esac
  printf "  %-9s " "$h:"
  out=$(curl -s -m 5 "$base/api/tags" 2>/dev/null)
  if [ -n "$out" ]; then
    echo "$out" | python3 -c 'import sys,json;m=[x["name"] for x in json.load(sys.stdin).get("models",[])];print(len(m),"models:",", ".join(m))' 2>/dev/null || echo "up (unparsed)"
  else
    echo "unreachable ($base)"
  fi
done
