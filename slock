#!/usr/bin/env python3
"""slock — subject-level advisory locks for parallel agent sessions (Lumen fleet).
Scope = any subsystem string (litellm, messenger, maat, vault-ha, minerva-db, ...).
Backed by queue.db (WAL, BEGIN IMMEDIATE = atomic). Locks auto-expire (default 120 min).
Rule: acquire the scope BEFORE any state-changing work on that subsystem; release when done.
Same holder re-acquiring = lease refresh (re-entrant). Deny is LOUD, exit 1."""
import sqlite3, sys, os, argparse, datetime, socket
DB = os.environ.get("WQ_DB", "/home/lumen/agents/work-queue/queue.db")
DEFAULT_TTL_MIN = 120
FMT = "%Y-%m-%d %H:%M:%S"
def utcnow(): return datetime.datetime.now(datetime.timezone.utc)
def now(): return utcnow().strftime(FMT)
def lease_from(m): return (utcnow() + datetime.timedelta(minutes=m)).strftime(FMT)
def conn():
    c = sqlite3.connect(DB, timeout=30)
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA busy_timeout=30000")
    return c
def init():
    c = conn()
    c.execute("""CREATE TABLE IF NOT EXISTS slocks(
        scope TEXT PRIMARY KEY, holder TEXT, acquired_at TEXT,
        expires_at TEXT, note TEXT DEFAULT '')""")
    c.commit(); c.close()
def default_holder(): return f"{socket.gethostname()}:{os.getpid()}"
def cmd_acquire(a):
    holder = a.holder or default_holder()
    scope = a.scope.strip().lower()
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    t_now = now()
    c.execute("DELETE FROM slocks WHERE expires_at < ?", (t_now,))
    r = c.execute("SELECT holder, expires_at, note FROM slocks WHERE scope=?", (scope,)).fetchone()
    if r and r[0] != holder:
        c.execute("COMMIT"); c.close()
        print(f"DENIED: '{scope}' held by {r[0]} until {r[1]}Z" + (f" — {r[2]}" if r[2] else ""))
        print("Do NOT touch this subsystem. Coordinate or wait for expiry.")
        sys.exit(1)
    exp = lease_from(a.ttl)
    c.execute("""INSERT INTO slocks(scope,holder,acquired_at,expires_at,note) VALUES(?,?,?,?,?)
                 ON CONFLICT(scope) DO UPDATE SET holder=excluded.holder,
                   expires_at=excluded.expires_at, note=excluded.note""",
              (scope, holder, t_now, exp, a.note or ''))
    c.execute("COMMIT"); c.close()
    verb = "REFRESHED" if r else "ACQUIRED"
    print(f"{verb} '{scope}' by {holder} until {exp}Z (ttl {a.ttl}m)")
def cmd_release(a):
    holder = a.holder or default_holder()
    scope = a.scope.strip().lower()
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    r = c.execute("SELECT holder FROM slocks WHERE scope=?", (scope,)).fetchone()
    if not r:
        c.execute("COMMIT"); c.close(); print(f"'{scope}' not held (nothing to release)"); return
    if r[0] != holder and not a.force:
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: '{scope}' held by {r[0]}, you are {holder}. Use --force to override."); sys.exit(1)
    c.execute("DELETE FROM slocks WHERE scope=?", (scope,))
    c.execute("COMMIT"); c.close()
    print(f"RELEASED '{scope}'" + (f" (forced, was {r[0]})" if r[0] != holder else ""))
def cmd_extend(a):
    holder = a.holder or default_holder()
    scope = a.scope.strip().lower()
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    r = c.execute("SELECT holder FROM slocks WHERE scope=?", (scope,)).fetchone()
    if not r or r[0] != holder:
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: '{scope}' " + (f"held by {r[0]}, not you ({holder})" if r else "not held — acquire first"))
        sys.exit(1)
    exp = lease_from(a.ttl)
    c.execute("UPDATE slocks SET expires_at=? WHERE scope=?", (exp, scope))
    c.execute("COMMIT"); c.close()
    print(f"EXTENDED '{scope}' until {exp}Z")
def cmd_who(a):
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    c.execute("DELETE FROM slocks WHERE expires_at < ?", (now(),))
    q, args = "SELECT scope,holder,acquired_at,expires_at,note FROM slocks", ()
    if a.scope: q += " WHERE scope=?"; args = (a.scope.strip().lower(),)
    rows = c.execute(q + " ORDER BY scope", args).fetchall()
    c.execute("COMMIT"); c.close()
    if not rows: print("(no active locks)"); return
    for r in rows:
        print(f"{r[0]:<20} {r[1]:<28} acquired {r[2]}Z expires {r[3]}Z" + (f"  # {r[4]}" if r[4] else ""))
p = argparse.ArgumentParser()
sub = p.add_subparsers(dest="cmd")
s=sub.add_parser("acquire"); s.add_argument("scope"); s.add_argument("--ttl",type=int,default=DEFAULT_TTL_MIN); s.add_argument("--holder"); s.add_argument("--note"); s.set_defaults(f=cmd_acquire)
s=sub.add_parser("release"); s.add_argument("scope"); s.add_argument("--holder"); s.add_argument("--force",action="store_true"); s.set_defaults(f=cmd_release)
s=sub.add_parser("extend"); s.add_argument("scope"); s.add_argument("--ttl",type=int,default=DEFAULT_TTL_MIN); s.add_argument("--holder"); s.set_defaults(f=cmd_extend)
s=sub.add_parser("who"); s.add_argument("scope",nargs="?"); s.set_defaults(f=cmd_who)
init()
a = p.parse_args()
if not getattr(a,"cmd",None): p.print_help(); sys.exit(0)
a.f(a)
