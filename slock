#!/usr/bin/env python3
"""slock — subject-level advisory locks for parallel agent sessions (Lumen fleet).
Scope = any subsystem string (litellm, messenger, maat, vault-ha, minerva-db, ...).
Backed by queue.db (WAL, BEGIN IMMEDIATE = atomic). Locks auto-expire (default 120 min).
Rule: acquire the scope BEFORE any state-changing work on that subsystem; release when done.
Same holder re-acquiring = lease refresh (re-entrant). Deny is LOUD, exit 1.

wq#532 (2026-08-14) — three changes, each traced to a coordination failure on 2026-08-13:
  --ttl NOW ACCEPTS A SUFFIX (5m, 2h, 90). `--ttl 5m` used to be rejected by argparse, which is
    how rabbit15 breached lpp-git the first time: the acquire failed, the caller chained with
    `;`, and the land ran unlocked. A unit that reads naturally must not be a trap.
  DEFAULT TTL 120 -> 30. A lock is held for the OPERATION, not for the session. 120m was long
    enough that a finished ticket sat stranded for 65 minutes behind an abandoned lock. Use
    --ttl for genuinely long work, or `slock extend`.
  `who` NAMES THE TICKET, its LANE and its PRIORITY, and `acquire` WARNS on a priority
    inversion — a p4 in one lane holding a subsystem a p1 in another lane declares. That
    happened (wq#499 held lpp-repo against p1 gameplay work) and nothing said a word.

EXIT STATUS IS THE SAFETY SIGNAL AND A PIPE DESTROYS IT. `slock acquire ... | tail -2 && cmd`
runs cmd even on DENIED, because a pipeline exits with the LAST command's status. Never pipe an
acquire. Better: do not hand-wrap a critical section at all — `lumen-pr land` now takes the repo
lock itself (wq#532a).

wq#1182 (2026-09-02) — FENCE. slock was already DB-backed (WAL + BEGIN IMMEDIATE, never a
bare flock file) with a TTL and a session-unique holder, so two of the three properties
wq#1158 hardened `wq` leases with were already here. The missing one is a fence: `acquire`,
`extend` and `release` all key on the HOLDER STRING alone, and a holder string is exactly
the thing that gets reused when the same identity's lease expires, gets reaped, and is
handed back out — same shape as the zombie wq#1158 closed for ticket claims. `acquire`
now mints a monotonic `fence` on every GRANT (never on a same-holder REFRESH of a still-live
lock, so a caller renewing on schedule never has to re-read its own fence) and prints
`FENCE=<n>`. `extend`/`release` take an OPTIONAL `--fence <n>`; a caller that passes one is
refused (exit 5) if the live lock has moved past it. Opt-in and additive: every existing
caller in the fleet (dc-narrow-deploy.sh, foreman_dispatcher.py, ...) passes no `--fence` and
sees byte-identical behavior. See kb/fleet-upgrade-plan-review.md's slock audit for why this
was "add a fence" rather than "retire slock for wq leases" — slock locks ARBITRARY subsystem
scopes (vault-ha, litellm, ...) that never map onto a wq ticket, so folding it into the wq
lease table would need every caller rewritten for no safety gain the fence doesn't already
buy more cheaply."""
import sqlite3, sys, os, argparse, datetime, socket, re
DB = os.environ.get("WQ_DB", "/home/lumen/agents/work-queue/queue.db")
DEFAULT_TTL_MIN = 30
FMT = "%Y-%m-%d %H:%M:%S"
def parse_ttl(v):
    """Minutes. Accepts a bare integer, or a suffix: 90 / 5m / 2h / 1d.
    argparse used to take type=int here, so `--ttl 5m` died with a usage error and the caller
    carried on unlocked. Anything unparseable is a hard error, never a silent default."""
    t = str(v).strip().lower()
    if not t: raise argparse.ArgumentTypeError("empty --ttl")
    mult = {"m": 1, "h": 60, "d": 1440}
    unit = 1
    if t[-1] in mult:
        unit = mult[t[-1]]; t = t[:-1]
    try:
        n = int(t)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"bad --ttl {v!r} — use minutes (30), or a suffix: 5m, 2h, 1d")
    if n <= 0: raise argparse.ArgumentTypeError(f"--ttl must be positive, got {v!r}")
    return n * unit

def utcnow(): return datetime.datetime.now(datetime.timezone.utc)
def now(): return utcnow().strftime(FMT)
def lease_from(m): return (utcnow() + datetime.timedelta(minutes=m)).strftime(FMT)
def conn():
    c = sqlite3.connect(DB, timeout=30)
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA busy_timeout=30000")
    return c
def init():
    c = conn()
    c.execute("""CREATE TABLE IF NOT EXISTS slocks(
        scope TEXT PRIMARY KEY, holder TEXT, acquired_at TEXT,
        expires_at TEXT, note TEXT DEFAULT '')""")
    # wq#1182: inert until a caller passes --fence, so this is safe to auto-add like any
    # other column — unlike wq's lease_owner/fence/attempt, nothing here changes protocol
    # just by existing.
    cols = {r[1] for r in c.execute("PRAGMA table_info(slocks)")}
    if "fence" not in cols:
        c.execute("ALTER TABLE slocks ADD COLUMN fence INTEGER DEFAULT 0")
    c.commit(); c.close()
def default_holder():
    # wq#502: share the wq session identity so slock holders are session-unique too.
    # Two sessions with the same free-text holder made every ownership check invert.
    return os.environ.get("WQ_AGENT", "").strip() or f"{socket.gethostname()}:{os.getpid()}"
def refuse_if_retired(holder, action):
    """wq#568 (3): a retired session may not ACQUIRE or EXTEND — this is what actually stops
    a respawn from landing code, because `lumen-pr land` takes the repo lock itself. DENIED is
    fail-closed for the retired session and exit 1. `release` stays open on purpose: a retired
    identity shedding held state is desirable, never dangerous. A missing retired_sessions
    table (standalone lock DB, or a queue.db that pre-dates wq#568) means nobody is retired —
    that is absence of the feature, not a reason to deny the living."""
    try:
        c = conn()
        r = c.execute("SELECT retired_at, kind, reason FROM retired_sessions WHERE session_id=?",
                      (holder,)).fetchone()
        c.close()
    except sqlite3.Error:
        return
    if r:
        print(f"DENIED: holder '{holder}' was RETIRED at {r[0]}Z ({r[1]}): {r[2]}")
        print(f"  A retired session may not {action} a lock. STOP NOW — do not resume work.")
        print("  (wq#568: if you are an auto-continued agent, end your run immediately.)")
        sys.exit(1)
def ticket_for_holder(c, holder, note):
    """The ticket behind a lock, for display. Prefer the note wq#N that wq's own acquire_subs
    writes; fall back to whatever this holder currently has claimed."""
    try:
        tid = None
        m = re.search(r"wq#(\d+)", note or "")
        if m: tid = int(m.group(1))
        if tid is None:
            r = c.execute("""SELECT id FROM tasks WHERE claimed_by=? AND status='claimed'
                             ORDER BY pri ASC, id ASC LIMIT 1""", (holder,)).fetchone()
            if r: tid = r[0]
        if tid is None: return None
        return c.execute("SELECT id,lane,pri,status,title FROM tasks WHERE id=?", (tid,)).fetchone()
    except sqlite3.Error:
        # No `tasks` table (slock against a standalone lock DB), or a schema this build does not
        # know. Display context is a nice-to-have; the LOCK is not. Never fail the acquire.
        return None

def waiting_higher_priority(c, scope, my_pri, my_lane):
    """Tickets in ANOTHER lane that DECLARE this subsystem and outrank the acquirer.

    Deliberately a WARNING and not a refusal. It can only see tickets that declare the
    subsystem in `subsystems`, so it is a partial view of who is waiting — and refusing on a
    partial view would block legitimate work on missing data, which is a worse failure than the
    p4-blocks-p1 case it is trying to catch. Loud is proportionate; fatal is not."""
    if my_pri is None: return []
    out = []
    try:
        rows = c.execute(
            """SELECT id,lane,pri,status,title FROM tasks
               WHERE status IN ('open','claimed') AND pri < ?
               ORDER BY pri ASC, id ASC""", (my_pri,)).fetchall()
        for tid, lane, pri, status, title in rows:
            raw = c.execute("SELECT subsystems FROM tasks WHERE id=?", (tid,)).fetchone()[0] or ""
            subs = [x.strip().lower() for x in raw.replace(",", " ").split() if x.strip()]
            if scope in subs and lane != my_lane:
                out.append((tid, lane, pri, status, title))
    except sqlite3.Error:
        return []
    return out

def cmd_acquire(a):
    holder = a.holder or default_holder()
    refuse_if_retired(holder, "acquire")
    scope = a.scope.strip().lower()
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    t_now = now()
    # wq#1182: read the fence BEFORE the reap-expired delete below. The counter must survive
    # its own row being deleted — that delete-and-reinsert IS the reap-then-regrant cycle the
    # fence exists to catch, so resetting to 1 here would erase the exact history a stale
    # zombie caller needs refused against.
    prev = c.execute("SELECT fence FROM slocks WHERE scope=?", (scope,)).fetchone()
    prev_fence = int((prev[0] if prev else 0) or 0)
    c.execute("DELETE FROM slocks WHERE expires_at < ?", (t_now,))
    r = c.execute("SELECT holder, expires_at, note, fence FROM slocks WHERE scope=?", (scope,)).fetchone()
    if r and r[0] != holder:
        c.execute("COMMIT"); c.close()
        print(f"DENIED: '{scope}' held by {r[0]} until {r[1]}Z" + (f" — {r[2]}" if r[2] else ""))
        print("Do NOT touch this subsystem. Coordinate or wait for expiry.")
        sys.exit(1)
    mine = ticket_for_holder(c, holder, a.note or '')
    my_pri = mine[2] if mine else None
    my_lane = mine[1] if mine else None
    blocked_higher = waiting_higher_priority(c, scope, my_pri, my_lane)
    exp = lease_from(a.ttl)
    # wq#1182: a GRANT (r is None — never held, or held-and-reaped since expiry) mints a new
    # fence. A REFRESH (r exists, same holder, still live) keeps it: nothing invalidated the
    # holder's standing, so a caller renewing on schedule must not have its own last fence
    # go stale out from under it.
    fence = prev_fence + (0 if r else 1)
    c.execute("""INSERT INTO slocks(scope,holder,acquired_at,expires_at,note,fence) VALUES(?,?,?,?,?,?)
                 ON CONFLICT(scope) DO UPDATE SET holder=excluded.holder,
                   expires_at=excluded.expires_at, note=excluded.note, fence=excluded.fence""",
              (scope, holder, t_now, exp, a.note or '', fence))
    c.execute("COMMIT"); c.close()
    verb = "REFRESHED" if r else "ACQUIRED"
    ctx = f" for wq#{mine[0]} [{mine[1]}/p{mine[2]}]" if mine else ""
    print(f"{verb} '{scope}' by {holder}{ctx} until {exp}Z (ttl {a.ttl}m) FENCE={fence}")
    if blocked_higher:
        print(f"PRIORITY INVERSION WARNING: {len(blocked_higher)} higher-priority ticket(s) in "
              f"another lane declare '{scope}':")
        for tid, lane, pri, status, title in blocked_higher[:5]:
            print(f"  wq#{tid} [{lane}/p{pri}/{status}] {title[:60]}")
        print("  A p4 must never block a p1, in any lane. Hold this for the OPERATION only, or")
        print("  release it and let the higher-priority ticket through. This is a warning, not a")
        print("  refusal — it can only see tickets that DECLARE the subsystem, so it is a partial")
        print("  view of who is waiting.")
def fence_check(a, live_fence, scope):
    """wq#1182 — optional stale-fence refusal shared by release/extend. `--fence` unset (the
    default, every existing caller) skips this entirely: it never fires for a caller that
    never asked for it. Returns None (proceed) or an exit code."""
    want = getattr(a, "fence", None)
    if want is None:
        return None
    if int(want) != int(live_fence or 0):
        print(f"REFUSED: stale fence (wq#1182) — you hold fence {want} for '{scope}', the "
              f"live lock is at fence {live_fence or 0}. Your claim ended and '{scope}' was "
              f"re-acquired since; this call would act on a scope you no longer hold.\n"
              f"  If you are a resumed session: stop here, do not resume the guarded work.")
        return 5
    return None
def cmd_release(a):
    holder = a.holder or default_holder()
    scope = a.scope.strip().lower()
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    r = c.execute("SELECT holder, fence FROM slocks WHERE scope=?", (scope,)).fetchone()
    if not r:
        c.execute("COMMIT"); c.close(); print(f"'{scope}' not held (nothing to release)"); return
    if r[0] != holder and not a.force:
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: '{scope}' held by {r[0]}, you are {holder}. Use --force to override."); sys.exit(1)
    rc = fence_check(a, r[1], scope)
    if rc is not None:
        c.execute("COMMIT"); c.close(); sys.exit(rc)
    c.execute("DELETE FROM slocks WHERE scope=?", (scope,))
    c.execute("COMMIT"); c.close()
    print(f"RELEASED '{scope}'" + (f" (forced, was {r[0]})" if r[0] != holder else ""))
def cmd_extend(a):
    holder = a.holder or default_holder()
    refuse_if_retired(holder, "extend")
    scope = a.scope.strip().lower()
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    r = c.execute("SELECT holder, fence FROM slocks WHERE scope=?", (scope,)).fetchone()
    if not r or r[0] != holder:
        c.execute("COMMIT"); c.close()
        print(f"REFUSED: '{scope}' " + (f"held by {r[0]}, not you ({holder})" if r else "not held — acquire first"))
        sys.exit(1)
    rc = fence_check(a, r[1], scope)
    if rc is not None:
        c.execute("COMMIT"); c.close(); sys.exit(rc)
    exp = lease_from(a.ttl)
    c.execute("UPDATE slocks SET expires_at=? WHERE scope=?", (exp, scope))
    c.execute("COMMIT"); c.close()
    print(f"EXTENDED '{scope}' until {exp}Z FENCE={r[1] or 0}")
def cmd_who(a):
    c = conn(); c.isolation_level = None
    c.execute("BEGIN IMMEDIATE")
    c.execute("DELETE FROM slocks WHERE expires_at < ?", (now(),))
    q, args = "SELECT scope,holder,acquired_at,expires_at,note,fence FROM slocks", ()
    if a.scope: q += " WHERE scope=?"; args = (a.scope.strip().lower(),)
    rows = c.execute(q + " ORDER BY scope", args).fetchall()
    c.execute("COMMIT"); c.close()
    if not rows: print("(no active locks)"); return
    c2 = conn()
    for r in rows:
        t = ticket_for_holder(c2, r[1], r[4] or '')
        ctx = f"  wq#{t[0]} [{t[1]}/p{t[2]}/{t[3]}]" if t else "  (no ticket)"
        print(f"{r[0]:<20} {r[1]:<28} acquired {r[2]}Z expires {r[3]}Z FENCE={r[5] or 0}{ctx}"
              + (f"  # {r[4]}" if r[4] else ""))
        if t: print(f"{'':<20} {t[4][:76]}")
    c2.close()
p = argparse.ArgumentParser()
sub = p.add_subparsers(dest="cmd")
s=sub.add_parser("acquire"); s.add_argument("scope"); s.add_argument("--ttl",type=parse_ttl,default=DEFAULT_TTL_MIN); s.add_argument("--holder"); s.add_argument("--note"); s.set_defaults(f=cmd_acquire)
s=sub.add_parser("release"); s.add_argument("scope"); s.add_argument("--holder"); s.add_argument("--force",action="store_true"); s.add_argument("--fence",type=int); s.set_defaults(f=cmd_release)
s=sub.add_parser("extend"); s.add_argument("scope"); s.add_argument("--ttl",type=parse_ttl,default=DEFAULT_TTL_MIN); s.add_argument("--holder"); s.add_argument("--fence",type=int); s.set_defaults(f=cmd_extend)
s=sub.add_parser("who"); s.add_argument("scope",nargs="?"); s.set_defaults(f=cmd_who)
init()
a = p.parse_args()
if not getattr(a,"cmd",None): p.print_help(); sys.exit(0)
a.f(a)
