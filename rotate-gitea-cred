#!/usr/bin/env bash
# rotate-gitea-cred - safely replace the Gitea token in ~/.git-credentials (wq#529).
# Token is read from a hidden prompt: never in argv, never in shell history,
# never echoed, never written anywhere but the 600-mode credentials file.
#   --check   dry run: show which line WOULD change. No writes, no prompt.
set -euo pipefail
[ "$(hostname)" = lumen ] || { echo "run on lumen only"; exit 9; }

CRED="$HOME/.git-credentials"
HOSTPAT='100\.121\.17\.5%3a3000'
[ -f "$CRED" ] || { echo "no $CRED"; exit 1; }

if [ "${1:-}" = "--check" ]; then
  python3 - "$CRED" "$HOSTPAT" <<'PY'
import re,sys
cred,hp=sys.argv[1],sys.argv[2]
rx=re.compile(r'^(https?://)([^:]+):([^@]+)(@'+hp+r')$')
n=0
for i,l in enumerate(open(cred).read().splitlines(),1):
    m=rx.match(l)
    if m:
        n+=1
        print("  line %d: %s%s:***REDACTED***%s  (token len %d)"%(i,m.group(1),m.group(2),m.group(4),len(m.group(3))))
print("%d line(s) would be rewritten."%n if n else "NO MATCH - check the host pattern before rotating.")
PY
  exit 0
fi

# --- credential rotation safety gate (wq#3747) ---
source /home/lumen/bin/lib/require-vault-backup.sh
require_vault_backup "gitea-cred" "$CRED" || exit $?
# --- end gate ---

BAK="$CRED.bak.$(date +%Y%m%d_%H%M%S)_pre_gitea_rotate"
cp -a "$CRED" "$BAK"; chmod 600 "$BAK"
echo "backup: $BAK"

IFS= read -rsp "Paste NEW Gitea token (hidden), then Enter: " NEWTOK
echo
# Validate AFTER stripping. A whitespace-only paste passes -n but strips to empty
# downstream - exactly how this script wrote a 0-length token on 2026-08-13 and
# silently broke Gitea auth. Length-check too: Gitea tokens are 40 hex chars.
CLEAN=$(printf '%s' "$NEWTOK" | tr -d '[:space:]')
[ -n "$CLEAN" ] || { echo "empty/whitespace token, aborted (original untouched)"; exit 1; }
[ ${#CLEAN} -ge 30 ] || { echo "token is only ${#CLEAN} chars, expected ~40; aborted (original untouched)"; exit 1; }
NEWTOK="$CLEAN"

printf '%s' "$NEWTOK" | python3 - "$CRED" "$HOSTPAT" <<'PY'
import re,sys,os
tok=sys.stdin.read().strip()
if len(tok)<30:
    print("refusing to write a %d-char token - original untouched."%len(tok)); sys.exit(1)
cred,hp=sys.argv[1],sys.argv[2]
rx=re.compile(r'^(https?://)([^:]+):([^@]+)(@'+hp+r')$')
lines=open(cred).read().splitlines()
out=[];n=0
for l in lines:
    m=rx.match(l)
    if m: out.append(m.group(1)+m.group(2)+":"+tok+m.group(4)); n+=1
    else: out.append(l)
if n==0:
    print("NO MATCH - nothing written, original untouched."); sys.exit(1)
fd=os.open(cred+".tmp",os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600)
os.write(fd,("\n".join(out)+"\n").encode()); os.close(fd)
os.replace(cred+".tmp",cred); os.chmod(cred,0o600)
print("rewrote %d line(s)"%n)
PY
unset NEWTOK

ls -l "$CRED"
echo "--- identities only (protocol-agnostic mask):"
sed -E 's#^([a-z]+://[^:]+):[^@]+@#\1:***@#' "$CRED"
echo
echo "Verify against Gitea, then shred the backup:  shred -u $BAK"
