#!/usr/bin/env bash
# fleet-keymesh — full-mesh SSH key trust + host aliases across the Lumen fleet.
# Rerunnable/idempotent. Bootstrap auth: sshpass fleet password. wq#330-adjacent, 2026-07-18.
#
# wq#1456: the roster comes from the fleet inventory (`fleet-inv ssh-list`, DESIGN_SOT.md) —
# no NODES list lives here. Every box whose status is active/standby/bench with a resolvable
# user@tailscale_ip is meshed: parked standby boxes (hathor, wadjet) stay in so they rejoin the
# mesh the day they are powered on (UNREACHABLE ones are skipped below, as before), while
# decommissioned/dead/in-storage boxes (nephthys) never appear. Adding sobek (wq#1447) is now
# one YAML edit, not a script edit.   `fleet-keymesh --list` prints the roster and exits.
set -uo pipefail
FLEET_INV=${FLEET_INV:-/home/lumen/bin/fleet-inv}
ROSTER=$("$FLEET_INV" ssh-list --all --status active,standby,bench) \
  || { echo "fleet-keymesh: fleet-inv ssh-list failed — refusing to mesh without a roster" >&2; exit 1; }
[ -n "$ROSTER" ] || { echo "fleet-keymesh: empty roster from inventory — refusing to run" >&2; exit 1; }
if [ "${1:-}" = "--list" ]; then printf '%s\n' "$ROSTER"; exit 0; fi
PASS=$(cat /home/lumen/.fleet_pw)  # rotated fleet pw lives in the 0600 file, never inline
SSHOPTS="-o ConnectTimeout=6 -o StrictHostKeyChecking=accept-new"
# NODES = user@host words (the shape the phases below loop over); ALIAS[user@host] = inventory
# name, which is the ssh alias (maat, not its login user maam).
declare -A ALIAS=()
NODES=""
while IFS=$'\t' read -r name tgt; do
  [ -n "$name" ] || continue
  ALIAS[$tgt]=$name; NODES="$NODES $tgt"
done <<<"$ROSTER"
alias_of(){ echo "${ALIAS[$1]:-${1%@*}}"; }
TMP=$(mktemp -d); trap "rm -rf $TMP" EXIT
echo "== Phase 1: ensure per-node key + harvest pubkeys =="
OK_NODES=""
for n in $NODES; do
  u=${n%@*}
  pk=$(sshpass -p "$PASS" ssh $SSHOPTS "$n" "mkdir -p ~/.ssh && chmod 700 ~/.ssh; [ -f ~/.ssh/id_ed25519 ] || ssh-keygen -t ed25519 -N \"\" -f ~/.ssh/id_ed25519 -C \"$u@fleet\" >/dev/null; cat ~/.ssh/id_ed25519.pub" 2>/dev/null)
  if [ -n "$pk" ]; then echo "$pk" >> "$TMP/fleet_keys"; echo "  $n OK"; OK_NODES="$OK_NODES $n"; else echo "  $n UNREACHABLE - skipped"; fi
done
sort -u "$TMP/fleet_keys" -o "$TMP/fleet_keys"
echo "== Phase 2: build alias config =="
{ echo "# fleet-keymesh generated $(date +%F) from fleet inventory"; for n in $NODES; do u=${n%@*}; h=${n#*@}; a=$(alias_of "$n"); printf "Host %s\n  HostName %s\n  User %s\n  StrictHostKeyChecking accept-new\n" "$a" "$h" "$u"; done; } > "$TMP/fleet_config"
echo "== Phase 3: distribute authorized_keys + config =="
for n in $OK_NODES; do
  sshpass -p "$PASS" scp $SSHOPTS -q "$TMP/fleet_keys" "$TMP/fleet_config" "$n:/tmp/" && \
  sshpass -p "$PASS" ssh $SSHOPTS "$n" "touch ~/.ssh/authorized_keys; sort -u ~/.ssh/authorized_keys /tmp/fleet_keys > ~/.ssh/ak.new && mv ~/.ssh/ak.new ~/.ssh/authorized_keys; chmod 600 ~/.ssh/authorized_keys; mv /tmp/fleet_config ~/.ssh/fleet_config; touch ~/.ssh/config; grep -q fleet_config ~/.ssh/config || sed -i \"1i Include ~/.ssh/fleet_config\" ~/.ssh/config; chmod 600 ~/.ssh/config; rm -f /tmp/fleet_keys" \
  && echo "  $n distributed" || echo "  $n FAILED distribute"
done
echo "== Phase 4: verify mesh from this node =="
for n in $OK_NODES; do
  a=$(alias_of "$n")
  r=$(ssh -o BatchMode=yes -o ConnectTimeout=6 "$a" "echo OK" 2>/dev/null)
  echo "  ssh $a -> ${r:-FAIL}"
done
