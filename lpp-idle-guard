#!/usr/bin/env bash
# lpp-idle-guard — ExecStartPre gate for lumen-kiosk-idle.service (wq#1021).
#
# The idle splash may hold :8871 ONLY while the live stream is NOT its owner.
# Refuse to start (non-zero) whenever lumen-pokemon-live is up or coming up, so
# the cover can never squat the product port even if something starts it out of
# band. This is the belt to the Conflicts=/After= suspenders on the live unit.
set -u
state="$(/usr/bin/systemctl show -P ActiveState lumen-pokemon-live.service 2>/dev/null)"
case "$state" in
  active|activating|reloading|deactivating)
    echo "lpp-idle-guard: lumen-pokemon-live is '$state' — it owns :8871, refusing idle start" >&2
    exit 3
    ;;
esac
exit 0
