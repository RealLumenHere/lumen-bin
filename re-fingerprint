def _iter_matches(data):
    per = []
    for idx, rx in enumerate(SIG_RES):
        n = 0
        for m in rx.finditer(data):
            per.append((m.start(), idx))
            n += 1
            if n >= 2000:  # pathological repeats (padding, tables): stop counting this signature
                break
    per.sort()
    return per


def sweep(data, base, depth, maxdepth, hits, top_format):
    for mstart, idx in _iter_matches(data):
        if len(hits) >= MAX_HITS:
            return
        _, name, kind, validator, delta = SIGS[idx]
        start = mstart - delta
        if start < 0:
            continue
        if base + start == 0 and depth == 0 and name in ("elf", "pe", "zip"):
            continue  # that's the top-level container itself
        try:
            if validator and not validator(data, start if delta == 0 else start):
                continue
        except (struct.error, IndexError):
            continue
        h = {"offset": base + start, "format": name, "kind": kind, "depth": depth, "source": "signature"}
        if name in NOISY:
            h["confidence"] = "low"
        if name == "fdt_dtb":
            h["dtb"] = parse_fdt(data, start)
        if name == "elf":
            e = parse_elf(data[start:start + 4096])
            if e:
                h["arch"], h["elf_type"] = e["arch"], e["type"]
        hits.append(h)
        if kind == "compressed" and depth < maxdepth and name in ("gzip", "xz", "lzma", "bzip2", "zstd"):
            inner = inflate(name, data[start:start + INFLATE_CAP * 2])
            if inner and len(inner) > 512:
                h["inflated_size"] = len(inner)
                h["inner_sha256"] = hashlib.sha256(inner).hexdigest()
                sub = []
                sweep(inner, 0, depth + 1, maxdepth, sub, None)
                for s in sub:
                    s["parent_offset"] = base + start
                    s["parent_format"] = name
                h["children"] = sub[:60]
                h["_inner"] = inner


def inflate(name, blob):
    try:
        if name == "gzip":
            d = zlib.decompressobj(16 + zlib.MAX_WBITS)
            return d.decompress(blob, INFLATE_CAP)
        if name in ("xz", "lzma"):
            d = lzma.LZMADecompressor(format=lzma.FORMAT_XZ if name == "xz" else lzma.FORMAT_ALONE)
            return d.decompress(blob, max_length=INFLATE_CAP)
        if name == "bzip2":
            return bz2.BZ2Decompressor().decompress(blob, max_length=INFLATE_CAP)
        if name == "zstd" and _zstd is not None:
            return _zstd.ZstdDecompressor().decompress(blob, max_length=INFLATE_CAP)
    except Exception:
        return None
    return None


def sweep_file(path, cap, maxdepth):
    hits, size = [], os.path.getsize(path)
    with open(path, "rb") as f:
        off = 0
        while off < min(size, cap) and len(hits) < MAX_HITS:
            f.seek(off)
            data = f.read(CHUNK + OVERLAP)
            if not data:
                break
            sub = []
            sweep(data, off, 0, maxdepth, sub, None)
            seen = {(h["offset"], h["format"]) for h in hits}
            hits.extend(h for h in sub if (h["offset"], h["format"]) not in seen and h["offset"] < off + CHUNK)
            off += CHUNK
    return hits, size > cap


PRINTABLE = re.compile(rb"[\x20-\x7e]{6,}")


def printable(blob):
    return b"\n".join(PRINTABLE.findall(blob))


def strings_hints(blobs):
    os_hints, vendors, misc = {}, {}, {}
    for raw in blobs:
        blob = printable(raw)
        for rx, field, value, note in STRING_HINTS:
            m = re.search(rx, blob)
            if not m:
                continue
            ver = next((g.decode("latin1") for g in m.groups() if g), None) if m.groups() else None
            if field == "os":
                os_hints.setdefault(value, {"name": value, "version": ver, "evidence": note})
            else:
                misc.setdefault(field, {"value": value or ver, "version": ver if value else None, "evidence": note})
        for rx, vendor in VENDOR_HINTS:
            ms = list(re.finditer(rx, blob))
            if not ms:
                continue
            v = vendors.setdefault(vendor, {"vendor": vendor, "matches": 0, "socs": set(), "evidence": "strings"})
            v["matches"] += len(ms)
            for m in ms[:50]:
                g = next((x for x in m.groups() if x), None) if m.groups() else None
                if g:
                    v["socs"].add(g.decode("latin1").lower())
    return os_hints, vendors, misc


def entropy_profile(path, size):
    if size == 0:
        return {"overall": 0.0, "high_entropy_ratio": 0.0, "blocks_sampled": 0}
    from collections import Counter
    blk, n = 65536, min(64, max(1, size // 65536))
    step = max(1, (size - blk) // max(1, n - 1)) if size > blk else 1
    ents = []
    with open(path, "rb") as f:
        for i in range(n):
            f.seek(min(i * step, max(0, size - blk)))
            d = f.read(blk)
            if not d:
                break
            c = Counter(d).values()
            ents.append(-sum((k / len(d)) * math.log2(k / len(d)) for k in c))
    return {"overall": round(sum(ents) / len(ents), 3) if ents else 0.0,
            "high_entropy_ratio": round(sum(1 for e in ents if e > 7.5) / len(ents), 3) if ents else 0.0,
            "blocks_sampled": len(ents)}


def run_file_cmd(path):
    if not shutil.which("file"):
        return None
    try:
        return subprocess.run(["file", "-b", path], capture_output=True, text=True, timeout=30).stdout.strip() or None
    except (subprocess.SubprocessError, OSError):
        return None


def run_binwalk(path, timeout):
    if not shutil.which("binwalk"):
        return None, "binwalk not installed"
    try:
        p = subprocess.run(["binwalk", "-B", path], capture_output=True, text=True, timeout=timeout,
                           env={**os.environ, "HOME": os.environ.get("HOME", "/tmp")})
    except subprocess.TimeoutExpired:
        return None, f"binwalk timed out after {timeout}s"
    except OSError as e:
        return None, f"binwalk failed: {e}"
    out = []
    for line in p.stdout.splitlines():
        m = re.match(r"^(\d+)\s+0x[0-9A-Fa-f]+\s+(.+)$", line)
        if m:
            out.append({"offset": int(m.group(1)), "description": m.group(2).strip()[:240], "source": "binwalk"})
    return out[:MAX_HITS], None


# ---------------------------------------------------------------- top-level classification
def classify(path, head, apk, elf, pe, macho, hits, file_desc):
    """-> (format, subformat). format uses re-route's vocabulary."""
    ext = Path(path).suffix.lower()
    if elf:
        return ("memory_dump", "elf_core") if elf.get("type") == "core" else ("ELF", elf.get("type"))
    if pe:
        return "PE", pe.get("subsystem")
    if macho:
        return "Mach-O", "fat" if macho.get("fat") else "thin"
    if apk:
        if apk["android"]:
            return "APK", None
        if apk["jar"] or ext in (".jar", ".war", ".ear"):
            return "JAR", None
    if head[:4] == b"GDPC":
        return "Godot_PCK", None
    if head[:8] == HBC_MAGIC:
        return "HBC", None
    if head[:4] == b"dex\n":
        return "DEX", None
    if ext in (".pyc", ".pyo") or (len(head) >= 4 and head[2:4] == b"\r\n" and
                                   (3000 <= struct.unpack_from("<H", head)[0] <= 4000 or
                                    62000 <= struct.unpack_from("<H", head)[0] <= 62300)):
        return "PYC", None
    if head[:4] == b"EMiL":
        return "memory_dump", "lime"
    if head[:8] in (b"PAGEDUMP", b"PAGEDU64"):
        return "memory_dump", "windows_crashdump"
    if head[:4] in (b"hibr", b"HIBR", b"wake", b"WAKE"):
        return "memory_dump", "windows_hiberfil"
    top = {h["format"] for h in hits if h["offset"] == 0}
    for name in ("rockchip_rkfw", "rockchip_rkaf", "rockchip_krnl", "android_dtbo_table", "android_boot", "android_vendor_boot", "uimage", "trx",
                 "android_sparse", "ubi", "squashfs_le", "squashfs_be", "cramfs", "fdt_dtb",
                 "intel_flash_descriptor", "rockchip_idblock_v2", "rockchip_idblock_signed"):
        if name in top:
            return "firmware", name
    if any(h["format"] == "uefi_firmware_volume" for h in hits):
        return "firmware", "uefi"
    strong = {"filesystem", "boot_image", "kernel", "device_tree", "vendor_container", "bootloader", "uefi"}
    if any(h["kind"] in strong and h.get("confidence") != "low" for h in hits):
        return "firmware", "composite"
    if any(c["kind"] in strong and c.get("confidence") != "low" for h in hits for c in h.get("children", [])):
        return "firmware", "compressed_payload"
    if ext in (".vmem", ".lime", ".mem", ".dmp", ".core", ".raw") and not hits:
        return "memory_dump", "raw"
    if ext in (".bin", ".img", ".fw", ".rom", ".dump", ".flash", ".trx", ".chk", ".ubi", ".hex"):
        return "firmware", "raw_blob"
    if file_desc and re.search(r"firmware|boot ?loader|filesystem|u-boot", file_desc, re.I):
        return "firmware", "file_magic"
    return "unknown", None


def build_conditions(fmt, arch, elf, pe, apk, data_scan, hits):
    cond = []
    if arch:
        cond.append(f"arch:{arch}")
        if arch not in ("x86", "x86_64"):
            cond.append("arch:non_x86")
    d = data_scan or b""
    go = b"go.buildinfo" in d or b".gopclntab" in d or b"runtime.main" in d or \
        bool(elf and (".gopclntab" in elf.get("sections", []) or ".go.buildinfo" in elf.get("sections", [])))
    if fmt == "ELF":
        if go:
            cond.append("go_buildinfo_section_or_pclntab")
        if b"_kDartVmSnapshotInstructions" in d or b"libflutter" in d:
            cond.append("libflutter_or_libapp_pair")
        if b"il2cpp" in d or b"global-metadata.dat" in d:
            cond.append("il2cpp_metadata_nearby")
    elif fmt in ("PE", "Mach-O"):
        if go:
            cond.append("go_buildinfo")
        if fmt == "PE":
            if b"#Strings" in d and b"BSJB" in d:
                cond.append("dotnet_metadata")
            if b"il2cpp" in d:
                cond.append("il2cpp_metadata_nearby")
            if b"GDPC" in d:
                cond.append("godot_pck_embedded")
    elif fmt == "APK" and apk:
        fw = apk["frameworks"]
        if "flutter" in fw:
            cond.append("flutter_libapp")
        if "unity_il2cpp" in fw:
            cond.append("il2cpp_metadata")
        if "hermes" in fw or any(n.endswith(".hbc") for n in apk.get("_names", [])):
            cond.append("hermes_bytecode")
        if "godot" in fw:
            cond.append("godot_pck_embedded")
        if apk["native_libs"]:
            cond.append("native_libs")
    if any(h["format"] in ("uefi_firmware_volume", "intel_flash_descriptor") for h in hits):
        cond.append("uefi_volume")
    if fmt == "firmware":
        if any(h["kind"] == "filesystem" and h.get("confidence") != "low" for h in hits):
            cond.append("embedded_filesystem")
        if any(h["kind"] == "kernel" for h in hits) or any(c["kind"] == "kernel" for h in hits for c in h.get("children", [])):
            cond.append("embedded_kernel")
        if any(h["format"] == "elf" for h in hits):
            cond.append("embedded_elf")
    return cond


def fingerprint(path, scan_cap=SCAN_CAP_DEFAULT, depth=2, use_binwalk=True, binwalk_timeout=120):
    path = os.path.abspath(path)
    size = os.path.getsize(path)
    sha, md5 = hashlib.sha256(), hashlib.md5()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            sha.update(chunk); md5.update(chunk)
    head = read_at(path, 0, 1 << 20)
    elf, pe, macho = parse_elf(head), parse_pe(head), parse_macho(head)
    apk = parse_apk(path) if head[:4] == b"PK\x03\x04" else None
    hits, truncated = sweep_file(path, scan_cap, depth)
    if apk:
        hits = [h for h in hits if h["format"] != "zip"]
        use_binwalk = False
    file_desc = run_file_cmd(path)
    bw, bw_note = run_binwalk(path, binwalk_timeout) if use_binwalk else (None, "disabled")
    fmt, sub = classify(path, head, apk, elf, pe, macho, hits, file_desc)

    scan = read_at(path, 0, STR_RE_SCAN)
    blobs = [scan] + [h.pop("_inner") for h in hits if "_inner" in h]
    for h in hits:
        for c in h.get("children", []):
            c.pop("_inner", None)
    os_h, vend, misc = strings_hints(blobs)

    arch = bits = endian = None
    if elf:
        arch, bits, endian = elf["arch"], elf["bits"], elf["endianness"]
    elif pe:
        arch, bits, endian = pe["arch"], pe["bits"], "little"
    elif macho:
        arch, bits, endian = macho.get("arch"), macho.get("bits"), macho.get("endianness")
    elif apk and apk["abis"]:
        abi_arch = {"arm64-v8a": "aarch64", "armeabi-v7a": "arm", "armeabi": "arm", "x86": "x86", "x86_64": "x86_64"}
        archs = [abi_arch.get(a, a) for a in apk["abis"]]
        arch = "aarch64" if "aarch64" in archs else archs[0]
    else:
        embedded = [h.get("arch") for h in hits if h.get("arch")] + \
                   [c.get("arch") for h in hits for c in h.get("children", []) if c.get("arch")]
        if embedded:
            arch = max(set(embedded), key=embedded.count)
        elif any(h["format"] == "linux_arm64_image" for h in hits):
            arch = "aarch64"
        elif any(h["format"] == "linux_arm_zimage" for h in hits):
            arch = "arm"

    # vendor hints: header-derived first (high confidence), then strings
    vendor_hints = []
    def add_vendor(vendor, evidence, conf, soc=None, offset=None):
        for v in vendor_hints:
            if v["vendor"] == vendor:
                if evidence not in v["evidence"]:
                    v["evidence"].append(evidence)
                v["confidence"] = max(v["confidence"], conf)
                if soc and soc not in v["socs"]:
                    v["socs"].append(soc)
                return
        vendor_hints.append({"vendor": vendor, "confidence": conf, "socs": [soc] if soc else [], "evidence": [evidence],
                             **({"offset": offset} if offset is not None else {})})
    for h in hits:
        if h["format"].startswith("rockchip_"):
            add_vendor("rockchip", f"{h['format']}@{h['offset']:#x}", 0.95 if h["offset"] == 0 else 0.8)
        elif h["format"] == "allwinner_boot0":
            add_vendor("allwinner", f"eGON.BT0@{h['offset']:#x}", 0.9)
        elif h["format"] == "intel_flash_descriptor":
            add_vendor("intel", f"flash descriptor@{h['offset']:#x}", 0.7)
        elif h["format"] == "trx":
            add_vendor("broadcom", f"TRX HDR0@{h['offset']:#x}", 0.5)
        dtb = h.get("dtb") or {}
        for comp in (dtb.get("compatible") or []):
            if "," in comp:
                add_vendor(comp.split(",")[0], f"dtb compatible '{comp}'@{h['offset']:#x}", 0.9, soc=comp.split(",")[1])
    for v in vend.values():
        conf = min(0.85, 0.3 + 0.05 * v["matches"])
        for soc in sorted(v["socs"])[:6] or [None]:
            add_vendor(v["vendor"], f"strings x{v['matches']}", round(conf, 2), soc=soc)
    vendor_hints.sort(key=lambda v: -v["confidence"])

    os_name = None
    if elf:
        os_name = "android" if (elf.get("interp") or "").startswith("/system/bin/linker") else \
            ("linux" if elf.get("interp") or elf.get("osabi") in (0, 3) else None)
    elif pe:
        os_name = "uefi" if (pe.get("subsystem") or "").startswith("efi") else "windows"
    elif macho:
        os_name = "darwin"
    elif fmt in ("APK", "DEX", "HBC"):
        os_name = "android"
    for pref in ("android", "openwrt", "linux", "zephyr", "freertos", "threadx", "vxworks", "qnx", "nuttx", "rt-thread", "esp-idf"):
        if pref in os_h and (os_name is None or (os_name == "linux" and pref in ("android", "openwrt"))):
            os_name = pref
            break

    dtbs = [h["dtb"] for h in hits if h.get("dtb")] + [c["dtb"] for h in hits for c in h.get("children", []) if c.get("dtb")]
    data_scan = scan if fmt in ("ELF", "PE", "Mach-O") else None
    conditions = build_conditions(fmt, arch, elf, pe, apk, data_scan, hits)
    ent = entropy_profile(path, size)
    warnings = []
    if truncated:
        warnings.append(f"signature sweep capped at {scan_cap} bytes of {size}")
    if ent["high_entropy_ratio"] > 0.9 and fmt in ("firmware", "unknown") and not any(h["kind"] == "compressed" for h in hits[:5]):
        warnings.append("near-uniform high entropy without a known compression header: likely encrypted/obfuscated image")
        conditions.append("likely_encrypted")
    if bw_note and use_binwalk:
        warnings.append(bw_note)

    confidence = 0.95 if fmt in ("ELF", "PE", "Mach-O", "APK", "DEX", "HBC", "JAR") else \
        0.85 if sub and sub not in ("raw_blob", "file_magic", "raw") else 0.6 if fmt != "unknown" else 0.2

    apk_out = {k: v for k, v in apk.items() if not k.startswith("_")} if apk else None
    return {
        "fingerprinter": f"re-fingerprint {VERSION}",
        "path": path, "size": size, "sha256": sha.hexdigest(), "md5": md5.hexdigest(),
        "format": fmt, "subformat": sub, "confidence": confidence,
        "file_magic": file_desc,
        "arch": arch, "bits": bits, "endianness": endian,
        "os": os_name, "os_hints": list(os_h.values()),
        "vendor_hints": vendor_hints,
        "embedded_formats": hits,
        "binwalk": bw,
        "device_trees": dtbs[:10],
        "conditions": conditions,
        "entropy": ent,
        "elf": {k: v for k, v in elf.items() if k != "sections"} | {"section_count": len(elf.get("sections", []))} if elf else None,
        "pe": pe, "macho": macho, "apk": apk_out,
        "strings_misc": misc,
        "warnings": warnings,
    }


def main():
    ap = argparse.ArgumentParser(description="RE target fingerprinter (wq#5200)")
    ap.add_argument("file")
    ap.add_argument("--scan-cap", type=int, default=SCAN_CAP_DEFAULT, help="max bytes signature-swept (default 256MiB)")
    ap.add_argument("--depth", type=int, default=2, help="recursion depth into compressed payloads (default 2)")
    ap.add_argument("--no-binwalk", action="store_true")
    ap.add_argument("--binwalk-timeout", type=int, default=120)
    ap.add_argument("--compact", action="store_true", help="single-line JSON")
    a = ap.parse_args()
    if not os.path.isfile(a.file):
        print(json.dumps({"error": f"not a file: {a.file}"}))
        sys.exit(2)
    fp = fingerprint(a.file, a.scan_cap, a.depth, not a.no_binwalk, a.binwalk_timeout)
    print(json.dumps(fp, separators=(",", ":"), default=list) if a.compact else json.dumps(fp, indent=2, default=list))


if __name__ == "__main__":
    main()
