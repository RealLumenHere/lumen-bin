def u32le(b, o=0):
    return struct.unpack_from("<I", b, o)[0]


def u32be(b, o=0):
    return struct.unpack_from(">I", b, o)[0]


def read_at(path, off, n):
    try:
        with open(path, "rb") as f:
            f.seek(off)
            return f.read(n)
    except OSError:
        return b""


# ---------------------------------------------------------------- header parsers
def parse_elf(b):
    if len(b) < 52 or b[:4] != b"\x7fELF":
        return None
    cls, data = b[4], b[5]
    e = "<" if data == 1 else ">"
    bits = 64 if cls == 2 else 32
    e_type, e_machine = struct.unpack_from(e + "HH", b, 16)
    info = {"bits": bits, "endianness": "little" if data == 1 else "big", "type": ET.get(e_type, str(e_type)),
            "machine": e_machine, "arch": EM.get(e_machine, f"em_{e_machine}"), "osabi": b[7]}
    try:
        if bits == 64:
            phoff, shoff = struct.unpack_from(e + "QQ", b, 32)
            phentsize, phnum, shentsize, shnum, shstrndx = struct.unpack_from(e + "HHHHH", b, 54)
        else:
            phoff, shoff = struct.unpack_from(e + "II", b, 28)
            phentsize, phnum, shentsize, shnum, shstrndx = struct.unpack_from(e + "HHHHH", b, 42)
        info.update(_phdr_shdr(b, e, bits, phoff, phentsize, phnum, shoff, shentsize, shnum, shstrndx))
    except struct.error:
        info["truncated_header"] = True
    return info


def _phdr_shdr(b, e, bits, phoff, phentsize, phnum, shoff, shentsize, shnum, shstrndx):
    out = {"interp": None, "sections": [], "stripped": None}
    for i in range(min(phnum, 64)):
        o = phoff + i * phentsize
        if o + phentsize > len(b):
            break
        p_type = struct.unpack_from(e + "I", b, o)[0]
        if p_type == 3:  # PT_INTERP
            if bits == 64:
                p_off, p_filesz = struct.unpack_from(e + "Q", b, o + 8)[0], struct.unpack_from(e + "Q", b, o + 32)[0]
            else:
                p_off, p_filesz = struct.unpack_from(e + "I", b, o + 4)[0], struct.unpack_from(e + "I", b, o + 16)[0]
            if p_off + p_filesz <= len(b):
                out["interp"] = b[p_off:p_off + p_filesz].rstrip(b"\0").decode("latin1")
    if shoff and shnum and shstrndx < shnum and shoff + shnum * shentsize <= len(b):
        def sh(i):
            o = shoff + i * shentsize
            if bits == 64:
                name, = struct.unpack_from(e + "I", b, o)
                off, size = struct.unpack_from(e + "QQ", b, o + 24)
            else:
                name, = struct.unpack_from(e + "I", b, o)
                off, size = struct.unpack_from(e + "II", b, o + 16)
            return name, off, size
        _, stroff, strsize = sh(shstrndx)
        strtab = b[stroff:stroff + strsize]
        names = []
        for i in range(min(shnum, 512)):
            n, _, _ = sh(i)
            end = strtab.find(b"\0", n)
            names.append(strtab[n:end if end >= 0 else None].decode("latin1"))
        out["sections"] = [n for n in names if n]
        out["stripped"] = ".symtab" not in names
    return out


def parse_pe(b):
    if len(b) < 0x40 or b[:2] != b"MZ":
        return None
    lfanew = u32le(b, 0x3C)
    if lfanew + 24 > len(b) or b[lfanew:lfanew + 4] != b"PE\0\0":
        return None
    machine, nsec = struct.unpack_from("<HH", b, lfanew + 4)
    opt_size, chars = struct.unpack_from("<HH", b, lfanew + 20)
    opt = lfanew + 24
    magic = struct.unpack_from("<H", b, opt)[0] if opt + 2 <= len(b) else 0
    info = {"machine": machine, "arch": PE_MACHINE.get(machine, f"pe_{machine:#x}"),
            "bits": 64 if magic == 0x20B else 32, "dll": bool(chars & 0x2000), "endianness": "little"}
    sub_off = opt + 68
    if sub_off + 2 <= len(b):
        info["subsystem"] = {1: "native", 2: "windows_gui", 3: "windows_cui", 10: "efi_application",
                             11: "efi_boot_driver", 12: "efi_runtime_driver"}.get(
            struct.unpack_from("<H", b, sub_off)[0], "other")
    return info


def parse_macho(b):
    if len(b) < 8:
        return None
    m = b[:4]
    if m in (b"\xfe\xed\xfa\xce", b"\xfe\xed\xfa\xcf"):
        cpu = u32be(b, 4); e = "big"
    elif m in (b"\xce\xfa\xed\xfe", b"\xcf\xfa\xed\xfe"):
        cpu = u32le(b, 4); e = "little"
    elif m == b"\xca\xfe\xba\xbe":
        n = u32be(b, 4)
        if not 0 < n < 20:  # java class files share this magic; nfat_arch is small for Mach-O
            return None
        cpus = [MACHO_CPU.get(u32be(b, 8 + 20 * i), "other") for i in range(n) if 8 + 20 * i + 4 <= len(b)]
        return {"fat": True, "arch": cpus[0] if cpus else None, "archs": cpus, "endianness": "big"}
    else:
        return None
    return {"fat": False, "arch": MACHO_CPU.get(cpu, "other"), "bits": 64 if m[3] in (0xcf, 0xfe) and m in (b"\xfe\xed\xfa\xcf", b"\xcf\xfa\xed\xfe") else 32,
            "endianness": e}


def parse_fdt(b, off=0):
    """Minimal flattened-device-tree walk: root `model` + `compatible`."""
    try:
        if b[off:off + 4] != b"\xd0\x0d\xfe\xed":
            return None
        total, o_struct, o_strings, _, version = struct.unpack_from(">IIIII", b, off + 4)
        if not (64 <= total <= 64 * 1024 * 1024) or o_struct >= total or o_strings >= total or version > 32:
            return None
        blob = b[off:off + total]
        p, depth, props = o_struct, 0, {}
        while p + 4 <= len(blob):
            tok = u32be(blob, p); p += 4
            if tok == 1:  # BEGIN_NODE
                end = blob.find(b"\0", p); p = (end + 4) & ~3; depth += 1
            elif tok == 2:
                depth -= 1
                if depth <= 0:
                    break
            elif tok == 3:
                ln, nameoff = struct.unpack_from(">II", blob, p); p += 8
                val = blob[p:p + ln]; p = (p + ln + 3) & ~3
                if depth == 1:
                    ne = blob.find(b"\0", o_strings + nameoff)
                    name = blob[o_strings + nameoff:ne].decode("latin1")
                    if name in ("model", "compatible"):
                        props[name] = [s.decode("latin1") for s in val.split(b"\0") if s]
            elif tok == 4:
                continue
            elif tok == 9:
                break
            else:
                break
        return {"total_size": total, "model": (props.get("model") or [None])[0], "compatible": props.get("compatible", [])}
    except (struct.error, ValueError):
        return None


def parse_apk(path):
    try:
        with zipfile.ZipFile(path) as zf:
            names = zf.namelist()
    except (zipfile.BadZipFile, OSError):
        return None
    info = {"entries": len(names), "android": "AndroidManifest.xml" in names, "jar": "META-INF/MANIFEST.MF" in names,
            "abis": sorted({n.split("/")[1] for n in names if n.startswith("lib/") and n.count("/") >= 2}),
            "native_libs": sorted({n.rsplit("/", 1)[-1] for n in names if n.startswith("lib/") and n.endswith(".so")})[:80],
            "dex": sum(1 for n in names if re.fullmatch(r"classes\d*\.dex", n)), "frameworks": []}
    fw = info["frameworks"]
    libs = set(info["native_libs"])
    if "libflutter.so" in libs or "libapp.so" in libs:
        fw.append("flutter")
    if "libil2cpp.so" in libs or any(n.endswith("global-metadata.dat") for n in names):
        fw.append("unity_il2cpp")
    elif "libmono.so" in libs or "libmonobdwgc-2.0.so" in libs:
        fw.append("unity_mono")
    if "libmonodroid.so" in libs or any(n.startswith("assemblies/") for n in names):
        fw.append("xamarin")
    if any(n.endswith("index.android.bundle") for n in names):
        fw.append("react_native")
        if "libhermes.so" in libs:
            fw.append("hermes")
    if any(n.endswith(".pck") for n in names) or "libgodot_android.so" in libs:
        fw.append("godot")
    if any(n.startswith("assets/www/") for n in names):
        fw.append("cordova")
    if any(n.startswith("kotlin/") for n in names):
        fw.append("kotlin")
    info["_names"] = names
    return info


# ---------------------------------------------------------------- signature sweep
def _v_squash_le(b, i):
    return len(b) >= i + 96 and 1 <= struct.unpack_from("<H", b, i + 28)[0] <= 4  # s_major
def _v_squash_be(b, i):
    return len(b) >= i + 96 and 1 <= struct.unpack_from(">H", b, i + 28)[0] <= 4
def _v_gzip(b, i):
    return len(b) > i + 10 and b[i + 3] & 0xE0 == 0 and b[i + 9] in (0, 3, 7, 11, 255)
def _v_uimage(b, i):
    return len(b) >= i + 64 and 0 < u32be(b, i + 12) < 512 * 1024 * 1024
def _v_dtb(b, i):
    return parse_fdt(b, i) is not None
def _v_elf(b, i):
    return len(b) >= i + 20 and b[i + 4] in (1, 2) and b[i + 5] in (1, 2) and b[i + 6] == 1
def _v_pe(b, i):
    if len(b) < i + 0x40:
        return False
    lf = u32le(b, i + 0x3C)
    return lf < 4096 and b[i + lf:i + lf + 4] == b"PE\0\0"
def _v_lzma(b, i):
    if len(b) < i + 13:
        return False
    dsize = struct.unpack_from("<Q", b, i + 5)[0]
    return dsize == 0xFFFFFFFFFFFFFFFF or 0 < dsize < 1 << 32
def _v_zimage(b, i):  # matched at magic offset 0x24
    return True
def _v_jffs2(b, i):
    return len(b) >= i + 12 and u32le(b, i + 4) < 1 << 24
def _v_krnl(b, i):
    return len(b) >= i + 12 and 0 < u32le(b, i + 4) < 512 * 1024 * 1024


def _v_ext(b, i):
    sb = i + 0x400  # superblock; magic sits at sb+0x38
    if len(b) < sb + 0x60:
        return False
    log_bs, = struct.unpack_from("<I", b, sb + 24)
    state, = struct.unpack_from("<H", b, sb + 0x3A)
    rev, = struct.unpack_from("<I", b, sb + 0x4C)
    inodes, blocks = struct.unpack_from("<II", b, sb)
    return log_bs <= 6 and state in (1, 2, 3) and rev <= 1 and 0 < inodes <= blocks * 64 and blocks > 0


