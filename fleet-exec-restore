#!/usr/bin/env python3
"""fleet-exec-restore <node> <unit> — the restore-cmd half of the broker's
stop/restore contract (BROKER_WIRING.md §2.4.2).

Lumen-only, and deliberately NOT a worker tool: it is the command the self-healer
runs when a `<unit>@<node>` holddown flag EXPIRES, so it takes no grant and is never
reachable from a worker's Bash allowlist. Its whole job is the one thing the healer
cannot do from Lumen — reach across ssh and start a unit that lives on another node:

    ssh <node> -- sudo -n systemctl start <unit>

Why it exists at all: `/home/lumen/bin/holddown` only exists on Lumen, so a holddown
for a remote unit has to be registered here, which means its restore path has to be
here too. Without this helper an expired flag would run Lumen's local `systemctl
start <unit>` against a unit Lumen does not have.

Refusals (fail closed, exit 2): thor is never touched (instinct tier 0 #1, the same
THOR_HARDLOCK the broker's policy module enforces), and node/unit must be plain
tokens — no shell metacharacters ever reach ssh.
"""
import os
import re
import shlex
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import fleet_exec_policy as P

SSH_KEY = os.environ.get("FLEET_EXEC_SSH_KEY", "/home/lumen/.ssh/id_ed25519")
CONNECT_TIMEOUT_S = 10
TIMEOUT_S = 90
_TOKEN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._@:-]*$")


def die(msg, code=2):
    print(f"fleet-exec-restore: {msg}", file=sys.stderr)
    sys.exit(code)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) != 2:
        die("usage: fleet-exec-restore <node> <unit>")
    node, unit = argv
    if not _TOKEN_RE.match(node):
        die(f"node {node!r} is not a plain token")
    if not _TOKEN_RE.match(unit):
        die(f"unit {unit!r} is not a plain token")
    if node in P.THOR_HARDLOCK:
        die("thor is never touched by the broker or its restore path")
    if node == "lumen":
        cmd = ["sudo", "-n", "systemctl", "start", unit]
    else:
        cmd = ["ssh", "-i", SSH_KEY, "-o", "BatchMode=yes",
               "-o", f"ConnectTimeout={CONNECT_TIMEOUT_S}",
               "-o", "StrictHostKeyChecking=accept-new", node, "--",
               *[shlex.quote(a) for a in ("sudo", "-n", "systemctl", "start", unit)]]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        die(f"could not reach {node}: {e}")
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    if p.returncode != 0:
        die(f"`systemctl start {unit}` on {node} exited {p.returncode}", code=1)
    print(f"fleet-exec-restore: started {unit} on {node}")


if __name__ == "__main__":
    main()
