#!/usr/bin/env python3
"""litellm-completion-probe (wq#3169) — send one real chat completion per
api_base host in litellm_config.yaml, so a dead rung or a key/quota failure
pages before a real request hits it, instead of only after.

WHY THIS EXISTS: lumen-model-check (wq#2903-era) only checks that a model ID
is present in /v1/models — it never sends a completion. That misses a rung
whose api_base is unreachable, whose upstream key expired, or whose quota is
exhausted; those stay invisible until a live caller gets the failure. This
is the completion-level probe that was missing, productionized from the
one-shot audit script at /home/lumen/scratch/audit_20260929/probe2.py.

DESIGN:
  - ONE model probed per api_base host (not every model — a dead host fails
    every model on it identically, so probing more just burns quota).
  - Embed/rerank/whisper/tts deployments are skipped: chat completions is
    the wrong call shape for them.
  - Authenticates with the model-watchdog service key (0600 file), used only
    in the Authorization header, never printed or logged (instinct 4).
  - A gateway that rejects the probe's own key is ONE probe-key row, not a
    row per host (wq#3736).
  - Edge-triggered alerting, same contract as litellm-auth-alert (wq#911)
    and health_check_failure_alert (wq#1295): aq add + urgent ntfy on
    clear->breach, aq bump (no re-ntfy) while the breach persists, low-pri
    ntfy on breach->clear. Constant re-alerting trains you to ignore pages.
  - Nothing is printed on a normal run; --print emits a one-line summary
    (for manual/test invocation).

Deploy: see install.sh (script -> /home/lumen/bin, units -> systemd, timer
runs this every 30 min). The .service's ExecStartPost writes the
lumen-cron-stamp dead-man's-switch file so a stopped timer alarms sideways
via lumen-cron-deadman instead of silently going stale.
"""
import argparse
import concurrent.futures as cf
import json
import os
import pathlib
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

# wq#3212: rung enumeration moved to the shared litellm_rungs module so this
# probe and lumen-model-watchdog read the SAME rung list (deployed next to
# this script in /home/lumen/bin; in-repo at ops/wq3212-litellm-dead-rungs/).
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import litellm_rungs

# wq#3736: the master key is retired for non-admin routes (wq#914), so reading
# LITELLM_MASTER_KEY got a 401 on every host from 2026-10-07 22:06 and the probe
# filed it as 12 "unreachable" rows. Same key lumen-model-check moved to (wq#3681).
KEY_PATH = os.environ.get("LITELLM_COMPLETION_PROBE_KEY_FILE",
                          "/home/lumen/.secrets/litellm-service-keys/model-watchdog.key")
CONFIG_PATH = os.environ.get("LITELLM_COMPLETION_PROBE_CONFIG", "/home/lumen/agent/litellm_config.yaml")
GATEWAY_URL = os.environ.get("LITELLM_COMPLETION_PROBE_URL", "http://localhost:4000/v1/chat/completions")
MODELS_URL = os.environ.get("LITELLM_COMPLETION_PROBE_MODELS_URL", "http://localhost:4000/v1/models")
PROBE_KEY_HOST = "probe-key"
STATE_DIR = pathlib.Path(os.environ.get("LITELLM_COMPLETION_PROBE_STATE_DIR", "/home/lumen/agents/litellm-completion-probe"))
NTFY = os.environ.get("LITELLM_COMPLETION_PROBE_NTFY", "/home/lumen/bin/ntfy-send")
NTFY_TOPIC = os.environ.get("LITELLM_COMPLETION_PROBE_TOPIC", "lumen-alerts")
AQ = os.environ.get("LITELLM_COMPLETION_PROBE_AQ", "/home/lumen/bin/aq")
TIMEOUT_S = int(os.environ.get("LITELLM_COMPLETION_PROBE_TIMEOUT_S", "60"))
# wq#3463: a rung configured with a longer litellm timeout gets that budget, up
# to this cap. A flat 60s paged nephthys (timeout 2460, CPU-only qwen3:14b cold
# load) "unreachable" on ~92% of runs while real callers were being served.
TIMEOUT_CAP_S = int(os.environ.get("LITELLM_COMPLETION_PROBE_TIMEOUT_CAP_S", "300"))
MAX_TOKENS = int(os.environ.get("LITELLM_COMPLETION_PROBE_MAX_TOKENS", "300"))
WORKERS = int(os.environ.get("LITELLM_COMPLETION_PROBE_WORKERS", "6"))
AQ_DIR = os.environ.get("LITELLM_COMPLETION_PROBE_AQ_DIR", "/home/lumen/agents/alert-queue")
# wq#3587: a free-tier daily request quota is a budget the probe itself spends.
# gemini-2.5-flash free tier allows 20 requests/day and the 30-min timer sends
# 48, so the probe alone exhausted it, then paged its own 429 as "unreachable"
# (aq 2652505). Format: host=seconds[,host=seconds].
HOST_MIN_INTERVAL_S = {
    h: int(s) for h, _, s in (p.partition("=") for p in os.environ.get(
        "LITELLM_COMPLETION_PROBE_HOST_INTERVALS", "gemini=21600").split(",") if "=" in p)}
RATE_LIMIT_BACKOFF_S = 3600     # 429 without a "retry in" hint
RATE_LIMIT_BACKOFF_CAP_S = 86400
RETRY_HINT = re.compile(r"retry in ((?:\d+h)?(?:\d+m)?(?:[\d.]+s)?)", re.I)
BILLING = re.compile(r"insufficient.balance|insufficient_quota|credit balance", re.I)

Rung = litellm_rungs.Rung
one_rung_per_host = litellm_rungs.one_rung_per_host


def read_service_key(path: str) -> str:
    key = pathlib.Path(path).read_text().strip()
    if not key:
        raise RuntimeError("empty service key file " + path)
    return key


def check_probe_key(key_path: str) -> tuple:
    """(key, None) when the gateway accepts our key, else (None, failure result).
    A rejected or unreadable key would fail every host identically, so it is
    reported once under PROBE_KEY_HOST and the host probes are skipped."""
    fail = {"host": PROBE_KEY_HOST, "model": "-", "ok": False, "kind": "auth", "elapsed_s": 0.0}
    try:
        key = read_service_key(key_path)
    except Exception as e:  # noqa: BLE001
        return None, {**fail, "reason": f"service key unreadable: {type(e).__name__} {key_path}"}
    req = urllib.request.Request(MODELS_URL, headers={"Authorization": "Bearer " + key})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT_S):
            return key, None
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            body = ""
            try:
                body = e.read().decode()
            except Exception:
                pass
            return None, {**fail, "reason": (f"gateway rejected probe key: {e} {body[:200]}").replace("\n", " ")}
        return key, None
    except Exception:
        # gateway down is not a key problem: let the host probes report it
        return key, None


def probe_budget_s(rung: Rung) -> float:
    """Never stricter than the floor, never longer than the cap, otherwise the
    rung's own configured timeout — the probe must not call "unreachable" a rung
    the gateway itself would still be waiting on for a real caller."""
    return max(TIMEOUT_S, min(rung.timeout or TIMEOUT_S, TIMEOUT_CAP_S))


def retry_after_s(text: str) -> int:
    """Seconds from a provider's "Please retry in 10h20m19.5s" hint, else the
    default backoff; capped so a garbled hint can't park a host for days."""
    m = RETRY_HINT.search(text)
    secs = 0.0
    for num, unit in re.findall(r"([\d.]+)([hms])", m.group(1) if m else ""):
        secs += float(num) * {"h": 3600, "m": 60, "s": 1}[unit]
    return min(int(secs) or RATE_LIMIT_BACKOFF_S, RATE_LIMIT_BACKOFF_CAP_S)


def classify(code, text: str) -> str:
    """wq#3587: a 402/429 is an authenticated answer about the account, not a
    dead host. billing = out of credit (aq 3198: deepseek "Insufficient
    Balance", x135 over 6 days while the top-up sat queued as wq#3410);
    rate_limited = quota spent, comes back by itself."""
    if code == 402 or BILLING.search(text):
        return "billing"
    if code == 429:
        return "rate_limited"
    return "unreachable"


def probe_one(key: str, rung: Rung) -> dict:
    body = json.dumps({
        "model": rung.model_name,
        "messages": [{"role": "user", "content": "Reply with the single word: pong"}],
        "max_tokens": MAX_TOKENS,
    }).encode()
    req = urllib.request.Request(
        GATEWAY_URL, body,
        {"Authorization": "Bearer " + key, "Content-Type": "application/json"},
    )
    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=probe_budget_s(rung)) as resp:
            json.load(resp)
        return {"host": rung.host, "model": rung.model_name, "ok": True, "kind": "ok",
                "elapsed_s": round(time.time() - t0, 1), "reason": ""}
    except Exception as e:  # noqa: BLE001 - report any failure shape as a probe FAIL
        body = ""
        try:
            body = e.read().decode()  # type: ignore[attr-defined]
        except Exception:
            pass
        kind = classify(getattr(e, "code", None), body)
        reason = (str(e)[:120] + " " + body[:200]).strip().replace("\n", " ")
        result = {"host": rung.host, "model": rung.model_name, "ok": False, "kind": kind,
                  "elapsed_s": round(time.time() - t0, 1), "reason": reason}
        if kind == "rate_limited":
            result["retry_s"] = retry_after_s(body)
        return result


def run_probes(key: str, rungs: list) -> list:
    with cf.ThreadPoolExecutor(WORKERS) as ex:
        return [f.result() for f in cf.as_completed([ex.submit(probe_one, key, r) for r in rungs])]


def _state_path() -> pathlib.Path:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    return STATE_DIR / "state.json"


def _load_state(path: pathlib.Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def _notify(priority: str, title: str, message: str) -> None:
    if not os.path.exists(NTFY):
        return
    try:
        subprocess.run([NTFY, "-t", NTFY_TOPIC, "-p", priority, "-T", title, "--quiet", message],
                        timeout=15, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def _aq_add(key: str, title: str, message: str) -> None:
    if not os.path.exists(AQ):
        return
    try:
        subprocess.run([AQ, "add", "litellm-completion", key, title, message],
                        timeout=15, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def _aq_has_open(key: str) -> bool:
    """False when the db can't be read, so the caller falls back to aq add."""
    try:
        if AQ_DIR not in sys.path:
            sys.path.insert(0, AQ_DIR)
        import aq as _aq
        c = _aq.db()
        row = c.execute("SELECT 1 FROM alerts WHERE source='litellm-completion' "
                        "AND key=? AND status IN ('open','acked')", (key,)).fetchone()
        c.close()
        return row is not None
    except Exception:
        return False


def _aq_resolve(key: str, why: str) -> None:
    """wq#3212: close our own open row on a recovery edge or when the host left
    the probe set (rung removed from litellm_config.yaml). Without this, a row
    for a removed rung stayed open forever — no probe result ever cleared it.
    Same direct-db shape as lumen_model_watchdog.aq_clear (wq#548 pattern).
    wq#3463: acked rows close too — an acked row still counts against the
    source in sentinel-watch, and aq dedups only onto OPEN rows, so acking one
    just forked the next failure into a fresh row (aq 3140 -> 2671109)."""
    try:
        if AQ_DIR not in sys.path:
            sys.path.insert(0, AQ_DIR)
        import aq as _aq
        c = _aq.db()
        ts = _aq.now()
        rows = c.execute("SELECT id FROM alerts WHERE source='litellm-completion' "
                         "AND key=? AND status IN ('open','acked')", (key,)).fetchall()
        for (rid,) in rows:
            c.execute("UPDATE alerts SET status='resolved', note=?, resolved_ts=? "
                      "WHERE id=? AND status IN ('open','acked')",
                      (f"auto-cleared: {why} on {ts} probe run", ts, rid))
        c.commit()
        c.close()
    except Exception:
        pass


def _answered(r: dict) -> bool:
    # a 429 is the host up and authenticated, only out of quota for now
    return r["ok"] or r.get("kind") == "rate_limited"


def due_rungs(rungs: list, state: dict, now: float) -> tuple:
    """(rungs to probe now, hosts skipped this run). A host is skipped while a
    429 backoff runs or inside its HOST_MIN_INTERVAL_S since the last probe."""
    due, skipped = [], set()
    for r in rungs:
        prev = state.get(r.host, {})
        if (now < prev.get("skip_until", 0)
                or now - prev.get("checked_at", 0) < HOST_MIN_INTERVAL_S.get(r.host, 0)):
            skipped.add(r.host)
        else:
            due.append(r)
    return due, skipped


def apply_results(results: list, skipped: set = frozenset()) -> dict:
    """Edge-triggered aq/ntfy: alert once per host on clear->breach, bump
    (no re-ntfy) while breached, low-pri notice on breach->clear. A billing
    failure keeps one open row without bumping it: the count can't change
    until someone tops up, and the bumps tripped sentinel-watch's 100-repeat
    floor into a ticket nobody could fix (wq#3587). Skipped hosts carry their
    state forward. Returns the new state dict (caller persists it)."""
    path = _state_path()
    state = _load_state(path)
    now = int(time.time())
    now_failed = {r["host"]: r for r in results if not _answered(r)}
    for host, r in now_failed.items():
        was_failed = state.get(host, {}).get("failed", False)
        billing = r.get("kind") == "billing"
        if r.get("kind") == "auth":
            title = "LiteLLM completion probe: gateway rejected the probe's own key"
        else:
            title = f"LiteLLM completion probe: {host} " + ("out of credit" if billing else "unreachable")
        msg = f"model={r['model']} elapsed={r['elapsed_s']}s reason={r['reason']}"
        if not (billing and _aq_has_open(host)):
            _aq_add(host, title, msg)
        if not was_failed:
            _notify("urgent", title, msg)
    for r in results:
        host = r["host"]
        if not _answered(r):
            continue
        if state.get(host, {}).get("failed", False):
            _notify("low", f"LiteLLM completion probe: {host} recovered",
                     f"model={r['model']} elapsed={r['elapsed_s']}s")
        # wq#3463: every passing host closes its rows, not only on the state
        # edge — a lost/rewritten state.json used to strand rows open forever
        _aq_resolve(host, f"{host} answered (model={r['model']})")
    probed_hosts = {r["host"] for r in results}
    for host, prev in state.items():
        # wq#3212: rung removed from litellm_config.yaml while its row was open
        if host not in probed_hosts and host not in skipped and prev.get("failed", False):
            _aq_resolve(host, f"{host} left the probe set (rung removed from config)")
    new_state = {h: state[h] for h in skipped if h in state}
    for r in results:
        new_state[r["host"]] = {"failed": not _answered(r), "checked_at": now}
        if r.get("kind") == "rate_limited":
            new_state[r["host"]]["skip_until"] = now + r["retry_s"]
    return new_state


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--print", action="store_true", dest="do_print")
    args = parser.parse_args()

    rungs, skipped = due_rungs(one_rung_per_host(CONFIG_PATH), _load_state(_state_path()), time.time())
    key, key_failure = check_probe_key(KEY_PATH)
    if key_failure:
        # host state and rows carry forward untouched: nothing was learned about them
        results = [key_failure]
        skipped = skipped | {r.host for r in rungs}
    else:
        results = run_probes(key, rungs) + [
            {"host": PROBE_KEY_HOST, "model": "-", "ok": True, "kind": "ok", "elapsed_s": 0.0, "reason": ""}]
    new_state = apply_results(results, skipped)
    path = _state_path()
    try:
        path.write_text(json.dumps(new_state))
    except Exception:
        pass

    if args.do_print:
        fails = [r for r in results if not r["ok"]]
        print(f"probed {len(results)} hosts ({len(skipped)} skipped), {len(fails)} failing: "
              + ",".join(f"{r['host']}({r['kind']})" for r in fails))
    return 0


if __name__ == "__main__":
    sys.exit(main())
