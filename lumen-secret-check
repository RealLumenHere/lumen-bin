#!/usr/bin/env bash
# lumen-secret-check: catch embedded PATs in git remote URLs (the .git/config class default gitleaks
# misses) across all fleet repos, plus gitleaks if installed. Read-only, transition-based, stamped.
set -uo pipefail
exec 9>/tmp/lumen-secret-check.lock; flock -n 9 || exit 0
STAMP=/home/lumen/logs/.secret-check.laststate; mkdir -p /home/lumen/logs
FOUND=""
while read -r g; do
  d=${g%/.git}
  hit=$(git --git-dir="$g" config --get-regexp 'remote\..*\.url' 2>/dev/null | grep -oE '(ghp_|github_pat_|gho_|ghs_|glpat-)[A-Za-z0-9_-]+' | head -1)
  [ -n "$hit" ] && FOUND="$FOUND ${d}"
done < <(find /home/lumen -maxdepth 4 -name .git -type d 2>/dev/null | grep -v node_modules)
# wq#4599: secret-bearing backups past their expiry (.bak.*, gate-snapshot pre-images). Offline and read-only; the
# secret-backup-sweep timer decides what is provably dead and shreds it. This only keeps the count visible, at normal
# priority: overdue backups are hygiene debt, not a live leak, so they must not page like a PAT in a remote URL.
BKFOUND=""
BKN=$(/home/lumen/bin/secret-backup-sweep scan 2>/dev/null | sed -n 's/.*overdue=\([0-9][0-9]*\).*/\1/p')
[ "${BKN:-0}" -gt 0 ] && BKFOUND=" backups-overdue=${BKN}"
touch /home/lumen/logs/.stamp.secret-check
ALL="${FOUND}${BKFOUND}"
if [ -n "$ALL" ] && [ "$ALL" != "$(cat "$STAMP" 2>/dev/null)" ]; then
  if [ -n "$FOUND" ]; then PRI=high; TTL="secret leak"; else PRI=default; TTL="secret backups overdue"; fi
  /home/lumen/bin/ntfy-send -p "$PRI" -T "$TTL" "PAT embedded in git remote URL / overdue secret backups:${ALL}" 2>/dev/null || true
fi
echo "$ALL" > "$STAMP"
echo "secret-check: embedded-PAT repos=[${FOUND:-none}] backups_overdue=${BKN:-0}"
