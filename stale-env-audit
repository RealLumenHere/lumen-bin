#!/usr/bin/env python3
"""stale-env-audit - running services whose process environment differs from their
current EnvironmentFile (read-only; prints unit and VARIABLE NAMES, never values).

WHY (wq#3211, 2026-09-30): the Langfuse key rotation changed agent/.env but four
long-running units (messenger, two fleet researchers, n8n-watcher) kept the old key in
their process environment for two days, so their traces were silently dropped. A rotation
that does not restart its consumers is invisible from the file side. This compares what
each process actually holds (/proc/<pid>/environ) with what its EnvironmentFile says now.

  stale-env-audit            report, exit 0 clean / 1 drift / 2 could not read anything
  stale-env-audit --json     machine-readable
Run it as root (sudo) to cover units that run under another uid; as lumen it only sees
lumen-owned processes and says how many it could not read.

Ignored on purpose: variables whose file value is empty (systemd never exports them, e.g.
ssh.service SSHD_OPTS=).
"""
import json, os, re, shlex, subprocess, sys


def sh(*a):
    return subprocess.run(a, capture_output=True, text=True).stdout


def parse_envfile(path):
    """systemd EnvironmentFile subset: KEY=VALUE, # and ; comments, one layer of quotes.
    None when the file cannot be read."""
    out = {}
    try:
        with open(path, errors="replace") as f:
            for line in f:
                s = line.strip()
                if not s or s[0] in "#;" or "=" not in s:
                    continue
                k, v = s.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        return None
    return out


def find_drift(proc_env, expected):
    """-> (differs, missing) as sorted VARIABLE NAMES. Empty file values are not expected
    in the process (systemd drops them), so they never count as missing."""
    differs = sorted(k for k, v in expected.items() if v != "" and k in proc_env and proc_env[k] != v)
    missing = sorted(k for k, v in expected.items() if v != "" and k not in proc_env)
    return differs, missing


def audit():
    rows, clean, unreadable = [], 0, 0
    units = [l.split()[0] for l in sh("systemctl", "list-units", "--type=service", "--state=running",
                                     "--no-legend", "--no-pager").splitlines() if l.strip()]
    for u in units:
        pid = sh("systemctl", "show", u, "-p", "MainPID", "--value").strip()
        if not pid.isdigit() or pid == "0":
            continue
        efs = []
        for line in sh("systemctl", "show", u, "-p", "EnvironmentFiles", "--value").splitlines():
            m = re.match(r"^(\S+)\s*(\(.*\))?$", line.strip())
            if m:
                efs.append(m.group(1).lstrip("-"))
        if not efs:
            continue
        try:
            raw = open("/proc/%s/environ" % pid, "rb").read().decode("utf-8", "replace")
            started = os.stat("/proc/%s" % pid).st_mtime
        except OSError:
            unreadable += 1
            continue
        proc_env = dict(kv.split("=", 1) for kv in raw.split("\0") if "=" in kv)
        expected, src = {}, {}
        for f in efs:
            d = parse_envfile(f)
            for k, v in (d or {}).items():
                expected[k], src[k] = v, f
        differs, missing = find_drift(proc_env, expected)
        if not (differs or missing):
            clean += 1
            continue
        try:
            inline = {kv.split("=", 1)[0] for kv in shlex.split(sh("systemctl", "show", u, "-p", "Environment", "--value")) if "=" in kv}
        except ValueError:
            inline = set()
        rows.append({"unit": u, "differs": differs, "missing": missing,
                     "file_newer_than_process": sorted({os.path.basename(src[k]) for k in differs + missing
                                                        if os.path.getmtime(src[k]) > started}),
                     "also_set_inline": sorted(set(differs) & inline)})
    return {"clean": clean, "drift": rows, "unreadable": unreadable}


def main(argv):
    res = audit()
    if "--json" in argv:
        print(json.dumps(res, indent=2))
    else:
        print("stale-env-audit: %d clean, %d with drift, %d not readable (other uid; run with sudo)"
              % (res["clean"], len(res["drift"]), res["unreadable"]))
        for r in res["drift"]:
            print("- %s" % r["unit"])
            if r["differs"]:
                print("    process value differs from file: %s" % ", ".join(r["differs"]))
            if r["missing"]:
                print("    in file but not in process: %s" % ", ".join(r["missing"]))
            print("    file newer than process: %s" % (", ".join(r["file_newer_than_process"]) or "no"))
            if r["also_set_inline"]:
                print("    also set via Environment= (may be an intentional override): %s" % ", ".join(r["also_set_inline"]))
    if res["clean"] == 0 and not res["drift"]:
        return 2
    return 1 if res["drift"] else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
