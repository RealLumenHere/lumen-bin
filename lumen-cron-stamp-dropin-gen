#!/usr/bin/env python3
"""lumen-cron-stamp-dropin-gen — universal timer dead-man via auto
cron-stamp drop-in (wq#1658).

cron_deadman.py (wq#1184) alerts on stale /home/lumen/logs/.stamp.<unit>
files, but coverage is opt-in: as of wq#1627's fleet atlas, only 11 of 118
fleet timers had a service wired with
`ExecStartPost=-/home/lumen/bin/lumen-cron-stamp %n`. The other 107
(backups, vault HA monitor, sentinel-probes, model-watchdog, every drift
guard) produce silence, not failure, if their timer is stopped, masked, or
lost to a unit-drift apply — nobody notices.

This script makes the stamp automatic: for every *fleet-authored* timer
unit (a real file directly under /etc/systemd/system, not a distro/symlinked
one — same test unit-drift's scan() uses), it resolves the service the
timer activates and, unless that service already has cron-stamp coverage or
carries the opt-out tag, generates
`/etc/systemd/system/<service>.service.d/99-cron-stamp.conf` with the same
`ExecStartPost=-` line the 11 hand-wired units already use. Opting OUT is
now the exception: add a `# lumen-cron-stamp: opt-out` comment line to the
service unit's [Service] section and re-run.

cron_deadman.py already derives each unit's expected cadence from
`systemctl list-timers`, so once a drop-in lands, coverage for that unit is
total with no cron_deadman changes needed.

Usage:
  lumen_cron_stamp_dropin_gen.py plan            # dry-run report (default)
  lumen_cron_stamp_dropin_gen.py apply           # write missing drop-ins + daemon-reload
  lumen_cron_stamp_dropin_gen.py apply --dry-run # same report, explicit

Wired into `unit-drift snapshot` (wq#1041) at the top of cmd_snapshot(), so
every baseline snapshot also closes any new dead-man coverage gap before it
captures the baseline — see ops/wq1658-cron-stamp-dropin/README.md.
"""
import argparse
import os
import re
import subprocess
import sys

SYS = "/etc/systemd/system"
STAMP_BIN = "/home/lumen/bin/lumen-cron-stamp"
DROPIN_NAME = "99-cron-stamp.conf"
OPTOUT_RE = re.compile(r"^\s*#\s*lumen-cron-stamp:\s*opt-out\s*$", re.I | re.M)
UNIT_LINE_RE = re.compile(r"^\s*Unit\s*=\s*(\S+)\s*$", re.M)
DROPIN_TEMPLATE = (
    "# generated by lumen-cron-stamp-dropin-gen (wq#1658) — dead-man stamp\n"
    "# for cron_deadman.py (wq#1184). Opt out: add a\n"
    "# `# lumen-cron-stamp: opt-out` line to this unit's [Service] section\n"
    "# and re-run `unit-drift snapshot` (or this script directly).\n"
    "[Service]\n"
    "ExecStartPost=-%s %%n\n" % STAMP_BIN
)


def read_text(path):
    try:
        with open(path, "r") as f:
            return f.read()
    except PermissionError:
        r = subprocess.run(["sudo", "cat", path], capture_output=True, text=True)
        return r.stdout if r.returncode == 0 else ""
    except FileNotFoundError:
        return None


def fleet_timers():
    """Real (non-symlink) *.timer files directly under SYS — fleet-authored,
    same placement test unit-drift's scan() applies to distinguish those
    from distro units pulled in only via a .wants/ enablement symlink."""
    out = []
    for name in sorted(os.listdir(SYS)):
        full = os.path.join(SYS, name)
        if name.endswith(".timer") and os.path.isfile(full) and not os.path.islink(full):
            out.append(name)
    return out


def resolve_service(timer_name, timer_text):
    m = UNIT_LINE_RE.search(timer_text)
    if m:
        return m.group(1)
    return timer_name[: -len(".timer")] + ".service"


def already_covered(service_name, service_text):
    if "lumen-cron-stamp" in service_text:
        return True
    dropin_dir = os.path.join(SYS, service_name + ".d")
    if os.path.isdir(dropin_dir):
        for conf in os.listdir(dropin_dir):
            text = read_text(os.path.join(dropin_dir, conf)) or ""
            if "lumen-cron-stamp" in text:
                return True
    return False


def plan():
    """Returns (generate: list[(service_name, dropin_path)], skipped: dict[str, list[str]])."""
    generate = []
    skipped = {"opted-out": [], "already-covered": [], "service-missing": []}
    for timer_name in fleet_timers():
        timer_text = read_text(os.path.join(SYS, timer_name)) or ""
        service_name = resolve_service(timer_name, timer_text)
        service_path = os.path.join(SYS, service_name)
        service_text = read_text(service_path)
        if service_text is None:
            skipped["service-missing"].append(service_name)
            continue
        if OPTOUT_RE.search(service_text) or OPTOUT_RE.search(timer_text):
            skipped["opted-out"].append(service_name)
            continue
        if already_covered(service_name, service_text):
            skipped["already-covered"].append(service_name)
            continue
        dropin_path = os.path.join(SYS, service_name + ".d", DROPIN_NAME)
        generate.append((service_name, dropin_path))
    return generate, skipped


def write_dropin(dropin_path):
    dropin_dir = os.path.dirname(dropin_path)
    try:
        os.makedirs(dropin_dir, exist_ok=True)
        with open(dropin_path, "w") as f:
            f.write(DROPIN_TEMPLATE)
        return True
    except PermissionError:
        r = subprocess.run(["sudo", "mkdir", "-p", dropin_dir])
        if r.returncode != 0:
            return False
        r = subprocess.run(["sudo", "tee", dropin_path], input=DROPIN_TEMPLATE,
                            capture_output=True, text=True)
        return r.returncode == 0


def report(generate, skipped):
    print("lumen-cron-stamp-dropin-gen (wq#1658):")
    print("  %d fleet timer(s) scanned" % (
        len(generate) + sum(len(v) for v in skipped.values())))
    print("  %d already covered, %d opted out, %d service file missing" % (
        len(skipped["already-covered"]), len(skipped["opted-out"]),
        len(skipped["service-missing"])))
    if generate:
        print("  %d uncovered — would generate:" % len(generate))
        for service_name, dropin_path in generate:
            print("    %s -> %s" % (service_name, dropin_path))
    else:
        print("  0 uncovered — dead-man coverage is total")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                  formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.set_defaults(cmd="plan", dry_run=False)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("plan", help="dry-run report (default)")
    ap_apply = sub.add_parser("apply", help="write missing drop-ins + daemon-reload")
    ap_apply.add_argument("--dry-run", action="store_true",
                           help="report only, same as `plan`")
    args = ap.parse_args()

    generate, skipped = plan()
    report(generate, skipped)

    if args.cmd == "apply" and not args.dry_run:
        written = []
        for service_name, dropin_path in generate:
            if write_dropin(dropin_path):
                written.append(service_name)
            else:
                print("  FAILED to write drop-in for %s" % service_name, file=sys.stderr)
        if written:
            subprocess.run(["systemctl", "daemon-reload"])
            print("  applied %d drop-in(s), ran daemon-reload" % len(written))
        return 0 if len(written) == len(generate) else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
