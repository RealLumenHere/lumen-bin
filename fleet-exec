#!/usr/bin/env python3
"""fleet-exec — the ONE broker a worker gets for fleet execution (wq#1332,
foreman/research/WORKER_EXEC_CAPABILITY_GAP.md §2.4).

  fleet-exec run     <node> -- <cmd> [args...]
  fleet-exec copy    <node> <local-path> <remote-dir>
  fleet-exec restart <node> <unit> [restart|reload|start]   # default: restart
  fleet-exec peer    <node> <name> [--timeout SEC]          # wq#3200 fixed-argv exec
  fleet-exec grant                                          # print this worker's grant

v1 verbs: run, copy, restart, peer. sudo/bench/power are v2 (fleet_exec_policy.py
already has their check_* functions so the policy matrix is provable now; this CLI
just doesn't expose the subcommands yet).

peer (wq#3200) is the one reviewed path to START a process on a second node: it
executes EXACTLY policy.peer_cmds[<node>][<name>].argv — worker argv never reaches
the remote node — and only after the entry-point file's sha256sum on the node
matches the sha256 pinned in the policy entry. A replaced/tampered entry point is
a deny before anything runs.

Every verb: (1) grant file present/readable/sha256 matches FOREMAN_GRANT_SHA/not
expired/ticket matches WQ_AGENT's claim; (2) node is a known fleet subject; (3)
node+verb present in the grant; (4) node+verb+argv permitted by the static policy
(fleet-exec-policy.yaml) — argv is shlex-parsed by the CALLER's shell (Claude Code's
Bash tool), never re-joined into a string here; (5) restart only: the unit is read
BEFORE the action (LoadState must be `loaded`), passwordless sudo is prechecked, a
holddown is registered ON LUMEN, and the unit is polled back to `active` AFTER;
(6) execute over ssh, BatchMode, one audit line before and one after. Any doubt at
any step is a DENY, exit 2, reason on stderr — this script has no `--` escape into
`bash -c` anywhere in its own logic.

Privilege (design BROKER_WIRING.md §2.4.1): the only sudo this broker ever emits is
the literal `sudo -n ...` built here, never worker argv. `never.sudo_argv_deny` still
governs the (unshipped) v2 `sudo` verb; this is not that verb.

Rollback (design §5.1/5.3): remove the `Bash(/home/lumen/bin/fleet-exec *)` allow
rule from worker-settings.json/base.json (workers can no longer invoke this at
all) and/or `chmod 000` fleet-exec-policy.yaml (every call then denies with
rule=policy_unreadable — fleet_exec_policy.load_policy fails closed on that).
"""
import argparse
import os
import re
import shlex
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import fleet_exec_policy as P

POLICY_PATH = os.environ.get("FLEET_EXEC_POLICY_PATH", "/home/lumen/foreman/harness/fleet-exec-policy.yaml")
AUDIT_PATH = os.environ.get("FLEET_EXEC_AUDIT_PATH", "/home/lumen/foreman/events/fleet-exec.jsonl")
WORKER_AUDIT_PATH = os.environ.get("FLEET_EXEC_WORKER_AUDIT_PATH")  # set per-worker by fworker.build_env
SSH_KEY = os.environ.get("FLEET_EXEC_SSH_KEY", "/home/lumen/.ssh/id_ed25519")
CONNECT_TIMEOUT_S = 10
# Lumen-side helpers. HOLDDOWN_BIN is invoked LOCALLY (§2.4.2): the healer and the
# flag dir live on Lumen, and /home/lumen/bin/holddown does not exist on any other
# node — the old remote invocation could only ever fail.
HOLDDOWN_BIN = "/home/lumen/bin/holddown"
RESTORE_BIN = "/home/lumen/bin/fleet-exec-restore"
NTFY_BIN = "/home/lumen/bin/ntfy-send"
LUMEN_STATE_BIN = "/home/lumen/minerva/lumen_state.py"
ALERT_TOPIC = "lumen-alerts"
# §2.4.3 verify-after budget: 30s for the action itself, then ONE rescue start and
# a shorter 15s re-poll before the unit is declared un-restarted.
VERIFY_POLL_S = 30
RESCUE_POLL_S = 15
POLL_INTERVAL_S = 1
SHOW_PROPS = "LoadState,ActiveState,SubState,ActiveEnterTimestampMonotonic"

_WQ_AGENT_RE = re.compile(r"^fworker-wq(\d+)$")

# ssh reserves exit 255 for its OWN failures, but a remote command is free to exit
# 255 too, so a transport verdict needs one of ssh's own diagnostics as well.
_SSH_TRANSPORT_STDERR = re.compile(
    r"ssh: connect to host|Connection timed out|Connection refused|No route to host|"
    r"Could not resolve hostname|Host key verification failed|Permission denied \(publickey|"
    r"kex_exchange_identification|Connection closed by|Operation timed out|"
    r"Network is unreachable|Broken pipe")


def die(msg):
    print(f"fleet-exec: {msg}", file=sys.stderr)
    sys.exit(2)


def ticket_from_wq_agent(wq_agent):
    m = _WQ_AGENT_RE.match(wq_agent or "")
    return m.group(1) if m else None


def known_nodes():
    """Roster of live fleet subjects (same source fleet-telemetry already uses:
    lumen_state.py's tailscale_ip facts). Unreachable minerva -> empty roster, which
    fails every node closed rather than skipping the check."""
    try:
        out = subprocess.run(
            ["python3", LUMEN_STATE_BIN, "current", "", "tailscale_ip"],
            capture_output=True, text=True, timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return set()
    roster = set()
    pat = re.compile(r"^\s*(\S+)\.tailscale_ip\s*=")
    for line in out.stdout.splitlines():
        m = pat.match(line)
        if m:
            roster.add(m.group(1))
    return roster


def audit(record):
    """§2.4.6: every line carries the grant sha, so an offline replay joins
    grant.json -> attempt-N.json -> fleet-exec.jsonl -> events/<worker>.jsonl on
    grant_sha alone, with no timestamp matching."""
    record.setdefault("grant_sha", os.environ.get("FOREMAN_GRANT_SHA"))
    P.append_jsonl(AUDIT_PATH, record)
    if WORKER_AUDIT_PATH:
        P.append_jsonl(WORKER_AUDIT_PATH, record)


def deny(ticket, attempt, worker, node, verb, argv, rule, reason, **extra):
    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb=verb, argv=argv, decision="deny", rule=rule, **extra))
    die(f"DENY [{rule}]: {reason}")


def notify(priority, title, message):
    """Best effort: an alert that fails to publish must never change the broker's
    verdict, so every error here is swallowed."""
    try:
        subprocess.run([NTFY_BIN, "-t", ALERT_TOPIC, "-p", priority, "-T", title, message],
                       capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        pass


def ingest_fact(subject, predicate, value):
    """Best effort, same reason as notify()."""
    try:
        subprocess.run(["python3", LUMEN_STATE_BIN, "ingest", subject, predicate, value,
                        "--source", "fleet-exec"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        pass


def load_context():
    """Grant + identity, shared by every verb. Returns (grant, ticket, attempt,
    worker) or calls deny()/die() itself — never returns a half-valid context."""
    wq_agent = os.environ.get("WQ_AGENT", "")
    ticket = ticket_from_wq_agent(wq_agent) or os.environ.get("FOREMAN_TICKET_ID")
    attempt = os.environ.get("FOREMAN_ATTEMPT")
    grant_path = os.environ.get("FOREMAN_GRANT_FILE")
    grant_sha = os.environ.get("FOREMAN_GRANT_SHA")
    if not ticket:
        die("no ticket identity (WQ_AGENT/FOREMAN_TICKET_ID unset) — refusing to guess")
    grant, err = P.load_grant(grant_path, grant_sha, ticket, wq_agent)
    if err:
        audit(P.audit_record(ticket=ticket, attempt=attempt, worker=wq_agent, node=None,
                              verb=sys.argv[1] if len(sys.argv) > 1 else None, argv=sys.argv[1:],
                              decision="deny", rule=f"grant:{err}"))
        die(f"DENY [grant:{err}]: grant file did not verify")
    return grant, ticket, attempt, wq_agent


def load_policy_or_die(ticket, attempt, worker, node, verb, argv):
    try:
        return P.load_policy(POLICY_PATH)
    except P.PolicyError as e:
        deny(ticket, attempt, worker, node, verb, argv, "policy_unreadable", str(e))


def check_node_known(ticket, attempt, worker, node, verb, argv):
    if node not in known_nodes():
        deny(ticket, attempt, worker, node, verb, argv, "unknown_node",
             f"{node!r} is not a live fleet subject (lumen_state.py current)")


def run_ssh(node, remote_argv, *, input_text=None, timeout=90):
    cmd = ["ssh", "-i", SSH_KEY, "-o", "BatchMode=yes",
           "-o", f"ConnectTimeout={CONNECT_TIMEOUT_S}",
           "-o", "StrictHostKeyChecking=accept-new", node, "--",
           *[shlex.quote(a) for a in remote_argv]]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=input_text)


def run_local(argv, *, timeout=60):
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)


def is_transport_error(p):
    return p.returncode == 255 and bool(_SSH_TRANSPORT_STDERR.search(p.stderr or ""))


def transport_fail(ticket, attempt, worker, node, verb, argv, detail, t0):
    """§2.4.4: an offline node fails closed, alerts, and leaves a fact behind so the
    next dispatch pass skips this node instead of spawning into the same wall.
    Never returns — exit stays 2."""
    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb=verb, argv=argv, decision="allow", rule="ssh_transport_error",
                          exit_code=2, elapsed_s=time.time() - t0, out_head=detail[:240]))
    ingest_fact(node, "broker_last_transport_error",
                datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
    notify("high", f"fleet-exec: {node} unreachable",
           f"wq{ticket} {verb} {' '.join(argv)} — {detail[:300]}")
    die(f"ssh transport error to {node}: {detail[:300]}")


def transport_guard(ticket, attempt, worker, node, verb, argv, t0):
    """Returns a run_ssh wrapper that turns any transport failure into
    transport_fail() — the callers below never see a half-connected result."""
    def call(remote_argv, *, timeout=90):
        try:
            p = run_ssh(node, remote_argv, timeout=timeout)
        except (OSError, subprocess.TimeoutExpired) as e:
            transport_fail(ticket, attempt, worker, node, verb, argv, str(e), t0)
        if is_transport_error(p):
            transport_fail(ticket, attempt, worker, node, verb, argv,
                           (p.stderr or "").strip(), t0)
        return p
    return call


def unit_state(ssh, unit):
    """`systemctl show` on a unit that does not exist still exits 0 with
    LoadState=not-found, which is exactly the read §2.4.3 gates on."""
    p = ssh(["systemctl", "show", "-p", SHOW_PROPS, unit], timeout=30)
    state = {}
    for line in (p.stdout or "").splitlines():
        key, sep, value = line.partition("=")
        if sep:
            state[key.strip()] = value.strip()
    return {"load": state.get("LoadState", "unknown"),
            "active": state.get("ActiveState", "unknown"),
            "sub": state.get("SubState", "unknown"),
            "active_enter_monotonic": state.get("ActiveEnterTimestampMonotonic", "")}


def poll_active(ssh, unit, seconds):
    """Poll `systemctl is-active` at POLL_INTERVAL_S until it reports active or the
    budget runs out. Returns (active, last_reading)."""
    deadline = time.time() + seconds
    last = "unknown"
    while True:
        p = ssh(["systemctl", "is-active", unit], timeout=30)
        last = ((p.stdout or "") + (p.stderr or "")).strip().splitlines()[0:1]
        last = last[0] if last else "unknown"
        if last == "active":
            return True, last
        if time.time() >= deadline:
            return False, last
        time.sleep(POLL_INTERVAL_S)


def holddown_key(node, unit):
    """§2.4.2: the flag lives on Lumen, so a remote unit is namespaced <unit>@<node>.
    node=lumen keeps the plain local name the healer already understands."""
    return unit if node == "lumen" else f"{unit}@{node}"


def grant_minutes(grant):
    try:
        expires = datetime.fromisoformat(grant["expires"].replace("Z", "+00:00"))
    except (KeyError, ValueError, AttributeError):
        expires = datetime.now(timezone.utc) + timedelta(minutes=5)
    if expires.tzinfo is None:
        expires = expires.replace(tzinfo=timezone.utc)
    return max(5, int((expires - datetime.now(timezone.utc)).total_seconds() // 60))


def holddown_set_argv(node, unit, ticket, attempt, minutes):
    argv = [HOLDDOWN_BIN, "set", holddown_key(node, unit),
            "--reason", f"fleet-exec wq{ticket} attempt{attempt}",
            "--ticket", f"wq{ticket}", "--restore-by", f"+{minutes}m"]
    if node != "lumen":
        argv += ["--restore-cmd", f"{RESTORE_BIN} {node} {unit}"]
    return argv


def holddown_drop(node, unit):
    try:
        run_local([HOLDDOWN_BIN, "drop", holddown_key(node, unit)], timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        pass


def cmd_run(args, grant, ticket, attempt, worker):
    node, argv = args.node, args.cmd
    policy = load_policy_or_die(ticket, attempt, worker, node, "run", argv)
    check_node_known(ticket, attempt, worker, node, "run", argv)
    ssh_grants = P.find_grants(grant, "ssh", node)
    if not any("run" in g.get("verbs", []) for g in ssh_grants):
        deny(ticket, attempt, worker, node, "run", argv, "grant:no_ssh_run",
             f"no ssh grant for {node} with verb run")
    ok, rule, reason = P.check_run(node, argv, policy)
    if not ok:
        deny(ticket, attempt, worker, node, "run", argv, rule, reason)
    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb="run", argv=argv, decision="allow", rule=rule))
    t0 = time.time()
    ssh = transport_guard(ticket, attempt, worker, node, "run", argv, t0)
    p = ssh(argv)
    out = (p.stdout or "") + (p.stderr or "")
    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb="run", argv=argv, decision="allow", rule=rule,
                          exit_code=p.returncode, elapsed_s=time.time() - t0,
                          out_sha256=P.sha256_bytes(out.encode()), out_head=out[:240]))
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    sys.exit(p.returncode)


def cmd_copy(args, grant, ticket, attempt, worker):
    node, local_path, remote_dir = args.node, args.local_path, args.remote_dir
    argv = [local_path, remote_dir]
    policy = load_policy_or_die(ticket, attempt, worker, node, "copy", argv)
    check_node_known(ticket, attempt, worker, node, "copy", argv)
    copy_grants = P.find_grants(grant, "copy", node)
    if not any(g.get("dir") == remote_dir for g in copy_grants):
        deny(ticket, attempt, worker, node, "copy", argv, "grant:no_copy_dir",
             f"no copy grant for {node}:{remote_dir}")
    ok, rule, reason = P.check_copy(node, remote_dir, policy)
    if not ok:
        deny(ticket, attempt, worker, node, "copy", argv, rule, reason)
    if not os.path.isfile(local_path) or os.path.islink(local_path):
        deny(ticket, attempt, worker, node, "copy", argv, "local_path_invalid",
             f"{local_path!r} is not a regular file")
    t0 = time.time()
    # §2.4.5: a missing drop dir is a DENY before the allow line, not an scp that
    # fails after the broker has already said yes.
    ssh = transport_guard(ticket, attempt, worker, node, "copy", argv, t0)
    if ssh(["test", "-d", remote_dir], timeout=30).returncode != 0:
        deny(ticket, attempt, worker, node, "copy", argv, "copy_dir_missing",
             f"{remote_dir!r} does not exist on {node} (provision it: mkdir -p)")
    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb="copy", argv=argv, decision="allow", rule=rule))
    cmd = ["scp", "-i", SSH_KEY, "-o", "BatchMode=yes",
           "-o", f"ConnectTimeout={CONNECT_TIMEOUT_S}",
           "-o", "StrictHostKeyChecking=accept-new",
           local_path, f"{node}:{remote_dir}/"]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        transport_fail(ticket, attempt, worker, node, "copy", argv, f"scp: {e}", t0)
    out = (p.stdout or "") + (p.stderr or "")
    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb="copy", argv=argv, decision="allow", rule=rule,
                          exit_code=p.returncode, elapsed_s=time.time() - t0,
                          out_sha256=P.sha256_bytes(out.encode()), out_head=out[:240]))
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    sys.exit(p.returncode)


def cmd_restart(args, grant, ticket, attempt, worker):
    node, unit, action = args.node, args.unit, args.action
    argv = [unit, action]
    policy = load_policy_or_die(ticket, attempt, worker, node, "restart", argv)
    check_node_known(ticket, attempt, worker, node, "restart", argv)
    restart_grants = P.find_grants(grant, "restart", node)
    if not any(g.get("unit") == unit for g in restart_grants):
        deny(ticket, attempt, worker, node, "restart", argv, "grant:no_restart_unit",
             f"no restart grant for {node}:{unit}")
    ok, rule, reason = P.check_restart(node, unit, policy)
    if not ok:
        deny(ticket, attempt, worker, node, "restart", argv, rule, reason)
    # ---- gate order above is verbatim; everything below is AFTER the allow decision ----
    t0 = time.time()
    ssh = transport_guard(ticket, attempt, worker, node, "restart", argv, t0)

    # §2.4.3 verify-before-act: a typo must not create a holddown.
    before = unit_state(ssh, unit)
    if before["load"] != "loaded":
        deny(ticket, attempt, worker, node, "restart", argv, "unit_not_found",
             f"{unit!r} on {node} has LoadState={before['load']}, not loaded", before=before)

    # §2.4.1 privilege precheck: without passwordless sudo the action is a polkit
    # refusal, so refuse here rather than leaving a holddown behind a failed restart.
    sudo_probe = ssh(["sudo", "-n", "true"], timeout=30)
    if sudo_probe.returncode != 0:
        notify("high", f"fleet-exec: no passwordless sudo on {node}",
               f"wq{ticket} restart {unit}@{node} refused: `sudo -n true` exited "
               f"{sudo_probe.returncode}")
        deny(ticket, attempt, worker, node, "restart", argv, "sudo_nopasswd_missing",
             f"`sudo -n true` on {node} exited {sudo_probe.returncode} — restart not attempted",
             before=before)

    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb="restart", argv=argv, decision="allow", rule=rule,
                          before=before))

    # §2.4.2 stop-restore contract, registered on LUMEN (the healer and the flag dir
    # are here); the restore path back to the node is fleet-exec-restore.
    hd_argv = holddown_set_argv(node, unit, ticket, attempt, grant_minutes(grant))
    try:
        hd = run_local(hd_argv, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                              verb="restart", argv=argv, decision="allow",
                              rule="holddown_local_error", exit_code=1,
                              elapsed_s=time.time() - t0, before=before, verified=False))
        die(f"holddown registration failed locally: {e}")
    if hd.returncode != 0:
        audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                              verb="restart", argv=argv, decision="allow", rule="holddown_failed",
                              exit_code=1, elapsed_s=time.time() - t0, before=before,
                              verified=False,
                              out_head=((hd.stdout or "") + (hd.stderr or ""))[:240]))
        print(f"fleet-exec: holddown registration failed for {holddown_key(node, unit)} — "
              f"restart NOT attempted: {(hd.stderr or hd.stdout)[:300]}", file=sys.stderr)
        sys.exit(1)

    p = ssh(["sudo", "-n", "systemctl", action, unit])
    out = (p.stdout or "") + (p.stderr or "")

    # §2.4.3 verify-after: is-active decides, not the action's own exit code.
    active, last = poll_active(ssh, unit, VERIFY_POLL_S)
    rescue_rc = None
    if not active or p.returncode != 0:
        rescue_rc = ssh(["sudo", "-n", "systemctl", "start", unit]).returncode
        active, last = poll_active(ssh, unit, RESCUE_POLL_S)
    after = unit_state(ssh, unit)
    verified = bool(active) and (p.returncode == 0 or rescue_rc == 0)

    record = P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                             verb="restart", argv=argv, decision="allow", rule=rule,
                             exit_code=0 if verified else 1, elapsed_s=time.time() - t0,
                             before=before, after=after, verified=verified,
                             out_sha256=P.sha256_bytes(out.encode()), out_head=out[:240])
    audit(record)
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    if verified:
        holddown_drop(node, unit)
        sys.exit(0)
    # Holddown is deliberately LEFT ACTIVE: the healer keeps restoring the unit until
    # a human drops the flag, and the worker cannot claim a restart it did not get.
    notify("urgent", f"fleet-exec: {unit} on {node} not active after {action}",
           f"wq{ticket} before={before['active']}/{before['sub']} "
           f"after={after['active']}/{after['sub']} (is-active={last}); holddown "
           f"{holddown_key(node, unit)} LEFT ACTIVE — healer will restore.")
    print(f"fleet-exec: {unit} on {node} is {last!r} after {action} + one rescue start; "
          f"holddown {holddown_key(node, unit)} left ACTIVE", file=sys.stderr)
    sys.exit(1)


def cmd_peer(args, grant, ticket, attempt, worker):
    node, name = args.node, args.name
    argv = [name]
    policy = load_policy_or_die(ticket, attempt, worker, node, "peer", argv)
    check_node_known(ticket, attempt, worker, node, "peer", argv)
    ssh_grants = P.find_grants(grant, "ssh", node)
    if not any("peer" in g.get("verbs", []) and name in g.get("peers", [])
               for g in ssh_grants):
        deny(ticket, attempt, worker, node, "peer", argv, "grant:no_ssh_peer",
             f"no ssh grant for {node} with verb peer and peer name {name!r}")
    ok, rule, reason = P.check_peer(node, name, policy)
    if not ok:
        deny(ticket, attempt, worker, node, "peer", argv, rule, reason)
    entry = P.peer_entry(node, name, policy)
    if entry is None:
        deny(ticket, attempt, worker, node, "peer", argv, "policy:peer_entry_invalid",
             f"peer entry for {name!r} failed re-validation")
    remote_argv = entry["argv"]
    t0 = time.time()
    ssh = transport_guard(ticket, attempt, worker, node, "peer", argv, t0)
    # Content pin: the sha256 in the reviewed entry must match what is on the node
    # RIGHT NOW, or nothing runs. sha256sum here is broker-emitted argv (like
    # restart's systemctl show), never worker argv.
    probe = ssh(["sha256sum", remote_argv[0]], timeout=30)
    actual = (probe.stdout or "").split()[0] if probe.stdout else ""
    if probe.returncode != 0 or actual != entry["sha256"]:
        deny(ticket, attempt, worker, node, "peer", argv, "peer:sha256_mismatch",
             f"{remote_argv[0]} on {node}: sha256sum exited {probe.returncode}, "
             f"got {actual[:16]!r}…, pinned {entry['sha256'][:16]!r}… — entry point "
             f"absent or not the reviewed content")
    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb="peer", argv=remote_argv, decision="allow", rule=rule))
    p = ssh(remote_argv, timeout=max(1, min(args.timeout, 3600)))
    out = (p.stdout or "") + (p.stderr or "")
    audit(P.audit_record(ticket=ticket, attempt=attempt, worker=worker, node=node,
                          verb="peer", argv=remote_argv, decision="allow", rule=rule,
                          exit_code=p.returncode, elapsed_s=time.time() - t0,
                          out_sha256=P.sha256_bytes(out.encode()), out_head=out[:240]))
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    sys.exit(p.returncode)


def cmd_grant(args, grant, ticket, attempt, worker):
    import json
    print(json.dumps(grant, indent=2, sort_keys=True))


def build_parser():
    ap = argparse.ArgumentParser(prog="fleet-exec")
    sub = ap.add_subparsers(dest="verb", required=True)

    r = sub.add_parser("run")
    r.add_argument("node")
    r.add_argument("cmd", nargs=argparse.REMAINDER)

    c = sub.add_parser("copy")
    c.add_argument("node")
    c.add_argument("local_path")
    c.add_argument("remote_dir")

    rs = sub.add_parser("restart")
    rs.add_argument("node")
    rs.add_argument("unit")
    rs.add_argument("action", nargs="?", default="restart", choices=["restart", "reload", "start"])

    pe = sub.add_parser("peer")
    pe.add_argument("node")
    pe.add_argument("name")
    # A peer that must outlive this budget daemonizes in its own reviewed wrapper
    # (setsid + exit 0); the broker never holds an unbounded ssh session open.
    pe.add_argument("--timeout", type=int, default=90, metavar="SEC")

    sub.add_parser("grant")
    return ap


def main(argv=None):
    ap = build_parser()
    args = ap.parse_args(argv)
    if args.verb == "run" and args.cmd[:1] == ["--"]:
        args.cmd = args.cmd[1:]
    grant, ticket, attempt, worker = load_context()
    {
        "run": cmd_run,
        "copy": cmd_copy,
        "restart": cmd_restart,
        "peer": cmd_peer,
        "grant": cmd_grant,
    }[args.verb](args, grant, ticket, attempt, worker)


if __name__ == "__main__":
    main()
