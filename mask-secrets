#!/bin/bash
# Pipe grep/cat/env output through this to redact secret VALUES before they hit a transcript.
# Usage: grep -rn GITHUB_TOKEN /home/lumen/agent | mask-secrets
sed -E '
s/(ghp_|gho_|ghu_|ghs_|ghr_|github_pat_)[A-Za-z0-9_]{6,}/\1MASKED/g
s/(cfut_?)[A-Za-z0-9_.-]{6,}/\1MASKED/g
s/(sk-[a-zA-Z-]*)[A-Za-z0-9_-]{16,}/\1MASKED/g
s/(xox[bpasr]-)[A-Za-z0-9-]{8,}/\1MASKED/g
s/(AKIA)[0-9A-Z]{16}/\1MASKED/g
s/((TOKEN|KEY|SECRET|PASSWORD|PASSWD|PAT)["[:space:]]*[:=]["[:space:]]*)[A-Za-z0-9._-]{12,}/\1MASKED/gI
'
