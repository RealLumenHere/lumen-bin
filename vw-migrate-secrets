# ── main ─────────────────────────────────────────────────────
if __name__ == "__main__":
    if not Path(PW_FILE).exists():
        die(f"Drop VW master password into {PW_FILE} (0600) first.")
    if oct(Path(PW_FILE).stat().st_mode)[-3:] != "600":
        die(f"{PW_FILE} perms must be 600.")

    ts = datetime.now(timezone.utc).isoformat()
    print(f"=== VW Secret Migration v2 (wq#306) ===")
    print(f"Time: {ts}")

    # 1. Login
    print("[1/4] Logging in...", end=" ", flush=True)
    env = os.environ.copy()
    env["PATH"] = f"/home/lumen/.npm-global/bin:{env.get('PATH','')}"
    env["BW_NOINTERACTION"] = "true"
    r = subprocess.run([BW, "login", VW_EMAIL, "--passwordfile", PW_FILE, "--raw"],
                       capture_output=True, text=True, timeout=30, env=env)
    if r.returncode != 0:
        # Maybe already logged in
        r = subprocess.run([BW, "unlock", "--passwordfile", PW_FILE, "--raw"],
                           capture_output=True, text=True, timeout=30, env=env)
        if r.returncode != 0:
            die(f"auth failed: {r.stderr.strip()[:200]}")
    env["BW_SESSION"] = r.stdout.strip()
    print("OK")

    subprocess.run([BW, "sync"], capture_output=True, env=env, timeout=30)

    # 2. Build Bitwarden JSON export format
    print("[2/4] Building import file...", end=" ", flush=True)
    folders = {}  # name -> index
    folder_list = []
    items = []

    for spec in SECRETS:
        folder_name, name, kind, source, extra = spec
        # Ensure folder exists
        if folder_name not in folders:
            fid = str(uuid.uuid4())
            folders[folder_name] = fid
            folder_list.append({"id": fid, "name": folder_name})

        # Build notes content
        try:
            if kind == "file":
                content = read_file(source)
                if extra: content = f"# {name}\n{extra}\n\n{content}"
            elif kind == "file_env":
                content = read_env_all(source)
                if extra: content = f"# {name}\n{extra}\n\n{content}"
            elif kind == "env_keys":
                content = read_env_keys(source, extra)
            elif kind == "dir_json":
                parts = []
                for f in sorted(Path(source).glob("*.json")):
                    parts.append(f"--- {f.name} ---")
                    parts.append(f.read_text().strip())
                content = '\n'.join(parts)
                if extra: content = f"# {name}\n{extra}\n\n{content}"
            else:
                raise ValueError(f"unknown kind: {kind}")
            if not content:
                raise ValueError("empty")
        except FileNotFoundError:
            print(f"\n  SKIP {name}: {source} not found", file=sys.stderr)
            continue
        except Exception as e:
            print(f"\n  SKIP {name}: {mask(e)}", file=sys.stderr)   # wq#2902: mask at the boundary
            continue

        items.append({
            "type": 2,  # secure note
            "name": name,
            "notes": content,
            "favorite": False,
            "reprompt": 0,
            "secureNote": {"type": 0},
            "folderId": folders[folder_name],  # index into folder_list
        })

    # Write import file (0600, /tmp)
    export = {"encrypted": False, "folders": folder_list, "items": items}
    Path(IMPORT_FILE).write_text(json.dumps(export, indent=2))
    os.chmod(IMPORT_FILE, 0o600)
    print(f"{len(items)} items, {len(folder_list)} folders")

    # 3. Import
    print("[3/4] Importing into Vaultwarden...", end=" ", flush=True)
    r = subprocess.run([BW, "import", "bitwardenjson", IMPORT_FILE],
                       capture_output=True, text=True, timeout=60, env=env)
    os.unlink(IMPORT_FILE)
    if r.returncode != 0:
        die(f"import failed rc={r.returncode}: {(r.stderr or r.stdout).strip()[:600]}")
    print("OK")

    # 4. Verify
    print("[4/4] Verifying...", end=" ", flush=True)
    subprocess.run([BW, "sync"], capture_output=True, env=env, timeout=30)
    r = subprocess.run([BW, "list", "items"], capture_output=True, text=True,
                       timeout=30, env=env)
    if r.returncode != 0:
        print(f"verify list failed: {r.stderr.strip()[:200]}", file=sys.stderr)
    else:
        vault_items = json.loads(r.stdout)
        named = {i["name"] for i in vault_items}
        expected = {s[1] for s in SECRETS}
        found = expected & named
        missing = expected - named
        print(f"{len(found)}/{len(expected)} items verified in vault")
        if missing:
            print(f"  MISSING: {missing}", file=sys.stderr)

    # Lock
    subprocess.run([BW, "lock"], capture_output=True, env=env, timeout=10)
    print("Vault locked.")

    # Report
    report = [
        f"# VW Migration Report (wq#306)",
        f"Generated: {ts}", "",
        "## Doctrine",
        ".env files = RUNTIME source. VW = RECOVERY source of truth.",
        "Sync: human rotates in VW -> updates .env. Never the reverse.", "",
        f"## Results",
        f"- Items imported: {len(items)}",
        f"- Folders: {', '.join(folders.keys())}",
        f"- Method: bw import bitwardenjson", "",
        "## ESCROW (NOT in VW)",
        "- VW master password (Frank only)",
        "- VW ADMIN_TOKEN (hashed in Maat .env)",
        "- Vault PostgreSQL creds (root-only on Maat)",
        "- Restic repo passwords", "",
        "## Post-migration",
        f"- [ ] shred -u {PW_FILE}",
        "- [ ] shred -u /home/lumen/secrets/.new_fleet_pw",
        "- [ ] Verify VW web UI shows items in correct folders",
        "- [ ] lumen_state ingest + episode commit", "",
    ]
    Path(REPORT).write_text('\n'.join(report))
    print(f"Report: {REPORT}")
