def die(msg):
    print(f"FATAL: {msg}", file=sys.stderr)
    cleanup()
    sys.exit(1)

def cleanup():
    try: os.unlink(IMPORT_FILE)
    except: pass
    try:
        subprocess.run([BW, "lock"], capture_output=True, timeout=10,
                       env={**os.environ, "PATH": f"/home/lumen/.npm-global/bin:{os.environ.get('PATH','')}"})
    except: pass

def read_file(path):
    return Path(path).read_text().strip()

def read_env_keys(path, keys):
    lines = []
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if line.startswith('#') or '=' not in line: continue
        if line.split('=', 1)[0] in keys: lines.append(line)
    return '\n'.join(lines)

def read_env_all(path):
    lines = []
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if line and not line.startswith('#'): lines.append(line)
    return '\n'.join(lines)

