#!/usr/bin/env python3
"""
pt — Frank's ticket CLI (Scribe backend).

Ported from Leantime JSON-RPC to Scribe HTTP API 2026-07-16 (wq#267).
Same verbs, same UX. Ticket ids are SCRIBE task ids (shown by todo/show).

Quick reference:
  pt ls                                # list all projects
  pt todo [id_or_substr]               # list OPEN work (what needs doing)
  pt show <id_or_substr>               # show one project + open tickets
  pt next <id_or_substr> "..."         # add a 'next step' ticket
  pt buy <id_or_substr> "..."          # add a shopping-list ticket
  pt wait <id_or_substr> "..."         # add a waiting-on ticket
  pt blocker <id_or_substr> "..."      # add a blocker ticket
  pt done <ticket_id>                  # mark ticket done
  pt log <id_or_substr> "..."          # append a step to the project log
  pt inbox "..."                       # add to the Inbox
  pt idea "..."                        # park an idea in Ideas Parking Lot
  pt research "..."                    # queue an item for the research agents
  pt url                               # print Scribe URL
"""
import argparse
import json
import sys
import urllib.request
import urllib.error
import urllib.parse

SCRIBE_URL = "http://127.0.0.1:8131"
PUBLIC_URL = "https://scribe.lumennode.uk"


def http(method, path, body=None, params=None):
    url = SCRIBE_URL + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"Content-Type": "application/json",
                                          "X-Actor": "frank"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        print("HTTP %s: %s" % (e.code, e.read().decode()[:200]), file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print("ERROR: Scribe unreachable at %s (%s)" % (SCRIBE_URL, e.reason),
              file=sys.stderr)
        sys.exit(1)


def find_project(needle):
    projects = http("GET", "/api/projects") or []
    if str(needle).isdigit():
        for p in projects:
            if str(p["id"]) == str(needle):
                return p
    for p in projects:
        if p["name"].lower() == str(needle).lower():
            return p
    matches = [p for p in projects if str(needle).lower() in p["name"].lower()]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        print("ambiguous '%s'. matches:" % needle, file=sys.stderr)
        for p in matches:
            print("  [%s] %s" % (p["id"], p["name"]), file=sys.stderr)
        sys.exit(1)
    print("no project matched '%s'" % needle, file=sys.stderr)
    sys.exit(1)


def add_task(project_id, title, status="open", priority="medium",
             blocker_note="", blocker_type=None, context=""):
    if blocker_type is None:
        blocker_type = "other" if status == "blocked" else "none"
    body = {"project_id": project_id, "title": title, "status": status,
            "priority": priority, "blocker_type": blocker_type,
            "blocker_note": blocker_note, "context_md": context}
    return http("POST", "/api/tasks", body=body)


def cmd_ls(args):
    for p in http("GET", "/api/projects") or []:
        print("  [%3s] [open:%2s] %s" % (p["id"], p.get("open_count", 0), p["name"]))


def cmd_show(args):
    p = find_project(args.project)
    print("\n[%s] %s" % (p["id"], p["name"]))
    print("  open tasks: %s" % p.get("open_count", 0))
    tasks = http("GET", "/api/tasks", params={"project_id": p["id"]}) or []
    if not tasks:
        print("  (no tasks)")
        return
    by_status = {}
    for t in tasks:
        by_status.setdefault(t.get("status") or "open", []).append(t)
    for status in ("blocked", "in_progress", "open", "done"):
        rows = by_status.get(status)
        if not rows:
            continue
        print("\n  [%s]" % status.upper())
        for t in rows[:40 if status == "done" else 200]:
            print("    [%4s] %s" % (t["id"], t["title"]))


def cmd_todo(args):
    params = {"status": "open,in_progress,blocked"}
    only = None
    if getattr(args, "project", None):
        only = find_project(args.project)
        params["project_id"] = only["id"]
    tasks = http("GET", "/api/tasks", params=params) or []
    tasks = [t for t in tasks if not (t["title"] or "").startswith("\U0001F4DD")]
    if not tasks:
        print("\n  (nothing open — you're clear)\n")
        return
    buckets = {}
    for t in tasks:
        buckets.setdefault((t.get("project_id") or 0,
                            t.get("project_name") or "?"), []).append(t)
    pri_rank = {"critical": 0, "high": 1, "medium": 2, "low": 3}
    st_name = {"open": "NEW", "blocked": "BLOCKED", "in_progress": "WIP"}
    print("\n  OPEN WORK — %d item(s)\n" % len(tasks))
    for (pid, pname) in sorted(buckets):
        print("  [%s] %s" % (pid, pname))
        rows = sorted(buckets[(pid, pname)],
                      key=lambda t: (pri_rank.get(t.get("priority"), 2),
                                     t.get("status") or ""))
        for t in rows:
            hl = t["title"]
            if len(hl) > 88:
                hl = hl[:87] + "\u2026"
            print("      [%3s] %-8s %-4s  %s"
                  % (t["id"], st_name.get(t.get("status"), "?"),
                     (t.get("priority") or "med")[:4].upper(), hl))
        print()


def cmd_next(args):
    p = find_project(args.project)
    add_task(p["id"], "\u2192 " + args.text, priority="medium")
    print("\u2713 added next-step to [%s] %s" % (p["id"], p["name"]))


def cmd_buy(args):
    p = find_project(args.project)
    add_task(p["id"], "\U0001F6D2 " + args.text, priority="high",
             blocker_type="budget", status="blocked",
             blocker_note="shopping item — needs purchase")
    print("\u2713 added shopping item to [%s] %s" % (p["id"], p["name"]))


def cmd_wait(args):
    p = find_project(args.project)
    add_task(p["id"], "\u23F3 " + args.text, status="blocked", priority="high",
             blocker_note=args.text)
    print("\u2713 added waiting-on to [%s] %s" % (p["id"], p["name"]))


def cmd_blocker(args):
    p = find_project(args.project)
    add_task(p["id"], "\u26A0 " + args.text, status="blocked", priority="critical",
             blocker_note=args.text)
    print("\u2713 added blocker to [%s] %s" % (p["id"], p["name"]))


def cmd_done(args):
    http("PATCH", "/api/tasks/%d" % int(args.ticket), body={"status": "done"})
    print("\u2713 ticket %s \u2192 done" % args.ticket)


def cmd_log(args):
    p = find_project(args.project)
    from datetime import datetime
    from zoneinfo import ZoneInfo
    ts = datetime.now(ZoneInfo("America/Los_Angeles")).strftime("%Y-%m-%d %H:%M")
    add_task(p["id"], "\U0001F4DD %s: %s" % (ts, args.text), status="done",
             context=args.text)
    print("\u2713 logged to [%s] %s" % (p["id"], p["name"]))


def cmd_inbox(args):
    p = find_project("\U0001F4E5 Inbox")
    add_task(p["id"], "\U0001F4CC " + args.text, priority="high")
    print("\u2713 added to Inbox")


def cmd_idea(args):
    p = find_project("\U0001F4A1 Ideas Parking Lot")
    add_task(p["id"], "\U0001F4A1 " + args.text, priority="low")
    print("\u2713 parked idea")


def cmd_research(args):
    p = find_project("\U0001F52C Research Queue")
    add_task(p["id"], "\U0001F52C " + args.text, priority="medium",
             blocker_type="needs_research")
    print("\u2713 queued for research")


def cmd_url(args):
    print(PUBLIC_URL)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    sp.add_parser("ls", help="list all projects")
    sp.add_parser("url", help="print Scribe URL")
    pt_todo = sp.add_parser("todo", help="list open work across projects")
    pt_todo.add_argument("project", nargs="?", help="optional project id/substr filter")
    p = sp.add_parser("show", help="show a project + its tickets")
    p.add_argument("project", help="project id or name substring")
    for name, help_ in [("next", "add a next-step ticket"),
                        ("buy", "add a shopping ticket"),
                        ("wait", "add a waiting-on ticket"),
                        ("blocker", "add a blocker ticket"),
                        ("log", "append a step to the project log")]:
        p = sp.add_parser(name, help=help_)
        p.add_argument("project", help="project id or name substring")
        p.add_argument("text", help="ticket text")
    for name, help_ in [("inbox", "add to the Inbox"),
                        ("idea", "park an idea"),
                        ("research", "queue research item")]:
        p = sp.add_parser(name, help=help_)
        p.add_argument("text", help="ticket text")
    p = sp.add_parser("done", help="mark a ticket done")
    p.add_argument("ticket", help="ticket id")
    args = ap.parse_args()
    {"ls": cmd_ls, "show": cmd_show, "next": cmd_next, "buy": cmd_buy,
     "wait": cmd_wait, "blocker": cmd_blocker, "done": cmd_done,
     "log": cmd_log, "inbox": cmd_inbox, "idea": cmd_idea,
     "research": cmd_research, "url": cmd_url, "todo": cmd_todo}[args.cmd](args)


if __name__ == "__main__":
    main()
