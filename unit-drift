#!/usr/bin/env python3
"""unit-drift (wq#1041) — git-tracked desired-state for /etc/systemd/system.

Baseline = fleet unit files + drop-ins + enable-state under a git repo.
The reconciler is READ-ONLY: it reports drift (added/removed/modified units,
enable-state changes) and exits 1 on drift, 3 on a crash (wq#3099). It never applies or restarts.

  unit-drift snapshot          rebuild baseline from /etc, git commit
  unit-drift check [--digest]  read-only diff; exit 1 on drift;
                               --digest emits an info-class ntfy on drift
                               under one fixed title (= one aq row), skips the
                               ntfy while the change set is unchanged (wq#3509) and
                               resolves that row once the check is CLEAN (wq#3466);
                               also lints for dangling After/Wants/Requires
                               targets (wq#1659) and the guard exit-code
                               contract (wq#1657 GEL1/GEL2 via guard_exit_lint.py);
                               advises on masked units with no entry in
                               docs/fleet/retired_services.yaml (wq#2218)
  unit-drift apply --dry-run   show disk<-baseline plan (manual, no write)
  unit-drift show-baseline     list tracked files in the baseline

Secret-bearing Environment= values are REDACTED in the stored copies; the
MANIFEST hashes the REAL on-disk content, so drift is still detected without
plaintext secrets ever entering the repo.
"""
import os, sys, json, hashlib, subprocess, re, datetime

SYS  = os.environ.get("UNIT_DRIFT_SYS", "/etc/systemd/system")  # env override is for tests
REPO = "/home/lumen/fleet-units"
UNITS_DIR  = os.path.join(REPO, "units")
DROPIN_DIR = os.path.join(REPO, "dropins")
MANIFEST   = os.path.join(REPO, "MANIFEST.json")
ENABLE_TSV = os.path.join(REPO, "enable-state.tsv")
KNOWN_RM   = os.path.join(REPO, "known-removed.txt")
RETIRED_YAML = "/home/lumen/foreman/docs/fleet/retired_services.yaml"
NTFY  = "/home/lumen/bin/ntfy-send"
TOPIC = "lumen-alerts"
AQ    = os.environ.get("UNIT_DRIFT_AQ", "/home/lumen/bin/aq")  # env override is for tests
AQ_SOURCE = "ntfy:" + TOPIC
# wq#3466: the aq ntfy ingest keys a row by its title. A title carrying the change count
# opened a new row each time the count moved (47 rows / 3064 repeats for one drift stream).
DIGEST_TITLE = "unit-drift: drift on lumen"
# wq#3509: one ntfy per distinct drift state, not one per 15-min cycle (x433 repeat
# counters). The last-notified change-set hash lives here; CLEAN removes it.
DIGEST_STATE = os.environ.get("UNIT_DRIFT_DIGEST_STATE",
                              os.path.expanduser("~/.cache/unit-drift-digest.state"))
AQ_ROW_RE = re.compile(r"^\[\s*(\d+)\]\s+open\s+x\d+\s+(\S+)\s+(.*?)\s+owner=")
SEARCH_PATHS = ("/etc/systemd/system","/run/systemd/system",
                "/usr/lib/systemd/system","/lib/systemd/system")
SUFFIXES = ("service","socket","timer","target","path","mount",
            "automount","swap","slice","scope","device")
SUF_RE = re.compile(r"\.(" + "|".join(SUFFIXES) + r")$")
SECRET_KEY = re.compile(r"(?i)^(token|key|secret|password|passwd|auth)$")
SECRET_VAL = re.compile(r"(cfut_|sk-[A-Za-z0-9]|ghp_|xoxb-|glpat-)")
DEP_RE = re.compile(r"^(After|Wants|Requires|BindsTo|PartOf)=(.+)$")

def redact(text):
    out = []
    for ln in text.splitlines(keepends=True):
        m = re.match(r"(\s*Environment=)\"?([^=\"]+)=(.*)$", ln)
        if m:
            key, val = m.group(2), m.group(3).rstrip("\"\n")
            comps = re.split(r"[^A-Za-z0-9]+", key)
            if any(SECRET_KEY.match(c) for c in comps) or SECRET_VAL.search(val):
                out.append(m.group(1) + key + "=***REDACTED-wq1041***\n")
                continue
        out.append(ln)
    return "".join(out)

def sha(b): return hashlib.sha256(b).hexdigest()

def read_bytes(p):
    try:
        with open(p, "rb") as f: return f.read()
    except PermissionError:
        return subprocess.run(["sudo","cat",p], capture_output=True).stdout

def base_unit_exists(base):
    return any(os.path.exists(os.path.join(d, base)) for d in SEARCH_PATHS)

def list_dir(p):
    """os.listdir with the same sudo fallback read_bytes() has (wq#3099). A root-only drop-in dir (mcp-gateway.service.d,
    0700 on purpose) used to crash the whole scan. Returns (names, readable); unreadable is reported, never raised."""
    try:
        return sorted(os.listdir(p)), True
    except PermissionError:
        r = subprocess.run(["sudo", "-n", "ls", "-1", p], capture_output=True, text=True)
        if r.returncode == 0:
            return sorted(l for l in r.stdout.splitlines() if l), True
        return [], False

def scan():
    units, dropins, enable = {}, {}, {}
    for name in sorted(os.listdir(SYS)):
        full = os.path.join(SYS, name)
        if name.endswith((".wants", ".requires")) and os.path.isdir(full):
            for lnk in list_dir(full)[0]:
                lp = os.path.join(full, lnk)
                if os.path.islink(lp):
                    enable[name + "/" + lnk] = os.readlink(lp)
            continue
        if name.endswith(".d") and os.path.isdir(full):
            names, readable = list_dir(full)
            if not readable:
                dropins[name + "/<UNREADABLE>"] = "unreadable"  # visible as drift, not a crash
                continue
            for conf in names:
                cp = os.path.join(full, conf)
                if conf.endswith(".conf") and (os.path.isfile(cp) or not os.access(full, os.R_OK | os.X_OK)):
                    dropins[name + "/" + conf] = sha(read_bytes(cp))
            continue
        if not SUF_RE.search(name):
            continue
        if os.path.islink(full):
            units[name] = {"kind": "symlink", "target": os.readlink(full)}
        elif os.path.isfile(full):
            units[name] = {"kind": "file", "sha256": sha(read_bytes(full))}
    return {"units": units, "dropins": dropins, "enable": enable}

def git(*args):
    return subprocess.run(["git","-C",REPO,*args], capture_output=True, text=True)

def load_manifest():
    r = git("show", "HEAD:MANIFEST.json")
    if r.returncode == 0:
        return json.loads(r.stdout)
    return json.load(open(MANIFEST))

def load_known_removed():
    if os.path.exists(KNOWN_RM):
        return set(l.strip() for l in open(KNOWN_RM)
                   if l.strip() and not l.startswith("#"))
    return set()

def cmd_snapshot():
    # wq#1658: close any new dead-man coverage gap before capturing the
    # baseline, so opting out of cron-stamp coverage is the exception —
    # failure here must never block the snapshot itself.
    try:
        subprocess.run(["/home/lumen/bin/lumen-cron-stamp-dropin-gen", "apply"], timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print("unit-drift: lumen-cron-stamp-dropin-gen skipped: %s" % exc)
    os.makedirs(UNITS_DIR, exist_ok=True); os.makedirs(DROPIN_DIR, exist_ok=True)
    st = scan()
    for d in (UNITS_DIR, DROPIN_DIR):
        for root, _, files in os.walk(d):
            for f in files: os.remove(os.path.join(root, f))
    for name, meta in st["units"].items():
        if meta["kind"] == "symlink":
            open(os.path.join(UNITS_DIR, name + ".symlink"), "w").write(meta["target"] + "\n")
        else:
            txt = read_bytes(os.path.join(SYS, name)).decode("utf-8","replace")
            open(os.path.join(UNITS_DIR, name), "w").write(redact(txt))
    for rel in st["dropins"]:
        dst = os.path.join(DROPIN_DIR, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        txt = read_bytes(os.path.join(SYS, rel)).decode("utf-8","replace")
        open(dst, "w").write(redact(txt))
    with open(ENABLE_TSV, "w") as f:
        for k in sorted(st["enable"]): f.write(k + "\t" + st["enable"][k] + "\n")
    json.dump(st, open(MANIFEST, "w"), indent=2, sort_keys=True)
    if not os.path.exists(KNOWN_RM):
        open(KNOWN_RM, "w").write("# units deliberately removed; reappearance = respawn (wq#1041)\n")
    git("add", "-A")
    msg = ("snapshot %s: %d units, %d drop-ins, %d enable-links" %
           (datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            len(st["units"]), len(st["dropins"]), len(st["enable"])))
    r = git("commit", "-m", msg)
    print(msg); print((r.stdout or r.stderr).strip())
    return 0

def dangling_target_lint():
    """wq#1659: flag After=/Wants=/Requires=/BindsTo=/PartOf= targets that never
    load. Source: FLEET_SERVICE_ATLAS.md #13 (wq#1627) — 3 fleet researchers +
    lumen-convo-learn ordered After/Wants a fictional `litellm.service`,
    lumen-research-index After a fictional `lumen-pgvector.service`; both are
    docker containers with no matching unit. Fail-open: an unreadable unit is
    skipped, never crashes the check."""
    out = []
    for name in sorted(os.listdir(SYS)):
        full = os.path.join(SYS, name)
        if not SUF_RE.search(name) or os.path.islink(full) or not os.path.isfile(full):
            continue
        try:
            text = read_bytes(full).decode("utf-8", "replace")
        except OSError:
            continue
        for ln in text.splitlines():
            m = DEP_RE.match(ln.strip())
            if not m:
                continue
            kind, targets = m.groups()
            for target in targets.split():
                if "%" in target or not SUF_RE.search(target):
                    continue
                if not base_unit_exists(target):
                    out.append("%s: %s=%s does not load" % (name, kind, target))
    return out

def guard_lint():
    """wq#1657 guard exit-code contract lint. Fail-open: no module, no lint."""
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import guard_exit_lint
        return guard_exit_lint.lint_dir(SYS, read=read_bytes)
    except Exception:
        return []

def masked_units(units):
    """Units masked via a symlink to /dev/null."""
    return sorted(n for n, m in units.items()
                  if m.get("kind") == "symlink" and m.get("target") == "/dev/null")

def retired_names():
    """Unit names (with and without suffix) that retired_services.yaml records.
    None when the file cannot be read, so the lint stays silent."""
    try:
        import yaml
        with open(RETIRED_YAML) as f:
            doc = yaml.safe_load(f)
        names = set()
        for e in doc:
            for u in e.get("units", []):
                names.add(u); names.add(SUF_RE.sub("", u))
        return names
    except Exception:
        return None

def unexplained_masks(units):
    """wq#2218: a mask with no retired_services.yaml entry reads as an unexplained
    leftover (wq#2073: lumen-pokemon-live was masked with the reason recorded
    nowhere and unmasked in good faith five days later). Fail-open: an unreadable
    record means no lint."""
    known = retired_names()
    if known is None:
        return []
    return [n for n in masked_units(units)
            if n not in known and SUF_RE.sub("", n) not in known]

def _diff(kind, base, cur, known_rm=None):
    d = []
    for n in sorted(set(cur) - set(base)):
        tag = "  RESPAWN(known-removed)" if known_rm and n in known_rm else ""
        d.append(("ADDED " + kind, n + tag))
    for n in sorted(set(base) - set(cur)):
        d.append(("REMOVED " + kind, n))
    for n in sorted(set(base) & set(cur)):
        if base[n] != cur[n]: d.append(("MODIFIED " + kind, n))
    return d

def print_mask_advisory(masks):
    """Advisory only: never changes the exit code or the digest."""
    if masks:
        print("  advisory: masked with no entry in %s — a mask is deliberate, "
              "not a leftover; find why before unmasking (wq#2073): %s"
              % (RETIRED_YAML, ", ".join(masks)))

def cmd_check(digest=False):
    base = load_manifest(); cur = scan(); known = load_known_removed()
    drift  = _diff("unit",   base["units"],   cur["units"], known)
    drift += _diff("dropin", base["dropins"], cur["dropins"])
    drift += _diff("enable", base["enable"],  cur["enable"])
    orphans = sorted({rel.split("/")[0] for rel in cur["dropins"]
                      if not base_unit_exists(rel.split("/")[0][:-2])})
    dangling = dangling_target_lint()
    lint = guard_lint()
    masks = unexplained_masks(cur["units"])
    ts =datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    counts = "%d units, %d drop-ins, %d enable-links" % (
        len(cur["units"]), len(cur["dropins"]), len(cur["enable"]))
    if not drift and not dangling and not lint:
        print("[%s] unit-drift: CLEAN (%s)" % (ts, counts))
        if orphans: print("  advisory: orphaned drop-in dir(s), base unit absent: " + ", ".join(orphans))
        print_mask_advisory(masks)
        if digest:
            resolve_digest_rows()
            _clear_digest_state()
        return 0
    print("[%s] unit-drift: DRIFT — %d change(s) vs git baseline, %d dangling target(s), %d guard-lint violation(s)"
          % (ts, len(drift), len(dangling), len(lint)))
    for kind, name in drift: print("  %-16s %s" % (kind, name))
    for v in dangling: print("  %-16s %s" % ("DANGLING-TARGET", v))
    for v in lint: print("  %-16s %s" % ("GUARD-LINT", v))
    if orphans: print("  advisory: orphaned drop-in dir(s), base unit absent: " + ", ".join(orphans))
    print_mask_advisory(masks)
    if digest:
        items = [k + " " + n for k, n in drift] + dangling + [v.split(":")[0] for v in lint]
        h = hashlib.sha256("\n".join(items).encode()).hexdigest()[:12]
        if h == _read_digest_state():
            print("  digest: suppressed, drift unchanged since last ntfy (hash %s)" % h)
        else:
            summ = "; ".join(items[:12])
            if len(items) > 12: summ += "; +%d more" % (len(items) - 12)
            r = subprocess.run([NTFY, "-t", TOPIC, "-p", "low", "-T", DIGEST_TITLE,
                                "%d change(s) [%s]: %s" % (len(items), h, summ)])
            # record only a delivered ntfy, so a failed send retries next cycle
            if r.returncode == 0:
                _write_digest_state(h)
    return 1

def _read_digest_state():
    try:
        with open(DIGEST_STATE) as f: return f.read().strip()
    except OSError:
        return None

def _write_digest_state(h):
    try:
        os.makedirs(os.path.dirname(DIGEST_STATE), exist_ok=True)
        with open(DIGEST_STATE, "w") as f: f.write(h + "\n")
    except OSError as exc:
        print("  advisory: digest state unwritable, dedup off (%s)" % exc)

def _clear_digest_state():
    try:
        os.remove(DIGEST_STATE)
    except FileNotFoundError:
        pass
    except OSError as exc:
        print("  advisory: digest state unremovable (%s)" % exc)

def resolve_digest_rows():
    """wq#3466: nothing closed a digest row when drift cleared, so they piled up open until a
    human resolved them. Matches every 'unit-drift:' key, which also sweeps the old count-keyed rows."""
    try:
        r = subprocess.run([AQ, "list", "open"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as exc:
        print("  advisory: aq unreadable, digest rows left open (%s)" % exc); return
    for line in r.stdout.splitlines():
        m = AQ_ROW_RE.match(line)
        if m and m.group(2) == AQ_SOURCE and m.group(3).startswith("unit-drift:"):
            subprocess.run([AQ, "resolve", m.group(1), "auto: unit-drift check CLEAN"],
                           capture_output=True, timeout=60)
            print("  resolved aq#%s (%s)" % (m.group(1), m.group(3)))

def cmd_apply():
    base = load_manifest(); cur = scan()
    plan  = ["restore " + n for n in sorted(set(base["units"]) - set(cur["units"]))]
    plan += ["REMOVE "  + n for n in sorted(set(cur["units"]) - set(base["units"]))]
    plan += ["rewrite " + n for n in sorted(set(base["units"]) & set(cur["units"]))
             if base["units"][n] != cur["units"][n]]
    if not plan:
        print("apply: nothing to do — disk matches baseline"); return 0
    print("apply PLAN (dry-run — nothing written):")
    for p in plan: print("  " + p)
    print("(wq#1041 ships READ-ONLY; no --force-write path is wired. Restore manually.)")
    return 0

def cmd_show():
    base = load_manifest()
    for n in sorted(base["units"]):   print("unit   " + n)
    for n in sorted(base["dropins"]): print("dropin " + n)
    for n in sorted(base["enable"]):  print("enable " + n)
    return 0

def main():
    a = sys.argv[1:]
    if not a: print(__doc__); return 2
    if a[0] == "snapshot":      return cmd_snapshot()
    if a[0] == "check":         return cmd_check(digest="--digest" in a)
    if a[0] == "apply":         return cmd_apply()
    if a[0] == "show-baseline": return cmd_show()
    print(__doc__); return 2

def run():
    """wq#3099: a crash is not a finding. Exit 1 means drift (whitelisted in SuccessExitStatus), so a traceback that
    also exited 1 read as 'drift found' and hid a 3-day outage of this guard. Exit 3 is outside the whitelist,
    so OnFailure= fires."""
    try:
        return main() or 0
    except Exception as exc:
        import traceback
        traceback.print_exc()
        print("unit-drift: CRASH (%s: %s) -- exit 3, this is NOT a drift finding" % (type(exc).__name__, exc), file=sys.stderr)
        return 3

if __name__ == "__main__":
    sys.exit(run())
