#!/usr/bin/env bash
set -uo pipefail
# One-way Gitea -> GitHub mirror sync (wq#2908).
#
# Gitea (origin) is the only writable primary; GitHub (`github` remote) is a
# read-only mirror for visibility/backup. This never authors or force-pushes
# origin, and it never pushes from the live primary working tree — each repo's
# mirror lives in its own bare clone under $MIRROR_ROOT, fetched fresh from
# origin every run, so a dirty or mid-work primary tree can never leak into the
# mirror and a broken mirror push can never touch the primary tree either.
#
# A mirror push does land straight on the mirror's default branch, which is what
# .githooks/branch-guard (wq#1476) refuses — but the guard is never in the way here
# and needs no exemption (wq#2947): it runs as a pre-push hook, and the bare clones
# under $MIRROR_ROOT have no hooks wired (`git clone --mirror` carries none, and
# nothing installs the guard there). Keeping the push out of the guarded primary
# trees is the whole point of the bare clone. If a mirror push ever does start
# tripping the guard, unguard the mirror clone — do not weaken cmd_push.
#
# The push sends branches and tags only, never `--mirror` (wq#3166): a `clone
# --mirror` fetches `+refs/*:refs/*`, so the bare clone also holds Gitea's
# refs/pull/* PR refs, and GitHub rejects any push touching those ("deny updating
# a hidden ref"), failing the whole push. Every git step's stderr tail goes into
# the aq row so a failure says why.
declare -A REPOS=(
  [claude-foreman]=/home/lumen/foreman
  [minerva]=/home/lumen/minerva
  [lumen-bin]=/home/lumen/bin
  [fleet-inventory]=/home/lumen/fleet/inventory
  [mission-control]=/home/lumen/mission-control
  [ccc]=/home/lumen/ccc
)
# Test hook: GITHUB_MIRROR_REPOS="name=dir name=dir" replaces the table above.
if [ -n "${GITHUB_MIRROR_REPOS:-}" ]; then
  REPOS=()
  for pair in $GITHUB_MIRROR_REPOS; do REPOS[${pair%%=*}]=${pair#*=}; done
fi
MIRROR_ROOT=${GITHUB_MIRROR_ROOT:-/home/lumen/mirrors}
AQ=${GITHUB_MIRROR_AQ:-/home/lumen/bin/aq}
PUSH_REFSPECS=('+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*')
fail=0
errlog=$(mktemp)
trap 'rm -f "$errlog"' EXIT

BIN_DIR="$(dirname "$(readlink -f "$0")")"
MASK="$BIN_DIR/mask-secrets"
# Test hook: GITHUB_MIRROR_SET_DEFAULT names a command run as <github_url> <branch>
# in place of github_set_default below.
SET_DEFAULT=${GITHUB_MIRROR_SET_DEFAULT:-github_set_default}

# err_tail: last lines of the step's stderr, masked, one line, for the aq detail.
err_tail() {
  [ -x "$MASK" ] || { echo "(stderr withheld: $MASK missing)"; return; }
  tail -n 5 "$errlog" | "$MASK" | tr '\n' ' ' | cut -c1-600
}

aq_fail() {  # aq_fail <key> <title> <detail>
  "$AQ" add github-mirror "$1" "$2" "$3" --owner github-mirror-sync >/dev/null 2>&1 || true
}

# github_set_default <github_url> <branch>: point the GitHub repo's default branch at
# <branch> through the REST API. Errors go to stderr for err_tail. The token reaches
# curl on stdin, never argv.
github_set_default() {
  local url="$1" branch="$2" slug out code
  case "$url" in
    https://github.com/*|https://*@github.com/*) slug=${url#*github.com/} ;;
    git@github.com:*) slug=${url#git@github.com:} ;;
    ssh://git@github.com/*) slug=${url#ssh://git@github.com/} ;;
    *) echo "not a github.com remote" >&2; return 1 ;;
  esac
  slug=${slug%/}; slug=${slug%.git}
  [[ $slug =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { echo "cannot parse owner/repo from the github url" >&2; return 1; }
  # shellcheck source=lumen-github-identity.sh
  . "$BIN_DIR/lumen-github-identity.sh" || { echo "cannot load lumen-github-identity.sh" >&2; return 1; }
  resolve_github_token "$slug" || return 1
  out=$(printf 'Authorization: Bearer %s\n' "$GITHUB_TOKEN" | curl -sS -m 30 -w '\n%{http_code}' -X PATCH \
    -H @- -H "Accept: application/vnd.github+json" \
    -d "$(jq -nc --arg b "$branch" '{default_branch: $b}')" "https://api.github.com/repos/$slug")
  code=${out##*$'\n'}
  [ "$code" = 200 ] && return 0
  echo "PATCH repos/$slug default_branch: HTTP $code $(printf '%s' "${out%$'\n'*}" | jq -r '.message // empty' 2>/dev/null)" >&2
  return 1
}

for name in "${!REPOS[@]}"; do
  dir="${REPOS[$name]}"
  [ -d "$dir" ] || continue
  git -C "$dir" remote get-url github >/dev/null 2>&1 || continue
  origin_url=$(git -C "$dir" remote get-url origin 2>/dev/null)
  github_url=$(git -C "$dir" remote get-url github 2>/dev/null)
  if [ -z "$origin_url" ] || [ -z "$github_url" ]; then
    echo "$name: FAIL missing origin or github remote url" >&2
    aq_fail "$name-no-remote" "github-mirror-sync: $name missing a remote url" \
      "origin or github remote url could not be resolved for $dir"
    fail=1
    continue
  fi

  bare="$MIRROR_ROOT/$name.git"
  if [ -d "$bare" ]; then
    if ! git -C "$bare" -c credential.helper=store fetch --prune origin --quiet 2>"$errlog"; then
      tail=$(err_tail)
      echo "$name: FAIL fetch from origin into mirror clone: $tail" >&2
      aq_fail "$name-fetch-fail" "github-mirror-sync: $name fetch from origin failed" \
        "bare mirror clone at $bare could not fetch origin: $tail"
      fail=1
      continue
    fi
  else
    mkdir -p "$MIRROR_ROOT"
    if ! git -c credential.helper=store clone --mirror --quiet "$origin_url" "$bare" 2>"$errlog"; then
      tail=$(err_tail)
      echo "$name: FAIL initial mirror clone from origin: $tail" >&2
      aq_fail "$name-clone-fail" "github-mirror-sync: $name initial mirror clone failed" \
        "git clone --mirror of origin into $bare failed: $tail"
      fail=1
      continue
    fi
    git -C "$bare" remote add github "$github_url" 2>/dev/null || true
  fi
  # github url may rotate independently of the initial clone; keep it current.
  git -C "$bare" remote set-url github "$github_url" 2>/dev/null || true

  # GitHub refuses to delete its current (default) branch, so a default branch that
  # is gone from origin would fail the whole push under --prune. The mirror follows
  # origin, so repoint GitHub's default at origin's HEAD (wq#3461: mission-control's
  # default was a deleted feature branch and the manual-fix row repeated 343 times).
  # Only if that fails, leave the branch out of the prune and raise a row.
  refspecs=("${PUSH_REFSPECS[@]}")
  gh_head=$(git -C "$bare" -c credential.helper=store ls-remote --symref github HEAD 2>/dev/null \
    | sed -n 's|^ref: refs/heads/\(.*\)\tHEAD$|\1|p')
  if [ -n "$gh_head" ] && ! git -C "$bare" show-ref --verify --quiet "refs/heads/$gh_head"; then
    origin_head=$(git -C "$bare" symbolic-ref --short HEAD 2>/dev/null)
    if [ -n "$origin_head" ] && git -C "$bare" show-ref --verify --quiet "refs/heads/$origin_head" \
      && git -C "$bare" -c credential.helper=store push --quiet github "refs/heads/$origin_head:refs/heads/$origin_head" 2>"$errlog" \
      && "$SET_DEFAULT" "$github_url" "$origin_head" 2>"$errlog"; then
      echo "$name: github default branch '$gh_head' is not on origin; repointed it to '$origin_head'"
    else
      tail=$(err_tail)
      refspecs+=("^refs/heads/$gh_head")
      echo "$name: WARN github default branch '$gh_head' is not on origin; kept it: $tail" >&2
      aq_fail "$name-default-branch" "github-mirror-sync: $name github default branch not on origin" \
        "GitHub default branch '$gh_head' does not exist on origin (HEAD '$origin_head'); it is kept out of the prune. Repointing it automatically failed: $tail. Set the GitHub default branch to '$origin_head'."
    fi
  fi

  if git -C "$bare" -c credential.helper=store push --prune --quiet github "${refspecs[@]}" 2>"$errlog"; then
    echo "$name: mirrored to GitHub"
  else
    tail=$(err_tail)
    echo "$name: FAIL push heads+tags to github: $tail" >&2
    aq_fail "$name-push-fail" "github-mirror-sync: $name push to github failed" \
      "git push --prune github heads+tags failed from bare clone $bare: $tail"
    fail=1
  fi
done

exit "$fail"
