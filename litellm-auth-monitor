#!/usr/bin/env bash
# litellm-auth-monitor — tail LiteLLM container logs for auth failures,
# write structured JSONL to a persistent audit log.
#
# wq#721: every auth rejection (401) is captured with timestamp, requester IP,
# and error detail. Runs as a long-lived service (lumen-litellm-auth-monitor.service).
#
# The LiteLLM proxy already rejects unkeyed callers (master_key enforcement),
# but those rejections only went to container stderr (ephemeral). This makes
# them persistent and machine-parseable for audit.

set -euo pipefail

LOGDIR="${LITELLM_AUTH_LOGDIR:-/home/lumen/logs/litellm}"
LOGFILE="$LOGDIR/auth-failures.jsonl"
CONTAINER="${LITELLM_CONTAINER:-litellm}"
MAX_BYTES="${LITELLM_AUTH_LOG_MAX_BYTES:-10485760}"  # 10 MiB rotate threshold

mkdir -p "$LOGDIR"

rotate_if_needed() {
    if [[ -f "$LOGFILE" ]] && [[ $(stat -c%s "$LOGFILE" 2>/dev/null || echo 0) -ge $MAX_BYTES ]]; then
        mv "$LOGFILE" "$LOGFILE.$(date -u +%Y%m%d-%H%M%S).bak"
    fi
}

# Tail container logs (follow mode). On container restart, docker logs --follow
# reconnects automatically. The --since flag avoids replaying ancient history.
docker logs --follow --since 1m "$CONTAINER" 2>&1 | while IFS= read -r line; do
    # Match the LiteLLM auth exception handler output
    # Pattern: "auth_exception_handler.py:NN - ... Exception occured - <reason>"
    if [[ "$line" =~ auth_exception_handler ]]; then
        # Extract the error message
        reason="${line##*Exception occured - }"
        reason="${reason%%$'\n'*}"
        ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        rotate_if_needed
        # The next line in the log typically has "Requester IP Address:"
        read -r -t 2 ipline || ipline=""
        ip=""
        if [[ "$ipline" =~ "Requester IP Address:" ]]; then
            ip="${ipline##*Requester IP Address:}"
            ip="${ip// /}"
        fi
        printf '{"ts":"%s","event":"auth_failure","ip":"%s","reason":"%s"}\n' \
            "$ts" "$ip" "$reason" >> "$LOGFILE"
    fi
    # Also catch the HTTP 401 access log line for additional context
    if [[ "$line" =~ "401 Unauthorized" ]] || [[ "$line" =~ '"401"' ]]; then
        ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        # Extract path and method from the access log
        endpoint=""
        if [[ "$line" =~ \"([A-Z]+)\ (/[^ ]+)\ HTTP ]]; then
            endpoint="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
        fi
        rotate_if_needed
        printf '{"ts":"%s","event":"auth_401","endpoint":"%s","raw":"%s"}\n' \
            "$ts" "$endpoint" "${line//\"/\\\"}" >> "$LOGFILE"
    fi
done
