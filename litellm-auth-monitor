#!/usr/bin/env bash
# litellm-auth-monitor — tail LiteLLM container logs for auth failures,
# write structured JSONL to a persistent audit log.
#
# wq#721: every auth rejection (401) is captured with timestamp, requester IP,
# and error detail. Runs as a long-lived service (lumen-litellm-auth-monitor.service).
#
# The LiteLLM proxy already rejects unkeyed callers (master_key enforcement),
# but those rejections only went to container stderr (ephemeral). This makes
# them persistent and machine-parseable for audit.
#
# wq#2571: `docker logs --follow` does NOT reconnect on container restart —
# the stream simply ends (exit 0) when the container it's attached to stops
# or is recreated. The old script relied on systemd Restart=always to notice
# and respawn it, which (a) racked up NRestarts on every routine container
# bounce and (b) always resumed with a fixed `--since 1m`, silently dropping
# every event in a gap longer than a minute. This version owns the reconnect
# itself: an inner loop restarts `docker logs --follow` with backoff and
# resumes exactly from the last log line it actually saw (persisted to
# STATEFILE), so the systemd unit no longer needs to restart on a container
# bounce and no event window is lost to a fixed lookback.

set -uo pipefail  # no -e: a single bad line (failed json build, no match) must not kill the monitor

LOGDIR="${LITELLM_AUTH_LOGDIR:-/home/lumen/logs/litellm}"
LOGFILE="$LOGDIR/auth-failures.jsonl"
CONTAINER="${LITELLM_CONTAINER:-litellm}"
MAX_BYTES="${LITELLM_AUTH_LOG_MAX_BYTES:-10485760}"  # 10 MiB rotate threshold
STATEFILE="${LITELLM_AUTH_STATEFILE:-$LOGDIR/.monitor-last-seen}"
MAX_BACKOFF="${LITELLM_AUTH_MAX_BACKOFF:-60}"

mkdir -p "$LOGDIR"

rotate_if_needed() {
    if [[ -f "$LOGFILE" ]] && [[ $(stat -c%s "$LOGFILE" 2>/dev/null || echo 0) -ge $MAX_BYTES ]]; then
        mv "$LOGFILE" "$LOGFILE.$(date -u +%Y%m%d-%H%M%S).bak"
    fi
}

# emit_json TS EVENT K1 V1 K2 V2 — append one JSONL record built by a real
# encoder (python json.dumps). Values travel via env, never interpolated into
# the python source, so a backslash/quote/control-char in a log line (e.g. a
# raw access-log line) can't produce broken JSON or break out of the literal.
emit_json() {
    local ts="$1" event="$2" k1="$3" v1="$4" k2="$5" v2="$6"
    EJ_TS="$ts" EJ_EVENT="$event" EJ_K1="$k1" EJ_V1="$v1" EJ_K2="$k2" EJ_V2="$v2" \
        python3 - >>"$LOGFILE" <<'PY'
import json, os
d = {"ts": os.environ["EJ_TS"], "event": os.environ["EJ_EVENT"]}
d[os.environ["EJ_K1"]] = os.environ.get("EJ_V1", "")
d[os.environ["EJ_K2"]] = os.environ.get("EJ_V2", "")
print(json.dumps(d))
PY
}

last_seen_ts() {
    if [[ -s "$STATEFILE" ]]; then
        cat "$STATEFILE"
    else
        date -u -d '1 minute ago' +%Y-%m-%dT%H:%M:%S.000000000Z
    fi
}

save_last_seen() {
    printf '%s' "$1" > "$STATEFILE.tmp" && mv -f "$STATEFILE.tmp" "$STATEFILE"
}

# process_line LINE — parse one docker-log line (optionally --timestamps-
# prefixed) for the two event shapes this monitor cares about. For an
# auth_exception_handler hit it reads one more line from fd 3 (the
# "Requester IP Address:" follow-up); callers must have fd 3 wired to the
# same stream LINE came from (the live loop wires it to the docker stream,
# the test harness wires it to a fixture).
process_line() {
    local line="$1" ts_field rest reason ip ipline endpoint

    ts_field="${line%% *}"
    if [[ "$ts_field" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9] ]]; then
        rest="${line#* }"
        save_last_seen "$ts_field"
    else
        rest="$line"
    fi

    if [[ "$rest" =~ auth_exception_handler ]]; then
        reason="${rest##*Exception occured - }"
        reason="${reason%%$'\n'*}"
        rotate_if_needed
        ipline=""
        read -r -t 2 -u 3 ipline || ipline=""
        ip=""
        if [[ "$ipline" =~ "Requester IP Address:" ]]; then
            ip="${ipline##*Requester IP Address:}"
            ip="${ip// /}"
        fi
        emit_json "$(date -u +%Y-%m-%dT%H:%M:%SZ)" auth_failure ip "$ip" reason "$reason"
    fi

    if [[ "$rest" =~ "401 Unauthorized" ]] || [[ "$rest" =~ '"401"' ]]; then
        endpoint=""
        if [[ "$rest" =~ \"([A-Z]+)\ (/[^ ]+)\ HTTP ]]; then
            endpoint="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
        fi
        rotate_if_needed
        emit_json "$(date -u +%Y-%m-%dT%H:%M:%SZ)" auth_401 endpoint "$endpoint" raw "$rest"
    fi
}

run() {
    local backoff=1 since line
    while true; do
        since=$(last_seen_ts)
        while IFS= read -r -u 3 line; do
            backoff=1
            process_line "$line"
        done 3< <(docker logs --follow --timestamps --since "$since" "$CONTAINER" 2>&1)

        # The follow stream ended — container stopped/recreated, or a
        # transient docker error. Reconnect with backoff instead of exiting
        # (which used to hand this off to systemd Restart=always and lose the
        # gap beyond a fixed --since 1m).
        sleep "$backoff"
        backoff=$(( backoff < MAX_BACKOFF ? backoff * 2 : MAX_BACKOFF ))
    done
}

if [[ "${LITELLM_AUTH_MONITOR_TEST_MODE:-0}" != 1 ]]; then
    run
fi
